      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a HerbariumSheet voucher specimen to the Plant record it documents. Enables herbarium institution records to join to Iroko plant records."
