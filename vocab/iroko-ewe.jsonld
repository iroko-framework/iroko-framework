      "rdfs:domain": {
        "@id": "iroko:HerbariumSheet"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ewe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "documents plant"
      },
      "rdfs:range": {
        "@id": "iroko:Plant"
      }
    },
    {
