    {
      "@id": "https://ontology.irokosociety.org/iroko-ewe",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-17"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Domain module. Vocabulary for documenting sacred plant knowledge in Afro-Atlantic traditions. Provides ritual use governance over Darwin Core botanical data. Focus on medicinal and ritual applications, harvest protocols, preparation methods, and access control for operational knowledge. Use with iroko-epistemic to model harvest and preparation constraints; with iroko-travay for ceremony context in which plants are deployed. Darwin Core alignment declarations are in iroko-align-dwc."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-08"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-epistemic"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-travay"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Ewe Module (Sacred Plant Knowledge)"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-ewe/2.1.0"
      },
      "owl:versionInfo": "2.1.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
