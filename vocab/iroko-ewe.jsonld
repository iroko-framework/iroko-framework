    {
      "@id": "iroko:HerbariumSheet",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Physical plant specimen preserved for documentation. Links botanical voucher to a plant record and archival photograph via iroko:documentsPlant and iroko:photographicVoucher. Darwin Core alignment: iroko:specimenNumber skos:exactMatch dwc:catalogNumber (declared in iroko-align-dwc)."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ewe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Herbarium Sheet"
      },
