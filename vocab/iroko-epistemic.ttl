@prefix iroko:    <https://ontology.irokosociety.org/core/> .
@prefix iroko-ag: <https://ontology.irokosociety.org/agency/> .
@prefix iroko-ep: <https://ontology.irokosociety.org/epistemic/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.irokosociety.org/epistemic/>
    a owl:Ontology ;
    rdfs:label "Iroko epistemic module"@en ;
    dcterms:description "Optional module for modeling epistemic constraints and permissions (knowledge gating). Designed for sovereignty-aware archives where disclosure can be conditioned, restricted, or sanctioned."@en ;
    dcterms:creator "Iroko Historical Society"@en ;
    dcterms:issued "2026-02-22"^^xsd:date ;
    dcterms:license <https://ontology.irokosociety.org/policy/terms-of-use> ;
    dcterms:isPartOf <https://ontology.irokosociety.org/> ;
    dcterms:requires <https://ontology.irokosociety.org/core/> ;
    dcterms:requires <https://ontology.irokosociety.org/agency/> .

# ===================================================================
# CLASSES
# ===================================================================

iroko-ep:EpistemicConstraint
    a owl:Class ;
    rdfs:label "Epistemic Constraint"@en ;
    rdfs:comment "A constraint describing conditions under which knowledge may be disclosed, withheld, transformed, or restricted. This models governance of revelation and secrecy without encoding ritual instructions."@en .

iroko-ep:DisclosurePermission
    a owl:Class ;
    rdfs:subClassOf iroko-ep:EpistemicConstraint ;
    rdfs:label "Disclosure Permission"@en ;
    rdfs:comment "A constraint that asserts disclosure is permitted under specified conditions."@en .

iroko-ep:DisclosureRestriction
    a owl:Class ;
    rdfs:subClassOf iroko-ep:EpistemicConstraint ;
    rdfs:label "Disclosure Restriction"@en ;
    rdfs:comment "A constraint that asserts disclosure is restricted, limited, or prohibited under specified conditions."@en .

iroko-ep:SanctionedDisclosure
    a owl:Class ;
    rdfs:subClassOf iroko-ep:EpistemicConstraint ;
    rdfs:label "Sanctioned Disclosure"@en ;
    rdfs:comment "A constraint that asserts disclosure is permitted only when sanctioned by an authority or mandate."@en .

iroko-ep:ConstraintBasis
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Constraint Basis"@en ;
    rdfs:comment "A SKOS concept describing the basis for an epistemic constraint (initiation, lineage, community mandate, ritual condition, safety, and similar bases)."@en .

iroko-ep:ConstraintBasisScheme
    a skos:ConceptScheme ;
    rdfs:label "Constraint Bases"@en ;
    dcterms:description "Controlled terms describing bases for epistemic constraints."@en ;
    skos:hasTopConcept
        iroko-ep:basis-initiation,
        iroko-ep:basis-lineage,
        iroko-ep:basis-community-mandate,
        iroko-ep:basis-ritual-condition,
        iroko-ep:basis-safety,
        iroko-ep:basis-unknown .

# ===================================================================
# PROPERTIES
# ===================================================================

iroko-ep:hasEpistemicConstraint
    a owl:ObjectProperty ;
    rdfs:label "has epistemic constraint"@en ;
    rdfs:comment "Associates a policy, record, or assertion node with an EpistemicConstraint."@en ;
    rdfs:range iroko-ep:EpistemicConstraint .

iroko-ep:hasConstraintBasis
    a owl:ObjectProperty ;
    rdfs:label "has constraint basis"@en ;
    rdfs:comment "Associates an EpistemicConstraint with a ConstraintBasis concept."@en ;
    rdfs:range iroko-ep:ConstraintBasis .

iroko-ep:hasTemporalVariation
    a owl:ObjectProperty ;
    rdfs:label "has temporal variation"@en ;
    rdfs:comment "Reuses the core TemporalVariation scheme to qualify constraints that vary by season, cycle, event, or context."@en ;
    rdfs:range iroko:TemporalVariation .

# ===================================================================
# CONCEPTS: Constraint bases (starter set)
# ===================================================================

iroko-ep:basis-initiation
    a iroko-ep:ConstraintBasis ;
    skos:inScheme iroko-ep:ConstraintBasisScheme ;
    skos:prefLabel "Initiation"@en ;
    skos:definition "Constraint basis asserted as initiation level or initiatory boundary."@en .

iroko-ep:basis-lineage
    a iroko-ep:ConstraintBasis ;
    skos:inScheme iroko-ep:ConstraintBasisScheme ;
    skos:prefLabel "Lineage"@en ;
    skos:definition "Constraint basis asserted as lineage affiliation or lineage authority."@en .

iroko-ep:basis-community-mandate
    a iroko-ep:ConstraintBasis ;
    skos:inScheme iroko-ep:ConstraintBasisScheme ;
    skos:prefLabel "Community Mandate"@en ;
    skos:definition "Constraint basis asserted as a community mandate or governance decision."@en .

iroko-ep:basis-ritual-condition
    a iroko-ep:ConstraintBasis ;
    skos:inScheme iroko-ep:ConstraintBasisScheme ;
    skos:prefLabel "Ritual Condition"@en ;
    skos:definition "Constraint basis asserted as a ritual condition or ritual state."@en .

iroko-ep:basis-safety
    a iroko-ep:ConstraintBasis ;
    skos:inScheme iroko-ep:ConstraintBasisScheme ;
    skos:prefLabel "Safety"@en ;
    skos:definition "Constraint basis asserted as safety, harm prevention, or protective limitation."@en .

iroko-ep:basis-unknown
    a iroko-ep:ConstraintBasis ;
    skos:inScheme iroko-ep:ConstraintBasisScheme ;
    skos:prefLabel "Unknown"@en ;
    skos:definition "Constraint basis not known or not recorded."@en .
