    {
      "@id": "iroko:societyStatus-forcibly-dissolved",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The society was suppressed by an external authority — colonial administration, state government, or occupying power — rather than ceasing through internal process. Records held by a forcibly dissolved society do not become public as a result of the dissolution. See also: iroko:ForcedDissolution."
      },
      "skos:inScheme": {
        "@id": "iroko:SocietyStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "forcibly dissolved"
      }
    },
    {
      "@id": "iroko:society-gelede",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A masquerade society of the Yorùbá, Nago, and Fon peoples honoring the power of women, especially elder women, ancestresses, and the mothers (àwọn ìyá wa). Gelede festivals feature carved wooden masks worn by male dancers who embody female spiritual authority. UNESCO Intangible Cultural Heritage. Active in Nigeria, Benin, and Afro-Atlantic communities."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiatorySocietyTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Gelede"
        },
        {
          "@language": "yo",
          "@value": "Gẹlẹdẹ"
        }
      ]
    },
    {
      "@id": "iroko:membershipSociety",
