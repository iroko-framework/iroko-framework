    },
    {
      "@id": "iroko:gov-hierarchical-grade",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority flows through a defined sequence of grades; higher grades govern lower. Characteristic of Ékpè, Abakuá, and similar tiered societies."
      },
      "skos:inScheme": {
        "@id": "iroko:GovernanceStructureScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Hierarchical grade system"
      }
    },
    {
      "@id": "iroko:gradePrerequisite",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The grade that must be held before this grade may be received. Initiated-only: the sequencing of grades is esoteric knowledge."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyGrade"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "grade prerequisite"
      },
      "rdfs:range": {
        "@id": "iroko:SocietyGrade"
      }
    },
    {
      "@id": "iroko:conferral-purchase",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Title conferred in exchange for a defined payment or contribution to the society. Common in some Ékpè and Abakuá grade structures."
      },
      "skos:inScheme": {
        "@id": "iroko:TitleConferralScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Purchase / fee-based conferral"
      }
    },
    {
      "@id": "iroko:masqueradeRequiredGrade",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The minimum grade required to perform or wear this masquerade. Initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyMasquerade"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "required grade for performance"
      },
      "rdfs:range": {
        "@id": "iroko:SocietyGrade"
      }
    },
    {
      "@id": "iroko:mask-function-funerary",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The masquerade participates in funerary ceremonies, guiding the deceased or honoring the passing. Abakuá íremes appear at members' funerals."
      },
      "skos:inScheme": {
        "@id": "iroko:MasqueradeFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Funerary / transition rites"
      }
    },
    {
      "@id": "iroko:mask-function-healing",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The masquerade carries healing or protective power for the community or individual supplicants."
      },
      "skos:inScheme": {
        "@id": "iroko:MasqueradeFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Healing / protective"
      }
    },
    {
      "@id": "iroko:society-oro",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A Yorùbá male initiatory society associated with the voice of Oro (heard as a bullroarer), ancestral authority, and community sanction. Oro festivals enforce communal prohibitions and conduct ancestral rites. Strict gender separation is central to Oro practice: women must remain indoors when Oro goes out."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiatorySocietyTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Oro"
        },
        {
          "@language": "yo",
          "@value": "Oro"
        }
      ]
    },
    {
      "@id": "iroko:SocietyGrade",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A defined rank or level within an initiatory society's graded hierarchy. Each grade confers specific knowledge, privileges, obligations, and esoteric rights. Grade names, their sequence, and their content are among the most carefully protected knowledge in these traditions. The existence of a grade structure is public; grade names are community-restricted; grade content and sequence are initiated-only or initiated-elder."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Society Grade"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:gov-hereditary-title",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Key titles pass within specific families or lineages. Characteristic of some Egungun and Agemo societies."
      },
      "skos:inScheme": {
        "@id": "iroko:GovernanceStructureScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Hereditary title succession"
      }
    },
    {
      "@id": "iroko:genderPolicy",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Documents tradition-specific rules regarding gender and membership. For Abakuá: historically male-only (juramento); for Ogboni: both male and female members, with distinct female titleholder roles (Iyalode); for Gelede: primarily concerns gender complementarity (mothers/fathers). Free-text, records documented practice without normative judgment."
      },
      "rdfs:domain": {
        "@id": "iroko:InitiatorySociety"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "gender policy"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:masqueradeName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The name of the masquerade or masked figure. Community-restricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyMasquerade"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "masquerade name"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:conferral-spiritual-designation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Title conferred through divination or spiritual indication rather than human election."
      },
      "skos:inScheme": {
        "@id": "iroko:TitleConferralScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Spiritual designation"
      }
    },
    {
      "@id": "iroko:memberPerson",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-no-access"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The person to whom this membership record belongs. No-access: member identity is the most protected information in society records."
      },
      "rdfs:domain": {
        "@id": "iroko:MembershipRecord"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "member person"
      },
      "rdfs:range": {
        "@id": "http://xmlns.com/foaf/0.1/Person"
      }
    },
    {
      "@id": "iroko:societyStatus-historical",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The society is no longer operating but was not forcibly dissolved — it ceased through natural discontinuity, succession failure, or community decision."
      },
      "skos:inScheme": {
        "@id": "iroko:SocietyStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "historical"
      }
    },
    {
      "@id": "iroko:mask-function-honor-mothers",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The masquerade pays tribute to the power of elder women, ancestresses, and female spiritual authority. Primary function of Gelede."
      },
      "skos:inScheme": {
        "@id": "iroko:MasqueradeFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Honoring the mothers"
      }
    },
    {
      "@id": "iroko:gov-elected-officers",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Governance officers are elected by the membership for defined terms. More common in Afro-Atlantic adaptations (Reformed Ogboni Fraternity, some Abakuá mutual aid structures)."
      },
      "skos:inScheme": {
        "@id": "iroko:GovernanceStructureScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Elected officers"
      }
    },
    {
