      }
    },
    {
      "@id": "iroko:SocietyTitle",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A named office or titled position within an initiatory society, distinct from grade level. Titles may be elected, inherited, purchased, or conferred. Examples: Iyamba (Abakuá), Isue (Abakuá), Ekueñón (Abakuá), Apetebi Ogboni, Olori Egungun. Each title carries specific ritual functions, insignia, and governance authority. Title names are community-restricted; the ritual functions attached to them are initiated-only."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Society Title"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:representedEntity",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The ancestral spirit, principle, or force embodied by this masquerade. Range: iroko:SpiritualEntity. Initiated-only: the identity of what a masquerade embodies is esoteric in many traditions."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyMasquerade"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "represented entity"
      },
      "rdfs:range": {
        "@id": "iroko:SpiritualEntity"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-ekpe",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-21"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Domain module. Vocabulary for documenting initiatory societies, grade structures, esoteric governance, and sodality membership across Afro-Atlantic traditions. Covers Ékpè/Ngbe, Abakuá, Ogboni/Oshugbo, Oro, Gelede, Egungun, and analogous institutions. Distinct from iroko-ile (religious houses and lineages) and iroko-travay (ritual processes): this module focuses on the institutional architecture of sodalities as systems of graded authority, esoteric knowledge, and community governance. Use with iroko-authority to model grade conferral authority and recognition networks; iroko-epistemic to constrain disclosure of restricted grade content and member identities."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-epistemic"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Ékpè Module (Initiatory Societies, Grades, and Esoteric Governance)"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
