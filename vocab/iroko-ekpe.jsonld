    {
      "@id": "iroko:societyStatus-reformed",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The society has been reconstituted after a period of dormancy or dissolution, with continuity of tradition but a break in institutional operation."
      },
      "skos:inScheme": {
        "@id": "iroko:SocietyStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "reformed"
      }
    },
    {
      "@id": "iroko:societyStatus",
      "@type": "owl:ObjectProperty",
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The current operational status of an initiatory society. Range: iroko:SocietyStatusScheme concepts (active, historical, reformed, forcibly-dissolved). A forcibly-dissolved society's archival records retain their access restrictions — dissolution by external authority does not transfer governance to the suppressing power or to the public."
      },
      "rdfs:domain": {
        "@id": "iroko:InitiatorySociety"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "society status"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
