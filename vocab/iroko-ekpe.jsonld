        },
        {
          "@language": "fr",
          "@value": "Types de société initiatique"
        },
        {
          "@language": "pt",
          "@value": "Tipos de sociedade iniciática"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ìrú ẹgbẹ́ àṣírí"
        }
      ]
    },
    {
      "@id": "iroko:mask-function-entertainment",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The masquerade performs entertainment, social commentary, or satire as a secondary function. Often combined with sacred primary functions."
      },
      "skos:inScheme": {
        "@id": "iroko:MasqueradeFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Entertainment / social satire"
      }
    },
    {
      "@id": "iroko:societyStatus-active",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The society is currently operating, initiating members, and exercising its governance functions."
      },
      "skos:inScheme": {
        "@id": "iroko:SocietyStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "active"
      }
    },
    {
      "@id": "iroko:masqueradeFunction",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The ceremonial function of this masquerade. Range: iroko:MasqueradeFunctionScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyMasquerade"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "masquerade function"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:mask-function-society-voice",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The masquerade carries and communicates the voice or authority of the society. Function of Abakuá íremes and Ékpè masquerades."
      },
      "skos:inScheme": {
        "@id": "iroko:MasqueradeFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Society voice / announcement"
      }
    },
    {
      "@id": "iroko:society-ogboni",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Reformed Ogboni Fraternity"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The Yorùbá earth-deity society organized around Onilé (the earth) and its representations. Historically a governance institution with judicial, political, and ritual authority in Yorùbá towns. Members include both men and women. The Reformed Ogboni Fraternity (ROF) is a Christianized offshoot. Distinct from the traditional Oshugbo lineages in Ijebu and other areas."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiatorySocietyTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Ogboni / Oshugbo"
        },
        {
          "@language": "yo",
          "@value": "Ogboni / Oshugbo"
        }
      ]
    },
    {
      "@id": "iroko:society-abakua",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "es",
        "@value": "Ñáñigos"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The Abakuá mutual aid and initiatory society founded in Cuba in 1836, derived from Ékpè/Ngbe through enslaved Efik and Efut practitioners in Havana and Matanzas. Organized into potencias (lodges), each with a specific founding charter and ranked titleholders. Known in Cuban public life through the íremes (diablito masquerades) which appear at funerals and public ceremonies. Male-only by tradition (juramento)."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiatorySocietyTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Abakuá"
        },
        {
          "@language": "es",
          "@value": "Abakuá"
        }
      ],
      "skos:scopeNote": {
        "@language": "en",
        "@value": "One of the most extensively documented Afro-Atlantic initiatory societies due to 19th-century Cuban court records and 20th-century ethnographic work (Cabrera, Sosa). Historical lodge names and early records are in the public domain; contemporary lodge governance and membership remain restricted."
      }
    },
    {
      "@id": "iroko:TitleConferralScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Title Conferral Methods"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:conferral-election"
        },
        {
          "@id": "iroko:conferral-hereditary"
        },
        {
          "@id": "iroko:conferral-other"
        },
        {
          "@id": "iroko:conferral-purchase"
        },
        {
          "@id": "iroko:conferral-senior-nomination"
        },
        {
          "@id": "iroko:conferral-spiritual-designation"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Title Conferral Methods"
        },
        {
          "@language": "es",
          "@value": "Métodos de conferimiento de títulos"
        },
        {
          "@language": "fr",
          "@value": "Méthodes de conférence des titres"
