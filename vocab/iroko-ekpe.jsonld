{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:titleConferralMethod",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "How this title is conferred: election, hereditary succession, purchase, senior nomination. Range: iroko:TitleConferralScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyTitle"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "title conferral method"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:society-egungun",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Yorùbá ancestral masquerade society responsible for summoning and embodying ancestral spirits (egungun). Membership and performance rights are typically hereditary through specific lineages. The masked figure is understood as a manifestation of the collective ancestral force, not a theatrical performance. Widespread across Yorùbáland and Afro-Atlantic."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiatorySocietyTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Egungun"
        },
        {
          "@language": "yo",
          "@value": "Egúngún"
        }
      ]
    },
    {
      "@id": "iroko:gradeName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The name of the grade in the tradition's language. Community-restricted for active societies."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyGrade"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "grade name"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:initiatingOfficiant",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-no-access"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The titleholder who performed the initiation. No-access."
      },
      "rdfs:domain": {
        "@id": "iroko:MembershipRecord"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "initiating officiant"
      },
      "rdfs:range": {
        "@id": "http://xmlns.com/foaf/0.1/Person"
      }
    },
    {
      "@id": "iroko:MembershipRecord",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A record documenting an individual's initiation into and progression through a society. Membership records are among the most sensitive data in this framework: the identity of initiates is strictly guarded by all documented traditions, and their disclosure to outsiders is a serious breach. Default access is no-access; date and grade level may be community-restricted in contexts where historical record-keeping is an accepted practice (e.g., Cuban Abakuá records kept since the 19th century)."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Membership Record"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:membershipDate",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Date of initiation into this grade. Community-restricted for historical records."
      },
      "rdfs:domain": {
        "@id": "iroko:MembershipRecord"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "membership date"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "iroko:associatedHouse",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A religious house (iroko:House) with which this society maintains an ongoing ceremonial relationship. In many traditions, society and house membership overlap for senior practitioners."
      },
      "rdfs:domain": {
        "@id": "iroko:InitiatorySociety"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "associated house"
      },
      "rdfs:range": {
        "@id": "iroko:House"
      }
    },
    {
      "@id": "iroko:gradeLevel",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Numeric position in the grade sequence. 1 = lowest/entry. Community-restricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyGrade"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "grade level"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "iroko:InitiatorySociety",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A sodality or secret society organized around graded initiation, with esoteric knowledge and authority distributed across hierarchical grades. Membership is earned through initiation rather than birth or lineage alone. Examples: Ékpè/Ngbe lodges (Ejagham, Cross River Nigeria/Cameroon), Abakuá potencias (Cuba), Ogboni chapters (Yorùbáland), Gelede societies (Yorùbá/Fon/Ewe), Egungun lineage associations. Subclasses schema:Organization for interoperability with external directories, and iroko:SacredEntity for access control. Distinguished from iroko:House (which organizes around founding-elder lineage) in that membership cross-cuts lineage boundaries."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Initiatory Society"
      },
      "rdfs:subClassOf": [
        {
          "@id": "https://schema.org/Organization"
        },
        {
          "@id": "iroko:SacredEntity"
        }
      ]
    },
    {
      "@id": "iroko:gov-consensus",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Decisions made through deliberation among all members or all senior members without fixed hierarchical authority."
      },
      "skos:inScheme": {
        "@id": "iroko:GovernanceStructureScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Consensus / deliberative"
      }
    },
    {
      "@id": "iroko:mask-function-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Masquerade function not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:MasqueradeFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:dissolutionDate",
      "@type": "owl:DatatypeProperty",
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The date or approximate period of the forced dissolution event."
      },
      "rdfs:domain": {
        "@id": "iroko:ForcedDissolution"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dissolution date"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:dissolutionAuthority",
      "@type": "owl:DatatypeProperty",
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The external authority (state, colonial power, occupying government) that forced dissolution of the society. Free text, language-tagged."
      },
      "rdfs:domain": {
        "@id": "iroko:ForcedDissolution"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dissolution authority"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:lodgeTerritory",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The geographic or community territory over which a lodge exercises spiritual and social jurisdiction. Free-text description."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyLodge"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "lodge territory"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:mask-function-ancestral-embodiment",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The masquerade manifests an ancestral spirit or collective ancestral force. Primary function of Egungun."
      },
      "skos:inScheme": {
        "@id": "iroko:MasqueradeFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ancestral embodiment"
      }
    },
    {
      "@id": "iroko:SocietyMasquerade",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A masked or costumed ritual embodiment associated with an initiatory society, representing an ancestor, force, or principle. Examples: Abakuá íremes (diablitos) representing the voice of the fish Tanze; Egungun masquerades embodying ancestral spirits; Gelede masquerades honoring the mothers. The masquerade as a cultural form (name, tradition, function) is community-restricted; the identities of performers and operational sequences are initiated-only. Distinct from iroko:SpiritualEntity (which covers the spiritual force) and travay:CeremonialSequence (which covers the ritual sequence)."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Society Masquerade"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:mask-function-communal-sanction",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The masquerade enforces community rules or social norms through symbolic or direct intervention. Function of Oro."
      },
      "skos:inScheme": {
        "@id": "iroko:MasqueradeFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Communal sanction / enforcement"
      }
    },
    {
      "@id": "iroko:society-agemo",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "An Ijebu Yorùbá priestly and masquerade society associated with Agemo, a deity of transformation and mediation between worlds. The Agemo festival cycle involves multiple masquerades representing aspects of Agemo's power. Restricted primarily to Ijebu initiates."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiatorySocietyTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Agemo"
        },
        {
          "@language": "yo",
          "@value": "Àgẹmọ"
        }
      ]
    },
    {
      "@id": "iroko:titleName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The name of the office or title in the tradition's language. Community-restricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyTitle"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "title name"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:gradeSign",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-elder"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The esoteric graphic sign or identifying mark associated with this grade. Range: iroko:GraphicSign — grade signs in Ékpè and cognate societies are drawn symbols belonging to a sacred sign system, not free-text strings. Initiated-elder only."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyGrade"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "grade sign"
      },
      "rdfs:range": {
        "@id": "iroko:GraphicSign"
      }
    },
    {
      "@id": "iroko:SocietyStatusScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Controlled vocabulary for the operational status of an initiatory society."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Society Status Scheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Society Status Scheme"
      }
    },
    {
      "@id": "iroko:societyTradition",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The Afro-Atlantic tradition within which this society operates. Range: iroko:TraditionScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:InitiatorySociety"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "society tradition"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:society-ekpe",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Leopard Society"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The Ékpè (also Ngbe) leopard society originating among Ejagham and neighboring Cross River peoples of Nigeria and Cameroon. One of the most widespread and influential initiatory societies in West Africa, with documented Afro-Atlantic presence through enslaved Africans in Cuba (Abakuá) and elsewhere. Organized around graded leopard-force initiation; Nsibidi script is associated with Ékpè esoteric communication."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiatorySocietyTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Ékpè / Ngbe"
        },
        {
          "@language": "fr",
          "@value": "Ékpè / Ngbe"
        }
      ],
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Ékpè and Abakuá are historically related but institutionally distinct. Use iroko:parentSociety to express the derived relationship."
      }
    },
    {
      "@id": "iroko:gov-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Governance structure not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:GovernanceStructureScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:SocietyLodge",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A local chapter or lodge of an initiatory society. Ékpè lodges in Cross River; Abakuá potencias in Havana and Matanzas; Ogboni chapters in Yorùbá towns. Each lodge may have its own territory, titleholders, and charter, while being part of a broader society network. Uses iroko:parentSociety to link to the overarching tradition-level society."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Society Lodge"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:InitiatorySociety"
      }
    },
    {
      "@id": "iroko:gov-council-of-elders",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Governance by a council of senior members without strict linear grade hierarchy. Characteristic of Ogboni and some Egungun lineages."
      },
      "skos:inScheme": {
        "@id": "iroko:GovernanceStructureScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Council of elders"
      }
    },
    {
      "@id": "iroko:lodgeName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The public name of the lodge or potencia. In Abakuá: the potencia name (e.g., Efik Butón, Efik Efor). Community-restricted for active lodges; public for historical lodges documented in scholarly sources."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyLodge"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "lodge name"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:titleRequiredGrade",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The minimum grade required to hold this title. Initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyTitle"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "required grade"
      },
      "rdfs:range": {
        "@id": "iroko:SocietyGrade"
      }
    },
    {
      "@id": "iroko:gradeSociety",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The initiatory society to which this grade belongs."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyGrade"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "grade society"
      },
      "rdfs:range": {
        "@id": "iroko:InitiatorySociety"
      }
    },
    {
      "@id": "iroko:parentSociety",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The broader society network or tradition of which this lodge is a chapter. A Havana Abakuá potencia links to the Abakuá tradition; a Calabar Ékpè lodge links to the Ékpè tradition. Subproperty of prov:wasDerivedFrom."
      },
      "rdfs:domain": {
        "@id": "iroko:SocietyLodge"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "parent society"
      },
      "rdfs:range": {
        "@id": "iroko:InitiatorySociety"
      },
      "rdfs:subPropertyOf": {
        "@id": "http://www.w3.org/ns/prov#wasDerivedFrom"
      }
    },
    {
      "@id": "iroko:membershipTitle",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A title held by this member within the society."
      },
      "rdfs:domain": {
        "@id": "iroko:MembershipRecord"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ekpe"
      },
