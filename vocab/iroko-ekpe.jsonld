    {
      "@id": "iroko:society-sande",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The female counterpart to Poro, managing female initiation among Mende, Temne, and neighboring peoples. Sande is distinctive in African contexts as a society where women wear and operate the sacred Sowei helmet mask."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiatorySocietyTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Sande / Bundo"
      }
    },
