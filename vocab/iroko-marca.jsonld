        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Casting Media"
        },
        {
          "@language": "es",
          "@value": "Medios de lanzamiento"
        },
        {
          "@language": "fr",
          "@value": "Médiums de tirage"
        },
        {
          "@language": "pt",
          "@value": "Meios de lançamento"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ohun ìdán"
        }
      ]
    },
    {
      "@id": "iroko:medium-obi-coconut",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Coconut divided into four pieces for Obi divination."
      },
      "skos:inScheme": {
        "@id": "iroko:CastingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Obi Abata (coconut)"
      }
    },
    {
      "@id": "iroko:prescribedWork",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The ebó, rogation, ceremony, or spiritual work prescribed as a result of this reading. Range: iroko:EboTypeScheme. Among the most sensitive data: links divination outcome to specific prescribed action."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationReading"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "prescribed work"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:outcome-ire-omo",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Iré of children or generativity. The sign comes with the blessing of progeny or creative fruitfulness."
      },
      "skos:inScheme": {
        "@id": "iroko:OutcomeTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Iré Omo (children)"
        },
        {
          "@language": "es",
          "@value": "Iré Omo"
        }
      ]
    },
