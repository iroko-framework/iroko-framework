        },
        {
          "@language": "fr",
          "@value": "Types de système divinatoire"
        },
        {
          "@language": "pt",
          "@value": "Tipos de sistema divinatório"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ìrú ọ̀nà aṣọtẹ́lẹ̀"
        }
      ]
    },
    {
      "@id": "iroko:hasCorpus",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a DivinationSystem to its DivinationCorpus. The corpus is the complete body of verses, prescriptions, and commentary associated with this system within a specific lineage. A system may have multiple corpora across lineages — each lineage's corpus is a separate DivinationCorpus instance (subclass of LineageKnowledgeGraph). Access: public-unrestricted — the existence of a corpus associated with a system is public knowledge; the verse content within the corpus is governed at elder-initiated level on the DivinationVerse instances themselves."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSystem"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has corpus"
      },
      "rdfs:range": {
        "@id": "iroko:DivinationCorpus"
      }
    },
    {
      "@id": "iroko:ebo-sacrifice",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Ritual sacrifice of an animal specified by the reading. Species, preparation, and allocation are operational details held at initiated-only access."
      },
      "skos:inScheme": {
        "@id": "iroko:EboTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Animal sacrifice"
        },
        {
          "@language": "es",
          "@value": "Sacrificio animal"
        }
      ]
    },
    {
      "@id": "iroko:signVerseCorpus",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-elder"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The set of DivinationVerse instances in a specific lineage's corpus for this sign. The existence of a corpus is public; the verse content is initiated-elder only."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "verse corpus"
      },
      "rdfs:range": {
        "@id": "iroko:DivinationCorpus"
      }
    },
    {
      "@id": "iroko:secondarySign",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "In composite systems (Ifá), the sign generated by the second cast. Together with primarySign, identifies the full odù compound."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "secondary sign"
      },
      "rdfs:range": {
        "@id": "iroko:DivinationSign"
      }
    },
    {
      "@id": "iroko:DivinationSystem",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A tradition-specific divination system consisting of a defined corpus of signs, casting methods, and interpretive frameworks. Examples: Ifá (256 odù, palm nut or chain casting), Dilogún (16 principal signs, cowrie casting), Fá (Fon parallel to Ifá), Obi (4-part binary coconut or kola reading), Chamalongo (Palo Kongo coconut/bone divination). A DivinationSystem belongs to one or more traditions and may have regional variants."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Divination System"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-marca",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-21"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Domain module. Vocabulary for documenting divination systems, sacred signs, reading records, and verse corpora across Afro-Atlantic traditions. Covers Ifá (256 odù), Dilogún, Fá, Obi, Chamalongo, and analogous systems. Sign names and system typologies are public; verse texts, reading details, and prescribed works are restricted at the property level. Use with iroko-authority to document who may perform or transmit readings; iroko-narrative for verse corpus transmission chains and patakí variant relationships."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-02-25"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-narrative"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Marca Module (Divination Systems and Sacred Sign Corpora)"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-marca/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:signReceived",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The divination sign(s) that appeared in this reading."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationReading"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sign received"
      },
      "rdfs:range": {
        "@id": "iroko:DivinationSign"
      }
    },
    {
      "@id": "iroko:signProverb",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The principal proverb (owe) associated with this sign. Proverbs are often publicly known and shared in scholarly literature. Language-tagged."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sign proverb"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:ebo-ebo",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A prescribed offering to the Orisha or Ifá indicated by the reading. Includes specific materials, animals, foods, or objects. Operational details are initiated-only."
      },
      "skos:inScheme": {
        "@id": "iroko:EboTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Ebó"
        },
        {
          "@language": "es",
          "@value": "Ebó"
        },
        {
          "@language": "yo",
          "@value": "Ebó"
        }
      ]
    },
    {
      "@id": "iroko:readingRecipient",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-no-access"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The person for whom the reading was performed. No-access: reading recipients have a reasonable expectation of confidentiality. Stored internally for provenance tracking only."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationReading"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "reading recipient"
      },
      "rdfs:range": {
        "@id": "http://xmlns.com/foaf/0.1/Person"
      }
    },
    {
      "@id": "iroko:ebo-cleansing",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A full-body or environmental cleansing (despojo, limpieza) using herbs, waters, or other materials prescribed by the reading."
      },
      "skos:inScheme": {
        "@id": "iroko:EboTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Spiritual cleansing"
        },
        {
          "@language": "es",
          "@value": "Limpieza espiritual"
        }
      ]
    },
    {
      "@id": "iroko:signNumber",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The numeric identifier for this sign within its system. For Dilogún: 1–16. For Ifá: the composite index of primary (1–16) and secondary (1–16) throw."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sign number"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:outcome-osogbo",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A sign comes with negative polarity. The indicated difficulties or blockages are present. Prescribed works (ebó) are required to avert or mitigate."
      },
      "skos:inScheme": {
        "@id": "iroko:OutcomeTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Osogbo (negative)"
        },
        {
          "@language": "es",
          "@value": "Osogbo (negativo)"
        },
        {
          "@language": "yo",
          "@value": "Àṣọtẹ́lẹ̀ burúkú"
        }
      ]
    },
    {
      "@id": "iroko:verseSign",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The divination sign to which this verse belongs."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationVerse"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "verse sign"
      },
      "rdfs:range": {
        "@id": "iroko:DivinationSign"
      }
    },
    {
      "@id": "iroko:system-ifa",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Yorùbá-derived divination system using ikin (palm nuts) or okuele (divining chain) to generate 256 binary odù configurations. Practiced by authorized Babalawos. Versions found in Lucumí (Cuba), Candomblé de Ifá (Brazil), Trinidadian Orisha, and continental Yorùbá communities."
      },
      "skos:inScheme": {
        "@id": "iroko:DivinationSystemScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Ifá"
        },
        {
          "@language": "es",
          "@value": "Ifá"
        },
        {
          "@language": "yo",
          "@value": "Ifá"
        }
      ]
    },
    {
      "@id": "iroko:outcome-osogbo-arun",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Osogbo of illness or physical affliction."
      },
      "skos:inScheme": {
        "@id": "iroko:OutcomeTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Osogbo Arun (illness)"
        },
        {
          "@language": "es",
          "@value": "Osogbo Arun"
        }
      ]
    },
    {
      "@id": "iroko:medium-okuele",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Eight-piece divining chain of alternating concave and convex seed halves used by Babalawos as a faster alternative to palm nut casting in Ifá."
      },
      "skos:inScheme": {
        "@id": "iroko:CastingMediumScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Okuele / Ekuele (divining chain)"
        },
        {
          "@language": "es",
          "@value": "Okuele / Ekuele"
        }
      ]
    },
    {
      "@id": "iroko:ebo-rogacion",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A cleansing and feeding of the head (ori/eleda) using specific cool and white materials. One of the most commonly prescribed works across Lucumí and related traditions."
      },
      "skos:inScheme": {
        "@id": "iroko:EboTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Head Rogation"
        },
        {
          "@language": "es",
          "@value": "Rogación de cabeza"
        }
      ]
    },
    {
      "@id": "iroko:signTaboo",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A prohibition (eewo) traditionally associated with this sign. Taboos relate to foods, behaviors, materials, or associations that persons born under this sign or receiving this sign in reading should avoid."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sign taboo"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:readingNotes",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-elder"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Free-text notes from the diviner. Elder-only: may contain specific operational detail."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationReading"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "reading notes"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:outcome-osogbo-iku",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Osogbo of death or severe loss. The most serious category; requires immediate and specific ebó."
      },
      "skos:inScheme": {
        "@id": "iroko:OutcomeTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Osogbo Ikú (death)"
        },
        {
          "@language": "es",
          "@value": "Osogbo Ikú"
        }
      ]
    },
    {
      "@id": "iroko:DivinationVerse",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A single verse, story, or pataki within a sign's corpus. In Ifá: an ese Ifá. In Dilogún: a rezo or pataki. In Fá: a hwenoho. Verses carry narrative, ethical, prescriptive, and esoteric content. They are the primary means by which divination knowledge is transmitted and applied. Verse text is initiated-elder access; the existence of a verse corpus for a sign is public."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Divination Verse"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:system-vititi-nfinda",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Mirror or reflective-surface divination used in Palo Monte for spiritual vision and consultation. Complementary to but distinct from Chamalongo; requires specific nganga authorization."
      },
      "skos:inScheme": {
        "@id": "iroko:DivinationSystemScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Vititi Nfinda"
        },
        {
          "@language": "es",
          "@value": "Vititi Nfinda"
        }
      ]
    },
    {
      "@id": "iroko:medium-obi-kola",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Kola nut divided into lobes for Obi divination. More traditional form in continental Yorùbá practice."
      },
      "skos:inScheme": {
        "@id": "iroko:CastingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Obi Kola (kola nut)"
      }
    },
    {
      "@id": "iroko:governingEntity",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The spirit or deity principally associated with this sign across the tradition. In Ifá: Ogbe Meji is governed by Obatala; Oshé Meji by Oshun. This is a tradition-level association, not reading-specific. Range: iroko:SpiritualEntity."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "governing entity"
      },
      "rdfs:range": {
        "@id": "iroko:SpiritualEntity"
      }
    },
    {
      "@id": "iroko:ebo-abstention",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A behavioral abstention or avoidance prescribed by the reading: specific foods, colors, locations, or activities to avoid for a defined period."
      },
      "skos:inScheme": {
        "@id": "iroko:EboTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Abstention / Prohibition"
        },
        {
          "@language": "es",
          "@value": "Abstención / Prohibición"
        }
      ]
    },
    {
      "@id": "iroko:verseTheme",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Thematic summary of the verse's principal narrative or prescription, without reproducing the text. Initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationVerse"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "verse theme"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:system-derle",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Card-based or object-based divination associated with Espiritismo and Haitian Vodou mesa blanca practice. Distinct from African-derived binary casting systems."
      },
      "skos:inScheme": {
        "@id": "iroko:DivinationSystemScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Derlé"
        },
        {
          "@language": "fr",
          "@value": "Derlé"
        }
      ]
    },
    {
      "@id": "iroko:outcome-ire-are",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Iré of victory or achievement. The sign comes with the blessing of success in endeavor."
      },
      "skos:inScheme": {
        "@id": "iroko:OutcomeTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Iré Aré (victory)"
        },
        {
          "@language": "es",
          "@value": "Iré Aré"
        }
      ]
    },
    {
      "@id": "iroko:verseLineage",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The ile or lineage corpus from which this verse version derives. Different lineages may hold different versions of verses for the same sign."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationVerse"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "verse lineage"
      },
      "rdfs:range": {
        "@id": "iroko:House"
      }
    },
    {
      "@id": "iroko:primarySign",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "In composite systems (Ifá), the sign generated by the first cast. The primary odù of a compound figure."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "primary sign"
      },
      "rdfs:range": {
        "@id": "iroko:DivinationSign"
      }
    },
    {
      "@id": "iroko:outcome-ire",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A sign comes with positive polarity. The indicated blessings are accessible. Prescribed works (ebó) confirm and open the path."
      },
      "skos:inScheme": {
        "@id": "iroko:OutcomeTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Iré (positive)"
        },
        {
          "@language": "es",
          "@value": "Iré (positivo)"
        },
        {
          "@language": "yo",
          "@value": "Iré"
        }
      ]
    },
    {
      "@id": "iroko:prescribedEntity",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The spiritual entity indicated by the reading as requiring propitiation, attention, or ceremony. Range: iroko:SpiritualEntity."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationReading"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "prescribed entity"
      },
      "rdfs:range": {
        "@id": "iroko:SpiritualEntity"
      }
    },
    {
      "@id": "iroko:system-dilogún",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Cowrie shell divination using 16 shells (owó dilogún) to generate 16 principal signs. Practiced by authorized Olorisha. Used in Lucumí/Ocha, Candomblé, and related traditions. Shares sign names with Ifá odù but distinct system, corpus, and authority structure."
      },
      "skos:inScheme": {
        "@id": "iroko:DivinationSystemScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Dilogún"
        },
        {
          "@language": "es",
          "@value": "Dilogún"
        }
      ],
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Lineage-specific variations exist in casting protocol, sign count, and authority requirements."
      }
    },
    {
      "@id": "iroko:DivinationCorpus",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The complete body of verses, prescriptions, proverbs, and interpretive commentary associated with a divination system as transmitted through a specific lineage. Distinct from the system itself (which is the abstract framework) and from individual verses (which are its units). A corpus is lineage-specific: Ifá lineages in Havana may hold different verse inventories than those in Lagos or Trinidad, each representing a distinct corpus."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Divination Corpus"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:LineageKnowledgeGraph"
      }
    },
    {
      "@id": "iroko:DivinationSign",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A discrete sign, figure, or configuration within a divination system. In Ifá: one of 256 odù (each identified by primary + secondary throw). In Dilogún: one of 16 principal signs (odù Dilogún, omieros, and their paths). In Fá: du figures. In Chamalongo: one of 5 configurations. Each sign has an associated corpus of verses, prescriptions, and spirit-entity relationships. The sign's name and number are public; verses and prescribed works are restricted."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Divination Sign"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:Sign"
      }
    },
    {
      "@id": "iroko:authorizedPractitioner",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The authority title required to cast this system. In Ifá: Babalawo. In Dilogún: Olorisha with dilogún authorization. In Fá: Bokonon. Range: iroko:AuthorityTitleScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSystem"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "authorized practitioner type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:medium-cowrie",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Sixteen cowrie shells used in Dilogún divination by authorized Olorisha."
      },
      "skos:inScheme": {
        "@id": "iroko:CastingMediumScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Owó Dilogún (cowrie shells)"
        },
        {
          "@language": "es",
          "@value": "Caracoles / Dilogún"
        }
      ]
    },
    {
      "@id": "iroko:medium-chamalongo-bone",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Prepared bones or discs used as an alternative casting medium for Chamalongo. The specific preparation is lineage-specific and restricted."
      },
      "skos:inScheme": {
        "@id": "iroko:CastingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Chamalongo (prepared bones/discs)"
      }
    },
    {
      "@id": "iroko:genderRestriction",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Documents tradition-specific restrictions on who may cast this system, expressed as a free-text note. For Ifá in the Lucumí tradition: historically restricted to initiated men (Babalawos); contested in some lineages and Afro-Atlantic communities. This property records the documented practice of the lineage being described, not a normative judgment."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSystem"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "gender restriction"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:system-chamalongo",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Kongo-derived divination using four coconut shell halves or prepared bones/discs. Generates 5 configurations. Used in Palo Monte and related Bantu-Atlantic traditions. Practiced by authorized Paleros (Tatas and Yayas)."
      },
      "skos:inScheme": {
        "@id": "iroko:DivinationSystemScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Chamalongo"
        },
        {
          "@language": "es",
          "@value": "Chamalongo"
        }
      ]
    },
    {
      "@id": "iroko:ebo-etutu",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A cooling or pacifying ceremony, often performed after death, severe osogbo, or to address Egun. Requires specific authority and materials."
      },
      "skos:inScheme": {
        "@id": "iroko:EboTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Itutu / Etutu"
        },
        {
          "@language": "es",
          "@value": "Itutu / Etutu"
        }
      ]
    },
    {
      "@id": "iroko:outcome-ire-owo",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Iré of prosperity. The sign comes with the blessing of material abundance."
      },
      "skos:inScheme": {
        "@id": "iroko:OutcomeTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Iré Owó (wealth)"
        },
        {
          "@language": "es",
          "@value": "Iré Owó"
        }
      ]
    },
    {
      "@id": "iroko:readingOfficiant",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The diviner who performed the reading. Range: foaf:Person. Community-restricted to protect practitioner privacy unless the officiant has consented to public attribution."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationReading"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "reading officiant"
      },
      "rdfs:range": {
        "@id": "http://xmlns.com/foaf/0.1/Person"
      }
    },
    {
      "@id": "iroko:verseSource",
