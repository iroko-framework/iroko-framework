        },
        {
          "@language": "pt",
          "@value": "Tipos de trabalho prescrito"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ìrú iṣẹ́ àṣẹ"
        }
      ]
    },
    {
      "@id": "iroko:verseTitle",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The title or opening line of the verse as used within the lineage. Community-restricted: verse titles alone can partially disclose operational content."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationVerse"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "verse title"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
