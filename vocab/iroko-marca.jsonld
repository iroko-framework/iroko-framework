      },
      "rdfs:domain": {
        "@id": "iroko:DivinationReading"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "reading date"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
