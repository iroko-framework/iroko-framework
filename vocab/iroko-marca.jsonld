{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:outcome-ire-aiku",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Iré of long life. The sign comes with the blessing of longevity."
      },
      "skos:inScheme": {
        "@id": "iroko:OutcomeTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Iré Aiku (long life)"
        },
        {
          "@language": "es",
          "@value": "Iré Aiku"
        }
      ]
    },
    {
      "@id": "iroko:ebo-ceremony",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A prescribed ceremony (initiation, reception of Orisha, specific feast) indicated by the reading as necessary."
      },
      "skos:inScheme": {
        "@id": "iroko:EboTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Full ceremony"
        },
        {
          "@language": "es",
          "@value": "Ceremonia completa"
        }
      ]
    },
    {
      "@id": "iroko:DivinationReading",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A specific divination event performed for a recipient by an authorized diviner. Records the sign(s) that appeared, the outcome polarity (iré/osogbo), prescribed works, and the entities indicated. Reading records are among the most sensitive data in the framework: recipient identity is no-access; the date and officiant are community-restricted; the prescribed work and entity are initiated-only."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Divination Reading"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:OutcomeTypeScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Divination Outcome Types"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:outcome-ire"
        },
        {
          "@id": "iroko:outcome-ire-aiku"
        },
        {
          "@id": "iroko:outcome-ire-are"
        },
        {
          "@id": "iroko:outcome-ire-omo"
        },
        {
          "@id": "iroko:outcome-ire-owo"
        },
        {
          "@id": "iroko:outcome-osogbo"
        },
        {
          "@id": "iroko:outcome-osogbo-arun"
        },
        {
          "@id": "iroko:outcome-osogbo-iku"
        },
        {
          "@id": "iroko:outcome-osogbo-ojú"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Divination Outcome Types"
        },
        {
          "@language": "es",
          "@value": "Tipos de resultado divinatorio"
        },
        {
          "@language": "fr",
          "@value": "Types de résultat divinatoire"
        },
        {
          "@language": "pt",
          "@value": "Tipos de resultado divinatório"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ìrú àbájáde aṣọtẹ́lẹ̀"
        }
      ]
    },
    {
      "@id": "iroko:system-fa",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Fon and Ewe divination system cognate to Ifá, using palm nuts or a divining chain to generate du figures. Practiced by Bokonon (male diviners). The du corpus is distinct from but related to Yorùbá odù. Primary in Benin, Togo, and Haitian Vodou communities with Rada/Fon lineages."
      },
      "skos:inScheme": {
        "@id": "iroko:DivinationSystemScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Fá"
        },
        {
          "@language": "fr",
          "@value": "Fâ"
        }
      ]
    },
    {
      "@id": "iroko:outcome-osogbo-ojú",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Osogbo of enemies or opposition. The negative force indicated involves interpersonal conflict or hostility."
      },
      "skos:inScheme": {
        "@id": "iroko:OutcomeTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Osogbo Ojú (enmity)"
        },
        {
          "@language": "es",
          "@value": "Osogbo Ojú"
        }
      ]
    },
    {
      "@id": "iroko:system-obi",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Four-piece binary divination using coconut (obi abata) or kola nut (obi kola). Generates 5 configurations from the binary state of four pieces. Used across Lucumí, Candomblé, and Yorùbá traditions for confirmation and yes/no queries. Less elaborate than Ifá or Dilogún but widely practiced."
      },
      "skos:inScheme": {
        "@id": "iroko:DivinationSystemScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Obi"
        },
        {
          "@language": "es",
          "@value": "Obi"
        },
        {
          "@language": "yo",
          "@value": "Obi"
        }
      ]
    },
    {
      "@id": "iroko:castingMedium",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The physical medium used to cast or generate the sign in this system. Examples: ikin (palm nuts), okuele/ekuele (divining chain), owó dilogún (cowries), obi (coconut), obi kola (kola nut), chamalongo (coconut shells or bones). Range: iroko:CastingMediumScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationSystem"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "casting medium"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:readingOutcome",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Whether the sign came iré (positive polarity) or osogbo (negative polarity) in this reading. Range: iroko:OutcomeTypeScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationReading"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "reading outcome"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:ebo-adimú",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A food or vegetable offering (without blood) to an Orisha. Accessible outside of full ebó; considered the first step in propitiation."
      },
      "skos:inScheme": {
        "@id": "iroko:EboTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Adimu"
        },
        {
          "@language": "es",
          "@value": "Adimú"
        }
      ]
    },
    {
      "@id": "iroko:verseText",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-elder"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The full text of the verse. Elder-only: ese Ifá and analogous verses are among the most sacred and operationally powerful materials in the tradition. Their disclosure outside authorized transmission is a serious breach."
      },
      "rdfs:domain": {
        "@id": "iroko:DivinationVerse"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-marca"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "verse text"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:system-ita",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The extended Ifá reading performed for an individual at initiation (kariosha, itá de kariosha) or as a life-path consultation. Typically multi-sign, conducted by a Babalawo, and interpreted by Olorisha elders. The itá record is among the most sensitive personal documents in the tradition."
      },
      "skos:inScheme": {
        "@id": "iroko:DivinationSystemScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Itá"
        },
        {
          "@language": "es",
          "@value": "Itá / Ifá de Cabeza"
        }
      ]
    },
    {
      "@id": "iroko:medium-chamalongo-coconut",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Four coconut shell halves prepared and consecrated for Chamalongo divination in Palo traditions."
      },
      "skos:inScheme": {
        "@id": "iroko:CastingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Chamalongo (coconut shells)"
      }
    },
    {
      "@id": "iroko:medium-ikin",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Sacred palm nuts (ikin Ifá, obi Ifá) used by Babalawos for Ifá divination. Considered the highest-authority casting medium in Lucumí/Yorùbá tradition."
      },
      "skos:inScheme": {
        "@id": "iroko:CastingMediumScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Ikin (palm nuts)"
        },
        {
          "@language": "es",
          "@value": "Ikin (nueces de palma)"
        }
      ]
    },
    {
      "@id": "iroko:CastingMediumScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Casting Media"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:medium-chamalongo-bone"
        },
