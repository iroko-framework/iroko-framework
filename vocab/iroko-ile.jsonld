    {
      "@id": "iroko:governance-single-elder",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "One recognized head (Iyalosha, Babalosha, Mambo, etc.) with primary authority."
      },
      "skos:inScheme": {
        "@id": "iroko:GovernanceModelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Single Elder Authority"
      }
    },
    {
