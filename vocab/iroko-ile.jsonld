      "skos:inScheme": {
        "@id": "iroko:InitiationTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Couche"
        },
        {
          "@language": "ht",
          "@value": "Kouche"
        }
      ]
    },
