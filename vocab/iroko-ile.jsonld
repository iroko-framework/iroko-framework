  "@graph": [
    {
      "@id": "iroko:initiation-kariosha",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Making Ocha"
        },
        {
          "@language": "es",
          "@value": "Asiento"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Full head initiation in Lucumí/Candomblé Ketu. An orisha is seated on the initiate's head."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Kariosha"
      }
    },
    {
      "@id": "iroko:initiationType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Type of initiation ceremony. Range: iroko:InitiationTypeScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:InitiationEvent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ile"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "initiation type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:transmission-written",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Transmitted through notebooks, libreta, manuscripts, or printed texts."
      },
      "skos:inScheme": {
        "@id": "iroko:TransmissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Written"
      }
    },
    {
      "@id": "iroko:title-alagba",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Senior elder in a Yoruba-derived tradition, often with lineage-wide ceremonial authority."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTitleScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Alagba"
        },
        {
          "@language": "yo",
          "@value": "Alagba"
        }
      ]
    },
    {
      "@id": "iroko:title-olorisha",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Initiated Orisha priest of any gender. General term covering Iyalosha and Babalosha."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTitleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Olorisha"
      }
    },
