    {
      "@id": "iroko:title-iyanifa",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Female Ifá priest. Recognition is contested across lineages; use iroko:contestedStatus when applicable."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTitleScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Iyanifa"
        },
        {
          "@language": "yo",
          "@value": "Iyanifa"
        }
      ],
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The recognition of Iyanifa is a live dispute in Lucumí communities. iroko:ReligiousOffice records for this title should carry iroko:contestedStatus and iroko:contestedNotes."
      }
    },
    {
      "@id": "iroko:title-ekpe-member",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Initiated member of the Ekpe leopard society (Cross River / Calabari tradition)."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTitleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ekpe Member"
      }
    },
    {
      "@id": "iroko:houseType-study-group",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "An informal group organized for learning, not yet constituted as a full house."
      },
      "skos:inScheme": {
        "@id": "iroko:HouseTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Study / Learning Group"
      }
    },
    {
      "@id": "iroko:membershipEstimate",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Approximate number of initiated members. Text to allow ranges or qualitative descriptions."
      },
      "rdfs:domain": {
        "@id": "iroko:House"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ile"
