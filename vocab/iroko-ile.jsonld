    },
    {
      "@id": "iroko:houseType-egbe",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Association or society organized around a specific orisha or shared ritual purpose."
      },
      "skos:inScheme": {
        "@id": "iroko:HouseTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Egbé"
        },
        {
          "@language": "yo",
          "@value": "Egbé"
        }
      ]
    },
    {
      "@id": "iroko:publicPresence",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "True if the house maintains a publicly known identity (website, social media, public events). False does not imply the house is secret — many houses simply operate privately."
      },
      "rdfs:domain": {
        "@id": "iroko:House"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ile"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "public presence"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "iroko:title-omo-orisha",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Initiated child of an orisha. General term for those who have completed kariosha/asiento."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTitleScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Omo Orisha"
        },
        {
          "@language": "yo",
          "@value": "Omo Orisha"
        }
      ]
    },
    {
      "@id": "iroko:ReligiousOffice",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A religious title or position held by a practitioner, authorizing specific ritual functions within a tradition. Linked to the person (foaf:Person), the house, and the authority figure who conferred it. Distinct from iroko:ContestedAuthority in core, which models disputed titles at the category level — iroko:ReligiousOffice models specific individual instances."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ile"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Religious Office"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:recognizedOffice",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "owl:inverseOf": {
        "@id": "iroko:authorityHouse"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A religious office recognized and active within this house. Inverse of iroko:authorityHouse. A house may recognize multiple offices; each office is a separate ReligiousOffice instance. Active vs. historical status determined by iroko:conferralDate on the office record. Access: community-only — office structure of a house is internal governance information."
      },
      "rdfs:domain": {
        "@id": "iroko:House"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ile"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "recognized office"
      },
      "rdfs:range": {
        "@id": "iroko:ReligiousOffice"
      }
    },
