        "@language": "en",
        "@value": "lineage tradition"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:initiation-mano-orula",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Awofakan / Ikofa"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Reception of Orula's hand. First level of Ifá initiation, open to non-Babaláwo."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "es",
        "@value": "Mano de Orula"
      }
    },
    {
      "@id": "iroko:transmission-embodied",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Knowledge transmitted through physical ceremony, practice, and direct experiential transmission. Cannot be fully conveyed through text."
      },
      "skos:inScheme": {
        "@id": "iroko:TransmissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Embodied"
      }
    },
    {
      "@id": "iroko:initiation-couche",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The lying-in period component of Vodou kanzo initiation."
