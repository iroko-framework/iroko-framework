    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PreparationMethodScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#harvest-lunar-phase-required">
