    <skos:definition xml:lang="en">Requires ritual protocol and offering to plant spirit before harvesting.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HarvestProtocolScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#part-leaf">
