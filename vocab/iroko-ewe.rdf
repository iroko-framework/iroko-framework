>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#preparationInstructions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">preparation instructions</rdfs:label>
    <rdfs:comment xml:lang="en">Complete instructions for assembling the PlantPreparation: order of addition, timing, incantations, quantities, and critical steps. Governed at initiated-only minimum; elder-initiated for consecrated preparations such as Omiero.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#PlantPreparation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ewe"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#entityAssociation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">entity association</rdfs:label>
    <rdfs:comment xml:lang="en">Spiritual entity (orisa, lwa, mpungu) associated with this plant. Links to Nkisi module.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Plant"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SpiritualEntity"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ewe"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
