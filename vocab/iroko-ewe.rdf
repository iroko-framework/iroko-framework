    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#prep-maceration"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#prep-poultice"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#prep-powder"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#prep-tincture"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#prep-topical"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#prep-wash"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#medicinal-pediatric">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Pediatric</skos:prefLabel>
    <skos:definition xml:lang="en">Safe for children, pediatric applications.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MedicinalUseScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#harvest-wildcrafted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Wildcrafted (No Ritual)</skos:prefLabel>
    <skos:definition xml:lang="en">Harvested from wild without specific ritual protocol.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HarvestProtocolScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#specimenNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">specimen number</rdfs:label>
    <rdfs:comment xml:lang="en">Herbarium catalog number or specimen identifier. Aligns with dwc:catalogNumber (see iroko-align-dwc).</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#HerbariumSheet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ewe"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#harvestProtocolDetailed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">harvest protocol (detailed)</rdfs:label>
    <rdfs:comment xml:lang="en">Detailed harvest instructions: exact timing (dawn, dusk), direction (face east), quantities (3, 7, 9, 21), offerings required.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Plant"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ewe"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
