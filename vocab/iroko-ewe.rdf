    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HarvestProtocolScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#prep-infusion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Infusion (Hot Water)</skos:prefLabel>
