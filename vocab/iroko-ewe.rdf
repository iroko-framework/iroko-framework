    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#medicinal-reproductive-fertility"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#medicinal-respiratory-support"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#medicinal-skin-topical"/>
