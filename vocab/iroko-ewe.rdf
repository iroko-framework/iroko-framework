    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#ritual-house-blessing"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#ritual-invocation-communication"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#ritual-legal-justice"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#ritual-love-attraction"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#ritual-offering-devotion"/>
