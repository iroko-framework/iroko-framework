    <rdfs:label xml:lang="en">Ritual Use Classification</rdfs:label>
    <dcterms:description xml:lang="en">Controlled vocabulary of ceremonial and spiritual applications.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#ritual-ancestor-veneration"/>
