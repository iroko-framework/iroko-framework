    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Harvest Protocol Classification</rdfs:label>
    <dcterms:description xml:lang="en">Methods and requirements for harvesting plants.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#harvest-commercial-market"/>
