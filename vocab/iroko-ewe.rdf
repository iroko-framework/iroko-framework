    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#ritual-death-rites"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#ritual-divination-enhancement"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#ritual-domination-binding"/>
