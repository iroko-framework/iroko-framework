@prefix iroko: <https://ontology.irokosociety.org/iroko#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── UPDATE CHECKLIST — run these steps whenever this file is modified ──────────
#   1. Bump in this file: owl:versionInfo  owl:versionIRI  owl:priorVersion
#      dcterms:modified (YYYY-MM-DD)
#   2. scripts/iroko_config.py  →  title, subtitle for iroko-manifestation
#   3. index.html (repo root)   →  module-subtitle, module-version, module-desc
#   4. vocab/index.html         →  module-subtitle, module-version, module-desc
#   5. python scripts/generate_vocab_html.py iroko-manifestation
#   6. python scripts/build_all.py  (steps 2–5: term list, counts, serial., vocab)
#   PowerShell: run 'git add -A' and 'git commit -m ...' as separate commands
# ───────────────────────────────────────────────────────────────────────────────

iroko:hasManifestationMode a owl:ObjectProperty ;
    rdfs:label "has manifestation mode"@en ;
    rdfs:comment "Associates a ManifestationEvent or assertion node with a ManifestationMode concept from iroko:ManifestationModeScheme. Multiple modes may be asserted for a single event."@en ;
    rdfs:domain iroko:ManifestationEvent ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:range iroko:ManifestationMode ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

iroko:hasMediumType a owl:ObjectProperty ;
    rdfs:label "has medium type"@en ;
    rdfs:comment "Associates a Medium with a MediumType concept from iroko:MediumTypeScheme."@en ;
    rdfs:domain iroko:Medium ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:range iroko:MediumType ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

iroko:manifestsThroughMedium a owl:ObjectProperty ;
    rdfs:label "manifests through medium"@en ;
    rdfs:comment "Associates a ManifestationEvent with a Medium through which manifestation is asserted to occur. The identity of the medium (e.g., a specific person) may carry its own access level if the medium is a community member."@en ;
    rdfs:domain iroko:ManifestationEvent ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:range iroko:Medium ;
    iroko:minimumAccessLevel iroko:access-community-only .

iroko:medium-instrument a iroko:MediumType ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "A musical, divinatory, or ritual instrument serves as the medium — a consecrated bàtá drum, divining chain, or bell."@en ;
    skos:inScheme iroko:MediumTypeScheme ;
    skos:prefLabel "Instrument"@en .

iroko:medium-object a iroko:MediumType ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "A material object serves as the medium — a consecrated vessel, nganga, otán, or ritual artifact."@en ;
    skos:inScheme iroko:MediumTypeScheme ;
    skos:prefLabel "Object"@en .

iroko:medium-person a iroko:MediumType ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "A human person serves as the medium, as in possession or mounted manifestation."@en ;
    skos:inScheme iroko:MediumTypeScheme ;
    skos:prefLabel "Person"@en .

iroko:medium-place a iroko:MediumType ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "A place, site, crossroads, or territory serves as the medium."@en ;
    skos:inScheme iroko:MediumTypeScheme ;
    skos:prefLabel "Place"@en .

iroko:medium-text a iroko:MediumType ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "A text, inscription, vèvè, firma, or graphic document serves as the medium."@en ;
    skos:inScheme iroko:MediumTypeScheme ;
    skos:prefLabel "Text"@en .

iroko:medium-unknown a iroko:MediumType ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "Medium type not recorded or not known."@en ;
    skos:inScheme iroko:MediumTypeScheme ;
    skos:prefLabel "Unknown"@en .

iroko:mode-auditory a iroko:ManifestationMode ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "Manifestation asserted to occur through sound, voice, drumming, or hearing — including traditions where specific rhythms summon or identify a spirit."@en ;
    skos:inScheme iroko:ManifestationModeScheme ;
    skos:prefLabel "Auditory"@en .

iroko:mode-divination a iroko:ManifestationMode ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "Manifestation asserted to occur through divination, oracle, or the interpretive reading of divinatory instruments."@en ;
    skos:inScheme iroko:ManifestationModeScheme ;
    skos:prefLabel "Divination"@en .

iroko:mode-dream a iroko:ManifestationMode ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "Manifestation asserted to occur through dreams, dream visitation, or hypnagogic contact."@en ;
    skos:inScheme iroko:ManifestationModeScheme ;
    skos:prefLabel "Dream"@en .

iroko:mode-embodied a iroko:ManifestationMode ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "Manifestation asserted to occur in a physically embodied form distinct from possession — the agent is present as a body, not occupying another's."@en ;
    skos:inScheme iroko:ManifestationModeScheme ;
    skos:prefLabel "Embodied"@en .

iroko:mode-possession a iroko:ManifestationMode ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "Manifestation asserted to occur through mounting or possession of a medium person. The agent speaks and acts through the medium during the event."@en ;
    skos:inScheme iroko:ManifestationModeScheme ;
    skos:prefLabel "Possession"@en ;
    skos:scopeNote "Distinguish from embodied: possession involves a medium person who is temporarily occupied; embodied involves a distinct physical presence."@en .

iroko:mode-symbolic a iroko:ManifestationMode ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "Manifestation asserted to occur through symbols, signs, graphic marks, or indirect representation. Vèvè, firmas, and anaforuana are common vehicles."@en ;
    skos:inScheme iroko:ManifestationModeScheme ;
    skos:prefLabel "Symbolic"@en .

iroko:mode-territorial a iroko:ManifestationMode ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "Manifestation asserted to be bound to or expressed through a place, crossroads, body of water, forest, or territory."@en ;
    skos:inScheme iroko:ManifestationModeScheme ;
    skos:prefLabel "Territorial"@en .

iroko:mode-unknown a iroko:ManifestationMode ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:definition "Manifestation mode not recorded or not known."@en ;
    skos:inScheme iroko:ManifestationModeScheme ;
    skos:prefLabel "Unknown"@en .

iroko:Medium a owl:Class ;
    rdfs:label "Medium"@en ;
    rdfs:subClassOf iroko:SacredEntity ;
    rdfs:comment "A medium through which manifestation is asserted to occur — a person, object, place, text, or instrument. A Medium is the vehicle, not the agent; the sacred agent is modeled in iroko-nkisi or iroko-agency. One ManifestationEvent may involve multiple media."@en ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

iroko:MediumTypeScheme a skos:ConceptScheme ;
    rdfs:label "Medium Types"@en ;
    dcterms:description "Controlled terms for the kind of medium through which manifestation is asserted to occur."@en ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:hasTopConcept iroko:medium-instrument,
        iroko:medium-object,
        iroko:medium-person,
        iroko:medium-place,
        iroko:medium-text,
        iroko:medium-unknown .

iroko:MediumType a owl:Class ;
    rdfs:label "Medium Type"@en ;
    rdfs:comment "A SKOS concept categorizing the kind of medium involved in a manifestation assertion: person, object, place, text, instrument, or unknown."@en ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:subClassOf skos:Concept .

iroko:ManifestationModeScheme a skos:ConceptScheme ;
    rdfs:label "Manifestation Modes"@en ;
    dcterms:description "Controlled terms for how sacred agents are asserted to manifest. Tradition-reported descriptive categories. Multiple modes may apply to a single event."@en ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:hasTopConcept iroko:mode-auditory,
        iroko:mode-divination,
        iroko:mode-dream,
        iroko:mode-embodied,
        iroko:mode-possession,
        iroko:mode-symbolic,
        iroko:mode-territorial,
        iroko:mode-unknown .

iroko:ManifestationMode a owl:Class ;
    rdfs:label "Manifestation Mode"@en ;
    rdfs:comment "A SKOS concept describing how a sacred agent is asserted to manifest. Modes include embodied, possession, dream, divination, symbolic, territorial, auditory, and unknown. These categories are descriptive and tradition-reported; they record what a community asserts, not what an archive adjudicates. A single ManifestationEvent may reference multiple modes. Modes may vary by temporal regime — use iroko:TemporalVariation to document seasonal or initiatory shifts."@en ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:subClassOf skos:Concept .

# ── v1.4.0: Manuscript object and text content model ──────────────────────────

iroko:ManuscriptObject a owl:Class ;
    rdfs:label "Manuscript Object"@en ;
    rdfs:comment "A physical manuscript or archival object — codex, scroll, single leaf, inscribed stone, ostracon, stela, or similar carrier. Models the physical vehicle as distinct from the intellectual content it carries. Structurally equivalent to the Object level in the vHMML three-tier hierarchy (Object / Part / Contents). A ManuscriptObject may carry one or more iroko:TextContent instances. The physical and intellectual levels are modeled separately so that a single text can be located across multiple physical carriers, and a single object can carry multiple texts. Subclass of iroko:DocumentaryEvidence, which is itself a subclass of iroko:SacredEntity."@en ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:subClassOf iroko:DocumentaryEvidence ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

iroko:TextContent a owl:Class ;
    rdfs:label "Text Content"@en ;
    rdfs:comment "An abstract intellectual work — a text as a specific composition, title, or discrete textual unit — independent of its physical carrier. Equivalent to the FRBR Work level and to the Contents level in the vHMML three-tier hierarchy. Distinct from iroko:ManuscriptObject (the physical carrier) and from iroko:NarrativeVariant (a specific transcribed or performed telling). A single iroko:TextContent may be carried by multiple ManuscriptObjects across different repositories or copies. Properties cover language, script, genre, and uniform title. Subclass of iroko:SacredEntity."@en ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:subClassOf iroko:SacredEntity ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

iroko:carriersText a owl:ObjectProperty ;
    rdfs:label "carries text"@en ;
    rdfs:comment "Links a ManuscriptObject to an iroko:TextContent it physically carries. One ManuscriptObject may carry multiple TextContent instances — a codex may contain several distinct works. Inverse of iroko:carriedBy."@en ;
    rdfs:domain iroko:ManuscriptObject ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:range iroko:TextContent ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

iroko:carriedBy a owl:ObjectProperty ;
    rdfs:label "carried by"@en ;
    rdfs:comment "Links a TextContent to a ManuscriptObject that carries it. One TextContent may appear in multiple ManuscriptObjects. Inverse of iroko:carriersText."@en ;
    rdfs:domain iroko:TextContent ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:range iroko:ManuscriptObject ;
    owl:inverseOf iroko:carriersText ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

iroko:physicalSupport a owl:ObjectProperty ;
    rdfs:label "physical support"@en ;
    rdfs:comment "The material substrate of the manuscript object. Range: iroko:PhysicalSupportScheme. Covers parchment, paper, papyrus, stone, ostracon, textile, metal, wood, clay, and other carriers. Values drawn from the controlled vocabulary used by vHMML and comparable manuscript cataloging projects."@en ;
    rdfs:domain iroko:ManuscriptObject ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:range skos:Concept ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

iroko:textLanguage a owl:DatatypeProperty ;
    rdfs:label "text language"@en ;
    rdfs:comment "The language or languages of the text content. Express as a BCP 47 language tag where a standard code exists (e.g., 'ar' for Arabic, 'gez' for Ge'ez). For languages without standard BCP 47 codes, use a descriptive string: 'Old Nubian', 'Coptic', 'Middle Nubian'. Multiple values permitted for polyglot texts or texts in more than one language. Do not conflate language and script — record both separately."@en ;
    rdfs:domain iroko:TextContent ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:range xsd:string ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

iroko:textScript a owl:DatatypeProperty ;
    rdfs:label "text script"@en ;
    rdfs:comment "The script or writing system of the text content. Examples: Latin, Arabic, Ge'ez (Ethiopic), Greek, Old Nubian (Coptic-based), Hebrew, Syriac. Use ISO 15924 four-letter script codes where available. Multiple scripts may be present in a single text; record all."@en ;
    rdfs:domain iroko:TextContent ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:range xsd:string ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

iroko:uniformTitle a owl:DatatypeProperty ;
    rdfs:label "uniform title"@en ;
    rdfs:comment "The standardized title for this intellectual work, independent of how the title may appear on any specific manuscript or in any particular catalog. Use the form established by the relevant authority file: LCNAF, HAF (HMML Authority File), DBMNT, or community convention. Language-tagged. A single work may have multiple uniform title assertions in different languages or from different authority sources."@en ;
    rdfs:domain iroko:TextContent ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    rdfs:range rdf:langString ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

iroko:PhysicalSupportScheme a skos:ConceptScheme ;
    rdfs:label "Physical Support Types"@en ;
    dcterms:description "Controlled terms for manuscript and archival object physical substrates. Derived from vHMML support vocabulary (CC BY 4.0) and extended for Iroko Framework use."@en ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> ;
    skos:hasTopConcept iroko:support-parchment,
        iroko:support-paper,
        iroko:support-papyrus,
        iroko:support-stone,
        iroko:support-ostracon,
        iroko:support-textile,
        iroko:support-metal,
        iroko:support-wood,
        iroko:support-clay,
        iroko:support-other .

iroko:support-parchment a skos:Concept ;
    skos:prefLabel "Parchment"@en ;
    skos:definition "Animal skin prepared as a writing surface. Used extensively in Ethiopian, Nubian, and European medieval manuscript traditions."@en ;
    skos:inScheme iroko:PhysicalSupportScheme ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

iroko:support-paper a skos:Concept ;
    skos:prefLabel "Paper"@en ;
    skos:definition "Paper writing surface, including both handmade and machine-made paper."@en ;
    skos:inScheme iroko:PhysicalSupportScheme ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

iroko:support-papyrus a skos:Concept ;
    skos:prefLabel "Papyrus"@en ;
    skos:definition "Writing surface made from papyrus plant stems. Primary medium for ancient Egyptian and early Christian Egyptian documentation."@en ;
    skos:inScheme iroko:PhysicalSupportScheme ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

iroko:support-stone a skos:Concept ;
    skos:prefLabel "Stone"@en ;
    skos:definition "Stone inscriptions, stelae, and rock surfaces used for monumental or votive texts."@en ;
    skos:inScheme iroko:PhysicalSupportScheme ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

iroko:support-ostracon a skos:Concept ;
    skos:prefLabel "Ostracon"@en ;
    skos:definition "A pottery sherd or stone flake used as an informal writing surface for short texts, school exercises, receipts, or personal notes. Common in Nubian and Egyptian archaeological contexts; many DBMNT texts are ostraca."@en ;
    skos:inScheme iroko:PhysicalSupportScheme ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

iroko:support-textile a skos:Concept ;
    skos:prefLabel "Textile"@en ;
    skos:definition "Cloth, leather, or textile-based writing or inscription surface."@en ;
    skos:inScheme iroko:PhysicalSupportScheme ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

iroko:support-metal a skos:Concept ;
    skos:prefLabel "Metal"@en ;
    skos:definition "Metal tablets, plaques, or coins bearing inscribed text."@en ;
    skos:inScheme iroko:PhysicalSupportScheme ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

iroko:support-wood a skos:Concept ;
    skos:prefLabel "Wood"@en ;
    skos:definition "Wooden boards, tablets, or surfaces used for writing or carving."@en ;
    skos:inScheme iroko:PhysicalSupportScheme ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

iroko:support-clay a skos:Concept ;
    skos:prefLabel "Clay"@en ;
    skos:definition "Fired or unfired clay tablets bearing inscribed or impressed text."@en ;
    skos:inScheme iroko:PhysicalSupportScheme ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

iroko:support-other a skos:Concept ;
    skos:prefLabel "Other"@en ;
    skos:definition "Physical support type not covered by existing concepts. Use skos:scopeNote on the instance to describe the specific material."@en ;
    skos:inScheme iroko:PhysicalSupportScheme ;
    rdfs:isDefinedBy <https://ontology.irokosociety.org/iroko-manifestation> .

<https://ontology.irokosociety.org/iroko-manifestation> a owl:Ontology ;
    rdfs:label "Iroko Framework: Manifestation Module (Sacred Agent Manifestation Modes & Media)"@en ;
    dcterms:created "2026-02-22"^^xsd:date ;
    dcterms:creator "Iroko Historical Society" ;
    dcterms:description "Governance Layer module. Vocabulary for modeling how sacred agents are asserted to manifest — through embodied presence, possession, dream, divination, symbolic representation, territorial claim, or auditory sign. Plugs into iroko:ManifestationEvent and supports iroko:TemporalVariation where manifestation modes shift by ritual calendar or initiation cycle. These are descriptive, not metaphysical — they record what a tradition asserts, not what is metaphysically true."@en ;
    dcterms:modified "2026-06-16"^^xsd:date ;
    owl:versionInfo "1.3.1" ;
    owl:versionIRI <https://ontology.irokosociety.org/iroko-manifestation/1.3.1> ;
    owl:priorVersion <https://ontology.irokosociety.org/iroko-manifestation/1.3.0> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:isPartOf <https://ontology.irokosociety.org/iroko-framework/> ;
    dcterms:requires <https://ontology.irokosociety.org/iroko-core> ;
    dcterms:references <https://ontology.irokosociety.org/iroko-agency> ;
    rdfs:seeAlso <https://ontology.irokosociety.org/iroko-framework/> .
