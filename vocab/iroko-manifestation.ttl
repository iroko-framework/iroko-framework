# -*- coding: utf-8 -*-
# ===================================================================
# IROKO FRAMEWORK — MANIFESTATION MODULE
# Agent Manifestation Modes and Media
# Namespace: https://www.irokosociety.org/iroko-framework/manifestation#
# Version: 2.0.0 | February 2026
# Layer: Governance Layer (Infrastructure)
# Dependencies: iroko-core, iroko-agency
# ===================================================================

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix iroko:  <https://www.irokosociety.org/iroko-framework/core#> .
@prefix ag:     <https://www.irokosociety.org/iroko-framework/agency#> .
@prefix mani:   <https://www.irokosociety.org/iroko-framework/manifestation#> .

<https://www.irokosociety.org/iroko-framework/manifestation>
    a owl:Ontology ;
    dcterms:title "Iroko Framework: Manifestation Module"@en ;
    dcterms:description "Governance Layer module. Optional module for modeling how sacred agents are asserted to manifest — through embodied presence, possession, dream, divination, symbolic representation, territorial claim, auditory sign, or unknown mode. Designed to plug into ag:ManifestationEvent. Supports iroko:TemporalVariation where manifestation modes shift by ritual calendar or initiation cycle. Use with iroko-narrative to link manifestation events to the narrative records in which they are described, and iroko-authority to document which lineage context authorizes the assertion."@en ;
    dcterms:creator "Iroko Historical Society" ;
    dcterms:issued "2026-02-22"^^xsd:date ;
    dcterms:modified "2026-02-25"^^xsd:date ;
    owl:versionInfo "2.0.0" ;
    owl:versionIRI <https://www.irokosociety.org/iroko-framework/manifestation/2.0.0> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:isPartOf <https://www.irokosociety.org/iroko-framework/> ;
    dcterms:requires <https://www.irokosociety.org/iroko-framework/core> ;
    dcterms:requires <https://www.irokosociety.org/iroko-framework/agency> ;
    dcterms:references <https://www.irokosociety.org/iroko-framework/narrative> ;
    dcterms:references <https://www.irokosociety.org/iroko-framework/authority> ;
    rdfs:seeAlso <https://www.irokosociety.org/iroko-framework/> .

# ===================================================================
# CLASSES
# ===================================================================

mani:ManifestationMode
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Manifestation Mode"@en ;
    rdfs:comment "A SKOS concept describing how a sacred agent is asserted to manifest. Values from mani:ManifestationModeScheme. These are descriptive, not metaphysical — they record what is asserted within a tradition's own terms."@en .

mani:Medium
    a owl:Class ;
    rdfs:label "Medium"@en ;
    rdfs:comment "A person, object, place, text, or instrument through which manifestation is asserted to occur."@en .

mani:MediumType
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Medium Type"@en ;
    rdfs:comment "A SKOS concept categorizing types of media used in manifestation assertions. Values from mani:MediumTypeScheme."@en .

# ===================================================================
# PROPERTIES
# ===================================================================

mani:hasManifestationMode
    a owl:ObjectProperty ;
    rdfs:label "has manifestation mode"@en ;
    rdfs:comment "Associates a ag:ManifestationEvent or iroko:Assertion node with a mani:ManifestationMode concept describing the asserted mode of appearance."@en ;
    rdfs:domain ag:ManifestationEvent ;
    rdfs:range mani:ManifestationMode ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

mani:manifestsThroughMedium
    a owl:ObjectProperty ;
    rdfs:label "manifests through medium"@en ;
    rdfs:comment "Associates a ag:ManifestationEvent with the mani:Medium through which manifestation is asserted to occur."@en ;
    rdfs:domain ag:ManifestationEvent ;
    rdfs:range mani:Medium ;
    iroko:minimumAccessLevel iroko:access-community-only .

mani:hasMediumType
    a owl:ObjectProperty ;
    rdfs:label "has medium type"@en ;
    rdfs:comment "Associates a mani:Medium with a mani:MediumType concept."@en ;
    rdfs:domain mani:Medium ;
    rdfs:range mani:MediumType ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted .

mani:hasTemporalVariation
    a owl:ObjectProperty ;
    rdfs:label "has temporal variation"@en ;
    rdfs:comment "Qualifies a manifestation mode, medium, or event with an iroko:TemporalVariation node, for cases where the mode of manifestation shifts by ritual calendar, initiation cycle, or seasonal regime."@en ;
    rdfs:range iroko:TemporalVariation ;
    iroko:minimumAccessLevel iroko:access-community-only .

# ===================================================================
# CONCEPT SCHEME: Manifestation Modes
# ===================================================================

mani:ManifestationModeScheme
    a skos:ConceptScheme ;
    rdfs:label "Manifestation Modes"@en ;
    dcterms:description "Controlled terms for modes in which sacred agents are asserted to manifest. These are descriptive categories that may vary by tradition, lineage, or temporal regime."@en ;
    skos:hasTopConcept
        mani:mode-embodied,
        mani:mode-possession,
        mani:mode-dream,
        mani:mode-divination,
        mani:mode-symbolic,
        mani:mode-territorial,
        mani:mode-auditory,
        mani:mode-unknown .

mani:mode-embodied
    a mani:ManifestationMode ;
    skos:inScheme mani:ManifestationModeScheme ;
    skos:prefLabel "Embodied"@en ;
    skos:definition "Manifestation asserted to occur in embodied, physical form."@en .

mani:mode-possession
    a mani:ManifestationMode ;
    skos:inScheme mani:ManifestationModeScheme ;
    skos:prefLabel "Possession"@en ;
    skos:definition "Manifestation asserted to occur through possession or mounting of a human medium."@en .

mani:mode-dream
    a mani:ManifestationMode ;
    skos:inScheme mani:ManifestationModeScheme ;
    skos:prefLabel "Dream"@en ;
    skos:definition "Manifestation asserted to occur through dream or dream visitation."@en .

mani:mode-divination
    a mani:ManifestationMode ;
    skos:inScheme mani:ManifestationModeScheme ;
    skos:prefLabel "Divination"@en ;
    skos:definition "Manifestation asserted to occur through divination, oracle, or interpretive instrument."@en .

mani:mode-symbolic
    a mani:ManifestationMode ;
    skos:inScheme mani:ManifestationModeScheme ;
    skos:prefLabel "Symbolic"@en ;
    skos:definition "Manifestation asserted to occur through symbols, signs, or indirect representation."@en .

mani:mode-territorial
    a mani:ManifestationMode ;
    skos:inScheme mani:ManifestationModeScheme ;
    skos:prefLabel "Territorial"@en ;
    skos:definition "Manifestation asserted to be bound to or expressed through a specific place, site, or territory."@en .

mani:mode-auditory
    a mani:ManifestationMode ;
    skos:inScheme mani:ManifestationModeScheme ;
    skos:prefLabel "Auditory"@en ;
    skos:definition "Manifestation asserted to occur through sound, voice, or auditory sign."@en .

mani:mode-unknown
    a mani:ManifestationMode ;
    skos:inScheme mani:ManifestationModeScheme ;
    skos:prefLabel "Unknown"@en ;
    skos:definition "Manifestation mode not known or not recorded in available sources."@en .

# ===================================================================
# CONCEPT SCHEME: Medium Types
# ===================================================================

mani:MediumTypeScheme
    a skos:ConceptScheme ;
    rdfs:label "Medium Types"@en ;
    dcterms:description "Controlled terms for types of media through which sacred agent manifestation is asserted to occur."@en ;
    skos:hasTopConcept
        mani:medium-person,
        mani:medium-object,
        mani:medium-place,
        mani:medium-text,
        mani:medium-instrument,
        mani:medium-unknown .

mani:medium-person
    a mani:MediumType ;
    skos:inScheme mani:MediumTypeScheme ;
    skos:prefLabel "Person"@en ;
    skos:definition "A human person serves as the medium of manifestation."@en .

mani:medium-object
    a mani:MediumType ;
    skos:inScheme mani:MediumTypeScheme ;
    skos:prefLabel "Object"@en ;
    skos:definition "A material object (vessel, tool, consecrated item) serves as the medium."@en .

mani:medium-place
    a mani:MediumType ;
    skos:inScheme mani:MediumTypeScheme ;
    skos:prefLabel "Place"@en ;
    skos:definition "A place, site, natural feature, or territory serves as the medium."@en .

mani:medium-text
    a mani:MediumType ;
    skos:inScheme mani:MediumTypeScheme ;
    skos:prefLabel "Text"@en ;
    skos:definition "A text, inscription, verse, or document serves as the medium."@en .

mani:medium-instrument
    a mani:MediumType ;
    skos:inScheme mani:MediumTypeScheme ;
    skos:prefLabel "Instrument"@en ;
    skos:definition "A musical, divinatory, or ritual instrument serves as the medium."@en .

mani:medium-unknown
    a mani:MediumType ;
    skos:inScheme mani:MediumTypeScheme ;
    skos:prefLabel "Unknown"@en ;
    skos:definition "Medium type not known or not recorded in available sources."@en .
