    {
      "@id": "iroko:TemporalVariation",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A named temporal regime, calendar cycle, or context that conditions how a property, assertion, or policy applies. Covers: ritual calendar seasons, festival-bound periods, pre/post-initiation thresholds, gender regime cycles, and any other time-bounded condition affecting sacred knowledge governance. TemporalVariation instances are named nodes shared across modules — define once, reference everywhere. Examples: iroko:TemporalVariation/egungun-festival-period, iroko:TemporalVariation/post-kariocha-year."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Temporal Variation"
      }
    },
    {
      "@id": "iroko:ArchivalPerson",
      "@type": "owl:Class",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A person documented in archival records within the framework. Distinct from foaf:Person and prov:Agent in being specifically a person-as-archived — defined by their documentary trace rather than by personal attributes. Intended for persons appearing in historical records, colonial documents, notarial instruments, plantation registers, ecclesiastical records, and similar materials across any geographic or temporal scope. A single iroko:ArchivalPerson instance may carry multiple documentary references pointing to the same individual across different archival sources. Subclass of iroko:Entity; not a subclass of iroko:SacredEntity, since archival persons are not necessarily tradition-specific sacred knowledge subjects."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Archival Person"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:Entity"
      }
    },
    {
      "@id": "iroko:signAlternateName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Alternative or regional names for this sign across traditions or lineage variants. Language-tagged."
      },
      "rdfs:domain": {
        "@id": "iroko:Sign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sign alternate name"
      }
    },
    {
      "@id": "iroko:Narrative",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A narrative cluster that may have multiple variants across place, time, authority, and lineage. First-class in Core so any domain module (Marca for odu essays, Ngoma for lyric traditions, Ékpè for origin stories) can attach narratives without importing the full narrative module."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Narrative"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
