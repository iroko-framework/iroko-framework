        "@id": "https://ontology.irokosociety.org/iroko-core/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:comment": {
        "@language": "en",
        "@value": "This vocabulary provides the shared infrastructure for all Iroko Framework modules. It does not duplicate existing standards (Dublin Core, Schema.org, PROV-O) but adds governance mechanisms specific to sacred knowledge systems."
      },
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:tradition-rastafari",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "iroko:tradition-pan-african"
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Rastafari"
      }
    },
    {
      "@id": "iroko:tradition-umbanda",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "iroko:tradition-bantu-derived"
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Umbanda"
      }
    },
    {
      "@id": "iroko:systemType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Typological classification of the sign system. Range is tradition-specific concept scheme in marca or veve modules."
      },
      "rdfs:domain": {
        "@id": "iroko:Sign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "system type"
      }
    },
    {
      "@id": "iroko:assertionObject",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The entity that is the object of the claim. Named assertionObject (not object) to avoid shadowing rdf:object. Range is intentionally untyped — the object of an assertion may be any resource inside or outside the framework, including external URIs, foaf:Person instances, geographic locations, or framework entities. Constraining the range would break the generality of the reification model."
      },
      "rdfs:domain": {
        "@id": "iroko:Assertion"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "assertion object"
      }
    },
    {
      "@id": "iroko:access-no-access",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Operational or internal use only. Never exported to RDF."
      },
      "skos:inScheme": {
        "@id": "iroko:AccessLevelScheme"
      },
      "skos:notation": 99,
      "skos:prefLabel": {
        "@language": "en",
        "@value": "No Access"
      }
    },
    {
      "@id": "iroko:assertionScope",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Restricts the claim to a specific camino, aspect, or manifestation."
      },
      "rdfs:domain": {
        "@id": "iroko:RelationshipAssertion"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "assertion scope"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:sacredStatus-awaiting-consecration",
