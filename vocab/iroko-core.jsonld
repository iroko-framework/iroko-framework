    {
      "@id": "iroko:tradition-lucumi",
      "@type": "skos:Concept",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Lucumí"
      },
      "skos:broader": {
