        "@language": "en",
        "@value": "Fon/Ewe-derived tradition in Cuba."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Arara"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-core",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-17"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Cross-module infrastructure for governance and semantic integration of African and Afro-Atlantic sacred knowledge systems. Provides access control, provenance tracking, contested knowledge modeling, assertion governance, temporal variation, fieldwork capture, thin narrative primitives, archival person representation, and date precision modeling. Scope expanded to pan-African in v1.4.0."
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-05-21"
      },
      "dcterms:replaces": {
        "@id": "https://iroko-framework.github.io/iroko-framework/vocab/iroko-core"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework Core Vocabulary"
      },
      "owl:priorVersion": {
        "@id": "https://ontology.irokosociety.org/iroko-core/1.3.0"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-core/1.4.0"
      },
      "owl:versionInfo": "1.4.0",
      "rdfs:comment": {
        "@language": "en",
        "@value": "This vocabulary provides the shared infrastructure for all Iroko Framework modules. It does not duplicate existing standards (Dublin Core, Schema.org, PROV-O) but adds governance mechanisms specific to sacred knowledge systems, with pan-African geographic scope as of v1.4.0."
      },
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:signSystem",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The sacred sign system to which this sign belongs — divination, graphic, rhythmic, or other."
      },
      "rdfs:domain": {
        "@id": "iroko:Sign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sign system"
      }
    },
    {
      "@id": "iroko:tradition-vodou-ghede",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Gede"
      },
      "skos:broader": {
        "@id": "iroko:tradition-haitian-vodou"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Ghede nanchon in Haitian Vodou. Governs death, sexuality, resurrection, and the boundary between living and dead."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Vodou Ghede"
      }
    },
    {
      "@id": "iroko:ConsentStatusScheme",
      "@type": "skos:ConceptScheme",
