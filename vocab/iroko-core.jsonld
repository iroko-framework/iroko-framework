      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Candomble Angola"
      }
    },
    {
      "@id": "iroko:AssertionStatusScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Controlled terms for whether a claim is widely attested, lineage-specific, or actively contested."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Assertion Status"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:assertion-consensual"
        },
        {
          "@id": "iroko:assertion-contested"
        },
        {
          "@id": "iroko:assertion-lineage-specific"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Assertion Status"
        },
        {
          "@language": "es",
          "@value": "Estado de afirmación"
        },
        {
          "@language": "fr",
          "@value": "Statut d'affirmation"
        },
        {
          "@language": "pt",
          "@value": "Status de afirmação"
        },
        {
          "@language": "yo",
          "@value": "Ipo ìtẹnumọ́"
        }
      ]
    },
    {
      "@id": "iroko:epistemicType-material-culture",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:EpistemicTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Material Culture"
      }
    },
    {
      "@id": "iroko:endorsement-contested",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:CommunityEndorsementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Contested"
      }
    },
    {
      "@id": "iroko:tradition-garifuna",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Dugu"
      },
      "skos:broader": {
        "@id": "iroko:tradition-afro-indigenous"
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Garifuna"
      }
    },
    {
      "@id": "iroko:governedBy",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a resource or assertion to an AccessPolicy that governs it."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "governed by"
      },
      "rdfs:range": {
        "@id": "iroko:AccessPolicy"
      }
    },
    {
      "@id": "iroko:assertionStatus",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Whether the claim is consensual, lineage-specific, or contested. Range: iroko:AssertionStatusScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:Assertion"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "assertion status"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:oralTransmissionChain",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Documented chain of oral transmission for this knowledge. Example: Elder A (Havana) to Elder B (Matanzas) to Informant C (2018)."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "oral transmission chain"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:alternateNames",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Other names, honorifics, or tradition-specific designations for this entity across traditions or lineages. Language-tagged strings. Example: Babalu Aye (Lucumí) / Obaluaye (Candomblé) / Sakpata (Fon)."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "alternate names"
      }
    },
    {
      "@id": "iroko:contestedNotes",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Free-text description of the nature of contestation."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "contested notes"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:hasTemporalVariation",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Cross-cutting qualifier linking any resource — assertion, policy, property value, access rule, narrative — to a TemporalVariation node. Defined once in Core and referenced across all modules. Do not redefine per-module."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has temporal variation"
      },
      "rdfs:range": {
        "@id": "iroko:TemporalVariation"
      }
    },
    {
      "@id": "iroko:assertion-lineage-specific",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Recognized within a specific lineage or house but not universally."
      },
      "skos:inScheme": {
        "@id": "iroko:AssertionStatusScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Lineage-Specific"
        },
        {
          "@language": "es",
          "@value": "Específico de linaje"
        },
        {
          "@language": "fr",
          "@value": "Spécifique à une lignée"
        },
        {
          "@language": "pt",
          "@value": "Específico de linhagem"
        },
        {
          "@language": "yo",
          "@value": "Tó dá lórí ìdílé kan"
        }
      ]
    },
    {
      "@id": "iroko:consent-verbal-undocumented",
