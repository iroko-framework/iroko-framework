        "@value": "Bantu-derived Kongo religious tradition in Cuba."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Palo Mayombe"
      }
