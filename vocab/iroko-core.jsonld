      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Text description of the conditions under which this policy applies. May reference initiation levels, authority authorizations, temporal variations, or community mandates."
      },
      "rdfs:domain": {
        "@id": "iroko:AccessPolicy"
