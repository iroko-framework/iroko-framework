          "@id": "iroko:custodial-community-held"
        },
        {
          "@id": "iroko:custodial-institutional-disputed"
        },
        {
          "@id": "iroko:custodial-institutional-with-access"
        },
        {
          "@id": "iroko:custodial-lineage-succession"
        },
        {
          "@id": "iroko:custodial-private-collection"
        },
        {
          "@id": "iroko:custodial-repatriation-active"
        },
        {
          "@id": "iroko:custodial-shared-custody"
        },
        {
          "@id": "iroko:custodial-under-negotiation"
        },
        {
          "@id": "iroko:custodial-unknown-location"
        }
      ]
    },
    {
      "@id": "iroko:region-southern-african",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Traditions with primary roots in the southern African plateau and coastal zones, including Nguni-speaking peoples (Zulu, Xhosa, Swati, Ndebele), Sotho-Tswana communities, Venda, Shona, San/Khoisan hunter-gatherer traditions, and the diverse cultures of southern Africa."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Southern African traditions"
      }
    },
    {
      "@id": "iroko:access-no-access",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Operational or internal use only. Never exported to RDF."
      },
      "skos:inScheme": {
        "@id": "iroko:AccessLevelScheme"
      },
      "skos:notation": 99,
      "skos:prefLabel": {
        "@language": "en",
        "@value": "No Access"
      }
    },
    {
      "@id": "iroko:region-east-african",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Traditions with primary roots in the Swahili coast, Great Lakes region, and Horn of Africa, including Swahili-speaking coastal communities, Cushitic-speaking peoples (Somali, Oromo, Afar), Great Lakes Bantu communities (Ganda, Nyoro, Haya), and the diverse cultures of the East African interior."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "East African traditions"
      }
    },
    {
      "@id": "iroko:endorsement-contested",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:CommunityEndorsementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Contested"
      }
    },
    {
      "@id": "iroko:recordist",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:domain": {
        "@id": "iroko:SacredMedia"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "recordist"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:RelationshipAssertion",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A structured reification node recording a claimed relationship between two entities. Extends iroko:Assertion with relationship-specific slots: relationType, assertionScope, assertionLineage. Inherits governance properties (authorizedBy, recordedInEvent, assertionStatus, accessLevel) from the Assertion superclass."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Relationship Assertion"
      },
      "rdfs:subClassOf": [
        {
          "@id": "iroko:Assertion"
        },
        {
          "@id": "iroko:SacredEntity"
        }
      ]
    },
    {
      "@id": "iroko:tradition-santeria",
