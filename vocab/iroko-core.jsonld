    {
      "@id": "iroko:Entity",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Root class of the Iroko Framework. Represents any resource that can be described, governed, or linked within the framework — whether tradition-specific, archival, documentary, or institutional. iroko:SacredEntity is the primary subclass for tradition-specific sacred knowledge concepts. iroko:ArchivalPerson is the subclass for documented historical persons. Classes defined outside the SacredEntity hierarchy (such as those representing purely archival or infrastructural resources) are direct subclasses of this root."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Entity"
      }
    },
    {
      "@id": "iroko:communityEndorsement",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Status of community review and approval. Values from iroko:CommunityEndorsementScheme. Flips institutional authority model by centering community validation."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "community endorsement"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:func-healing",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "This element — sign, rhythm, plant use, or artifact — is employed as part of a healing or cleansing ceremony, calling protective or restorative forces."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Healing"
      }
    },
    {
