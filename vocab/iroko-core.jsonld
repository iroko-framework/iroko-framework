      }
    },
    {
      "@id": "iroko:tradition-bantu-derived",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "iroko:region-central-african"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Traditions with primary roots in Bantu and Kongo religious culture. Bantu as a linguistic and cultural family spans Central, East, and Southern Africa; this concept primarily covers the Kongo-rooted Central African traditions most prominent in Afro-Atlantic contexts. For traditions specifically rooted in Southern or East African Bantu cultures, use or add appropriate region-specific concepts under iroko:region-central-african, iroko:region-east-african, or iroko:region-southern-african."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Bantu-Derived"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Bantu spans multiple geographic regions. This concept is anchored to Central Africa / Kongo-derived Atlantic traditions. See region-east-african and region-southern-african for other Bantu-rooted traditions."
      }
    },
    {
      "@id": "iroko:epistemicType-claimed-revelation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:EpistemicTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Claimed Direct Revelation"
      }
    },
    {
      "@id": "iroko:publicTitleType",
      "@type": "owl:AnnotationProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Indicates the nature of dc:title when the title does not carry the entity's own name or the name by which the described person or community identifies themselves. A colonial notarial record may carry only an archival call number; a plantation register may assign an imposed name; a museum catalog may apply an institutional label coined decades after the object's creation. This property signals that dc:title is a surrogate identifier and characterizes the source of that surrogate. Planned in v1.4.0; implemented in v1.4.0. Values from iroko:PublicTitleTypeScheme."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "public title type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:MediaTypeScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Media Type"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:mediaType-audio"
        },
        {
          "@id": "iroko:mediaType-ephemera"
        },
        {
          "@id": "iroko:mediaType-manuscript"
        },
        {
          "@id": "iroko:mediaType-photograph"
        },
        {
          "@id": "iroko:mediaType-video"
        }
      ]
    },
