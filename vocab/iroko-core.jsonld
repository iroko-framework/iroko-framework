        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:access-community-only",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Accessible to verified community members. Requires authentication."
      },
      "skos:inScheme": {
        "@id": "iroko:AccessLevelScheme"
      },
      "skos:notation": 3,
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community Only"
      }
    },
    {
      "@id": "iroko:epistemicType-speculative-reconstruction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:EpistemicTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Speculative Reconstruction"
      }
    },
    {
      "@id": "iroko:assertionObject",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The entity that is the object of the claim. Named assertionObject (not object) to avoid shadowing rdf:object. Range is intentionally untyped — the object of an assertion may be any resource inside or outside the framework, including external URIs, foaf:Person instances, geographic locations, or framework entities. Constraining the range would break the generality of the reification model."
      },
      "rdfs:domain": {
        "@id": "iroko:Assertion"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "assertion object"
      }
    },
    {
      "@id": "iroko:ContestedAuthority",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An authority (religious title, position, or role) whose legitimacy or historical continuity is disputed across lineages. Example: Iyanifa (women Ifa priests) — some lineages affirm historical continuity, others claim modern innovation."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Contested Authority"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:epistemicType-published-ethnography",
