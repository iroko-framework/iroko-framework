        {
          "@language": "fr",
          "@value": "Contesté"
        },
        {
          "@language": "pt",
          "@value": "Contestado"
        },
        {
          "@language": "yo",
          "@value": "Tí a ń jiyàn lórí"
        }
      ]
    },
    {
      "@id": "iroko:FieldworkEvent",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A bounded fieldwork session or interview event during which assertions, narratives, or recordings were captured. Connects knowledge claims to their fieldwork provenance. rdfs:subClassOf prov:Activity asserted in iroko-align-prov.ttl."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Fieldwork Event"
      }
    },
    {
      "@id": "iroko:assertionSubject",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The entity that is the subject of the claim. Named assertionSubject (not subject) to avoid shadowing rdf:subject."
      },
      "rdfs:domain": {
        "@id": "iroko:Assertion"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "assertion subject"
      }
    },
