    {
      "@id": "iroko:Narrative",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A narrative cluster that may have multiple variants across place, time, authority, and lineage. First-class in Core so any domain module (Marca for odu essays, Ngoma for lyric traditions, Ékpè for origin stories) can attach narratives without importing the full narrative module."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Narrative"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
