        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:domain": {
        "@id": "iroko:SacredMedia"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "recording date"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "iroko:sacredStatus-honored-rest",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Object retired from active ritual use but continues to be tended with respect. Distinguished from decommissioned — no formal ritual deactivation has occurred."
      },
      "skos:inScheme": {
        "@id": "iroko:SacredStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Honored Rest"
      }
    },
    {
      "@id": "iroko:endorsement-pending-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:CommunityEndorsementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Pending Review"
      }
    },
    {
      "@id": "iroko:Assertion",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A first-class statement node representing a single claim about any subject in the framework. Attach authority, access level, epistemic type, contested status, and fieldwork provenance at the property level. iroko:RelationshipAssertion is a subclass for relationship-specific claims. All Assertion instances are semantically governed — they do not imply factual truth, only documented assertion."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Assertion"
      }
    },
    {
      "@id": "iroko:recordingContext",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:domain": {
        "@id": "iroko:SacredMedia"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "recording context"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:fieldworker",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Person who conducted the fieldwork. Range: foaf:Person or prov:Agent."
      },
      "rdfs:domain": {
        "@id": "iroko:FieldworkEvent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "fieldworker"
      },
      "rdfs:range": {
        "@id": "http://xmlns.com/foaf/0.1/Person"
      }
    },
    {
      "@id": "iroko:RecordingContextScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Recording Context"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:recordingContext-archival-transfer"
        },
        {
          "@id": "iroko:recordingContext-ceremonial"
        },
        {
          "@id": "iroko:recordingContext-field"
        },
        {
          "@id": "iroko:recordingContext-studio"
        }
      ]
    },
    {
      "@id": "iroko:DocumentaryEvidence",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Umbrella class for archival materials (photographs, manuscripts, audio recordings, herbarium specimens) that document sacred knowledge practices. Maps to schema:CreativeWork in RDF serialization."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Documentary Evidence"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:epistemicType-speculative-reconstruction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:EpistemicTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Speculative Reconstruction"
      }
    },
    {
      "@id": "iroko:tradition",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The Afro-Atlantic tradition to which this entity belongs. Values from controlled vocabulary: iroko:tradition-lucumi, iroko:tradition-candomble-ketu, iroko:tradition-vodou-rada, etc."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "tradition"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:relationType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The semantic type of relationship being asserted."
      },
      "rdfs:domain": {
        "@id": "iroko:RelationshipAssertion"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "relation type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:segmentOrder",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Integer position of this TextSegment within its containing narrative or variant. Used to reconstruct canonical ordering."
      },
      "rdfs:domain": {
        "@id": "iroko:TextSegment"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "segment order"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "iroko:custodial-institutional-with-access",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:CustodialRelationshipScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Institutional Holding with Community Access"
      }
    },
    {
      "@id": "iroko:SacredMedia",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Audio, photographic, or video records of sacred knowledge, ceremonies, instruments, or practitioners. Extends DocumentaryEvidence with media-specific metadata including format, instrumentation, consent status, and depicted entities."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sacred Media"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:DocumentaryEvidence"
      }
    },
    {
      "@id": "iroko:RitualAuthority",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A governance entity capable of authorizing assertion-level claims. May represent a lineage, cabildo, religious house, elder council, or individual office-holder. This is the minimal Core stub — full modeling of jurisdiction, basis, and recognition is in iroko-authority.ttl. Distinguished from ile:ReligiousOffice, which models the specific title instance held by an individual practitioner."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Ritual Authority"
      }
    },
    {
      "@id": "iroko:TextSegment",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An addressable, orderable segment within a narrative or narrative variant. Used for verse-level segmentation of odu essays, chant lines, prayers, and other structured oral or textual corpora."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Text Segment"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:role-elder",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Recognized elder whose presence and standing carry governance weight in ritual, narrative, and authorization contexts."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Elder"
      }
    },
    {
      "@id": "iroko:tradition-pan-african",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Traditions that integrate African religious identity with political liberation frameworks."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Pan-African Political-Spiritual"
      }
    },
    {
      "@id": "iroko:tradition-vodou-ghede",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Gede"
      },
      "skos:broader": {
        "@id": "iroko:tradition-haitian-vodou"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Ghede nanchon in Haitian Vodou. Governs death, sexuality, resurrection, and the boundary between living and dead."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Vodou Ghede"
      }
    },
    {
      "@id": "iroko:custodial-community-held",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:CustodialRelationshipScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community-Held"
      }
    },
    {
      "@id": "iroko:hasVariant",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a Narrative to one of its NarrativeVariants."
      },
      "rdfs:domain": {
        "@id": "iroko:Narrative"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has variant"
      },
      "rdfs:range": {
        "@id": "iroko:NarrativeVariant"
      }
    },
    {
      "@id": "iroko:sacredStatus-museum-specimen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:SacredStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Museum Specimen"
      }
    },
    {
      "@id": "iroko:tradition-lucumi",
      "@type": "skos:Concept",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Lucumí"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "Santeria"
      },
      "skos:broader": {
        "@id": "iroko:tradition-yoruba-derived"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Yoruba-derived tradition with much less syncretism with Catholicism.  Can be synonymous with Santeria."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lucumí"
      }
    },
    {
      "@id": "iroko:authorizedBy",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an Assertion to the RitualAuthority that authorizes it. An assertion without this property is undeclared as to authority — it may still carry other provenance (fieldwork event, epistemic type)."
      },
      "rdfs:domain": {
        "@id": "iroko:Assertion"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "authorized by"
      },
      "rdfs:range": {
        "@id": "iroko:RitualAuthority"
      }
    },
    {
      "@id": "iroko:tradition-afro-indigenous",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Traditions that blend African and Indigenous American religious elements."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Afro-Indigenous"
      }
    },
    {
      "@id": "iroko:signName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The canonical name of the sign in the tradition's liturgical language. Language-tagged. Examples: Ogbe Meji (Ifá), Ogún vèvè (Vodou)."
      },
      "rdfs:domain": {
        "@id": "iroko:Sign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sign name"
      }
    },
    {
      "@id": "iroko:RelationshipAssertion",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A structured reification node recording a claimed relationship between two entities. Extends iroko:Assertion with relationship-specific slots: relationType, assertionScope, assertionLineage. Inherits governance properties (authorizedBy, recordedInEvent, assertionStatus, accessLevel) from the Assertion superclass."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Relationship Assertion"
      },
      "rdfs:subClassOf": [
        {
          "@id": "iroko:Assertion"
        },
        {
          "@id": "iroko:SacredEntity"
        }
      ]
    },
    {
      "@id": "iroko:recordingContext-field",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:RecordingContextScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Field Recording"
      }
    },
    {
      "@id": "iroko:mediaType-ephemera",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Printed or handwritten items of transient purpose: programs, invitations, ritual schedules, advertisements for religious events."
      },
      "skos:inScheme": {
        "@id": "iroko:MediaTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Ephemera"
        },
        {
          "@language": "es",
          "@value": "Efímero"
        },
        {
          "@language": "fr",
          "@value": "Éphémère"
        }
      ]
    },
    {
      "@id": "iroko:tradition-abakua",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Abakuá"
      },
      "skos:broader": {
        "@id": "iroko:tradition-calabari"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Calabari/Efik-derived all-male secret society in Cuba."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Abakua"
      }
    },
    {
      "@id": "iroko:tradition-akan-derived",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
