    {
      "@id": "iroko:contestedAuthorityOf",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "owl:inverseOf": {
        "@id": "iroko:contestsAuthority"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a ContestedAuthority back to the RitualAuthority whose legitimacy is in question. Inverse of iroko:contestsAuthority. Enables bidirectional traversal: from the contesting party to the ContestedAuthority record, and from the ContestedAuthority record back to the authority being contested."
      },
      "rdfs:domain": {
        "@id": "iroko:ContestedAuthority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "contested authority of"
      },
      "rdfs:range": {
        "@id": "iroko:RitualAuthority"
      }
    },
    {
      "@id": "iroko:tradition-vodou-petwo",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Petro"
      },
      "skos:broader": {
        "@id": "iroko:tradition-haitian-vodou"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Petwo nanchon in Haitian Vodou. Hot, fierce rites with Kongo, New World maroon, and creole origins."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Vodou Petwo"
      }
    },
    {
      "@id": "iroko:languageOfPerformance",
