    },
    {
      "@id": "iroko:tradition",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The tradition to which this entity belongs. Values from iroko:TraditionScheme. May be a specific named tradition (e.g., iroko:tradition-lucumi, iroko:tradition-candomble-ketu, iroko:tradition-vodou-rada), a cultural-linguistic family (e.g., iroko:tradition-yoruba-derived, iroko:tradition-bantu-derived), or a geographic region (e.g., iroko:region-west-african, iroko:region-nile-valley). Scope is pan-African as of v1.4.0; not limited to Afro-Atlantic traditions."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "tradition"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
