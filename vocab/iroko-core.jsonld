      "@id": "iroko:access-initiated-elder",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Requires elder designation within tradition — recognized by community as having authority to access lineage-specific teachings."
      },
      "skos:inScheme": {
        "@id": "iroko:AccessLevelScheme"
      },
      "skos:notation": 5,
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Initiated Elder"
      }
    },
    {
      "@id": "iroko:region-west-african",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Traditions with primary roots in the peoples and cultures of the West African coastal and Sahel zones, spanning the area from Senegambia through the Gulf of Guinea. Includes but is not limited to Yoruba, Akan, Ewe-Fon/Gbe, Igbo, Hausa-Fulani, Mande, and Cross River/Efik communities. The geographic region from which the largest share of Afro-Atlantic religious traditions originate."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "West African traditions"
      }
    },
