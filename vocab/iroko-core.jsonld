    {
      "@id": "iroko:tradition-haitian-vodou",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Vodou Ghede"
        },
        {
          "@language": "en",
          "@value": "Vodou Petwo"
        },
        {
          "@language": "en",
          "@value": "Vodou Rada"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The creolized sacred tradition of Haiti, encompassing multiple nanchon (nations) with distinct African, Kongo, and New World origins."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Haitian Vodou"
      }
    },
    {
      "@id": "iroko:nativeDateExpression",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The date as expressed in the source document, without conversion to the Gregorian calendar. Preserves original dating systems as recorded: Alexandrian calendar, Era of Diocletian, Era of the Martyrs, Era of the Saracens, Ethiopian year, Hijri calendar, indiction (Constantinopolitan or Egyptian), regnal year, liturgical calendar, or any other indigenous system. Language-tagged string. Do not collapse to a Gregorian xsd:date when the source uses a non-Gregorian system; record the source expression in this field and the Gregorian equivalent separately. Example: '6 Pashons, year 743 of Diocletian'@cop for a Coptic-dated Nubian document."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "native date expression"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:TraditionScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Controlled vocabulary of tradition classifications spanning continental African regional traditions and Afro-Atlantic derived traditions. Three tiers: (1) geographic region concepts (iroko:region-*) as the broadest level for continental African traditions; (2) cultural-linguistic family concepts (iroko:tradition-*-derived, iroko:tradition-calabari, iroko:tradition-kemetic) as mid-level groupings; (3) specific named traditions as leaves. Afro-Atlantic creole and syncretic traditions (iroko:tradition-haitian-vodou, iroko:tradition-syncretic, iroko:tradition-afro-indigenous, iroko:tradition-pan-african, iroko:tradition-new-orleans-voodoo, iroko:tradition-obeah) are top-level concepts not subordinated to the geographic hierarchy, because their origins are plural or their character is specifically New World or political. Expanded to pan-African scope in v1.4.0."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Tradition Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:region-west-african"
        },
        {
          "@id": "iroko:region-central-african"
        },
        {
          "@id": "iroko:region-east-african"
        },
        {
          "@id": "iroko:region-southern-african"
        },
        {
          "@id": "iroko:region-north-african"
        },
        {
          "@id": "iroko:region-nile-valley"
        },
        {
          "@id": "iroko:tradition-afro-indigenous"
        },
        {
          "@id": "iroko:tradition-haitian-vodou"
        },
        {
          "@id": "iroko:tradition-new-orleans-voodoo"
        },
        {
          "@id": "iroko:tradition-obeah"
        },
        {
          "@id": "iroko:tradition-pan-african"
        },
        {
          "@id": "iroko:tradition-syncretic"
        }
      ]
    },
    {
      "@id": "iroko:titleType-colonial-designation",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
