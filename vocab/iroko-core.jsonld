    {
      "@id": "iroko:role-witness",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Person whose presence authorizes or validates an assertion, event, or ceremony. In ceremonial contexts, typically an initiated practitioner."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Witness"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "In travay contexts, the witness must be an initiated practitioner. In authority and narrative contexts, the role is broader."
      }
    },
    {
      "@id": "iroko:sacredStatus-museum-specimen",
