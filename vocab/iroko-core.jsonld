    {
      "@id": "iroko:tradition-santeria",
      "@type": "skos:Concept",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Santeria"
      },
      "skos:broader": {
        "@id": "iroko:tradition-yoruba-derived"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Yoruba-derived tradition with strong syncretisms with Catholicism and some folk traditions.  Can be synonymous with Lucumí.  Can also have a pejorative meaning, depending on context."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Santeria"
      }
    },
    {
      "@id": "iroko:documentsSpecimen",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a DocumentaryEvidence record to a SacredSpecimen it documents. A photograph, manuscript, or archival record may document one or more sacred objects. The existence of documentation is public-unrestricted; the ritual details of the object are governed by iroko:sacredStatus on the SacredSpecimen instance."
      },
      "rdfs:domain": {
        "@id": "iroko:DocumentaryEvidence"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "documents specimen"
      },
      "rdfs:range": {
        "@id": "iroko:SacredSpecimen"
      }
    },
    {
      "@id": "iroko:TemporalVariation",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A named temporal regime, calendar cycle, or context that conditions how a property, assertion, or policy applies. Covers: ritual calendar seasons, festival-bound periods, pre/post-initiation thresholds, gender regime cycles, and any other time-bounded condition affecting sacred knowledge governance. TemporalVariation instances are named nodes shared across modules — define once, reference everywhere. Examples: iroko:TemporalVariation/egungun-festival-period, iroko:TemporalVariation/post-kariocha-year."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Temporal Variation"
      }
    },
    {
      "@id": "iroko:depicts",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links archival materials to the entities they depict. Range: iroko:SacredEntity — covers plants, spirits, ceremonies, practitioners, instruments, and all other framework entities. Geographic locations not yet modeled as SacredEntity subclasses may be referenced via rdfs:label or external URI."
      },
      "rdfs:domain": {
        "@id": "iroko:DocumentaryEvidence"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "depicts"
      },
      "rdfs:range": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:variationContext",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a TemporalVariation to the context that activates it — a ceremony, liturgical calendar event, fieldwork session, or other conditioning context. Range is intentionally untyped: activating contexts are heterogeneous (RitualProcess, FieldworkEvent, calendar concept, geographic context) and constraining the range now would create fragility. Revisit when TemporalVariation has sufficient data to determine the realistic range."
      },
      "rdfs:domain": {
        "@id": "iroko:TemporalVariation"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "variation context"
      }
    },
