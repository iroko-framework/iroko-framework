        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ausar Auset Society"
      }
    },
    {
      "@id": "iroko:segmentText",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The text content of this segment. Language-tagged. Use iroko:accessLevel on the TextSegment instance to govern disclosure."
      },
      "rdfs:domain": {
        "@id": "iroko:TextSegment"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "segment text"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:tradition-obeah",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Obi"
        },
        {
          "@language": "en",
          "@value": "Obia"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "A category of spiritual practice found across the Anglophone Caribbean. Systematically criminalized under British colonial law; this history shapes the archival record significantly."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Obeah"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Obeah's criminalization history means archival materials are often court records or colonial surveillance documents. Access governance and provenance tracking are especially important."
      }
    },
    {
      "@id": "iroko:custodial-under-negotiation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:CustodialRelationshipScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Under Negotiation"
      }
    },
    {
      "@id": "iroko:recordingContext-studio",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:RecordingContextScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Studio Recording"
      }
    },
    {
      "@id": "iroko:contestsAuthority",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a RitualAuthority, SacredEntity, or Assertion to a ContestedAuthority instance it generates or references. A RitualAuthority contests another when it challenges the legitimacy or historical continuity of that authority's claims. A SacredEntity may have its governing authority contested across lineages. An Assertion may formally contest an authority's basis."
      },
      "rdfs:domain": {
        "@id": "_:n4ebb93c7a78340babd70bc74598ad590b1"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "contests authority"
      },
      "rdfs:range": {
        "@id": "iroko:ContestedAuthority"
      }
    },
    {
      "@id": "_:n4ebb93c7a78340babd70bc74598ad590b1",
      "@type": "owl:Class",
      "owl:unionOf": {
        "@list": [
          {
            "@id": "iroko:RitualAuthority"
          },
          {
            "@id": "iroko:SacredEntity"
          },
          {
            "@id": "iroko:Assertion"
          }
        ]
      }
    },
    {
      "@id": "iroko:func-invocation",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "This element calls or invites a spiritual entity into the ceremonial space. The primary function of vèvè, firmas, specific rhythms, and invocation plants across traditions."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Invocation"
      }
    },
    {
      "@id": "iroko:specimenEncounteredIn",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a FieldworkEvent to a SacredSpecimen encountered or documented during that session. Access: initiated-only — the association between a fieldwork event and a specific sacred object record discloses custody, location, and lineage information appropriate only for initiated practitioners."
      },
      "rdfs:domain": {
        "@id": "iroko:FieldworkEvent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "specimen encountered in"
      },
      "rdfs:range": {
        "@id": "iroko:SacredSpecimen"
      }
    },
    {
      "@id": "iroko:Commentary",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A commentary, gloss, or interpretive note attached to any resource in the framework — a narrative, an assertion, a sacred entity, a text segment. Keeps interpretive voice distinct from primary narrative content."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Commentary"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
