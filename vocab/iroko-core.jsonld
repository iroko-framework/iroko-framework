      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Published Ethnography"
      }
    },
    {
      "@id": "iroko:access-public-unrestricted",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Freely accessible to anyone. No authentication required."
      },
      "skos:inScheme": {
        "@id": "iroko:AccessLevelScheme"
      },
      "skos:notation": 1,
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Public - Unrestricted"
      }
    },
    {
      "@id": "iroko:hasTemporalVariation",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Cross-cutting qualifier linking any resource — assertion, policy, property value, access rule, narrative — to a TemporalVariation node. Defined once in Core and referenced across all modules. Do not redefine per-module."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has temporal variation"
      },
      "rdfs:range": {
        "@id": "iroko:TemporalVariation"
      }
    },
    {
      "@id": "iroko:datePrecision",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Indicates the level of confidence and granularity for an associated date value. Expected string values: 'exact', 'approximate', 'decade', 'century', 'unknown'. Use alongside xsd:date, xsd:gYear, or iroko:dateCentury to communicate certainty without losing the date value. When precision is 'century', prefer iroko:dateCentury over xsd:date. When precision is 'approximate' or unknown, set iroko:dateUncertain true."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "date precision"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:tradition-candomble-jeje",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "iroko:tradition-fon-ewe-derived"
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Candomble Jeje"
      }
    },
    {
      "@id": "iroko:region-nile-valley",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Traditions with primary roots in the Middle Nile Valley, Upper Nile, Ethiopian highlands, and Eritrean plateau. Covers Christian Nubian civilization (Nobadia, Makuria, Alodia), Sudanic traditions, Ethiopian Orthodox and indigenous Ethiopian communities, and Ge'ez-language manuscript cultures. The geographic scope of materials in the Database of Medieval Nubian Texts (DBMNT, University of Warsaw) and the Hill Museum and Manuscript Library Northeast African collections."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Nile Valley and Northeast African traditions"
      }
    },
    {
      "@id": "iroko:geographicVariation",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Regional or lineage-specific differences in use, form, identification, or meaning. Applies to plants, signs, rhythms, and other cross-domain entities."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "geographic variation"
      }
    },
    {
      "@id": "iroko:epistemicType-fieldwork-recording",
      "@type": "skos:Concept",
      "skos:inScheme": {
