    {
      "@id": "iroko:Commentary",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A commentary, gloss, or interpretive note attached to any resource in the framework — a narrative, an assertion, a sacred entity, a text segment. Keeps interpretive voice distinct from primary narrative content."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Commentary"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:foundingDate",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Date or approximate date when this community, house, society, or lineage was established. Applies to ile, ekpe lodge, sankofa project, or any organizational entity."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "founding date"
      }
    },
    {
      "@id": "iroko:assertionScope",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Restricts the claim to a specific camino, aspect, or manifestation."
      },
      "rdfs:domain": {
        "@id": "iroko:RelationshipAssertion"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "assertion scope"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:documents",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links archival materials to practices or events they document. Range: iroko:SacredEntity — covers ceremonies, ritual events, plants, spirits, lineages, and all other framework entities. Parallel treatment with iroko:depicts: both are documentary links from archival materials to framework entities."
      },
      "rdfs:domain": {
        "@id": "iroko:DocumentaryEvidence"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "documents"
      },
      "rdfs:range": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:custodial-lineage-succession",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Object received through lineage or house transmission. Paired with sacredStatus-hereditary-custody on the object record."
      },
      "skos:inScheme": {
        "@id": "iroko:CustodialRelationshipScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lineage Succession"
      }
    },
    {
      "@id": "iroko:AccessLevelScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Six-tier classification of access restrictions for sacred knowledge."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Access Level Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:access-community-only"
        },
        {
          "@id": "iroko:access-initiated-elder"
        },
        {
          "@id": "iroko:access-initiated-only"
        },
        {
          "@id": "iroko:access-no-access"
        },
        {
          "@id": "iroko:access-public-no-amplification"
        },
        {
          "@id": "iroko:access-public-unrestricted"
        }
      ]
    },
    {
      "@id": "iroko:titleType-unknown",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The nature of the dc:title designation has not been assessed or is not known. Flag for review."
      },
      "skos:inScheme": {
        "@id": "iroko:PublicTitleTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unknown"
      }
    },
    {
      "@id": "iroko:RitualAuthority",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A governance entity capable of authorizing assertion-level claims. May represent a lineage, cabildo, religious house, elder council, or individual office-holder. This is the minimal Core stub — full modeling of jurisdiction, basis, and recognition is in iroko-authority.ttl. Distinguished from ile:ReligiousOffice, which models the specific title instance held by an individual practitioner."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Ritual Authority"
      }
    },
    {
      "@id": "iroko:signName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The canonical name of the sign in the tradition's liturgical language. Language-tagged. Examples: Ogbe Meji (Ifá), Ogún vèvè (Vodou)."
      },
      "rdfs:domain": {
        "@id": "iroko:Sign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sign name"
      }
    },
    {
      "@id": "iroko:endorsement-unreviewed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:CommunityEndorsementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unreviewed"
      }
    },
    {
      "@id": "iroko:tradition-palo-mayombe",
