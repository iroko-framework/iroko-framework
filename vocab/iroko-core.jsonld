    {
      "@id": "iroko:dateCentury",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The century in which an event occurred or a document was produced, expressed as an integer representing the century number (e.g., 13 for the thirteenth century, 6 for the sixth century). Use when only century-level precision is available — characteristic of medieval and ancient materials from corpora such as the Database of Medieval Nubian Texts and the Hill Museum and Manuscript Library. Pair with iroko:dateUncertain to flag where even the century assignment is provisional. Does not replace xsd:date — both may be asserted on the same instance when the exact date is also known."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "date century"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "iroko:TextSegment",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An addressable, orderable segment within a narrative or narrative variant. Used for verse-level segmentation of odu essays, chant lines, prayers, and other structured oral or textual corpora."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Text Segment"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
