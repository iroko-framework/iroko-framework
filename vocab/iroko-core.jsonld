    {
      "@id": "iroko:region-central-african",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Traditions with primary roots in the Bantu and Equatorial communities of Central Africa, including the Kongo kingdom and its successor traditions, Luba, Mbundu, Chokwe, and related cultures of the Congo River basin and its watersheds."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Central African traditions"
      }
    },
