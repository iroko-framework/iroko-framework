{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:sacredStatus-hereditary-custody",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Object has passed to a new keeper through lineage or house succession and is actively maintained."
      },
      "skos:inScheme": {
        "@id": "iroko:SacredStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Hereditary Custody"
      }
    },
    {
      "@id": "iroko:TraditionScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Controlled vocabulary of Afro-Atlantic tradition classifications."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Tradition Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:tradition-afro-indigenous"
        },
        {
          "@id": "iroko:tradition-akan-derived"
        },
        {
          "@id": "iroko:tradition-bantu-derived"
        },
        {
          "@id": "iroko:tradition-calabari"
        },
        {
          "@id": "iroko:tradition-fon-ewe-derived"
        },
        {
          "@id": "iroko:tradition-haitian-vodou"
        },
        {
          "@id": "iroko:tradition-kemetic"
        },
        {
          "@id": "iroko:tradition-new-orleans-voodoo"
        },
        {
          "@id": "iroko:tradition-obeah"
        },
        {
          "@id": "iroko:tradition-pan-african"
        },
        {
          "@id": "iroko:tradition-syncretic"
        },
        {
          "@id": "iroko:tradition-yoruba-derived"
        }
      ]
    },
    {
      "@id": "iroko:SacredSpecimen",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Distinguishes objects that maintain active sacred status (consecrated, in ritual use) from decommissioned objects or museum specimens. Used to track the ritual life cycle of material culture."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sacred Specimen"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:sacredStatus-decommissioned",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:SacredStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Decommissioned"
      }
    },
    {
      "@id": "iroko:epistemicType-archival-document",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:EpistemicTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Archival Document"
      }
    },
    {
      "@id": "iroko:tradition-21-divisiones",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "21 Divisions"
        },
        {
          "@language": "en",
          "@value": "Dominican Vodu"
        }
      ],
      "skos:broader": {
        "@id": "iroko:tradition-syncretic"
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "21 Divisiones"
      }
    },
    {
      "@id": "iroko:depictedCeremony",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:domain": {
        "@id": "iroko:SacredMedia"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "depicted ceremony"
      },
      "rdfs:range": {
        "@id": "iroko:RitualProcess"
      }
    },
    {
      "@id": "iroko:AccessPolicy",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A named policy governing disclosure, access, or use of a resource, assertion, or collection. Policies may be conditioned on temporal variation, authority authorization, or community mandate. Used to attach institutional policy nodes to records and assertions. Full governance via iroko:accessLevel (per-property), iroko:EpistemicConstraint (per iroko-epistemic.ttl), and iroko:StewardshipMandate (per iroko-agency.ttl)."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Access Policy"
      }
    },
    {
      "@id": "iroko:recordedInEvent",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an Assertion to the FieldworkEvent during which it was captured."
      },
      "rdfs:domain": {
        "@id": "iroko:Assertion"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "recorded in event"
      },
      "rdfs:range": {
        "@id": "iroko:FieldworkEvent"
      }
    },
    {
      "@id": "iroko:mediaType-manuscript",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:MediaTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Manuscript"
        },
        {
          "@language": "es",
          "@value": "Manuscrito"
        },
        {
          "@language": "fr",
          "@value": "Manuscrit"
        },
        {
          "@language": "yo",
          "@value": "Ìwé àfọwọ́kọ"
        }
      ]
    },
    {
      "@id": "iroko:tradition-candomble-angola",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "iroko:tradition-bantu-derived"
      },
      "skos:inScheme": {
