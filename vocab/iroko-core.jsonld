        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:domain": {
        "@id": "iroko:SacredMedia"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "instrumentation"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:commentaryOn",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a Commentary to the resource it annotates. Range is intentionally open — commentary may attach to a Narrative, NarrativeVariant, TextSegment, Assertion, SacredEntity, or any other resource."
      },
      "rdfs:domain": {
        "@id": "iroko:Commentary"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "commentary on"
      }
    },
    {
      "@id": "iroko:minimumAccessLevel",
      "@type": "owl:AnnotationProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Annotation property used on other properties to indicate the minimum access level required to view their values. Used in vocabulary documentation and RDF export filtering."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "minimum access level"
      }
    },
    {
      "@id": "iroko:eventLocation",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Location where the fieldwork event took place. Language-tagged string; may be general (city/country) for access-controlled records."
      },
      "rdfs:domain": {
        "@id": "iroko:FieldworkEvent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "event location"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:role-witness",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Person whose presence authorizes or validates an assertion, event, or ceremony. In ceremonial contexts, typically an initiated practitioner."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Witness"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "In travay contexts, the witness must be an initiated practitioner. In authority and narrative contexts, the role is broader."
      }
    },
    {
      "@id": "iroko:tradition-hoodoo",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Conjure"
        },
        {
          "@language": "en",
          "@value": "Rootwork"
        }
      ],
      "skos:broader": {
        "@id": "iroko:tradition-syncretic"
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Hoodoo"
      }
    },
    {
      "@id": "iroko:SacredEntity",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Top-level class for any tradition-specific concept within the Iroko Framework. All module-specific classes (Plant, SpiritualEntity, RitualProcess, etc.) are subclasses of this."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sacred Entity"
      }
    },
    {
      "@id": "iroko:epistemicType-continuous-oral-transmission",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:EpistemicTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Continuous Oral Transmission"
      }
    },
    {
      "@id": "iroko:epistemicType-reconstructed-from-text",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:EpistemicTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Reconstructed from Text"
      }
    },
    {
      "@id": "iroko:competingClaim",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links to a prov:Entity representing an alternative position on this contested knowledge."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "competing claim"
      },
      "rdfs:range": {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    },
    {
      "@id": "iroko:recordingDate",
      "@type": "owl:DatatypeProperty",
