      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Traditions with primary roots in the Maghreb and Mediterranean African zones, including Amazigh/Berber communities, North African Arab traditions, and Coptic Christian communities of Egypt. Also covers ancient Egyptian religious traditions (Kemetic) and their modern revivals."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
