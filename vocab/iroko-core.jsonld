      "skos:inScheme": {
        "@id": "iroko:RecordingContextScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Field Recording"
      }
    },
    {
      "@id": "iroko:tradition-obeah",
      "@type": "skos:Concept",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Obeah"
      },
      "skos:broader": {
        "@id": "iroko:tradition-afro-indigenous"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A category of spiritual practice found across the Anglophone Caribbean. Systematically criminalized under British colonial law; this history shapes the archival record significantly."
      },
      "skos:inScheme": {
        "@id": "iroko:TraditionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Obeah"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Obeah's criminalization history means archival materials are often court records or colonial surveillance documents. Access governance and provenance tracking are especially important."
      }
    },
    {
      "@id": "iroko:relationType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The semantic type of relationship being asserted."
      },
      "rdfs:domain": {
        "@id": "iroko:RelationshipAssertion"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "relation type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
