{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:mode-territorial",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to be bound to or expressed through a place, crossroads, body of water, forest, or territory."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Territorial"
      }
    },
    {
      "@id": "iroko:hasManifestationMode",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Associates a ManifestationEvent or assertion node with a ManifestationMode concept from iroko:ManifestationModeScheme. Multiple modes may be asserted for a single event."
      },
      "rdfs:domain": {
        "@id": "iroko:ManifestationEvent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has manifestation mode"
      },
      "rdfs:range": {
        "@id": "iroko:ManifestationMode"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-manifestation",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-22"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Governance Layer module. Vocabulary for modeling how sacred agents are asserted to manifest — through embodied presence, possession, dream, divination, symbolic representation, territorial claim, or auditory sign. Plugs into iroko:ManifestationEvent and supports iroko:TemporalVariation where manifestation modes shift by ritual calendar or initiation cycle. These are descriptive, not metaphysical — they record what a tradition asserts in its own terms. Composes with iroko-narrative for temporal regime documentation and iroko-authority for assertion authorization."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-07"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-narrative"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Manifestation Module"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:label": {
        "@language": "en",
        "@value": "Iroko Framework: Manifestation Module (Sacred Agent Manifestation Modes & Media)"
      },
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:medium-place",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A place, site, crossroads, or territory serves as the medium."
      },
      "skos:inScheme": {
        "@id": "iroko:MediumTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Place"
      }
    },
    {
      "@id": "iroko:MediumTypeScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Controlled terms for the kind of medium through which manifestation is asserted to occur."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Medium Types"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:medium-instrument"
        },
        {
          "@id": "iroko:medium-object"
        },
        {
          "@id": "iroko:medium-person"
        },
        {
          "@id": "iroko:medium-place"
        },
        {
          "@id": "iroko:medium-text"
        },
        {
          "@id": "iroko:medium-unknown"
        }
      ]
    },
    {
      "@id": "iroko:ManifestationModeScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Controlled terms for how sacred agents are asserted to manifest. Tradition-reported descriptive categories. Multiple modes may apply to a single event."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Manifestation Modes"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:mode-auditory"
        },
        {
          "@id": "iroko:mode-divination"
        },
        {
          "@id": "iroko:mode-dream"
        },
        {
          "@id": "iroko:mode-embodied"
        },
        {
          "@id": "iroko:mode-possession"
        },
        {
          "@id": "iroko:mode-symbolic"
        },
        {
          "@id": "iroko:mode-territorial"
        },
        {
          "@id": "iroko:mode-unknown"
        }
      ]
    },
    {
      "@id": "iroko:mode-divination",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur through divination, oracle, or the interpretive reading of divinatory instruments."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Divination"
      }
    },
    {
      "@id": "iroko:ManifestationMode",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A SKOS concept describing how a sacred agent is asserted to manifest. Modes include embodied, possession, dream, divination, symbolic, territorial, auditory, and unknown. These categories are descriptive and tradition-reported; they record what a community asserts, not what an archive adjudicates. A single ManifestationEvent may reference multiple modes. Modes may vary by temporal regime — use iroko:TemporalVariation to document seasonal or initiatory shifts."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Manifestation Mode"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:MediumType",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A SKOS concept categorizing the kind of medium involved in a manifestation assertion: person, object, place, text, instrument, or unknown."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Medium Type"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:medium-text",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A text, inscription, vèvè, firma, or graphic document serves as the medium."
      },
      "skos:inScheme": {
        "@id": "iroko:MediumTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Text"
      }
    },
    {
      "@id": "iroko:mode-dream",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur through dreams, dream visitation, or hypnagogic contact."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Dream"
      }
    },
    {
      "@id": "iroko:mode-symbolic",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur through symbols, signs, graphic marks, or indirect representation. Vèvè, firmas, and anaforuana are common vehicles."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Symbolic"
      }
    },
    {
      "@id": "iroko:medium-unknown",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Medium type not recorded or not known."
      },
      "skos:inScheme": {
        "@id": "iroko:MediumTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unknown"
      }
    },
    {
      "@id": "iroko:mode-auditory",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur through sound, voice, drumming, or hearing — including traditions where specific rhythms summon or identify a spirit."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Auditory"
      }
    },
    {
      "@id": "iroko:medium-instrument",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A musical, divinatory, or ritual instrument serves as the medium — a consecrated bàtá drum, divining chain, or bell."
      },
      "skos:inScheme": {
        "@id": "iroko:MediumTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Instrument"
      }
    },
    {
      "@id": "iroko:mode-embodied",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur in a physically embodied form distinct from possession — the agent is present as a body, not occupying another's."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Embodied"
      }
    },
    {
      "@id": "iroko:medium-object",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A material object serves as the medium — a consecrated vessel, nganga, otán, or ritual artifact."
      },
      "skos:inScheme": {
        "@id": "iroko:MediumTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Object"
      }
    },
    {
      "@id": "iroko:mode-unknown",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation mode not recorded or not known."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unknown"
      }
    },
    {
      "@id": "iroko:hasMediumType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Associates a Medium with a MediumType concept from iroko:MediumTypeScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:Medium"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has medium type"
      },
      "rdfs:range": {
        "@id": "iroko:MediumType"
      }
    },
    {
      "@id": "iroko:Medium",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A medium through which manifestation is asserted to occur — a person, object, place, text, or instrument. A Medium is the vehicle, not the agent; the sacred agent is modeled in iroko-nkisi or iroko-agency. One ManifestationEvent may involve multiple media."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Medium"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:manifestsThroughMedium",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Associates a ManifestationEvent with a Medium through which manifestation is asserted to occur. The identity of the medium (e.g., a specific person) may carry its own access level if the medium is a community member."
      },
      "rdfs:domain": {
        "@id": "iroko:ManifestationEvent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "manifests through medium"
      },
      "rdfs:range": {
        "@id": "iroko:Medium"
      }
    },
    {
      "@id": "iroko:mode-possession",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur through mounting or possession of a medium person. The agent speaks and acts through the medium during the event."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Possession"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Distinguish from embodied: possession involves a medium person who is temporarily occupied; embodied involves a distinct physical presence."
      }
    },
    {
      "@id": "iroko:medium-person",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A human person serves as the medium, as in possession or mounted manifestation."
      },
      "skos:inScheme": {
        "@id": "iroko:MediumTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Person"
      }
    }
  ]
}