          "@id": "iroko:mode-dream"
        },
        {
          "@id": "iroko:mode-embodied"
        },
        {
          "@id": "iroko:mode-possession"
        },
        {
          "@id": "iroko:mode-symbolic"
        },
        {
          "@id": "iroko:mode-territorial"
        },
        {
          "@id": "iroko:mode-unknown"
        }
      ]
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-manifestation",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-22"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Governance Layer module. Vocabulary for modeling how sacred agents are asserted to manifest — through embodied presence, possession, dream, divination, symbolic representation, territorial claim, or auditory sign. Plugs into iroko:ManifestationEvent and supports iroko:TemporalVariation where manifestation modes shift by ritual calendar or initiation cycle. These are descriptive, not metaphysical — they record what a tradition asserts in its own terms. Composes with iroko-narrative for temporal regime documentation and iroko-authority for assertion authorization."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": [
        {
          "@type": "xsd:date",
          "@value": "2026-03-07"
        },
        {
          "@type": "xsd:date",
          "@value": "2026-05-21"
        }
      ],
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-narrative"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Manifestation Module"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:priorVersion": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation/1.3.0"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation/1.4.0"
      },
      "owl:versionInfo": "1.4.0",
      "rdfs:label": {
        "@language": "en",
        "@value": "Iroko Framework: Manifestation Module (Sacred Agent Manifestation Modes & Media)"
      },
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:mode-auditory",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur through sound, voice, drumming, or hearing — including traditions where specific rhythms summon or identify a spirit."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Auditory"
      }
    },
    {
      "@id": "iroko:mode-dream",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur through dreams, dream visitation, or hypnagogic contact."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Dream"
      }
    },
    {
      "@id": "iroko:textScript",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The script or writing system of the text content. Examples: Latin, Arabic, Ge'ez (Ethiopic), Greek, Old Nubian (Coptic-based), Hebrew, Syriac. Use ISO 15924 four-letter script codes where available. Multiple scripts may be present in a single text; record all."
      },
      "rdfs:domain": {
        "@id": "iroko:TextContent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "text script"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:medium-instrument",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A musical, divinatory, or ritual instrument serves as the medium — a consecrated bàtá drum, divining chain, or bell."
