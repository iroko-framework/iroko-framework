{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:TextContent",
      "@type": "owl:Class",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "An abstract intellectual work — a text as a specific composition, title, or discrete textual unit — independent of its physical carrier. Equivalent to the FRBR Work level and to the Contents level in the vHMML three-tier hierarchy. Distinct from iroko:ManuscriptObject (the physical carrier) and from iroko:NarrativeVariant (a specific transcribed or performed telling). A single iroko:TextContent may be carried by multiple ManuscriptObjects across different repositories or copies. Properties cover language, script, genre, and uniform title. Subclass of iroko:SacredEntity."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Text Content"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:support-papyrus",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Writing surface made from papyrus plant stems. Primary medium for ancient Egyptian and early Christian Egyptian documentation."
      },
      "skos:inScheme": {
        "@id": "iroko:PhysicalSupportScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Papyrus"
      }
    },
    {
      "@id": "iroko:carriersText",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a ManuscriptObject to an iroko:TextContent it physically carries. One ManuscriptObject may carry multiple TextContent instances — a codex may contain several distinct works. Inverse of iroko:carriedBy."
      },
      "rdfs:domain": {
        "@id": "iroko:ManuscriptObject"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "carries text"
      },
      "rdfs:range": {
        "@id": "iroko:TextContent"
      }
    },
    {
      "@id": "iroko:mode-divination",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur through divination, oracle, or the interpretive reading of divinatory instruments."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Divination"
      }
    },
    {
      "@id": "iroko:mode-symbolic",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur through symbols, signs, graphic marks, or indirect representation. Vèvè, firmas, and anaforuana are common vehicles."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Symbolic"
      }
    },
    {
      "@id": "iroko:support-textile",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Cloth, leather, or textile-based writing or inscription surface."
      },
      "skos:inScheme": {
        "@id": "iroko:PhysicalSupportScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Textile"
      }
    },
    {
      "@id": "iroko:textLanguage",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The language or languages of the text content. Express as a BCP 47 language tag where a standard code exists (e.g., 'ar' for Arabic, 'gez' for Ge'ez). For languages without standard BCP 47 codes, use a descriptive string: 'Old Nubian', 'Coptic', 'Middle Nubian'. Multiple values permitted for polyglot texts or texts in more than one language. Do not conflate language and script — record both separately."
      },
      "rdfs:domain": {
        "@id": "iroko:TextContent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "text language"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:mode-unknown",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation mode not recorded or not known."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unknown"
      }
    },
    {
      "@id": "iroko:support-other",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Physical support type not covered by existing concepts. Use skos:scopeNote on the instance to describe the specific material."
      },
      "skos:inScheme": {
        "@id": "iroko:PhysicalSupportScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:support-ostracon",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A pottery sherd or stone flake used as an informal writing surface for short texts, school exercises, receipts, or personal notes. Common in Nubian and Egyptian archaeological contexts; many DBMNT texts are ostraca."
      },
      "skos:inScheme": {
        "@id": "iroko:PhysicalSupportScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ostracon"
      }
    },
    {
      "@id": "iroko:support-stone",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Stone inscriptions, stelae, and rock surfaces used for monumental or votive texts."
      },
      "skos:inScheme": {
        "@id": "iroko:PhysicalSupportScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Stone"
      }
    },
    {
      "@id": "iroko:PhysicalSupportScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Controlled terms for manuscript and archival object physical substrates. Derived from vHMML support vocabulary (CC BY 4.0) and extended for Iroko Framework use."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Physical Support Types"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:support-parchment"
        },
        {
          "@id": "iroko:support-paper"
        },
        {
          "@id": "iroko:support-papyrus"
        },
        {
          "@id": "iroko:support-stone"
        },
        {
          "@id": "iroko:support-ostracon"
        },
        {
          "@id": "iroko:support-textile"
        },
        {
          "@id": "iroko:support-metal"
        },
        {
          "@id": "iroko:support-wood"
        },
        {
          "@id": "iroko:support-clay"
        },
        {
          "@id": "iroko:support-other"
        }
      ]
    },
    {
      "@id": "iroko:physicalSupport",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The material substrate of the manuscript object. Range: iroko:PhysicalSupportScheme. Covers parchment, paper, papyrus, stone, ostracon, textile, metal, wood, clay, and other carriers. Values drawn from the controlled vocabulary used by vHMML and comparable manuscript cataloging projects."
      },
      "rdfs:domain": {
        "@id": "iroko:ManuscriptObject"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "physical support"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:ManifestationMode",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A SKOS concept describing how a sacred agent is asserted to manifest. Modes include embodied, possession, dream, divination, symbolic, territorial, auditory, and unknown. These categories are descriptive and tradition-reported; they record what a community asserts, not what an archive adjudicates. A single ManifestationEvent may reference multiple modes. Modes may vary by temporal regime — use iroko:TemporalVariation to document seasonal or initiatory shifts."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Manifestation Mode"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:medium-person",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A human person serves as the medium, as in possession or mounted manifestation."
      },
      "skos:inScheme": {
        "@id": "iroko:MediumTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Person"
      }
    },
    {
      "@id": "iroko:support-wood",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Wooden boards, tablets, or surfaces used for writing or carving."
      },
      "skos:inScheme": {
        "@id": "iroko:PhysicalSupportScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Wood"
      }
    },
    {
      "@id": "iroko:support-clay",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Fired or unfired clay tablets bearing inscribed or impressed text."
      },
      "skos:inScheme": {
        "@id": "iroko:PhysicalSupportScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Clay"
      }
    },
    {
      "@id": "iroko:manifestsThroughMedium",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Associates a ManifestationEvent with a Medium through which manifestation is asserted to occur. The identity of the medium (e.g., a specific person) may carry its own access level if the medium is a community member."
      },
      "rdfs:domain": {
        "@id": "iroko:ManifestationEvent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "manifests through medium"
      },
      "rdfs:range": {
        "@id": "iroko:Medium"
      }
    },
    {
      "@id": "iroko:hasManifestationMode",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Associates a ManifestationEvent or assertion node with a ManifestationMode concept from iroko:ManifestationModeScheme. Multiple modes may be asserted for a single event."
      },
      "rdfs:domain": {
        "@id": "iroko:ManifestationEvent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has manifestation mode"
      },
      "rdfs:range": {
        "@id": "iroko:ManifestationMode"
      }
    },
    {
      "@id": "iroko:ManuscriptObject",
      "@type": "owl:Class",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A physical manuscript or archival object — codex, scroll, single leaf, inscribed stone, ostracon, stela, or similar carrier. Models the physical vehicle as distinct from the intellectual content it carries. Structurally equivalent to the Object level in the vHMML three-tier hierarchy (Object / Part / Contents). A ManuscriptObject may carry one or more iroko:TextContent instances. The physical and intellectual levels are modeled separately so that a single text can be located across multiple physical carriers, and a single object can carry multiple texts. Subclass of iroko:DocumentaryEvidence, which is itself a subclass of iroko:SacredEntity."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Manuscript Object"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:DocumentaryEvidence"
      }
    },
    {
      "@id": "iroko:mode-territorial",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to be bound to or expressed through a place, crossroads, body of water, forest, or territory."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Territorial"
      }
    },
    {
      "@id": "iroko:support-paper",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Paper writing surface, including both handmade and machine-made paper."
      },
      "skos:inScheme": {
        "@id": "iroko:PhysicalSupportScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Paper"
      }
    },
    {
      "@id": "iroko:support-parchment",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Animal skin prepared as a writing surface. Used extensively in Ethiopian, Nubian, and European medieval manuscript traditions."
      },
      "skos:inScheme": {
        "@id": "iroko:PhysicalSupportScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Parchment"
      }
    },
    {
      "@id": "iroko:mode-possession",
      "@type": "iroko:ManifestationMode",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Manifestation asserted to occur through mounting or possession of a medium person. The agent speaks and acts through the medium during the event."
      },
      "skos:inScheme": {
        "@id": "iroko:ManifestationModeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Possession"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Distinguish from embodied: possession involves a medium person who is temporarily occupied; embodied involves a distinct physical presence."
      }
    },
    {
      "@id": "iroko:carriedBy",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "owl:inverseOf": {
        "@id": "iroko:carriersText"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a TextContent to a ManuscriptObject that carries it. One TextContent may appear in multiple ManuscriptObjects. Inverse of iroko:carriersText."
      },
      "rdfs:domain": {
        "@id": "iroko:TextContent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "carried by"
      },
      "rdfs:range": {
        "@id": "iroko:ManuscriptObject"
      }
    },
    {
      "@id": "iroko:medium-place",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A place, site, crossroads, or territory serves as the medium."
      },
      "skos:inScheme": {
        "@id": "iroko:MediumTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Place"
      }
    },
    {
      "@id": "iroko:Medium",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A medium through which manifestation is asserted to occur — a person, object, place, text, or instrument. A Medium is the vehicle, not the agent; the sacred agent is modeled in iroko-nkisi or iroko-agency. One ManifestationEvent may involve multiple media."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Medium"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:medium-object",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A material object serves as the medium — a consecrated vessel, nganga, otán, or ritual artifact."
      },
      "skos:inScheme": {
        "@id": "iroko:MediumTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Object"
      }
    },
    {
      "@id": "iroko:MediumType",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A SKOS concept categorizing the kind of medium involved in a manifestation assertion: person, object, place, text, instrument, or unknown."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Medium Type"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:support-metal",
      "@type": "skos:Concept",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Metal tablets, plaques, or coins bearing inscribed text."
      },
      "skos:inScheme": {
        "@id": "iroko:PhysicalSupportScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Metal"
      }
    },
    {
      "@id": "iroko:hasMediumType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Associates a Medium with a MediumType concept from iroko:MediumTypeScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:Medium"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has medium type"
      },
      "rdfs:range": {
        "@id": "iroko:MediumType"
      }
    },
    {
      "@id": "iroko:uniformTitle",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The standardized title for this intellectual work, independent of how the title may appear on any specific manuscript or in any particular catalog. Use the form established by the relevant authority file: LCNAF, HAF (HMML Authority File), DBMNT, or community convention. Language-tagged. A single work may have multiple uniform title assertions in different languages or from different authority sources."
      },
      "rdfs:domain": {
        "@id": "iroko:TextContent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "uniform title"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:medium-unknown",
      "@type": "iroko:MediumType",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-manifestation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Medium type not recorded or not known."
      },
      "skos:inScheme": {
        "@id": "iroko:MediumTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unknown"
      }
    },
    {
      "@id": "iroko:MediumTypeScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
