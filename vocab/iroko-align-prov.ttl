@prefix iroko:    <https://ontology.irokosociety.org/core/> .
@prefix iroko-ag: <https://ontology.irokosociety.org/agency/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.irokosociety.org/align/prov/>
    a owl:Ontology ;
    rdfs:label "Iroko alignment with PROV-O (reference only)"@en ;
    dcterms:description "Reference-only alignment to PROV-O. This module declares subclass alignments to support interoperability. It does not owl:imports PROV-O, and it does not assert equivalence."@en ;
    dcterms:creator "Iroko Historical Society"@en ;
    dcterms:issued "2026-02-22"^^xsd:date ;
    dcterms:license <https://ontology.irokosociety.org/policy/terms-of-use> ;
    dcterms:isPartOf <https://ontology.irokosociety.org/> .

# Agents
iroko-ag:SacredAgent rdfs:subClassOf prov:Agent .

# Activities (events)
iroko-ag:RitualEvent rdfs:subClassOf prov:Activity .

# Entities (claims, policies, records)
iroko:RelationshipAssertion rdfs:subClassOf prov:Entity .
iroko:AccessPolicy          rdfs:subClassOf prov:Entity .
