        },
        {
          "@language": "es",
          "@value": "Permanencia del signo"
        },
        {
          "@language": "fr",
          "@value": "Permanence du signe"
        },
        {
          "@language": "pt",
          "@value": "Permanência do signo"
        },
        {
          "@language": "yo",
          "@value": "Ìṣẹ́ àkókò àmì"
        }
      ]
    },
    {
      "@id": "iroko:governingAuthority",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The title or institution with authority over this sign system. For Anaforuana: the Abakuá potencia leadership. For Vodou vèvè: the Houngan/Mambo body. Community-restricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SignSystem"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "governing authority"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:SignSystem",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A tradition-specific graphic communication system consisting of a defined corpus of signs with shared visual grammar, drawing conventions, and ceremonial functions. Examples: the Vodou vèvè corpus; the Palo Monte firma/patipemba tradition; Ejagham Nsibidi; Abakuá Anaforuana; Akan Adinkra. A sign system is identified by tradition, geographic origin, and governing authority. The existence of a system and its name are public; its internal grammar and full sign inventory may be restricted."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sign System"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:surface-ground",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Bare earth or dirt surface, often at crossroads or outdoor ceremony spaces."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ground / earth"
      }
    },
    {
      "@id": "iroko:drawingMedium",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The material used to draw this instance. Range: iroko:DrawingMediumScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:SignInstance"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "drawing medium"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:func-consecration",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sign activates or consecrates an object, person, or space for sacred use."
      },
      "skos:inScheme": {
        "@id": "iroko:SignFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Consecration"
      }
    },
    {
      "@id": "iroko:medium-cornmeal",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Ground cornmeal used for vèvè and some Lucumí ground drawings."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingMediumScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Cornmeal"
        },
        {
          "@language": "es",
          "@value": "Harina de maíz"
        }
      ]
    },
    {
      "@id": "iroko:surface-body",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The skin of a practitioner or initiate. Used for protective and initiatory markings."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Body (skin)"
      }
    },
    {
      "@id": "iroko:system-nsibidi",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "An ideographic script and graphic sign system originating among the Ejagham and neighboring Cross River peoples of Nigeria and Cameroon. Used by Ékpè society members for communication, record-keeping, and ceremonial marking. Nsibidi predates colonial contact; some signs are public while esoteric variants remain restricted to Ékpè initiates. Ancestor system to Cuban Abakuá Anaforuana."
      },
      "skos:inScheme": {
        "@id": "iroko:SignSystemTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Nsibidi"
        },
        {
          "@language": "en",
          "@value": "Nsibidi (Ejagham/Cross River)"
        }
      ]
    },
    {
      "@id": "iroko:DrawingSurfaceScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Drawing Surfaces"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:surface-altar"
        },
        {
          "@id": "iroko:surface-body"
        },
        {
          "@id": "iroko:surface-cloth"
        },
        {
          "@id": "iroko:surface-door"
        },
        {
          "@id": "iroko:surface-floor"
