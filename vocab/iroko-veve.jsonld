      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:PermanenceScheme",
      "@type": "skos:ConceptScheme",
