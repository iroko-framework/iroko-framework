{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:SignFunctionScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Sign Functions"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:func-binding"
        },
        {
          "@id": "iroko:func-communication"
        },
        {
          "@id": "iroko:func-consecration"
        },
        {
          "@id": "iroko:func-identification"
        },
        {
          "@id": "iroko:func-narrative"
        },
        {
          "@id": "iroko:func-opening"
        },
        {
          "@id": "iroko:func-protection"
        },
        {
          "@id": "iroko:func-sealing"
        },
        {
          "@id": "iroko:func-territorial"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Sign Functions"
        },
        {
          "@language": "es",
          "@value": "Funciones del signo"
        },
        {
          "@language": "fr",
          "@value": "Fonctions du signe"
        },
        {
          "@language": "pt",
          "@value": "Funções do signo"
        },
        {
          "@language": "yo",
          "@value": "Àwọn iṣẹ́ àmì"
        }
      ]
    },
    {
      "@id": "iroko:surface-cloth",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Fabric or cloth, particularly for Adinkra stamping and some Vodou ceremonial use."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Cloth / fabric"
      }
    },
    {
      "@id": "iroko:func-narrative",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sign records an event, tells a story, or encodes historical knowledge. Characteristic of Nsibidi's documentary function."
      },
      "skos:inScheme": {
        "@id": "iroko:SignFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Narrative / Recording"
      }
    },
    {
      "@id": "iroko:func-territorial",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sign marks the boundary or domain of a spiritual entity, house, or society. Particularly important in Abakuá Anaforuana."
      },
      "skos:inScheme": {
        "@id": "iroko:SignFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Territorial marking"
      }
    },
    {
      "@id": "iroko:surface-door",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Door, doorframe, or threshold — boundary surfaces with protective and liminal significance."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Door / threshold"
      }
    },
    {
      "@id": "iroko:relatedSign",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A sign within the same system that shares visual elements, modifies this sign's function, or is typically drawn in sequence with it."
      },
      "rdfs:domain": {
        "@id": "iroko:GraphicSign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "related sign"
      },
      "rdfs:range": {
        "@id": "iroko:GraphicSign"
      }
    },
    {
      "@id": "iroko:func-sealing",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sign closes or concludes a ceremony or seals a spiritual agreement."
      },
      "skos:inScheme": {
        "@id": "iroko:SignFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Sealing"
      }
    },
    {
      "@id": "iroko:perm-temporary",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Fades naturally or is ritually removed after the ceremony concludes (e.g., ground drawings exposed to weather)."
      },
      "skos:inScheme": {
        "@id": "iroko:PermanenceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Temporary"
      }
    },
    {
      "@id": "iroko:surface-floor",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Interior floor of a temple, hounfò, or ilé. The most common surface for Vodou vèvè."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Floor (interior)"
      }
    },
    {
      "@id": "iroko:surface-wall",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Interior or exterior wall surface. Used for semi-permanent protective signs."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Wall"
      }
    },
    {
      "@id": "iroko:SignInstance",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A specific documented occurrence of a graphic sign: a particular vèvè drawn at a specific ceremony, a firma traced before a consultation, an Adinkra stamped on cloth. Distinct from the abstract sign type (iroko:GraphicSign). Records medium, surface, date, ritual context, and photographer/recorder where available. Photographic documentation of sign instances is community-restricted; the sign's existence is public."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sign Instance"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:surface-tree",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Living tree or bark surface. Used in some outdoor and forest-spirit ceremonies."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Tree / bark"
      }
    },
    {
      "@id": "iroko:SignCorpus",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The complete inventory of graphic signs held and transmitted by a specific lineage, house, or tradition community. Different lineages within the same tradition may hold different signs or use the same sign with different operational meanings. A sign corpus is lineage-specific and represents a distinct LineageKnowledgeGraph."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sign Corpus"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:LineageKnowledgeGraph"
      }
    },
    {
      "@id": "iroko:medium-paint",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Commercial or natural paint used for wall murals, cloth stamping, or semi-permanent sign installation. Common in Adinkra cloth production."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Paint"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-veve",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-22"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Domain module. Vocabulary for documenting graphic sign systems, sacred diagrams, and esoteric scripts across Afro-Atlantic traditions. Covers Vèvè (Vodou), Firma/Patipemba (Palo), Ponto Riscado (Umbanda/Quimbanda), Anaforuana (Abakuá), Nsibidi (Ejagham), Adinkra (Akan), and Kongo cosmograms. Access control runs from public (sign system typology) through initiated-elder (operational drawing sequences) and no-access (selected Anaforuana protected by tradition authority). Use with iroko-authority to document which lineage or sodality context authorizes transmission of a sign system."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-07"
      },
      "dcterms:references": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Vèvè Module (Graphic Sign Systems and Sacred Diagrams)"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-veve/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:func-opening",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sign opens a ceremony, a spiritual pathway, or a sacred space for work."
      },
      "skos:inScheme": {
        "@id": "iroko:SignFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Opening"
      }
    },
    {
      "@id": "iroko:drawingSequence",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-elder"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The step-by-step sequence in which the sign must be drawn. The directionality and order of strokes often carries operational significance. Initiated-elder only."
      },
      "rdfs:domain": {
        "@id": "iroko:GraphicSign"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "drawing sequence"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:medium-ash",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Wood ash or specific burned materials used for cooling, ancestral, and threshold-crossing signs."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ash"
      }
    },
    {
      "@id": "iroko:surface-object",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A consecrated object, vessel, drum, or implement."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Sacred object"
      }
    },
    {
      "@id": "iroko:system-ponto-riscado",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The graphic sign system of Brazilian Umbanda and Quimbanda, consisting of drawn points (pontos) associated with Orixás, Exus, and Pombagiras. Related to but distinct from Palo Monte firmás; developed in the Brazilian context with syncretic elements from African, Indigenous, and Spiritist sources."
      },
      "skos:inScheme": {
        "@id": "iroko:SignSystemTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Ponto Riscado (Umbanda/Quimbanda)"
        },
        {
          "@language": "pt",
          "@value": "Ponto Riscado"
        }
      ]
    },
    {
      "@id": "iroko:perm-permanent",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Intended to endure: carved stone or metal, tattooed or scarified body marks, Nsibidi on permanent objects."
      },
      "skos:inScheme": {
        "@id": "iroko:PermanenceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Permanent"
      }
    },
    {
