      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A body of water, basin, or liquid surface. Used in some healing and cooling ceremonies."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
