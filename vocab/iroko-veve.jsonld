        },
        {
          "@language": "yo",
          "@value": "Àwọn ìrú ètò àmì mímọ́"
        }
      ]
    },
    {
      "@id": "iroko:medium-carved",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Signs carved or incised into wood, stone, metal, or other materials for permanent installation."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Carved / incised"
      }
    },
    {
      "@id": "iroko:system-adinkra",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A system of visual symbols originating among the Akan of Ghana and Côte d'Ivoire, each symbol encoding a proverb, concept, or value. Traditionally stamped on cloth for funerary and ceremonial use. More publicly documented than many Afro-Atlantic sign systems due to widespread commercial adoption, though ceremonial uses retain their gravity. Increasingly present in diaspora contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:SignSystemTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Adinkra"
        },
        {
          "@language": "en",
          "@value": "Adinkra (Akan)"
        }
      ],
      "skos:scopeNote": {
        "@language": "en",
        "@value": "While many Adinkra symbols are widely published, their ceremonial and mortuary use context should be documented with appropriate respect for Akan tradition authority."
      }
    },
    {
      "@id": "iroko:documentationRecord",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Photographic, rubbing, or tracing record of this sign instance. Range: iroko:SacredMedia. Community-restricted: documentation should not enable replication."
      },
      "rdfs:domain": {
        "@id": "iroko:SignInstance"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "documentation record"
      },
      "rdfs:range": {
        "@id": "iroko:SacredMedia"
      }
    },
    {
      "@id": "iroko:surface-altar",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The surface of an altar, throne, or ritual table."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Altar surface"
      }
    },
    {
      "@id": "iroko:system-veve",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The graphic sign system of Haitian Vodou, consisting of elaborate diagrams drawn in flour, cornmeal, ash, or gunpowder on the ground or altar surface to invoke and represent specific lwa. Each lwa has one or more canonical vèvè; regional and lineage variations are well-documented. Drawn at the opening of ceremonies and during possession rites."
      },
      "skos:inScheme": {
        "@id": "iroko:SignSystemTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Vèvè (Haitian Vodou)"
        },
        {
          "@language": "fr",
          "@value": "Vèvè"
        }
      ]
    },
    {
      "@id": "iroko:perm-ephemeral",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Destroyed or erased immediately after use as part of the ceremony (e.g., vèvè covered by dance, flour swept away)."
      },
      "skos:inScheme": {
        "@id": "iroko:PermanenceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ephemeral"
      }
    },
    {
      "@id": "iroko:surface-paper",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Paper, parchment, or documentary material. Used in some Palo and Espiritismo contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingSurfaceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Paper / document"
      }
    },
    {
      "@id": "iroko:perm-semi-permanent",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Remains for an extended period but is understood to be renewable (e.g., wall signs, painted objects, cloth)."
      },
      "skos:inScheme": {
        "@id": "iroko:PermanenceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Semi-permanent"
      }
    },
    {
      "@id": "iroko:medium-blood",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Animal or human blood used as a drawing medium in highly restricted ceremonies. Initiated-elder access for operational detail."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Blood"
      }
    },
    {
      "@id": "iroko:func-protection",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sign creates a boundary of spiritual protection around a person, object, or space."
      },
      "skos:inScheme": {
        "@id": "iroko:SignFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Protection"
      }
    },
    {
      "@id": "iroko:drawingSurface",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The surface on or within which this instance was drawn. Range: iroko:DrawingSurfaceScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:SignInstance"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "drawing surface"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:surface-other",
      "@type": "skos:Concept",
      "skos:definition": {
