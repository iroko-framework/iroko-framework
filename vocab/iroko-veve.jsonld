        {
          "@id": "iroko:surface-tree"
        },
        {
          "@id": "iroko:surface-wall"
        },
        {
          "@id": "iroko:surface-water"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Drawing Surfaces"
        },
        {
          "@language": "es",
          "@value": "Superficies de dibujo"
        },
        {
          "@language": "fr",
          "@value": "Surfaces de dessin"
        },
        {
          "@language": "pt",
          "@value": "Superfícies de desenho"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ilẹ̀ ìkọ̀"
        }
      ]
    },
    {
      "@id": "iroko:GraphicSign",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A discrete ritual diagram, symbol, or graphic mark belonging to a sacred sign system. Each sign has a conventional form, a tradition-specific name, and one or more ceremonial functions. Examples: a specific Vodou vèvè drawn for Ogou Feray; an Abakuá Anaforuana sign protecting a potencia's territory; a Palo firma drawn to open a Nganga. The sign's form and name are community-restricted in active traditions; its operational use and drawing sequence are initiated-only."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Graphic Sign"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:Sign"
      }
    },
    {
      "@id": "iroko:medium-charcoal",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Ground charcoal used for ancestral, funerary, and dark-force-related signs."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Charcoal"
      }
    },
    {
      "@id": "iroko:system-anaforuana",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The esoteric graphic script of the Abakuá society in Cuba, derived from Ejagham Nsibidi through enslaved Cross River practitioners. Anaforuana signs represent potencia territories, spiritual forces, and society knowledge. Among the most protected sign systems in the Afro-Atlantic world; specific signs are restricted to initiated members at specific grades. Related to but institutionally distinct from Nsibidi."
      },
      "skos:inScheme": {
        "@id": "iroko:SignSystemTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Anaforuana (Abakuá)"
        },
        {
          "@language": "es",
          "@value": "Anaforuana"
        }
      ],
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Many Anaforuana signs are protected at initiated-only or no-access level by potencia authority. Researchers must obtain community approval before documenting or publishing specific signs."
      }
    },
    {
      "@id": "iroko:func-communication",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sign transmits information or messages between practitioners or between practitioners and spiritual forces."
      },
      "skos:inScheme": {
        "@id": "iroko:SignFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Communication"
      }
    },
    {
      "@id": "iroko:medium-gunpowder",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Gunpowder used in Palo Monte firmás and some Vodou vèvè for Ogou/Oggun-family entities. Associated with warrior and fire forces."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingMediumScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Gunpowder"
        },
        {
          "@language": "es",
          "@value": "Pólvora"
        }
      ]
    },
    {
      "@id": "iroko:func-identification",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sign identifies a house, potencia, lineage, or practitioner's affiliation. Primary function of Anaforuana territorial marks."
      },
      "skos:inScheme": {
        "@id": "iroko:SignFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Identification / Territory"
      }
    },
    {
      "@id": "iroko:colorSignificance",
