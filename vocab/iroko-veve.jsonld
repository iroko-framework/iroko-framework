          "@value": "Àwọn ohun ìkọ̀"
        }
      ]
    },
    {
      "@id": "iroko:medium-chalk-colored",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Pigmented chalk in tradition-specific colors, used for signs associated with particular spiritual forces or chromatic requirements."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Colored chalk"
      }
    },
    {
      "@id": "iroko:func-binding",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The sign constrains or binds a force or entity. Initiated-only detail."
      },
      "skos:inScheme": {
        "@id": "iroko:SignFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Binding"
      }
    },
    {
      "@id": "iroko:system-cosmogram",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Dikenga"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The foundational Kongo cosmological diagram (dikenga dia Kongo) representing the cyclical journey of the soul through the four moments of the sun. A cross-in-circle form that underlies both Palo Monte firmás and traces of Kongo spiritual geography throughout the Afro-Atlantic diaspora. Foundational to understanding other Kongo-derived sign systems."
      },
      "skos:inScheme": {
        "@id": "iroko:SignSystemTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Kongo Cosmogram"
        },
        {
          "@language": "es",
          "@value": "Cosmograma Kongo"
        }
      ]
    },
    {
      "@id": "iroko:system-firma",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Prenda signature"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The Kongo-derived graphic sign system of Palo Monte and related Cuban-Bantu traditions. Firmas are drawn to open, close, seal, and communicate with Nganga (spirit vessels) and their governing Mpungo. Patipemba are specific ground-drawing configurations. The directionality and polarity of firmas is operationally significant."
      },
      "skos:inScheme": {
        "@id": "iroko:SignSystemTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Firma / Patipemba (Palo Monte)"
        },
        {
          "@language": "es",
          "@value": "Firma / Patipemba"
        }
      ]
    },
    {
      "@id": "iroko:drawnBy",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The practitioner who drew this sign instance. Range: iroko:RitualPractitioner — a vèvè, anaforuana, or other sacred graphic sign is always drawn by a human agent exercising ritual capacity, not merely any person. Community-restricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SignInstance"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-veve"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "drawn by"
      },
      "rdfs:range": {
        "@id": "iroko:RitualPractitioner"
      }
    },
    {
      "@id": "iroko:medium-ink",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Ink applied with pen, brush, or stamp. Common in Nsibidi documentation and Adinkra cloth stamping."
      },
      "skos:inScheme": {
        "@id": "iroko:DrawingMediumScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ink"
      }
    },
    {
      "@id": "iroko:SignSystemTypeScheme",
