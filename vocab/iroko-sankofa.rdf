<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:iroko="https://ontology.irokosociety.org/iroko#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recognition-rejected">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Source tradition authorities have formally rejected or declined to recognize this practice or community.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RecognitionStatusScheme"/>
    <skos:prefLabel xml:lang="en">Rejected</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rel-direct-descent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The Afro-Atlantic tradition descends directly from the African source tradition through documented enslaved practitioner transmission. Widely recognized by scholars and both communities.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">Direct descent (widely attested)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#type-reconstruction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Efforts to create or restore a practice from documentary, archaeological, or cross-tradition scholarly sources where direct lineage transmission has been lost.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MovementTypeScheme"/>
    <skos:prefLabel xml:lang="en">Tradition reconstruction</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#MovementTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Reclamation Movement Types</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#type-decolonization"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#type-heritage-tourism"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#type-other"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#type-purification"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#type-re-africanization"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#type-reconstruction"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#type-repatriation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#type-validation-seeking"/>
    <skos:prefLabel xml:lang="en">Reclamation Movement Types</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Tipos de movimiento de reclamación</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Types de mouvement de réclamation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Tipos de movimento de reclamação</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àwọn ìrú ìgbiyànjú ìpadàbọ̀</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#returningCommunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">returning community</rdfs:label>
    <rdfs:comment xml:lang="en">The Afro-Atlantic house or community making the return. Range: iroko:House.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TransAfroAtlanticReturn"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-type-freedom-petition">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Freedom Petition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Petición de libertad</skos:prefLabel>
    <skos:definition xml:lang="en">A legal petition filed by or on behalf of an enslaved person seeking recognition of free status, disputing ownership, or claiming coartación rights. Freedom petitions are the primary site of enslaved legal agency within the colonial documentary apparatus.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#movementContestation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">contestation notes</rdfs:label>
    <rdfs:comment xml:lang="en">Notes on how this movement has been received, resisted, or debated within and outside the tradition community.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko-sankofa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-22</dcterms:created>
    <dcterms:creator>Iroko Historical Society</dcterms:creator>
    <dcterms:description xml:lang="en">Domain module. Vocabulary for the full Afro-Atlantic arc: the forced-departure side, documenting the colonial legal instruments that constituted and contested ownership over enslaved persons (iroko:SlavePaper and the SlavePaper type, function, and period schemes); and the return side, documenting revitalization movements, Trans-Afro-Atlantic returns, reconstructed traditions, and heritage relationships. The module name follows the Akan sankofa principle — to go back and fetch what was taken — a structure that encompasses both what was taken (documented in slave paper) and the subsequent return to claim it. Models semantic relationships between Afro-Atlantic practice and African source traditions without adjudicating authenticity. All heritage relationship claims are modeled as iroko:RelationshipAssertion to reflect their contested and negotiated character. The classes and properties in this module are descriptive instruments — they document what movements call themselves and what they claim to do. The use of terms such as 'return', 'diaspora', and 'reclamation' reflects the self-description of the movements documented here, not a normative position of the Iroko Framework on questions of African identity or belonging. Use with iroko-authority to document who may authorize heritage relationship claims and recognition, and for contributor roles (notary, scribe, commissioner) associated with slave paper production; iroko-narrative for movement histories, oral transmission chains, and contested origin accounts.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-16</dcterms:modified>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <dcterms:title xml:lang="en">Iroko Framework: Sankofa Module (Documentary Apparatus, Reclamation Movements, and Trans-Afro-Atlantic Returns)</dcterms:title>
    <rdfs:seeAlso rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <owl:imports rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <owl:priorVersion rdf:resource="https://ontology.irokosociety.org/iroko-sankofa/1.3.0"/>
    <owl:versionIRI rdf:resource="https://ontology.irokosociety.org/iroko-sankofa/1.3.1"/>
    <owl:versionInfo>1.3.1</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#targetTradition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">target tradition</rdfs:label>
    <rdfs:comment xml:lang="en">The Afro-Atlantic tradition this movement seeks to reclaim or revitalize. Range: iroko:TraditionScheme concept.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#returnOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">return outcome</rdfs:label>
    <rdfs:comment xml:lang="en">The documented result of this return: mutual recognition, initiation, rejection, or ongoing relationship. Free-text.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TransAfroAtlanticReturn"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#type-purification">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Efforts within a tradition community to establish or enforce a more 'authentic' or 'pure' practice, often by marginalizing innovations perceived as non-traditional. May be conservative (defending existing Afro-Atlantic practice) or reformist (seeking African models).</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MovementTypeScheme"/>
    <skos:prefLabel xml:lang="en">Purification / orthodoxy movement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#hostCommunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">host community</rdfs:label>
    <rdfs:comment xml:lang="en">The African community or institution receiving the Afro-Atlantic visitors. Range: iroko:House.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TransAfroAtlanticReturn"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#RecognitionStatusScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Recognition Status</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#recognition-disputed"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#recognition-formally-recognized"/>
