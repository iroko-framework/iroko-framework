    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#recognition-not-sought"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#recognition-pending"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#recognition-rejected"/>
    <skos:prefLabel xml:lang="en">Recognition Status</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Estado de reconocimiento</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Statut de reconnaissance</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Status de reconhecimento</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Ipò ìdásílẹ̀</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#reconstructionMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">reconstruction method</rdfs:label>
    <rdfs:comment xml:lang="en">The primary method used to reconstruct this practice. Range: iroko:ReconstructionMethodScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructedPractice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rel-reconstructed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The relationship is based on reconstruction from historical evidence rather than surviving living transmission.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">Reconstructed / claimed</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#HeritageRelationshipTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Heritage Relationship Types</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#rel-claimed-disputed"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#rel-direct-descent"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#rel-influence"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#rel-other"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#rel-parallel-development"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#rel-reconstructed"/>
    <skos:prefLabel xml:lang="en">Heritage Relationship Types</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Tipos de relación patrimonial</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Types de relation patrimoniale</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Tipos de relação patrimonial</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àwọn ìrú ìbátan àṣà ìní</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#return-consultation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Afro-Atlantic practitioner receives divination or consultation from African authority figures.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReturnTypeScheme"/>
    <skos:prefLabel xml:lang="en">Consultation / divination</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#communityRecognition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">community recognition status</rdfs:label>
    <rdfs:comment xml:lang="en">Whether and how this reconstructed practice has been recognized by source tradition communities. Range: iroko:RecognitionStatusScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructedPractice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rel-influence">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The African tradition influenced the Afro-Atlantic tradition without a direct descent relationship. Elements were adopted or adapted.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">Historical influence</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#geographicLocus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">geographic locus</rdfs:label>
    <rdfs:comment xml:lang="en">The city, country, or region where this movement, return event, or reconstructed practice was primarily based or most active. Language-tagged string. Examples: 'New York City (1920s–1940s)'@en for Garveyite reclamation; 'Bahia, Brazil'@pt for the Candomblé re-Africanization effort; 'Port-au-Prince, Haiti'@fr for a Vodou governance movement. For machine-readable geographic linking, use iroko:hasJurisdiction (from iroko-authority.ttl) instead of or in addition to this property.</rdfs:comment>
    <rdfs:domain rdf:nodeID="ndd83576be13843109ada907a612d7dffb5"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#groundedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">grounded in</rdfs:label>
    <rdfs:comment xml:lang="en">The heritage relationship assertion that grounds this return event or reclamation movement. A TransAfroAtlanticReturn or ReclamationMovement is typically predicated on a claimed relationship between an Afro-Atlantic tradition and an African source tradition; this property links the event or movement to that formal assertion. The heritage claim may be widely attested, lineage-specific, or contested — the property records the claim without adjudicating it.</rdfs:comment>
    <rdfs:domain rdf:nodeID="ndd83576be13843109ada907a612d7dffb9"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationship"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-type-customs-certification">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Customs Certification</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Certificación aduanera</skos:prefLabel>
    <skos:definition xml:lang="en">A document issued by colonial customs or port authorities certifying the legal introduction of enslaved persons into a jurisdiction. Particularly significant in the post-1808 period when trade illegality required fraudulent backdating or re-certification.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ReturnTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Trans-Afro-Atlantic Return Types</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#return-ceremony-participation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#return-consultation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#return-initiation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#return-other"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#return-protocol-exchange"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#return-research"/>
    <skos:prefLabel xml:lang="en">Trans-Afro-Atlantic Return Types</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Tipos de retorno diaspórico</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Types de retour diasporique</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Tipos de retorno diaspórico</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àwọn ìrú ìpadàbọ̀ ará ìjìnlẹ̀ ayé</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb3">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#TransAfroAtlanticReturn"/>
    <rdf:rest rdf:nodeID="ndd83576be13843109ada907a612d7dffb4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-type-sale-record">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Sale Record</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Escritura de venta</skos:prefLabel>
    <skos:definition xml:lang="en">A notarized instrument documenting the sale or transfer of an enslaved person between owners. Core document in the Atlantic ownership chain; required notarial authentication in most colonial legal systems.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#slavePaperType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">slave paper type</rdfs:label>
    <rdfs:comment xml:lang="en">The document type classification for this slave paper instance. Range: iroko:SlavePaperTypeScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaper"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-function-ownership-claim">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Ownership Claim</skos:prefLabel>
    <skos:definition xml:lang="en">Document asserts or transfers a legal ownership claim over an enslaved person.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperFunctionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb6">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdf:rest rdf:nodeID="ndd83576be13843109ada907a612d7dffb7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#method-oral-tradition">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Reconstruction based on oral transmission from living elders or communities with partial survival of the tradition.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructionMethodScheme"/>
    <skos:prefLabel xml:lang="en">Oral tradition and living practitioners</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#corridorJurisdiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">corridor jurisdiction</rdfs:label>
    <rdfs:comment xml:lang="en">The Atlantic trade corridor node at which this slave paper was issued, recorded, or enforced. Range: iroko:Jurisdiction (from iroko-authority.ttl). Use to link slave paper to specific port cities and colonial administrative territories in the TiSP corridor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaper"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#Jurisdiction"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#afroAtlanticTradition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Afro-Atlantic tradition</rdfs:label>
    <rdfs:comment xml:lang="en">The Afro-Atlantic side of the claimed heritage relationship. Range: iroko:TraditionScheme concept.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationship"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#movementOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">movement outcome</rdfs:label>
    <rdfs:comment xml:lang="en">The documented or ongoing result of this movement. Range: iroko:MovementOutcomeScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recognition-informally-recognized">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Recognition exists through interpersonal relationships and mutual respect without formal institutional endorsement.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RecognitionStatusScheme"/>
    <skos:prefLabel xml:lang="en">Informally recognized</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-type-ship-manifest">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Ship Manifest</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Manifiesto de carga</skos:prefLabel>
    <skos:definition xml:lang="en">A customs or port document listing enslaved persons as cargo aboard a vessel. Required for transatlantic and coastal trade; used to collect duties and establish initial entry into the colonial documentary record.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb11">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sourceRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">source region</rdfs:label>
    <rdfs:comment xml:lang="en">The continental African geographic region toward which this movement, return event, or heritage relationship is oriented. Range: iroko:TraditionScheme geographic region concepts (iroko:region-west-african, iroko:region-central-african, iroko:region-east-african, iroko:region-southern-african, iroko:region-north-african, iroko:region-nile-valley). Distinct from iroko:sourceTradition, which points to a specific cultural-linguistic tradition; sourceRegion carries the broader geographic orientation when the specific tradition is not identified or when the movement is pan-regionally oriented. A Garveyite movement asserting a general Africa-wide claim would use sourceRegion rather than sourceTradition. Both properties may be asserted simultaneously.</rdfs:comment>
    <rdfs:domain rdf:nodeID="ndd83576be13843109ada907a612d7dffb1"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-type-judicial-filing">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Judicial Filing</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Expediente judicial</skos:prefLabel>
    <skos:definition xml:lang="en">A court record — complaint, testimony, judgment, or order — pertaining to the status, ownership, or freedom of an enslaved person. Judicial filings constitute the primary site where ownership claims were actively contested.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#evidenceBase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">evidence base</rdfs:label>
    <rdfs:comment xml:lang="en">Summary of the scholarly and community evidence supporting or complicating this heritage relationship claim.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationship"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb10">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#TransAfroAtlanticReturn"/>
    <rdf:rest rdf:nodeID="ndd83576be13843109ada907a612d7dffb11"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-function-chain-of-title">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Chain-of-Title Link</skos:prefLabel>
    <skos:definition xml:lang="en">Document serves as a link in the chain of ownership title — establishing the legal sequence of transfers by which the current owner's claim derives from the original sale or entry.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperFunctionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#returnDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">return date</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TransAfroAtlanticReturn"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#period-pre-1808">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Pre-1808</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Antes de 1808</skos:prefLabel>
    <skos:definition xml:lang="en">Legal trade period: the Atlantic slave trade operated within formal legal frameworks with extensive official documentation — bills of sale, ship manifests, customs declarations, baptismal registers, and notarial records. The full apparatus of slave paper as an active legal instrument of colonial property law. Documentation density is highest in this period.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperPeriodScheme"/>
    <skos:topConceptOf rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperPeriodScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-function-identity-document">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Identity Documentation</skos:prefLabel>
    <skos:definition xml:lang="en">Document establishes or records the name, origin, or identity of an enslaved person within the colonial bureaucratic system.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperFunctionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recognition-formally-recognized">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The reconstructed or Afro-Atlantic practice has received formal recognition from a source tradition authority.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RecognitionStatusScheme"/>
    <skos:prefLabel xml:lang="en">Formally recognized</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#type-repatriation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Physical return of Afro-Atlantic people to African source communities, creating new hybrid communities and exchanges. Examples: Brazilian returnee (aguda/tabom) communities in West Africa who brought Afro-Atlantic Candomblé elements back to Benin and Nigeria.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MovementTypeScheme"/>
    <skos:prefLabel xml:lang="en">Repatriation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#currentCommunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">current practicing community</rdfs:label>
    <rdfs:comment xml:lang="en">The house or community practicing this reconstructed tradition. Range: iroko:House.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructedPractice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#evidencesHeritage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">evidences heritage</rdfs:label>
    <rdfs:comment xml:lang="en">Links a SlavePaper instance to the HeritageRelationship it evidences — typically because the document records the name, origin, or cultural identity of an enslaved person whose tradition can be traced. This is the ontological connection between the forced-departure documentation and the reclamation arc: the slave record that proves a transmission chain is the evidentiary link between forced removal and the heritage claim.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaper"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationship"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#originDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">origin date</rdfs:label>
    <rdfs:comment xml:lang="en">Approximate date the movement began.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recognition-pending">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Recognition process is underway; outcome not yet determined.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RecognitionStatusScheme"/>
    <skos:prefLabel xml:lang="en">Pending</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rel-parallel-development">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The Afro-Atlantic and African traditions share a common ancestor but developed in parallel rather than one descending from the other.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">Parallel development from shared source</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#period-post-1820">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Post-1820</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Después de 1820</skos:prefLabel>
    <skos:definition xml:lang="en">Criminalization period: the U.S. Piracy Act of 1820 classified slave trading as a capital offense, forcing the trade into maximum clandestinity. Documentation became systematically destroyed, forged, or simply absent. Surviving slave paper from this period is often the product of legal challenges, freedom petitions, or judicial proceedings.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperPeriodScheme"/>
    <skos:topConceptOf rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperPeriodScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#movementName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">movement name</rdfs:label>
    <rdfs:comment xml:lang="en">The name or designation of this reclamation or revitalization movement. Language-tagged.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#method-cross-tradition-synthesis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Reconstruction by synthesizing elements from multiple related surviving traditions to fill gaps in a fragmented one.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructionMethodScheme"/>
    <skos:prefLabel xml:lang="en">Cross-tradition synthesis</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sourceTradition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">source tradition</rdfs:label>
    <rdfs:comment xml:lang="en">The African tradition identified as the reclamation's reference point. Range: iroko:TraditionScheme concept.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#returnType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">return type</rdfs:label>
    <rdfs:comment xml:lang="en">The nature of the return encounter. Range: iroko:ReturnTypeScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TransAfroAtlanticReturn"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#return-protocol-exchange">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Formal exchange of liturgical, ceremonial, or governance knowledge between Afro-Atlantic and African communities.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReturnTypeScheme"/>
    <skos:prefLabel xml:lang="en">Protocol / knowledge exchange</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#archivalRepository">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">archival repository</rdfs:label>
    <rdfs:comment xml:lang="en">The name and location of the physical archive or collection holding this slave paper or the document series from which it is drawn. Language-tagged string. Examples: 'Archivo General de la Nación, Mexico City'@es; 'Archivo Histórico del Estado de Veracruz'@es.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaper"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SlavePaperTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Slave Paper Types</rdfs:label>
    <dcterms:description xml:lang="en">Document type classification for colonial legal instruments that constituted or contested ownership claims over enslaved persons in the Atlantic world.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-type-baptismal-register"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-type-customs-certification"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-type-freedom-petition"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-type-irregular-forged"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-type-judicial-filing"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-type-manumission-instrument"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-type-official-correspondence"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-type-sale-record"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-type-ship-manifest"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="ndd83576be13843109ada907a612d7dffb2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#africanTradition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">African source tradition</rdfs:label>
    <rdfs:comment xml:lang="en">The African source tradition claimed in this heritage relationship. Range: iroko:TraditionScheme concept.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationship"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#type-re-africanization">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Efforts to restore African elements to Afro-Atlantic traditions that have been transformed by colonialism, syncretism, or assimilation. Exemplified by the Candomblé re-Africanization movement in Bahia and the movement to remove Catholic saint imagery from Lucumí/Ocha practice.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MovementTypeScheme"/>
    <skos:prefLabel xml:lang="en">Re-Africanization</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Re-africanización</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Ré-africanisation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ReconstructedPractice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Reconstructed Practice</rdfs:label>
    <rdfs:comment xml:lang="en">A religious practice or tradition that has been assembled or restored from documentary sources, scholarly research, or cross-tradition synthesis rather than direct lineage transmission. Examples: reconstructed Yorùbá practice in communities without living initiatory lineage; synthesis traditions drawing on Farrow, Bascom, or Verger ethnographic documentation; Neo-African traditions developed from scholarly sources in North America or Europe. The reconstruction method and its evidentiary basis are the core data here; the framework makes no judgment about the resulting practice's validity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recognition-not-sought">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The community practices without seeking external recognition, asserting autonomy over its own validity.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RecognitionStatusScheme"/>
    <skos:prefLabel xml:lang="en">Not sought</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb4">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationship"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#return-initiation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Afro-Atlantic practitioner receives initiation in Africa within a source tradition.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReturnTypeScheme"/>
    <skos:prefLabel xml:lang="en">African initiation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recognition-disputed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Some source tradition representatives recognize the practice; others do not. Contested.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RecognitionStatusScheme"/>
    <skos:prefLabel xml:lang="en">Disputed</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#method-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Reconstruction method not covered by existing concepts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructionMethodScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SlavePaperPeriodScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Atlantic Trade Periods (TiSP)</rdfs:label>
    <dcterms:description xml:lang="en">Chronological periods reflecting distinct legal regimes in the Atlantic slave trade, as defined in the TiSP (Trafficking in Slave Paper) project framework.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#period-1808-1820"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#period-post-1820"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#period-pre-1808"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#period-1808-1820">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">1808–1820</skos:prefLabel>
    <skos:prefLabel xml:lang="es">1808–1820</skos:prefLabel>
    <skos:definition xml:lang="en">Nominal suppression period: the Atlantic trade was illegal under U.S. and British law but continued with reduced official documentation, irregular certifications, forged manifests, and fraudulent domestic sale records obscuring trans-Atlantic origins. Slave paper from this period reflects the legal fiction of domestic transfer masking ongoing trans-Atlantic trafficking.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperPeriodScheme"/>
    <skos:topConceptOf rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperPeriodScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#TransAfroAtlanticReturn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Trans-Afro-Atlantic Return</rdfs:label>
    <rdfs:comment xml:lang="en">A documented instance of a Afro-Atlantic practitioner or community making contact with, seeking validation from, or receiving initiation within an African source community. Examples: Cuban Babalawos traveling to Yorùbáland for Ifá validation; Haitian Vodouisants conducting ceremonies in Benin at Ouidah; Candomblé priests initiating in West Africa. A Trans-Afro-Atlantic return may be documented as an event, a relationship, or a formal protocol exchange. The outcomes of such encounters — including mutual recognition or rejection — should be documented without taking sides.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-function-ownership-challenge">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Ownership Challenge</skos:prefLabel>
    <skos:definition xml:lang="en">Document contests or disrupts a claimed ownership right — through judicial petition, contested manumission, coartación claim, or challenge to the legality of original enslavement.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperFunctionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-function-freedom-basis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Freedom Basis</skos:prefLabel>
    <skos:definition xml:lang="en">Document constitutes or supports the legal basis for an enslaved person's free status — manumission instruments, freedom petitions, and successful court rulings.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperFunctionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb2">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdf:rest rdf:nodeID="ndd83576be13843109ada907a612d7dffb3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SlavePaper">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Slave Paper</rdfs:label>
    <rdfs:comment xml:lang="en">A colonial legal document — sale record, ship manifest, customs certification, baptismal register entry, judicial filing, manumission instrument, or freedom petition — that constituted, maintained, challenged, or forged an ownership claim over an enslaved person in the Atlantic world. The class name follows the TiSP (Trafficking in Slave Paper) project terminology, which foregrounds the documentary nature of the legal mechanism: slave paper was not merely a record of completed transactions but an active legal instrument through which status, ownership, and identity were continuously made and contested. Slave paper required perpetual renewal through notarial, customs, ecclesiastical, or judicial systems; the gap or absence in that chain was itself a legal event. SlavePaper instances may serve as iroko:evidentiarySources for iroko:ReconstructedPractice and populate iroko:evidenceBase on iroko:HeritageRelationship where the enslaved person's cultural or religious identity can be traced. Contributor roles for producers of slave paper (notary, scribe, commissioner) are modeled in iroko-authority.ttl via iroko:ContributorRoleScheme.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#DocumentaryEvidence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-type-official-correspondence">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Official Correspondence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Correspondencia oficial</skos:prefLabel>
    <skos:definition xml:lang="en">Letters, reports, or memoranda between colonial administrators, customs officials, port authorities, or clergy concerning the movement, legal status, or trade of enslaved persons. Includes instructions on trade suppression enforcement in the post-1808 period.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#type-validation-seeking">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Efforts by Afro-Atlantic practitioners to obtain formal recognition, initiation, or endorsement from African source communities or their representatives. May involve travel, correspondence, or receiving African elders in Afro-Atlantic contexts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MovementTypeScheme"/>
    <skos:prefLabel xml:lang="en">Validation-seeking</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#relationshipType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">relationship type</rdfs:label>
    <rdfs:comment xml:lang="en">The type of heritage relationship claimed. Range: iroko:HeritageRelationshipTypeScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationship"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#keyFigures">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">key figures</rdfs:label>
    <rdfs:comment xml:lang="en">Principal practitioners, scholars, or leaders associated with this movement. Range: foaf:Person.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-type-irregular-forged">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Irregular or Forged Paper</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Documento irregular o falsificado</skos:prefLabel>
    <skos:definition xml:lang="en">A document in the slave paper chain that was fraudulently produced, backdated, altered, or otherwise irregular. Analytically essential for the post-1820 period of illegal trade: the prevalence of forged documentation reveals the legal requirements of the official system and the networks that circumvented them.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SlavePaperFunctionScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Slave Paper Functions</rdfs:label>
    <dcterms:description xml:lang="en">The legal or institutional function served by a slave paper document within the Atlantic ownership claim apparatus.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-function-chain-of-title"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-function-freedom-basis"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-function-identity-document"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-function-ownership-challenge"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#paper-function-ownership-claim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#type-heritage-tourism">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Organized or individual Afro-Atlantic visits to African source sites for spiritual, cultural, or commemorative purposes. Distinguished from TransAfroAtlanticReturn in being primarily observational rather than initiatory.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MovementTypeScheme"/>
    <skos:prefLabel xml:lang="en">Heritage tourism / pilgrimage</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#method-ethnographic">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Reconstruction based primarily on published ethnographic literature (Bascom, Farrow, Verger, Cabrera, Herskovits, etc.).</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructionMethodScheme"/>
    <skos:prefLabel xml:lang="en">Published ethnographic sources</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#return-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Return type not covered by existing concepts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReturnTypeScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradePeriod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">trade period</rdfs:label>
    <rdfs:comment xml:lang="en">The Atlantic slave trade chronological period in which this slave paper was produced or to which it belongs. Range: iroko:SlavePaperPeriodScheme. The three TiSP periods reflect distinct legal regimes: pre-1808 (open Atlantic trade), 1808-1820 (nominal suppression, ongoing trade), post-1820 (intensified illegal trade requiring more elaborate documentary apparatus).</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaper"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#method-archival">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Reconstruction based on primary archival sources: colonial records, religious registers, fieldwork notes, photographs.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructionMethodScheme"/>
    <skos:prefLabel xml:lang="en">Archival / documentary sources</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb7">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#TransAfroAtlanticReturn"/>
    <rdf:rest rdf:nodeID="ndd83576be13843109ada907a612d7dffb8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#returnContestation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">contestation notes</rdfs:label>
    <rdfs:comment xml:lang="en">How this return has been evaluated or contested within the broader tradition community.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TransAfroAtlanticReturn"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#movementType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">movement type</rdfs:label>
    <rdfs:comment xml:lang="en">The typological category of this movement. Range: iroko:MovementTypeScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReclamationMovement"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ReclamationMovement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Reclamation Movement</rdfs:label>
    <rdfs:comment xml:lang="en">An organized or semi-organized community effort to recover, revitalize, or Africanize a Afro-Atlantic religious tradition. Examples: the Candomblé re-Africanization movement beginning in the 1930s–70s (Mãe Aninha, Martiniano do Bonfim, and later the SECNEB research agenda); the Lucumí decolonization efforts removing Catholic syncretism from Ocha practice; the Ifá revival in Trinidad and other Afro-Atlantic communities seeking direct Yorùbá validation; the African American Ifá reclamation beginning in the late 20th century. A movement is documented without adjudicating whether its claims of authenticity are correct.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Event"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ReconstructionMethodScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Reconstruction Methods</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#method-archival"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#method-community-consensus"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#method-cross-tradition-synthesis"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#method-ethnographic"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#method-oral-tradition"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#method-other"/>
    <skos:prefLabel xml:lang="en">Reconstruction Methods</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Métodos de reconstrucción</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Méthodes de reconstruction</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Métodos de reconstrução</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àwọn ọ̀nà ìtúnpadà</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#HeritageRelationship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Heritage Relationship</rdfs:label>
    <rdfs:comment xml:lang="en">A formal assertion of the relationship between a Afro-Atlantic tradition and its claimed African source tradition. Subclass of iroko:RelationshipAssertion: the claim is documented with its source, asserter, and status (widely attested, lineage-specific, or contested) without requiring resolution. Examples: the documented Yorùbá–Lucumí relationship; the contested specificity of Fon vs. Ewe sources for Haitian Vodou Rada; the debated connection between specific Cuban Abakuá potencias and Cross River Ékpè lodges.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#RelationshipAssertion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rel-claimed-disputed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The Afro-Atlantic tradition claims a relationship to the African source, but this claim is disputed by scholars, the African community, or other Afro-Atlantic communities.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">Claimed but contested</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#return-research">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Afro-Atlantic practitioner or scholar conducts fieldwork in African source communities.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReturnTypeScheme"/>
    <skos:prefLabel xml:lang="en">Research / ethnographic</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#type-decolonization">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Specifically framed efforts to identify and remove colonial impositions (Catholic syncretism, colonial-era secrecy requirements, European naming conventions) from a Afro-Atlantic tradition. Overlaps with re-Africanization but emphasizes the political critique of colonialism.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MovementTypeScheme"/>
    <skos:prefLabel xml:lang="en">Decolonization</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Descolonización</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Décolonisation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#type-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Movement type not covered by existing concepts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MovementTypeScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paperFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">paper function</rdfs:label>
    <rdfs:comment xml:lang="en">The legal or institutional function this slave paper instance served within the ownership claim chain. Range: iroko:SlavePaperFunctionScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaper"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#evidentiarySources">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">evidentiary sources</rdfs:label>
    <rdfs:comment xml:lang="en">The documentary, scholarly, or oral sources used as the basis for reconstruction. Range: iroko:DocumentaryEvidence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructedPractice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-sankofa"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#DocumentaryEvidence"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-type-baptismal-register">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Baptismal Register Entry</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Registro de bautismo</skos:prefLabel>
    <skos:definition xml:lang="en">An ecclesiastical record of an enslaved person's baptism. Critical for identity and status: in colonial Catholic systems, baptism established a Christian name and was often the first record of an enslaved person by name in the local documentary apparatus.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rel-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Heritage relationship type not covered by existing concepts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HeritageRelationshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb8">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructedPractice"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#paper-type-manumission-instrument">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Manumission Instrument</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Carta de libertad</skos:prefLabel>
    <skos:definition xml:lang="en">A legal instrument by which an enslaved person was formally freed by their enslaver. Coartación documents, cartas de libertad, and similar instruments. Manumission could be conditional, partial, or purchased (coartación) — the instrument type records the terms.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SlavePaperTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#return-ceremony-participation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Afro-Atlantic practitioner participates in African ceremonies without receiving initiation.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReturnTypeScheme"/>
    <skos:prefLabel xml:lang="en">Ceremony participation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#method-community-consensus">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Reconstruction through formal community process: elders and practitioners deliberating together to establish or restore practice.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ReconstructionMethodScheme"/>
    <skos:prefLabel xml:lang="en">Community deliberation and consensus</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="ndd83576be13843109ada907a612d7dffb10"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd83576be13843109ada907a612d7dffb5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="ndd83576be13843109ada907a612d7dffb6"/>
  </rdf:Description>
</rdf:RDF>
