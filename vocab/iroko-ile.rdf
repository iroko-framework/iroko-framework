<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:iroko="https://ontology.irokosociety.org/iroko#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiationWitness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">initiation witness</rdfs:label>
    <rdfs:comment xml:lang="en">Witnesses present at the initiation. Range: foaf:Person. Sensitive; access no-access by default.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#InitiationEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-no-access"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-hounfo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Haitian Vodou temple and its associated community.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Hounfò</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Hounfò</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">initiator</rdfs:label>
    <rdfs:comment xml:lang="en">The authority figure who performed the initiation. Range: iroko:ReligiousOffice.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#InitiationEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-yaya-nkisi">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Female initiated priest in Palo Monte with authority over an nganga.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Yaya Nkisi</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Cabildo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cabildo</rdfs:label>
    <rdfs:comment xml:lang="en">A Cuban colonial-era mutual aid and religious society organized by African ethnic identity. Cabildos were the institutional vessels for Lucumí, Arará, Kongo, and other traditions in Cuba. Distinct from contemporary houses in legal form and historical structure. May have successor houses linked via iroko:successorHouse.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#itaPerformed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">itá performed</rdfs:label>
    <rdfs:comment xml:lang="en">True if a life reading (itá) was conducted as part of this initiation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#InitiationEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#InitiationTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Initiation Types</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-abakua"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-couche"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-egbe"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-ifa"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-kanzo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-kariosha"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-mano-orula"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-necklaces"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-olofin"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-other"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-palo-rayamiento"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-rayisman"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#initiation-warriors"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-ekpe-member">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Initiated member of the Ekpe leopard society (Cross River / Calabari tradition).</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Ekpe Member</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-iyanifa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Female Ifá priest. Recognition is contested across lineages; use iroko:contestedStatus when applicable.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Iyanifa</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Iyanifa</skos:prefLabel>
    <skos:scopeNote xml:lang="en">The recognition of Iyanifa is a live dispute in Lucumí communities. iroko:ReligiousOffice records for this title should carry iroko:contestedStatus and iroko:contestedNotes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#membershipEstimate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">membership estimate</rdfs:label>
    <rdfs:comment xml:lang="en">Approximate number of initiated members. Text to allow ranges or qualitative descriptions.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/numberOfEmployees"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recognizedOffice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">recognized office</rdfs:label>
    <rdfs:comment xml:lang="en">A religious office recognized and active within this house. Inverse of iroko:authorityHouse. A house may recognize multiple offices; each office is a separate ReligiousOffice instance. Active vs. historical status determined by iroko:conferralDate on the office record. Access: community-only — office structure of a house is internal governance information.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <owl:inverseOf rdf:resource="https://ontology.irokosociety.org/iroko#authorityHouse"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#holdsOffice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">holds office</rdfs:label>
    <rdfs:comment xml:lang="en">A religious office currently or historically held by this person. Inverse of iroko:authorityHolder. Multiple offices may be held simultaneously or sequentially; each is a separate ReligiousOffice instance with its own iroko:conferralDate. This property does not distinguish current from historical — that distinction is carried by the office record. Access: community-only — office holding within a house is internal governance information not appropriate for public disclosure.</rdfs:comment>
    <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <owl:inverseOf rdf:resource="https://ontology.irokosociety.org/iroko#authorityHolder"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#lineageCharacteristics">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">lineage characteristics</rdfs:label>
    <rdfs:comment xml:lang="en">Description of what distinguishes this rama: liturgical variations, oriki, priestly protocols, founding relationships, regional practices.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Lineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-study-group">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An informal group organized for learning, not yet constituted as a full house.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Study / Learning Group</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-couche">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The lying-in period component of Vodou kanzo initiation.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Couche</skos:prefLabel>
    <skos:prefLabel xml:lang="ht">Kouche</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-olofista">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Priest initiated into the Olofin mysteries. Among the highest initiatory grades in Lucumí.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Olofista</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmission-divination-prescribed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The specific form of transmission was determined by divination rather than fixed protocol.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TransmissionTypeScheme"/>
    <skos:prefLabel xml:lang="en">Divination-Prescribed</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-abakua">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Initiation into an Abakuá potencia.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Abakuá Initiation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Iniciación Abakuá</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-cabildo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Cuban colonial mutual aid and religious society organized by African ethnic identity. Use iroko:Cabildo subclass for records of this type.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Cabildo</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Cabildo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">authority scope</rdfs:label>
    <rdfs:comment xml:lang="en">What ritual functions this title authorizes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-palo-rayamiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Palo Initiation</skos:altLabel>
    <skos:definition xml:lang="en">Palo Monte/Mayombe initiation ceremony marking entry into a munanso.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="es">Rayamiento</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#TransmissionTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Knowledge Transmission Types</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#transmission-combined"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#transmission-divination-prescribed"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#transmission-embodied"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#transmission-oral"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#transmission-written"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#entityCrowned">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">entity crowned</rdfs:label>
    <rdfs:comment xml:lang="en">For head initiations: the orisha/entity seated on the initiate's head. Range: nkisi:SpiritualEntity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#InitiationEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-iyalosha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Iyalorisha</skos:altLabel>
    <skos:altLabel xml:lang="es">Madrina</skos:altLabel>
    <skos:definition xml:lang="en">Senior female Orisha priest with the authority to initiate others.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Iyalosha</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#schismParentHouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schism parent house</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SchismEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmission-combined">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Transmission involves both embodied/oral and written components.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TransmissionTypeScheme"/>
    <skos:prefLabel xml:lang="en">Combined</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Religious Office Titles</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-abakua-member"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-alagba"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-araba"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-babalawo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-babalosha"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-ekpe-member"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-houngan"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-iyalosha"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-iyanifa"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-mae-de-santo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-mambo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-olofista"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-olorisha"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-olu-iroko"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-omo-orisha"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-osugbo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-other"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-pai-de-santo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-tata-nkisi"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#title-yaya-nkisi"/>
    <skos:prefLabel xml:lang="en">Religious Office Titles</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Títulos de autoridad religiosa</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#lineageParent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">lineage parent</rdfs:label>
    <rdfs:comment xml:lang="en">The house from which this house descends through initiation. Equivalent to godparent-house in common practice.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-abakua-potencia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An Abakuá lodge (potencia). Abakuá is a Cuban secret society of Calabari/Cross River origin.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Abakuá Potencia</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Potencia Abakuá</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#schismDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">schism date</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SchismEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#lineageChild">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">lineage child</rdfs:label>
    <rdfs:comment xml:lang="en">A house that descends from this house through initiation. Inverse of iroko:lineageParent.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <owl:inverseOf rdf:resource="https://ontology.irokosociety.org/iroko#lineageParent"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#publicPresence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">public presence</rdfs:label>
    <rdfs:comment xml:lang="en">True if the house maintains a publicly known identity (website, social media, public events). False does not imply the house is secret — many houses simply operate privately.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-ile-ifa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">House organized primarily around Ifá divination practice and Babaláwo lineage.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Ilé Ifá</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmission-embodied">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Knowledge transmitted through physical ceremony, practice, and direct experiential transmission. Cannot be fully conveyed through text.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TransmissionTypeScheme"/>
    <skos:prefLabel xml:lang="en">Embodied</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmission-written">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Transmitted through notebooks, libreta, manuscripts, or printed texts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TransmissionTypeScheme"/>
    <skos:prefLabel xml:lang="en">Written</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-espiritismo-centre">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Centre for Kardecist or Afro-influenced Espiritismo practice.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Espiritismo Centre</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Centro de Espiritismo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#foundingHouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">founding house</rdfs:label>
    <rdfs:comment xml:lang="en">The house from which this lineage (rama/branch) originates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Lineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#schismParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schism party</rdfs:label>
    <rdfs:comment xml:lang="en">Persons involved in the schism. Range: foaf:Person. Sensitive.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SchismEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#grantedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">granted by</rdfs:label>
    <rdfs:comment xml:lang="en">The authority figure who conferred this title. Range: iroko:ReligiousOffice.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ReligiousOffice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Religious Office</rdfs:label>
    <rdfs:comment xml:lang="en">A religious title or position held by a practitioner, authorizing specific ritual functions within a tradition. Linked to the person (foaf:Person), the house, and the authority figure who conferred it. Distinct from iroko:ContestedAuthority in core, which models disputed titles at the category level — iroko:ReligiousOffice models specific individual instances.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">house type</rdfs:label>
    <rdfs:comment xml:lang="en">Institutional form of the house. Range: iroko:HouseTypeScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#HouseTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">House Types</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-abakua-potencia"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-cabildo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-egbe"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-espiritismo-centre"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-hounfo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-ile-ifa"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-ile-orisha"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-other"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-palero-house"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-sosyete"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-study-group"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#houseType-terreiro"/>
    <skos:prefLabel xml:lang="en">House Types</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Tipos de casa religiosa</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Types de maison religieuse</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Tipos de casa religiosa</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àwọn iru ilé ẹ̀sìn</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-olofin">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Reception of the Olofin mysteries. Among the highest grades in Lucumí practice.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Olofin Initiation</skos:prefLabel>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-omo-orisha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Initiated child of an orisha. General term for those who have completed kariosha/asiento.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Omo Orisha</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Omo Orisha</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko-ile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-21</dcterms:created>
    <dcterms:creator>Iroko Historical Society</dcterms:creator>
    <dcterms:description xml:lang="en">Domain module. Vocabulary for documenting Afro-Atlantic religious houses, lineage structures, initiation genealogy, authority transmission, and schism events. Extends schema:Organization and FOAF with tradition-specific governance and lineage modeling. Covers ilé, terreiro, hounfò, cabildo, and analogous institutions. Use with iroko-authority to model the authority titles and governance structures held by specific individuals; iroko-epistemic to constrain disclosure of initiation details and membership records.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-25</dcterms:modified>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-epistemic"/>
    <dcterms:title xml:lang="en">Iroko Framework: Ilé Module (Lineage, Houses, and Religious Office)</dcterms:title>
    <rdfs:seeAlso rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <owl:imports rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <owl:versionIRI rdf:resource="https://ontology.irokosociety.org/iroko-ile/1.3.0"/>
    <owl:versionInfo>1.3.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmission-oral">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Transmitted through speech, song, proverb, and oral recitation.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TransmissionTypeScheme"/>
    <skos:prefLabel xml:lang="en">Oral</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-mae-de-santo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Female head of a Brazilian terreiro.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Mãe de Santo</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Mãe de Santo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiatedPerson">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">initiated person</rdfs:label>
    <rdfs:comment xml:lang="en">The person who received initiation. Range: foaf:Person. Highly sensitive — access no-access by default except to the individual and their house.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#InitiationEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-no-access"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#governance-age-grade">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Authority structured by seniority within initiation grade rather than individual title.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#GovernanceModelScheme"/>
    <skos:prefLabel xml:lang="en">Age-Grade</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#traditionPracticed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">tradition practiced</rdfs:label>
    <rdfs:comment xml:lang="en">Tradition(s) practiced in this house. Range: iroko:TraditionScheme in core.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#hasLineage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has lineage</rdfs:label>
    <rdfs:comment xml:lang="en">Links a house to a formal Lineage record documenting its rama characteristics.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#Lineage"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-pai-de-santo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Male head of a Brazilian terreiro.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Pai de Santo</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Pai de Santo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityHolder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">authority holder</rdfs:label>
    <rdfs:comment xml:lang="en">The person holding this title. Range: foaf:Person.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#eventHouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">event house</rdfs:label>
    <rdfs:comment xml:lang="en">The house in which the initiation took place.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#InitiationEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-egbe">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Initiation into an Egbé society or association.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Egbé Initiation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Inisiación de Egbé</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-olu-iroko">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Consecration to the Iroko tree spirit. Rare; received through specific lineage authorization.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Olu-Iroko</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Olu-Iròkò</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-egbe">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Association or society organized around a specific orisha or shared ritual purpose.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Egbé</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Egbé</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-ifa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Itefa</skos:altLabel>
    <skos:definition xml:lang="en">Full initiation into the Ifá corpus, conferring the title of Babaláwo.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Ifá Initiation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#governance-hereditary">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Leadership passes through biological or ritual family succession.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#GovernanceModelScheme"/>
    <skos:prefLabel xml:lang="en">Hereditary</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#governance-democratic">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Decisions made by member consensus or elected leadership.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#GovernanceModelScheme"/>
    <skos:prefLabel xml:lang="en">Democratic / Consensus</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#schismChildHouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schism child house</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SchismEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#founder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">founder</rdfs:label>
    <rdfs:comment xml:lang="en">The founding practitioner of the house. Range: foaf:Person.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/founder"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-babalawo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Initiated Ifá priest. Authorized to perform Ifá divination and related ceremonies.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Babaláwo</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Babaláwo</skos:prefLabel>
    <iroko:tradition rdf:resource="https://ontology.irokosociety.org/iroko#tradition-lucumi"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-kariosha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Making Ocha</skos:altLabel>
    <skos:altLabel xml:lang="es">Asiento</skos:altLabel>
    <skos:definition xml:lang="en">Full head initiation in Lucumí/Candomblé Ketu. An orisha is seated on the initiate's head.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Kariosha</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">initiation type</rdfs:label>
    <rdfs:comment xml:lang="en">Type of initiation ceremony. Range: iroko:InitiationTypeScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#InitiationEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-alagba">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Senior elder in a Yoruba-derived tradition, often with lineage-wide ceremonial authority.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Alagba</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Alagba</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-terreiro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Brazilian ritual space for Candomblé, Umbanda, or Quimbanda practice.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Terreiro</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Terreiro</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-araba">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Chief Babaláwo in a Yoruba community or lineage. Highest recognized Ifá authority.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Araba</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Araba</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#governance-gender-divided">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Male and female authorities govern separate domains within the same institution.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#GovernanceModelScheme"/>
    <skos:prefLabel xml:lang="en">Gender-Divided Authority</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#schismCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">schism cause</rdfs:label>
    <rdfs:comment xml:lang="en">Documented reason for the lineage split. Often contested; use iroko:contestedNotes alongside.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SchismEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#multiTradition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">multi-tradition</rdfs:label>
    <rdfs:comment xml:lang="en">True if the house actively practices more than one distinct tradition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#governance-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#GovernanceModelScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#conferralDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">conferral date</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-rayisman">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Haitian Vodou ceremony of recognition and elevation within a sosyete.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Rayisman</skos:prefLabel>
    <skos:prefLabel xml:lang="ht">Rayisman</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmissionMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">transmission method</rdfs:label>
    <rdfs:comment xml:lang="en">How the authority or knowledge was transmitted. Range: iroko:TransmissionTypeScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#InitiationEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-ile-orisha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Lucumí/Candomblé Ketu house organized around Orisha worship.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Ilé Orisha</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Ilé Orisha</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Lineage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lineage</rdfs:label>
    <rdfs:comment xml:lang="en">A rama, branch, or transmission line descending from a founding house or practitioner. Represents what makes a specific lineage distinct from others within the same tradition: liturgical variations, oriki, priestly protocols, or founding relationships.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SchismEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Schism Event</rdfs:label>
    <rdfs:comment xml:lang="en">A documented lineage split creating a new house from an existing one. Records the parent house, child house, date, cause, and parties involved. Often sensitive; access level is typically community-restricted or initiated-only.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#GovernanceModelScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Governance Models</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#governance-age-grade"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#governance-democratic"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#governance-elder-council"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#governance-gender-divided"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#governance-hereditary"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#governance-lineage-federation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#governance-other"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#governance-single-elder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-houngan">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Male Haitian Vodou priest.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Houngan</skos:prefLabel>
    <skos:prefLabel xml:lang="ht">Oungan</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#governance-single-elder">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One recognized head (Iyalosha, Babalosha, Mambo, etc.) with primary authority.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#GovernanceModelScheme"/>
    <skos:prefLabel xml:lang="en">Single Elder Authority</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-abakua-member">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Initiated member of an Abakuá potencia.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Abakuá Member</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Abakuá</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#InitiationEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Initiation Event</rdfs:label>
    <rdfs:comment xml:lang="en">A specific ceremony creating a formal genealogical link between initiator and initiate. The primary mechanism by which lineage is transmitted and authority is conferred. Access to records is typically initiated-only; existence of the event may be public.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityHouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">authority house</rdfs:label>
    <rdfs:comment xml:lang="en">The house within which this authority is recognized.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#lineageTradition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">lineage tradition</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Lineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#governance-elder-council">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Collective of recognized elders sharing governance authority.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#GovernanceModelScheme"/>
    <skos:prefLabel xml:lang="en">Elder Council</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-sosyete">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Haitian Vodou society, often with named lineage and territorial identity.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Sosyete</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Sosyete</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-babalosha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Babalorishaisha</skos:altLabel>
    <skos:altLabel xml:lang="es">Padrino</skos:altLabel>
    <skos:definition xml:lang="en">Senior male Orisha priest with the authority to initiate others.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Babalosha</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-tata-nkisi">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Male initiated priest in Palo Monte with authority over an nganga.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Tata Nkisi</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Tata Nkisi</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-warriors">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="es">Los Guerreros</skos:altLabel>
    <skos:definition xml:lang="en">Reception of the warrior orishas: Elegua, Ogun, Ochosi, and Osun.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Warriors</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#location">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">location</rdfs:label>
    <rdfs:comment xml:lang="en">Geographic location of the house. May be city/country only for active houses; full address behind access control.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/location"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-kanzo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Haitian Vodou initiation ceremony. Levels include Sur Pwen, Hounsi Kanzo, Si Pwen, and Asogwe.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Kanzo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#affiliatedHouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">affiliated house</rdfs:label>
    <rdfs:comment xml:lang="en">A house with recognized but non-hierarchical affiliation: alliance, shared lineage recognition, or ongoing ceremonial cooperation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#House">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">House</rdfs:label>
    <rdfs:comment xml:lang="en">A religious house, temple, or community organized around a lineage and founding elder. Encompasses ilé (Lucumí/Candomblé), terreiro (Candomblé/Umbanda), hounfò (Vodou), ile orisha, and analogous institutions. Subclass of schema:Organization for interoperability with external directories.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-necklaces">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Elekes</skos:altLabel>
    <skos:altLabel xml:lang="es">Collares</skos:altLabel>
    <skos:definition xml:lang="en">Reception of the five sacred beaded necklaces. Often the first formal initiation in Lucumí.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Necklaces</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityTradition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">authority tradition</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-olorisha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Initiated Orisha priest of any gender. General term covering Iyalosha and Babalosha.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Olorisha</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">authority title</rdfs:label>
    <rdfs:comment xml:lang="en">The formal title held. Range: iroko:AuthorityTitleScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ReligiousOffice"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseGovernanceModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">house governance model</rdfs:label>
    <rdfs:comment xml:lang="en">How authority and decision-making are structured within the house. Range: iroko:GovernanceModelScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-mambo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Female Haitian Vodou priest.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Mambo</skos:prefLabel>
    <skos:prefLabel xml:lang="ht">Manbo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#successorHouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">successor house</rdfs:label>
    <rdfs:comment xml:lang="en">For historical cabildos: the contemporary house that descends from or claims continuity with this institution.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Cabildo"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ile"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#title-osugbo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="yo">Ogboni</skos:altLabel>
    <skos:definition xml:lang="en">Member of the Osugbo/Ogboni earth society, holding judicial and spiritual authority.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTitleScheme"/>
    <skos:prefLabel xml:lang="en">Osugbo Member</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#initiation-mano-orula">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Awofakan / Ikofa</skos:altLabel>
    <skos:definition xml:lang="en">Reception of Orula's hand. First level of Ifá initiation, open to non-Babaláwo.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InitiationTypeScheme"/>
    <skos:prefLabel xml:lang="es">Mano de Orula</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseType-palero-house">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">House organized around Palo Monte/Mayombe practice and nganga custody.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#HouseTypeScheme"/>
    <skos:prefLabel xml:lang="en">Palo House</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Casa de Palo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#governance-lineage-federation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Federated structure of affiliated houses under loose shared authority.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#GovernanceModelScheme"/>
    <skos:prefLabel xml:lang="en">Lineage Federation</skos:prefLabel>
  </rdf:Description>
</rdf:RDF>
