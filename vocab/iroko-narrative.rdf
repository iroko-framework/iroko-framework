<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:iroko="https://ontology.irokosociety.org/iroko#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#generatesKinship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">generates kinship</rdfs:label>
    <rdfs:comment xml:lang="en">Links an InitiationEvent to the KinshipClaim it creates. Covers initiation-based human kinship bonds: godfather/godson (padrino/ahijado), initiator/initiate, elder/junior lineage member. Unlike assertsKinship, this bond is generated by a documented event of record rather than narrated — the initiation created the bond. Access: initiated-only — initiation genealogy and godparent lineage are internal community records not appropriate for public or community-tier disclosure.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#InitiationEvent"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#KinshipClaim"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#StoryLineage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Story Lineage</rdfs:label>
    <rdfs:comment xml:lang="en">A transmission chain for a narrative — who transmitted the story to whom, in what context. Separate from biological kinship. Models oral transmission provenance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmissionTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">transmission to</rdfs:label>
    <rdfs:comment xml:lang="en">The agent who received this story.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#StoryLineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SegmentTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Segment Types</rdfs:label>
    <dcterms:description xml:lang="en">Types of addressable narrative segments.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#segType-chant-line"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#segType-episode"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#segType-gloss"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#segType-praise-name"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#segType-prayer"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#segType-prohibition"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#segType-rubric"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#segType-verse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#variantCreatedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">variant created on</rdfs:label>
    <rdfs:comment xml:lang="en">Date on which this narrative variant was recorded, transcribed, or published.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#varRel-lineage-bound">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A variant that applies only within a specific lineage — not a deviation, but a legitimate lineage-specific telling.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#VariantRelationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Lineage-Bound</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#kinship-ancestor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#KinshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">ancestor</skos:prefLabel>
    <skos:prefLabel xml:lang="es">ancestro</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko-narrative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:creator>Iroko Historical Society</dcterms:creator>
    <dcterms:description xml:lang="en">Governance Layer module. Full narrative modeling for Afro-Atlantic sacred knowledge systems. Covers story transmission chains, contested kinship claims, testimonies, fieldnotes, interpretive stances, and narrative variant relationships. Builds on the thin narrative spine in iroko-core v1.3.0. Researcher voice (Fieldnote) is kept structurally distinct from community voice (Testimony). Use with iroko-authority to govern who may assert transmission claims, iroko-agency to link sacred agents to narrative appearances, and iroko-epistemic to constrain access to sensitive narrative content.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-23</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-25</dcterms:modified>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-agency"/>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-epistemic"/>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <dcterms:requires rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <dcterms:title xml:lang="en">Iroko Framework: Narrative Module</dcterms:title>
    <rdfs:seeAlso rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <owl:versionIRI rdf:resource="https://ontology.irokosociety.org/iroko-narrative/1.3.0"/>
    <owl:versionInfo>1.3.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#segType-verse">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SegmentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Verse</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#aboutEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">about entity</rdfs:label>
    <rdfs:comment xml:lang="en">Links a narrative or variant to entities it concerns — a spirit, plant, place, ritual, person, or any other resource. Range: iroko:SacredEntity — the top-level class for all tradition-specific concepts in the framework.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmissionNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">transmission note</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text note on context, mode, or conditions of transmission.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#StoryLineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#segType-gloss">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">An explanatory note or translation embedded within the narrative.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SegmentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Gloss</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#varRel-harmonized">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A variant produced by reconciling two or more divergent tellings.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#VariantRelationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Harmonized</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#segType-praise-name">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="yo">Oriki</skos:altLabel>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SegmentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Praise Name</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#varRel-translation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A variant that is a translation into another language, which may introduce interpretive differences.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#VariantRelationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Translation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#kinship-father">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#KinshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">father</skos:prefLabel>
    <skos:prefLabel xml:lang="es">padre</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#stance-polemic">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStance"/>
    <skos:definition xml:lang="en">Narrative produced or shaped by an argument about tradition, authority, or lineage legitimacy.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStanceScheme"/>
    <skos:prefLabel xml:lang="en">Polemic</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-researcher">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Ethnographer, archivist, or scholar whose authorship must be distinguished from community voice.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">Researcher</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#kinship-brother">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#KinshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">brother</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hermano</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#relatedAs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">related as</rdfs:label>
    <rdfs:comment xml:lang="en">The type of kinship or relational bond asserted. Range: concepts from iroko:KinshipTypeScheme or tradition-specific kinship schemes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#KinshipClaim"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#varRel-close">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Two variants sharing the same core content with minor differences.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#VariantRelationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Close Variant</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#varRel-derived">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One variant clearly derives from or expands upon the other.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#VariantRelationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Derived</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#kinship-owner">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Describes the relationship between an orisha or lwa and the practitioner over whom they have primary claim.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#KinshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">owner/patron</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Fieldnote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fieldnote</rdfs:label>
    <rdfs:comment xml:lang="en">Researcher-authored note, observation, or analytic memo. Treated as a NarrativeVariant with explicit authorship and interpretive stance to keep researcher voice distinct from community voice.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#featuresSacredAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">features sacred agent</rdfs:label>
    <rdfs:comment xml:lang="en">Links a narrative or variant to a sacred agent (spirit, ancestor) who appears as an actor within the narrative content.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SacredAgent"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-narrator">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Primary teller or transmitter of the narrative.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">Narrator</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmissionDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">transmission date</rdfs:label>
    <rdfs:comment xml:lang="en">Date or date range of this transmission event.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#StoryLineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#kinship-road">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="es">camino</skos:altLabel>
    <skos:definition xml:lang="en">Describes a relationship between aspects of a spirit or between a spirit and a tradition-specific manifestation.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#KinshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">road/camino</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#variantPlace">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">variant place</rdfs:label>
    <rdfs:comment xml:lang="en">Place where the telling occurred or was recorded.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#narrativeLanguage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">narrative language</rdfs:label>
    <rdfs:comment xml:lang="en">BCP 47 language tag of the language in which the variant is expressed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#claimSubject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">claim subject</rdfs:label>
    <rdfs:comment xml:lang="en">The entity about whom the kinship claim is made.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#KinshipClaim"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#narratedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">narrated by</rdfs:label>
    <rdfs:comment xml:lang="en">The person or agent who narrated this variant. Range: foaf:Person or prov:Agent. For sovereignty-aligned archives: consider access governance on the identity of narrators.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#KinshipTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Kinship Types</rdfs:label>
    <dcterms:description xml:lang="en">Relational categories for kinship and lineage claims, particularly in sacred genealogies and spirit family assertions.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#kinship-ancestor"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#kinship-brother"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#kinship-child"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#kinship-father"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#kinship-mother"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#kinship-owner"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#kinship-road"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#kinship-sister"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#hasStoryLineage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has story lineage</rdfs:label>
    <rdfs:comment xml:lang="en">Links a Narrative or NarrativeVariant to a StoryLineage node documenting its transmission chain.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#StoryLineage"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertsKinship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">asserts kinship</rdfs:label>
    <rdfs:comment xml:lang="en">Links a NarrativeVariant to a KinshipClaim it asserts. Used for spirit kinship — spirit-father, spirit-sibling, ancestral claims — where the bond is narrated or testified rather than generated by a documented event. The claim may be contested across lineages or traditions; iroko:KinshipClaim is a subclass of iroko:Assertion and inherits its contested-knowledge modeling. Access: community-only.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#KinshipClaim"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmissionFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">transmission from</rdfs:label>
    <rdfs:comment xml:lang="en">The agent who transmitted this story to the next link in the chain.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#StoryLineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#varRel-contested">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Two variants that contradict each other on a key claim.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#VariantRelationTypeScheme"/>
    <skos:prefLabel xml:lang="en">Contested</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#segType-rubric">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A heading, liturgical direction, or structural marker in the narrative.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SegmentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Rubric</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#segType-prohibition">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A stated prohibition or interdiction within the narrative.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SegmentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Prohibition</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#narrativeText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">narrative text</rdfs:label>
    <rdfs:comment xml:lang="en">The text of this narrative variant. Language-tagged. Access governed by iroko:accessLevel on the variant instance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#kinship-mother">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#KinshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">mother</skos:prefLabel>
    <skos:prefLabel xml:lang="es">madre</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#supportsAssertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">supports assertion</rdfs:label>
    <rdfs:comment xml:lang="en">Links a NarrativeVariant to iroko:Assertion nodes it supports or motivates. The narrative is the evidentiary basis for the assertion.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#claimObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">claim object</rdfs:label>
    <rdfs:comment xml:lang="en">The entity to whom the subject is related by this claim.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#KinshipClaim"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#InterpretiveStanceScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Interpretive Stances</rdfs:label>
    <dcterms:description xml:lang="en">Hermeneutic approaches to reading or transmitting a narrative.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#stance-allegorical"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#stance-analytic"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#stance-diagnostic"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#stance-initiatory"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#stance-literal"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#stance-polemic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#segType-episode">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SegmentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Episode</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#stance-allegorical">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStance"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStanceScheme"/>
    <skos:prefLabel xml:lang="en">Allegorical</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#KinshipClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kinship Claim</rdfs:label>
    <rdfs:comment xml:lang="en">A claim about relationships between entities (spirit-father, spirit-sibling, ancestor, etc.) that may be contested and authority-scoped. Implemented as an iroko:Assertion subtype so it inherits full assertion governance: authorizedBy, accessLevel, contestedStatus, assertionStatus.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#segType-chant-line">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SegmentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Chant Line</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Testimony">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Testimony</rdfs:label>
    <rdfs:comment xml:lang="en">A narrated account offered by a participant or witness. A Testimony is a NarrativeVariant with an identified speaker whose presence or role is itself the epistemic claim — the content derives its authority from the speaker's position.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#variantAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">variant authority</rdfs:label>
    <rdfs:comment xml:lang="en">The Authority context recognized for this variant. Which lineage or house endorses this telling as authoritative.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#RitualAuthority"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#variantRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">variant relation</rdfs:label>
    <rdfs:comment xml:lang="en">Typed relationship between two NarrativeVariants. Range: iroko:VariantRelationTypeScheme concepts.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#kinship-sister">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#KinshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">sister</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hermana</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#VariantRelationTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Variant Relation Types</rdfs:label>
    <dcterms:description xml:lang="en">Classification of the relationship between two narrative variants.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#varRel-close"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#varRel-contested"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#varRel-derived"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#varRel-harmonized"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#varRel-lineage-bound"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#varRel-translation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-chorus">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Collective voice responding to or accompanying the narrator.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">Chorus</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#kinship-child">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#KinshipTypeScheme"/>
    <skos:prefLabel xml:lang="en">child</skos:prefLabel>
    <skos:prefLabel xml:lang="es">hijo/hija</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-community">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Collective community voice or assembled participants.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">Community</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#stance-initiatory">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStance"/>
    <skos:definition xml:lang="en">Reading reserved for or shaped by initiatory context.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStanceScheme"/>
    <skos:prefLabel xml:lang="en">Initiatory</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-officiant">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Ritual officiant whose role shapes the telling.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">Officiant</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#variantEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">variant event</rdfs:label>
    <rdfs:comment xml:lang="en">The FieldworkEvent or ritual event that captured or generated this narrative variant.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#FieldworkEvent"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#stance-diagnostic">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStance"/>
    <skos:definition xml:lang="en">Reading the narrative as a diagnostic tool — for divination, consultation, or situational assessment.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStanceScheme"/>
    <skos:prefLabel xml:lang="en">Diagnostic</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#narrativeRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">narrative role</rdfs:label>
    <rdfs:comment xml:lang="en">The role played by a participant in a narrative event — narrator, elder, witness, chorus, officiant, etc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#variantRelationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">variant relation type</rdfs:label>
    <rdfs:comment xml:lang="en">Classifies the nature of a variant relationship — close variant, contested, derived, harmonized, lineage-bound.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#InterpretiveStance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Interpretive Stance</rdfs:label>
    <rdfs:comment xml:lang="en">A hermeneutic or epistemological approach to reading a narrative or variant. Tags the reading frame rather than the content.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#segType-prayer">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SegmentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Prayer</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#stance-literal">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStance"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStanceScheme"/>
    <skos:prefLabel xml:lang="en">Literal</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#NarrativeRoleScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Narrative Roles</rdfs:label>
    <dcterms:description xml:lang="en">Roles of participants in narrative events.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#role-chorus"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#role-community"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#role-narrator"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#role-officiant"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#role-researcher"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#interpretiveStance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">interpretive stance</rdfs:label>
    <rdfs:comment xml:lang="en">Tags a NarrativeVariant or Commentary with an interpretive hermeneutic frame.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStance"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#stance-analytic">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStance"/>
    <skos:definition xml:lang="en">Researcher or scholarly reading, necessarily outside community interpretive authority.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InterpretiveStanceScheme"/>
    <skos:prefLabel xml:lang="en">Analytic</skos:prefLabel>
  </rdf:Description>
</rdf:RDF>
