<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:iroko="https://ontology.irokosociety.org/iroko#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ManifestationMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Manifestation Mode</rdfs:label>
    <rdfs:comment xml:lang="en">A SKOS concept describing how a sacred agent is asserted to manifest. Modes include embodied, possession, dream, divination, symbolic, territorial, auditory, and unknown. These categories are descriptive and tradition-reported; they record what a community asserts, not what an archive adjudicates. A single ManifestationEvent may reference multiple modes. Modes may vary by temporal regime — use iroko:TemporalVariation to document seasonal or initiatory shifts.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#support-papyrus">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Papyrus</skos:prefLabel>
    <skos:definition xml:lang="en">Writing surface made from papyrus plant stems. Primary medium for ancient Egyptian and early Christian Egyptian documentation.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Medium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Medium</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <rdfs:comment xml:lang="en">A medium through which manifestation is asserted to occur — a person, object, place, text, or instrument. A Medium is the vehicle, not the agent; the sacred agent is modeled in iroko-nkisi or iroko-agency. One ManifestationEvent may involve multiple media.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#support-stone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Stone</skos:prefLabel>
    <skos:definition xml:lang="en">Stone inscriptions, stelae, and rock surfaces used for monumental or votive texts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mode-auditory">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationMode"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">Manifestation asserted to occur through sound, voice, drumming, or hearing — including traditions where specific rhythms summon or identify a spirit.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationModeScheme"/>
    <skos:prefLabel xml:lang="en">Auditory</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mode-unknown">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationMode"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">Manifestation mode not recorded or not known.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationModeScheme"/>
    <skos:prefLabel xml:lang="en">Unknown</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mode-territorial">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationMode"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">Manifestation asserted to be bound to or expressed through a place, crossroads, body of water, forest, or territory.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationModeScheme"/>
    <skos:prefLabel xml:lang="en">Territorial</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#support-ostracon">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Ostracon</skos:prefLabel>
    <skos:definition xml:lang="en">A pottery sherd or stone flake used as an informal writing surface for short texts, school exercises, receipts, or personal notes. Common in Nubian and Egyptian archaeological contexts; many DBMNT texts are ostraca.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#support-clay">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Clay</skos:prefLabel>
    <skos:definition xml:lang="en">Fired or unfired clay tablets bearing inscribed or impressed text.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#support-wood">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Wood</skos:prefLabel>
    <skos:definition xml:lang="en">Wooden boards, tablets, or surfaces used for writing or carving.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#support-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
    <skos:definition xml:lang="en">Physical support type not covered by existing concepts. Use skos:scopeNote on the instance to describe the specific material.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mode-embodied">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationMode"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">Manifestation asserted to occur in a physically embodied form distinct from possession — the agent is present as a body, not occupying another's.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationModeScheme"/>
    <skos:prefLabel xml:lang="en">Embodied</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#support-metal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Metal</skos:prefLabel>
    <skos:definition xml:lang="en">Metal tablets, plaques, or coins bearing inscribed text.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#medium-object">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#MediumType"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">A material object serves as the medium — a consecrated vessel, nganga, otán, or ritual artifact.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediumTypeScheme"/>
    <skos:prefLabel xml:lang="en">Object</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#carriedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">carried by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a TextContent to a ManuscriptObject that carries it. One TextContent may appear in multiple ManuscriptObjects. Inverse of iroko:carriersText.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TextContent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#ManuscriptObject"/>
    <owl:inverseOf rdf:resource="https://ontology.irokosociety.org/iroko#carriersText"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#manifestsThroughMedium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">manifests through medium</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a ManifestationEvent with a Medium through which manifestation is asserted to occur. The identity of the medium (e.g., a specific person) may carry its own access level if the medium is a community member.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#Medium"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#support-textile">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Textile</skos:prefLabel>
    <skos:definition xml:lang="en">Cloth, leather, or textile-based writing or inscription surface.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#MediumType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Medium Type</rdfs:label>
    <rdfs:comment xml:lang="en">A SKOS concept categorizing the kind of medium involved in a manifestation assertion: person, object, place, text, instrument, or unknown.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ManuscriptObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Manuscript Object</rdfs:label>
    <rdfs:comment xml:lang="en">A physical manuscript or archival object — codex, scroll, single leaf, inscribed stone, ostracon, stela, or similar carrier. Models the physical vehicle as distinct from the intellectual content it carries. Structurally equivalent to the Object level in the vHMML three-tier hierarchy (Object / Part / Contents). A ManuscriptObject may carry one or more iroko:TextContent instances. The physical and intellectual levels are modeled separately so that a single text can be located across multiple physical carriers, and a single object can carry multiple texts. Subclass of iroko:DocumentaryEvidence, which is itself a subclass of iroko:SacredEntity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#DocumentaryEvidence"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#medium-person">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#MediumType"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">A human person serves as the medium, as in possession or mounted manifestation.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediumTypeScheme"/>
    <skos:prefLabel xml:lang="en">Person</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ManifestationModeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Manifestation Modes</rdfs:label>
    <dcterms:description xml:lang="en">Controlled terms for how sacred agents are asserted to manifest. Tradition-reported descriptive categories. Multiple modes may apply to a single event.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mode-auditory"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mode-divination"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mode-dream"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mode-embodied"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mode-possession"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mode-symbolic"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mode-territorial"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mode-unknown"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mode-dream">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationMode"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">Manifestation asserted to occur through dreams, dream visitation, or hypnagogic contact.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationModeScheme"/>
    <skos:prefLabel xml:lang="en">Dream</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko-manifestation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Iroko Framework: Manifestation Module (Sacred Agent Manifestation Modes &amp; Media)</rdfs:label>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-22</dcterms:created>
    <dcterms:creator>Iroko Historical Society</dcterms:creator>
    <dcterms:description xml:lang="en">Governance Layer module. Vocabulary for modeling how sacred agents are asserted to manifest — through embodied presence, possession, dream, divination, symbolic representation, territorial claim, or auditory sign. Plugs into iroko:ManifestationEvent and supports iroko:TemporalVariation where manifestation modes shift by ritual calendar or initiation cycle. These are descriptive, not metaphysical — they record what a tradition asserts, not what is metaphysically true.</dcterms:description>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-16</dcterms:modified>
    <owl:versionInfo>1.3.1</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://ontology.irokosociety.org/iroko-manifestation/1.3.1"/>
    <owl:priorVersion rdf:resource="https://ontology.irokosociety.org/iroko-manifestation/1.3.0"/>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:isPartOf rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <dcterms:requires rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-agency"/>
    <rdfs:seeAlso rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Physical Support Types</rdfs:label>
    <dcterms:description xml:lang="en">Controlled terms for manuscript and archival object physical substrates. Derived from vHMML support vocabulary (CC BY 4.0) and extended for Iroko Framework use.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#support-parchment"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#support-paper"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#support-papyrus"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#support-stone"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#support-ostracon"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#support-textile"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#support-metal"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#support-wood"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#support-clay"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#support-other"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#textScript">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">text script</rdfs:label>
    <rdfs:comment xml:lang="en">The script or writing system of the text content. Examples: Latin, Arabic, Ge'ez (Ethiopic), Greek, Old Nubian (Coptic-based), Hebrew, Syriac. Use ISO 15924 four-letter script codes where available. Multiple scripts may be present in a single text; record all.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TextContent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#TextContent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Text Content</rdfs:label>
    <rdfs:comment xml:lang="en">An abstract intellectual work — a text as a specific composition, title, or discrete textual unit — independent of its physical carrier. Equivalent to the FRBR Work level and to the Contents level in the vHMML three-tier hierarchy. Distinct from iroko:ManuscriptObject (the physical carrier) and from iroko:NarrativeVariant (a specific transcribed or performed telling). A single iroko:TextContent may be carried by multiple ManuscriptObjects across different repositories or copies. Properties cover language, script, genre, and uniform title. Subclass of iroko:SacredEntity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mode-possession">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationMode"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">Manifestation asserted to occur through mounting or possession of a medium person. The agent speaks and acts through the medium during the event.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationModeScheme"/>
    <skos:prefLabel xml:lang="en">Possession</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Distinguish from embodied: possession involves a medium person who is temporarily occupied; embodied involves a distinct physical presence.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#medium-place">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#MediumType"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">A place, site, crossroads, or territory serves as the medium.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediumTypeScheme"/>
    <skos:prefLabel xml:lang="en">Place</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mode-divination">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationMode"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">Manifestation asserted to occur through divination, oracle, or the interpretive reading of divinatory instruments.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationModeScheme"/>
    <skos:prefLabel xml:lang="en">Divination</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#medium-unknown">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#MediumType"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">Medium type not recorded or not known.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediumTypeScheme"/>
    <skos:prefLabel xml:lang="en">Unknown</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#medium-text">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#MediumType"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">A text, inscription, vèvè, firma, or graphic document serves as the medium.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediumTypeScheme"/>
    <skos:prefLabel xml:lang="en">Text</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#medium-instrument">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#MediumType"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">A musical, divinatory, or ritual instrument serves as the medium — a consecrated bàtá drum, divining chain, or bell.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediumTypeScheme"/>
    <skos:prefLabel xml:lang="en">Instrument</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#textLanguage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">text language</rdfs:label>
    <rdfs:comment xml:lang="en">The language or languages of the text content. Express as a BCP 47 language tag where a standard code exists (e.g., 'ar' for Arabic, 'gez' for Ge'ez). For languages without standard BCP 47 codes, use a descriptive string: 'Old Nubian', 'Coptic', 'Middle Nubian'. Multiple values permitted for polyglot texts or texts in more than one language. Do not conflate language and script — record both separately.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TextContent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#MediumTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Medium Types</rdfs:label>
    <dcterms:description xml:lang="en">Controlled terms for the kind of medium through which manifestation is asserted to occur.</dcterms:description>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#medium-instrument"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#medium-object"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#medium-person"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#medium-place"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#medium-text"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#medium-unknown"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#hasMediumType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has medium type</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a Medium with a MediumType concept from iroko:MediumTypeScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Medium"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#MediumType"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#carriersText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">carries text</rdfs:label>
    <rdfs:comment xml:lang="en">Links a ManuscriptObject to an iroko:TextContent it physically carries. One ManuscriptObject may carry multiple TextContent instances — a codex may contain several distinct works. Inverse of iroko:carriedBy.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ManuscriptObject"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#TextContent"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#uniformTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">uniform title</rdfs:label>
    <rdfs:comment xml:lang="en">The standardized title for this intellectual work, independent of how the title may appear on any specific manuscript or in any particular catalog. Use the form established by the relevant authority file: LCNAF, HAF (HMML Authority File), DBMNT, or community convention. Language-tagged. A single work may have multiple uniform title assertions in different languages or from different authority sources.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TextContent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#support-parchment">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Parchment</skos:prefLabel>
    <skos:definition xml:lang="en">Animal skin prepared as a writing surface. Used extensively in Ethiopian, Nubian, and European medieval manuscript traditions.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#support-paper">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Paper</skos:prefLabel>
    <skos:definition xml:lang="en">Paper writing surface, including both handmade and machine-made paper.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#PhysicalSupportScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#hasManifestationMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has manifestation mode</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a ManifestationEvent or assertion node with a ManifestationMode concept from iroko:ManifestationModeScheme. Multiple modes may be asserted for a single event.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationMode"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mode-symbolic">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationMode"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <skos:definition xml:lang="en">Manifestation asserted to occur through symbols, signs, graphic marks, or indirect representation. Vèvè, firmas, and anaforuana are common vehicles.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ManifestationModeScheme"/>
    <skos:prefLabel xml:lang="en">Symbolic</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#physicalSupport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">physical support</rdfs:label>
    <rdfs:comment xml:lang="en">The material substrate of the manuscript object. Range: iroko:PhysicalSupportScheme. Covers parchment, paper, papyrus, stone, ostracon, textile, metal, wood, clay, and other carriers. Values drawn from the controlled vocabulary used by vHMML and comparable manuscript cataloging projects.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ManuscriptObject"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-manifestation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
</rdf:RDF>
