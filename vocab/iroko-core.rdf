  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#TemporalVariation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Temporal Variation</rdfs:label>
    <rdfs:comment xml:lang="en">A named temporal regime, calendar cycle, or context that conditions how a property, assertion, or policy applies. Covers: ritual calendar seasons, festival-bound periods, pre/post-initiation thresholds, gender regime cycles, and any other time-bounded condition affecting sacred knowledge governance. TemporalVariation instances are named nodes shared across modules — define once, reference everywhere. Examples: iroko:TemporalVariation/egungun-festival-period, iroko:TemporalVariation/post-kariocha-year.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
  </rdf:Description>
