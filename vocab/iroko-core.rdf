  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#hasTemporalVariation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has temporal variation</rdfs:label>
    <rdfs:comment xml:lang="en">Cross-cutting qualifier linking any resource — assertion, policy, property value, access rule, narrative — to a TemporalVariation node. Defined once in Core and referenced across all modules. Do not redefine per-module.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#TemporalVariation"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-shango-baptist">
