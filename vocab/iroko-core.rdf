<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:iroko="https://ontology.irokosociety.org/iroko#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#foundingDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">founding date</rdfs:label>
    <rdfs:comment xml:lang="en">Date or approximate date when this community, house, society, or lineage was established. Applies to ile, ekpe lodge, sankofa project, or any organizational entity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recordingDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">recording date</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#hasVariant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has variant</rdfs:label>
    <rdfs:comment xml:lang="en">Links a Narrative to one of its NarrativeVariants.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Narrative"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#NarrativeVariant"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#relationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">relation type</rdfs:label>
    <rdfs:comment xml:lang="en">The semantic type of relationship being asserted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#RelationshipAssertion"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sacredStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">sacred status</rdfs:label>
    <rdfs:comment xml:lang="en">Current ritual status of an object. Values from iroko:SacredStatusScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredSpecimen"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#consent-unknown">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ConsentStatusScheme"/>
    <skos:prefLabel xml:lang="en">Unknown</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#RitualAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ritual Authority</rdfs:label>
    <rdfs:comment xml:lang="en">A governance entity capable of authorizing assertion-level claims. May represent a lineage, cabildo, religious house, elder council, or individual office-holder. This is the minimal Core stub — full modeling of jurisdiction, basis, and recognition is in iroko-authority.ttl. Distinguished from ile:ReligiousOffice, which models the specific title instance held by an individual practitioner.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <skos:definition xml:lang="en">Catchall concept for entities not covered by existing controlled vocabulary. Use skos:scopeNote to describe the specific case.</skos:definition>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recordingContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">recording context</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mediaType-video">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediaTypeScheme"/>
    <skos:prefLabel xml:lang="en">Video Recording</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Grabación de video</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Enregistrement vidéo</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Gravação de vídeo</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àgbékalẹ̀ fídíò</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#commentaryOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">commentary on</rdfs:label>
    <rdfs:comment xml:lang="en">Links a Commentary to the resource it annotates. Range is intentionally open — commentary may attach to a Narrative, NarrativeVariant, TextSegment, Assertion, SacredEntity, or any other resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Commentary"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-santeria">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Santeria</rdfs:label>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-yoruba-derived"/>
    <skos:definition xml:lang="en">Yoruba-derived tradition with strong syncretisms with Catholicism and some folk traditions.  Can be synonymous with Lucumí.  Can also have a pejorative meaning, depending on context.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Santeria</skos:prefLabel>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mediaDuration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">duration</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mediaType-ephemera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Printed or handwritten items of transient purpose: programs, invitations, ritual schedules, advertisements for religious events.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediaTypeScheme"/>
    <skos:prefLabel xml:lang="en">Ephemera</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Efímero</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éphémère</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#contestsAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">contests authority</rdfs:label>
    <rdfs:comment xml:lang="en">Links a RitualAuthority, SacredEntity, or Assertion to a ContestedAuthority instance it generates or references. A RitualAuthority contests another when it challenges the legitimacy or historical continuity of that authority's claims. A SacredEntity may have its governing authority contested across lineages. An Assertion may formally contest an authority's basis.</rdfs:comment>
    <rdfs:domain rdf:nodeID="n86c9e8c17a6d4e97a5f1424732ef20a6b1"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#ContestedAuthority"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-palo-monte">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Palo</skos:altLabel>
    <skos:altLabel xml:lang="en">Regla de Congo</skos:altLabel>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-bantu-derived"/>
    <skos:definition xml:lang="en">Bantu-derived Kongo religious tradition in Cuba.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Palo Monte</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#variationCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">variation condition</rdfs:label>
    <rdfs:comment xml:lang="en">Text description of the condition that activates this temporal variation. Example: 'Applies during the 40-day post-kariocha seclusion period'.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TemporalVariation"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SacredStatusScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Sacred Object Status</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#sacredStatus-awaiting-consecration"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#sacredStatus-consecrated-active"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#sacredStatus-contested-consecration"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#sacredStatus-decommissioned"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#sacredStatus-hereditary-custody"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#sacredStatus-honored-rest"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#sacredStatus-museum-specimen"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#sacredStatus-replica-teaching"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#sacredStatus-unknown"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertionScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">assertion scope</rdfs:label>
    <rdfs:comment xml:lang="en">Restricts the claim to a specific camino, aspect, or manifestation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#RelationshipAssertion"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#hasSegment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has segment</rdfs:label>
    <rdfs:comment xml:lang="en">Links a Narrative or NarrativeVariant to a constituent TextSegment.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#TextSegment"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#governedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">governed by</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource or assertion to an AccessPolicy that governs it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#AccessPolicy"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#documents">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">documents</rdfs:label>
    <rdfs:comment xml:lang="en">Links archival materials to practices or events they document. Range: iroko:SacredEntity — covers ceremonies, ritual events, plants, spirits, lineages, and all other framework entities. Parallel treatment with iroko:depicts: both are documentary links from archival materials to framework entities.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#DocumentaryEvidence"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-winti">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-akan-derived"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Winti</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-trinidad-orisha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-yoruba-derived"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Trinidad Orisha</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#AccessLevelScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Access Level Classification</rdfs:label>
    <dcterms:description xml:lang="en">Six-tier classification of access restrictions for sacred knowledge.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-elder"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#access-no-access"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#access-public-no-amplification"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#documentsSpecimen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">documents specimen</rdfs:label>
    <rdfs:comment xml:lang="en">Links a DocumentaryEvidence record to a SacredSpecimen it documents. A photograph, manuscript, or archival record may document one or more sacred objects. The existence of documentation is public-unrestricted; the ritual details of the object are governed by iroko:sacredStatus on the SacredSpecimen instance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#DocumentaryEvidence"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SacredSpecimen"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-lucumi">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Lucumí</rdfs:label>
    <skos:altLabel xml:lang="en">Santeria</skos:altLabel>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-yoruba-derived"/>
    <skos:definition xml:lang="en">Yoruba-derived tradition with much less syncretism with Catholicism.  Can be synonymous with Santeria.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Lucumí</skos:prefLabel>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#accessLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">access level</rdfs:label>
    <rdfs:comment xml:lang="en">Governs who may view this knowledge. Values: iroko:access-public-unrestricted through iroko:access-no-access. Applied at record level and/or field level.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-21-divisiones">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">21 Divisions</skos:altLabel>
    <skos:altLabel xml:lang="en">Dominican Vodu</skos:altLabel>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-syncretic"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">21 Divisiones</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Commentary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Commentary</rdfs:label>
    <rdfs:comment xml:lang="en">A commentary, gloss, or interpretive note attached to any resource in the framework — a narrative, an assertion, a sacred entity, a text segment. Keeps interpretive voice distinct from primary narrative content.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#custodialRelationship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">custodial relationship</rdfs:label>
    <rdfs:comment xml:lang="en">Nature of custody for sacred objects. Values from iroko:CustodialRelationshipScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredSpecimen"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recordedInEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">recorded in event</rdfs:label>
    <rdfs:comment xml:lang="en">Links an Assertion to the FieldworkEvent during which it was captured.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#FieldworkEvent"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recordingLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">recording location</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SacredEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sacred Entity</rdfs:label>
    <rdfs:comment xml:lang="en">Top-level class for any tradition-specific concept within the Iroko Framework. All module-specific classes (Plant, SpiritualEntity, RitualProcess, etc.) are subclasses of this.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#endorsement-withdrawn">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#CommunityEndorsementScheme"/>
    <skos:prefLabel xml:lang="en">Withdrawn</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorizedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">authorized by</rdfs:label>
    <rdfs:comment xml:lang="en">Links an Assertion to the RitualAuthority that authorizes it. An assertion without this property is undeclared as to authority — it may still carry other provenance (fieldwork event, epistemic type).</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#RitualAuthority"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko-core">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-17</dcterms:created>
    <dcterms:creator>Iroko Historical Society</dcterms:creator>
    <dcterms:description xml:lang="en">Cross-module infrastructure for governance and semantic integration of Afro-Atlantic sacred knowledge systems. Provides access control, provenance tracking, contested knowledge modeling, assertion governance, temporal variation, fieldwork capture, and thin narrative primitives.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-21</dcterms:modified>
    <dcterms:replaces rdf:resource="https://iroko-framework.github.io/iroko-framework/vocab/iroko-core"/>
    <dcterms:title xml:lang="en">Iroko Framework Core Vocabulary</dcterms:title>
    <rdfs:comment xml:lang="en">This vocabulary provides the shared infrastructure for all Iroko Framework modules. It does not duplicate existing standards (Dublin Core, Schema.org, PROV-O) but adds governance mechanisms specific to sacred knowledge systems.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <owl:priorVersion rdf:resource="https://iroko-framework.github.io/iroko-framework/vocab/iroko-core/1.0.0"/>
    <owl:versionIRI rdf:resource="https://ontology.irokosociety.org/iroko-core/1.3.0"/>
    <owl:versionInfo>1.3.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-vodou-petwo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Petro</skos:altLabel>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-haitian-vodou"/>
    <skos:definition xml:lang="en">Petwo nanchon in Haitian Vodou. Hot, fierce rites with Kongo, New World maroon, and creole origins.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Vodou Petwo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#custodial-shared-custody">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#CustodialRelationshipScheme"/>
    <skos:prefLabel xml:lang="en">Shared Custody</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-calabari">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Traditions rooted in Efik, Ejagham, and Cross River peoples.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Calabari/Cross River</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#func-healing">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <skos:definition xml:lang="en">This element — sign, rhythm, plant use, or artifact — is employed as part of a healing or cleansing ceremony, calling protective or restorative forces.</skos:definition>
    <skos:prefLabel xml:lang="en">Healing</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-bantu-derived">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Traditions with primary roots in Bantu and Kongo religious culture.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Bantu-Derived</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-palo-mayombe">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Palo</skos:altLabel>
    <skos:altLabel xml:lang="en">Regla de Congo</skos:altLabel>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-bantu-derived"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Palo Mayombe</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sacredStatus-replica-teaching">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SacredStatusScheme"/>
    <skos:prefLabel xml:lang="en">Replica/Teaching Object</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#hasSourceCitation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has source citation</rdfs:label>
    <rdfs:comment xml:lang="en">Links any archival record — plant, spirit, Odu, ceremony, lineage — to a structured bibliographic citation. Range is dcterms:BibliographicResource, which covers both plain dcterms string citations and structured BIBO nodes (bibo:Book, bibo:DocumentPart). Use dcterms:bibliographicCitation for simple string citations on instances; use this property with BIBO nodes for queryable structured citations. Cross-domain: applies to all Iroko module entity types.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#instrumentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">instrumentation</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertion-consensual">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Cross-lineage consensus</skos:altLabel>
    <skos:definition xml:lang="en">Affirmed by multiple independent lineages or sources.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AssertionStatusScheme"/>
    <skos:prefLabel xml:lang="en">Widely Attested</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Ampliamente atestiguado</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Largement attesté</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Amplamente atestado</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Tí ọ̀pọ̀lọpọ̀ ìdílé jẹ́rìí sí</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#access-community-only">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Accessible to verified community members. Requires authentication.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AccessLevelScheme"/>
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</skos:notation>
    <skos:prefLabel xml:lang="en">Community Only</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#TextSegment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Text Segment</rdfs:label>
    <rdfs:comment xml:lang="en">An addressable, orderable segment within a narrative or narrative variant. Used for verse-level segmentation of odu essays, chant lines, prayers, and other structured oral or textual corpora.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-candomble-ketu">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-yoruba-derived"/>
    <skos:definition xml:lang="en">Yoruba-derived Candomble tradition in Brazil (Nago/Ketu nation).</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Candomble Ketu</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#FieldworkEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fieldwork Event</rdfs:label>
    <rdfs:comment xml:lang="en">A bounded fieldwork session or interview event during which assertions, narratives, or recordings were captured. Connects knowledge claims to their fieldwork provenance. rdfs:subClassOf prov:Activity asserted in iroko-align-prov.ttl.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#relatedTradition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">related tradition</rdfs:label>
    <rdfs:comment xml:lang="en">Links to related traditions when knowledge spans multiple systems.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-quimbanda">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Quimbanda</rdfs:label>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-bantu-derived"/>
    <skos:definition xml:lang="en">Brazilian; Candomblé + Spiritism synthesis</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Quimbanda</skos:prefLabel>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-kemetic">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Traditions reconstructing or reviving Ancient Egyptian (Kemetic) religious practice.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Kemetic/Revivalist</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-yoruba-continental">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Nigerian Yoruba</skos:altLabel>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-yoruba-derived"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Yoruba (continental)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#epistemicType-published-ethnography">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#EpistemicTypeScheme"/>
    <skos:prefLabel xml:lang="en">Published Ethnography</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#EpistemicTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Epistemic Source Type</rdfs:label>
    <dcterms:description xml:lang="en">Classification of knowledge sources for epistemological transparency.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#epistemicType-archival-document"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#epistemicType-claimed-revelation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#epistemicType-continuous-oral-transmission"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#epistemicType-fieldwork-recording"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#epistemicType-material-culture"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#epistemicType-political-reinterpretation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#epistemicType-published-ethnography"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#epistemicType-reconstructed-from-text"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#epistemicType-ritual-performance"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#epistemicType-speculative-reconstruction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#contestedNotes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">contested notes</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text description of the nature of contestation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-syncretic">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Traditions that deliberately blend multiple African, European, or Indigenous religious streams.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Syncretic/Creole</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ceremonyContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">ceremony context</rdfs:label>
    <rdfs:comment xml:lang="en">The ritual process in which this entity — sign, rhythm, plant use, or artifact — is employed. Range: travay:RitualProcess.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#RitualProcess"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#AssertionStatusScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Assertion Status</rdfs:label>
    <dcterms:description xml:lang="en">Controlled terms for whether a claim is widely attested, lineage-specific, or actively contested.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#assertion-consensual"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#assertion-contested"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#assertion-lineage-specific"/>
    <skos:prefLabel xml:lang="en">Assertion Status</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Estado de afirmación</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Statut d'affirmation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Status de afirmação</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Ipo ìtẹnumọ́</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#contestedStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">contested status</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean indicating whether this entity's attributes, existence, or interpretation are disputed across lineages.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#access-public-unrestricted">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Freely accessible to anyone. No authentication required.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AccessLevelScheme"/>
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</skos:notation>
    <skos:prefLabel xml:lang="en">Public - Unrestricted</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#MediaTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Media Type</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mediaType-audio"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mediaType-ephemera"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mediaType-manuscript"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mediaType-photograph"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#mediaType-video"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#subjectConsentStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">subject consent status</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#access-no-access">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Operational or internal use only. Never exported to RDF.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AccessLevelScheme"/>
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">99</skos:notation>
    <skos:prefLabel xml:lang="en">No Access</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertion-lineage-specific">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Recognized within a specific lineage or house but not universally.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AssertionStatusScheme"/>
    <skos:prefLabel xml:lang="en">Lineage-Specific</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Específico de linaje</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Spécifique à une lignée</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Específico de linhagem</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Tó dá lórí ìdílé kan</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#RelationshipAssertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Relationship Assertion</rdfs:label>
    <rdfs:comment xml:lang="en">A structured reification node recording a claimed relationship between two entities. Extends iroko:Assertion with relationship-specific slots: relationType, assertionScope, assertionLineage. Inherits governance properties (authorizedBy, recordedInEvent, assertionStatus, accessLevel) from the Assertion superclass.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#fieldworkProvenance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">fieldwork provenance</rdfs:label>
    <rdfs:comment xml:lang="en">Details of fieldwork context if this knowledge derives from direct ethnographic observation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#communityReleaseApproval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">community release approval</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#depictedEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">depicted entity</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#signSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">sign system</rdfs:label>
    <rdfs:comment xml:lang="en">The sacred sign system to which this sign belongs — divination, graphic, rhythmic, or other.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Sign"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recordist">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">recordist</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-vodou-rada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-haitian-vodou"/>
    <skos:definition xml:lang="en">Rada nanchon in Haitian Vodou. Cool, sweet rites with primary Fon/Dahomey origins.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Vodou Rada</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#endorsement-elder-approved">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#CommunityEndorsementScheme"/>
    <skos:prefLabel xml:lang="en">Elder-Approved</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertion-contested">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Actively disputed; multiple contradictory positions exist across lineages.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AssertionStatusScheme"/>
    <skos:prefLabel xml:lang="en">Contested</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Disputado</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Contesté</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Contestado</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Tí a ń jiyàn lórí</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#custodial-lineage-succession">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Object received through lineage or house transmission. Paired with sacredStatus-hereditary-custody on the object record.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#CustodialRelationshipScheme"/>
    <skos:prefLabel xml:lang="en">Lineage Succession</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sacredStatus-awaiting-consecration">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SacredStatusScheme"/>
    <skos:prefLabel xml:lang="en">Awaiting Consecration</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SacredSpecimen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sacred Specimen</rdfs:label>
    <rdfs:comment xml:lang="en">Distinguishes objects that maintain active sacred status (consecrated, in ritual use) from decommissioned objects or museum specimens. Used to track the ritual life cycle of material culture.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#signCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">sign count</rdfs:label>
    <rdfs:comment xml:lang="en">The number of discrete signs in the system. Example: Ifá 256, Dilogún 16 principal odù.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Sign"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#depictedCeremony">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">depicted ceremony</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#RitualProcess"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Sign">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sign</rdfs:label>
    <rdfs:comment xml:lang="en">A named unit within a sacred sign system — divination sign, graphic symbol, rhythmic pattern identifier, or similar structured signifier. Superclass of tradition-specific sign types such as marca:DivinationSign and veve:GraphicSign.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#epistemicType-archival-document">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#EpistemicTypeScheme"/>
    <skos:prefLabel xml:lang="en">Archival Document</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mediaType-audio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediaTypeScheme"/>
    <skos:prefLabel xml:lang="en">Audio Recording</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Grabación de audio</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Enregistrement audio</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Gravação de áudio</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àgbékalẹ̀ ohùn</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mediaType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">media type</rdfs:label>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#policyCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">policy condition</rdfs:label>
    <rdfs:comment xml:lang="en">Text description of the conditions under which this policy applies. May reference initiation levels, authority authorizations, temporal variations, or community mandates.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#AccessPolicy"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-vodou-ghede">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Gede</skos:altLabel>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-haitian-vodou"/>
    <skos:definition xml:lang="en">Ghede nanchon in Haitian Vodou. Governs death, sexuality, resurrection, and the boundary between living and dead.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Vodou Ghede</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ConsentStatusScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Consent Status</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#consent-community-authorized"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#consent-documented"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#consent-not-obtained"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#consent-unknown"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#consent-verbal-undocumented"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#func-invocation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <skos:definition xml:lang="en">This element calls or invites a spiritual entity into the ceremonial space. The primary function of vèvè, firmas, specific rhythms, and invocation plants across traditions.</skos:definition>
    <skos:prefLabel xml:lang="en">Invocation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-witness">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <skos:definition xml:lang="en">Person whose presence authorizes or validates an assertion, event, or ceremony. In ceremonial contexts, typically an initiated practitioner.</skos:definition>
    <skos:prefLabel xml:lang="en">Witness</skos:prefLabel>
    <skos:scopeNote xml:lang="en">In travay contexts, the witness must be an initiated practitioner. In authority and narrative contexts, the role is broader.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#alternateNames">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">alternate names</rdfs:label>
    <rdfs:comment xml:lang="en">Other names, honorifics, or tradition-specific designations for this entity across traditions or lineages. Language-tagged strings. Example: Babalu Aye (Lucumí) / Obaluaye (Candomblé) / Sakpata (Fon).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#LineageKnowledgeGraph">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lineage Knowledge Graph</rdfs:label>
    <rdfs:comment xml:lang="en">A named graph representing one lineage's perspective on contested knowledge. Enables multiple community-endorsed positions to coexist without requiring resolution. Core mechanism for postcustodial knowledge governance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertionLineage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">assertion lineage</rdfs:label>
    <rdfs:comment xml:lang="en">The specific lineage, house, or community within which this assertion holds.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#RelationshipAssertion"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-ekpe">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Egbo</skos:altLabel>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-calabari"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Ekpe</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#CommunityEndorsementScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Community Endorsement Status</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#endorsement-community-reviewed"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#endorsement-contested"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#endorsement-elder-approved"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#endorsement-pending-review"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#endorsement-unreviewed"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#endorsement-withdrawn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-obeah">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Obi</skos:altLabel>
    <skos:altLabel xml:lang="en">Obia</skos:altLabel>
    <skos:definition xml:lang="en">A category of spiritual practice found across the Anglophone Caribbean. Systematically criminalized under British colonial law; this history shapes the archival record significantly.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Obeah</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Obeah's criminalization history means archival materials are often court records or colonial surveillance documents. Access governance and provenance tracking are especially important.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#CustodialRelationshipScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Custodial Relationship</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#custodial-community-held"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#custodial-institutional-disputed"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#custodial-institutional-with-access"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#custodial-lineage-succession"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#custodial-private-collection"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#custodial-repatriation-active"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#custodial-shared-custody"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#custodial-under-negotiation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#custodial-unknown-location"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#eventProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">event protocol</rdfs:label>
    <rdfs:comment xml:lang="en">Notes on consent, permissions, recording protocols, and any community authorization obtained for this fieldwork event.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#FieldworkEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#endorsement-pending-review">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#CommunityEndorsementScheme"/>
    <skos:prefLabel xml:lang="en">Pending Review</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-umbanda">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-bantu-derived"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Umbanda</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#variationContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">variation context</rdfs:label>
    <rdfs:comment xml:lang="en">Links a TemporalVariation to the context that activates it — a ceremony, liturgical calendar event, fieldwork session, or other conditioning context. Range is intentionally untyped: activating contexts are heterogeneous (RitualProcess, FieldworkEvent, calendar concept, geographic context) and constraining the range now would create fragility. Revisit when TemporalVariation has sufficient data to determine the realistic range.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TemporalVariation"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Assertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Assertion</rdfs:label>
    <rdfs:comment xml:lang="en">A first-class statement node representing a single claim about any subject in the framework. Attach authority, access level, epistemic type, contested status, and fieldwork provenance at the property level. iroko:RelationshipAssertion is a subclass for relationship-specific claims. All Assertion instances are semantically governed — they do not imply factual truth, only documented assertion.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recordingContext-ceremonial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RecordingContextScheme"/>
    <skos:prefLabel xml:lang="en">Ceremonial Recording</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mediaType-manuscript">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediaTypeScheme"/>
    <skos:prefLabel xml:lang="en">Manuscript</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Manuscrito</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Manuscrit</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Ìwé àfọwọ́kọ</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#custodial-repatriation-active">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#CustodialRelationshipScheme"/>
    <skos:prefLabel xml:lang="en">Repatriation Claim Active</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertionPredicate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">assertion predicate</rdfs:label>
    <rdfs:comment xml:lang="en">The property or relationship type being asserted in an n-ary assertion node. Named assertionPredicate (not predicate) to avoid shadowing rdf:predicate.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertionSubject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">assertion subject</rdfs:label>
    <rdfs:comment xml:lang="en">The entity that is the subject of the claim. Named assertionSubject (not subject) to avoid shadowing rdf:subject.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#communityEndorsement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">community endorsement</rdfs:label>
    <rdfs:comment xml:lang="en">Status of community review and approval. Values from iroko:CommunityEndorsementScheme. Flips institutional authority model by centering community validation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertionNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">assertion note</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text note explaining the basis, source, or dispute surrounding the claim.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#NarrativeVariant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Narrative Variant</rdfs:label>
    <rdfs:comment xml:lang="en">A specific telling, transcript, or rendering of a narrative within a particular context, lineage, or temporal frame. The unit that carries text, language tag, authority scope, and access control.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Narrative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Narrative</rdfs:label>
    <rdfs:comment xml:lang="en">A narrative cluster that may have multiple variants across place, time, authority, and lineage. First-class in Core so any domain module (Marca for odu essays, Ngoma for lyric traditions, Ékpè for origin stories) can attach narratives without importing the full narrative module.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#epistemicType-reconstructed-from-text">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#EpistemicTypeScheme"/>
    <skos:prefLabel xml:lang="en">Reconstructed from Text</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-akan-derived">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Traditions with primary roots in Akan religious culture.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Akan-Derived</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SacredMedia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sacred Media</rdfs:label>
    <rdfs:comment xml:lang="en">Audio, photographic, or video records of sacred knowledge, ceremonies, instruments, or practitioners. Extends DocumentaryEvidence with media-specific metadata including format, instrumentation, consent status, and depicted entities.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#DocumentaryEvidence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-candomble-jeje">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-fon-ewe-derived"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Candomble Jeje</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recordingContext-archival-transfer">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RecordingContextScheme"/>
    <skos:prefLabel xml:lang="en">Archival Transfer</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-elder">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <skos:definition xml:lang="en">Recognized elder whose presence and standing carry governance weight in ritual, narrative, and authorization contexts.</skos:definition>
    <skos:prefLabel xml:lang="en">Elder</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#TraditionScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Tradition Classification</rdfs:label>
    <dcterms:description xml:lang="en">Controlled vocabulary of Afro-Atlantic tradition classifications.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-afro-indigenous"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-akan-derived"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-bantu-derived"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-calabari"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-fon-ewe-derived"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-haitian-vodou"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-kemetic"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-new-orleans-voodoo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-obeah"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-pan-african"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-syncretic"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#tradition-yoruba-derived"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-abakua">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Abakuá</skos:altLabel>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-calabari"/>
    <skos:definition xml:lang="en">Calabari/Efik-derived all-male secret society in Cuba.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Abakua</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sourceRelationship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">source relationship</rdfs:label>
    <rdfs:comment xml:lang="en">Nature of relationship to source tradition for reconstructed or reclaimed practices. Primarily used in Sankofa module.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#fieldworker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">fieldworker</rdfs:label>
    <rdfs:comment xml:lang="en">Person who conducted the fieldwork. Range: foaf:Person or prov:Agent.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#FieldworkEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#access-initiated-elder">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Requires elder designation within tradition — recognized by community as having authority to access lineage-specific teachings.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AccessLevelScheme"/>
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</skos:notation>
    <skos:prefLabel xml:lang="en">Initiated Elder</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-new-orleans-voodoo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Louisiana Voodoo</skos:altLabel>
    <skos:definition xml:lang="en">The syncretic sacred tradition of New Orleans and Louisiana.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">New Orleans Voodoo</skos:prefLabel>
    <skos:related rdf:resource="https://ontology.irokosociety.org/iroko#tradition-haitian-vodou"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#custodial-community-held">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#CustodialRelationshipScheme"/>
    <skos:prefLabel xml:lang="en">Community-Held</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-afro-indigenous">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Traditions that blend African and Indigenous American religious elements.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Afro-Indigenous</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#minimumAccessLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">minimum access level</rdfs:label>
    <rdfs:comment xml:lang="en">Annotation property used on other properties to indicate the minimum access level required to view their values. Used in vocabulary documentation and RDF export filtering.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sacredStatus-honored-rest">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Object retired from active ritual use but continues to be tended with respect. Distinguished from decommissioned — no formal ritual deactivation has occurred.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SacredStatusScheme"/>
    <skos:prefLabel xml:lang="en">Honored Rest</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#oralTransmissionChain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">oral transmission chain</rdfs:label>
    <rdfs:comment xml:lang="en">Documented chain of oral transmission for this knowledge. Example: Elder A (Havana) to Elder B (Matanzas) to Informant C (2018).</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#variationLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">variation label</rdfs:label>
    <rdfs:comment xml:lang="en">Human-readable name for the temporal regime or cycle.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TemporalVariation"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sacredStatus-unknown">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SacredStatusScheme"/>
    <skos:prefLabel xml:lang="en">Unknown Status</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sacredStatus-contested-consecration">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SacredStatusScheme"/>
    <skos:prefLabel xml:lang="en">Contested Consecration</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#competingClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">competing claim</rdfs:label>
    <rdfs:comment xml:lang="en">Links to a prov:Entity representing an alternative position on this contested knowledge.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-yoruba-derived">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Traditions with primary roots in Yoruba religious culture.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Yoruba-Derived</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#signName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">sign name</rdfs:label>
    <rdfs:comment xml:lang="en">The canonical name of the sign in the tradition's liturgical language. Language-tagged. Examples: Ogbe Meji (Ifá), Ogún vèvè (Vodou).</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Sign"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#eventLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">event location</rdfs:label>
    <rdfs:comment xml:lang="en">Location where the fieldwork event took place. Language-tagged string; may be general (city/country) for access-controlled records.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#FieldworkEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#depicts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">depicts</rdfs:label>
    <rdfs:comment xml:lang="en">Links archival materials to the entities they depict. Range: iroko:SacredEntity — covers plants, spirits, ceremonies, practitioners, instruments, and all other framework entities. Geographic locations not yet modeled as SacredEntity subclasses may be referenced via rdfs:label or external URI.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#DocumentaryEvidence"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertionStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">assertion status</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the claim is consensual, lineage-specific, or contested. Range: iroko:AssertionStatusScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#consent-documented">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ConsentStatusScheme"/>
    <skos:prefLabel xml:lang="en">Documented Consent</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#segmentText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">segment text</rdfs:label>
    <rdfs:comment xml:lang="en">The text content of this segment. Language-tagged. Use iroko:accessLevel on the TextSegment instance to govern disclosure.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TextSegment"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#invocationText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">invocation text</rdfs:label>
    <rdfs:comment xml:lang="en">Exact words, prayers, or songs recited when working with this entity — plant, spirit, or ceremony. Applies to any domain module. OPERATIONAL ONLY — never exported to public RDF.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-no-access"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#AccessPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Access Policy</rdfs:label>
    <rdfs:comment xml:lang="en">A named policy governing disclosure, access, or use of a resource, assertion, or collection. Policies may be conditioned on temporal variation, authority authorization, or community mandate. Used to attach institutional policy nodes to records and assertions. Full governance via iroko:accessLevel (per-property), iroko:EpistemicConstraint (per iroko-epistemic.ttl), and iroko:StewardshipMandate (per iroko-agency.ttl).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sacredStatus-hereditary-custody">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Object has passed to a new keeper through lineage or house succession and is actively maintained.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SacredStatusScheme"/>
    <skos:prefLabel xml:lang="en">Hereditary Custody</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#contestedAuthorityOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">contested authority of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a ContestedAuthority back to the RitualAuthority whose legitimacy is in question. Inverse of iroko:contestsAuthority. Enables bidirectional traversal: from the contesting party to the ContestedAuthority record, and from the ContestedAuthority record back to the authority being contested.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#ContestedAuthority"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#RitualAuthority"/>
    <owl:inverseOf rdf:resource="https://ontology.irokosociety.org/iroko#contestsAuthority"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sacredStatus-consecrated-active">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SacredStatusScheme"/>
    <skos:prefLabel xml:lang="en">Consecrated/Active Use</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">tradition</rdfs:label>
    <rdfs:comment xml:lang="en">The Afro-Atlantic tradition to which this entity belongs. Values from controlled vocabulary: iroko:tradition-lucumi, iroko:tradition-candomble-ketu, iroko:tradition-vodou-rada, etc.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#signAlternateName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">sign alternate name</rdfs:label>
    <rdfs:comment xml:lang="en">Alternative or regional names for this sign across traditions or lineage variants. Language-tagged.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Sign"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n86c9e8c17a6d4e97a5f1424732ef20a6b4">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#assertionObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">assertion object</rdfs:label>
    <rdfs:comment xml:lang="en">The entity that is the object of the claim. Named assertionObject (not object) to avoid shadowing rdf:object. Range is intentionally untyped — the object of an assertion may be any resource inside or outside the framework, including external URIs, foaf:Person instances, geographic locations, or framework entities. Constraining the range would break the generality of the reification model.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Assertion"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#epistemicType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">epistemic type</rdfs:label>
    <rdfs:comment xml:lang="en">Epistemological source classification. Values from iroko:EpistemicTypeScheme.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-rastafari">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-pan-african"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Rastafari</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#endorsement-unreviewed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#CommunityEndorsementScheme"/>
    <skos:prefLabel xml:lang="en">Unreviewed</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#policyLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">policy label</rdfs:label>
    <rdfs:comment xml:lang="en">Human-readable name or identifier for this access policy.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#AccessPolicy"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#RecordingContextScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Recording Context</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#recordingContext-archival-transfer"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#recordingContext-ceremonial"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#recordingContext-field"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#recordingContext-studio"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ContestedAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Contested Authority</rdfs:label>
    <rdfs:comment xml:lang="en">An authority (religious title, position, or role) whose legitimacy or historical continuity is disputed across lineages. Example: Iyanifa (women Ifa priests) — some lineages affirm historical continuity, others claim modern innovation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mediaType-photograph">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#MediaTypeScheme"/>
    <skos:prefLabel xml:lang="en">Photograph</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Fotografía</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Photographie</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Fotografia</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àwòrán</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#segmentOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">segment order</rdfs:label>
    <rdfs:comment xml:lang="en">Integer position of this TextSegment within its containing narrative or variant. Used to reconstruct canonical ordering.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#TextSegment"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#epistemicType-claimed-revelation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#EpistemicTypeScheme"/>
    <skos:prefLabel xml:lang="en">Claimed Direct Revelation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#sacredStatus-decommissioned">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SacredStatusScheme"/>
    <skos:prefLabel xml:lang="en">Decommissioned</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-hoodoo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Conjure</skos:altLabel>
    <skos:altLabel xml:lang="en">Rootwork</skos:altLabel>
    <skos:broader rdf:resource="https://ontology.irokosociety.org/iroko#tradition-syncretic"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Hoodoo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#eventDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">event date</rdfs:label>
    <rdfs:comment xml:lang="en">Date or date range of the fieldwork event.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#FieldworkEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#consent-not-obtained">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#ConsentStatusScheme"/>
    <skos:prefLabel xml:lang="en">Not Obtained</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#mediaFormat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">media format</rdfs:label>
    <rdfs:comment xml:lang="en">Technical format of the file. Example: FLAC, WAV, TIFF, JPEG, MP4.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredMedia"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#systemType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">system type</rdfs:label>
    <rdfs:comment xml:lang="en">Typological classification of the sign system. Range is tradition-specific concept scheme in marca or veve modules.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Sign"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rejectingLineages">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">rejecting lineages</rdfs:label>
    <rdfs:comment xml:lang="en">Text list of lineages or houses that reject this position on contested knowledge.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recordingContext-studio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RecordingContextScheme"/>
    <skos:prefLabel xml:lang="en">Studio Recording</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#supportingLineages">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">supporting lineages</rdfs:label>
    <rdfs:comment xml:lang="en">Text list of lineages or houses that endorse this position on contested knowledge.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#tradition-haitian-vodou">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The creolized sacred tradition of Haiti, encompassing multiple nanchon (nations) with distinct African, Kongo, and New World origins.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#TraditionScheme"/>
    <skos:prefLabel xml:lang="en">Haitian Vodou</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#DocumentaryEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Documentary Evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Umbrella class for archival materials (photographs, manuscripts, audio recordings, herbarium specimens) that document sacred knowledge practices. Maps to schema:CreativeWork in RDF serialization.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#custodial-private-collection">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#CustodialRelationshipScheme"/>
    <skos:prefLabel xml:lang="en">Private Collection</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#custodial-institutional-with-access">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#CustodialRelationshipScheme"/>
    <skos:prefLabel xml:lang="en">Institutional Holding with Community Access</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#specimenEncounteredIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">specimen encountered in</rdfs:label>
    <rdfs:comment xml:lang="en">Links a FieldworkEvent to a SacredSpecimen encountered or documented during that session. Access: initiated-only — the association between a fieldwork event and a specific sacred object record discloses custody, location, and lineage information appropriate only for initiated practitioners.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#FieldworkEvent"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SacredSpecimen"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n86c9e8c17a6d4e97a5f1424732ef20a6b2">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#RitualAuthority"/>
    <rdf:rest rdf:nodeID="n86c9e8c17a6d4e97a5f1424732ef20a6b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#consent-verbal-undocumented">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
