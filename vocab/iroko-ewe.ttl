@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dwc: <http://rs.tdwg.org/dwc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix iroko: <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core#> .
@prefix ewe: <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe#> .

<https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> 
    a owl:Ontology ;
    dcterms:title "Iroko Framework: Ewé Module (Sacred Plant Knowledge)"@en ;
    dcterms:description "Vocabulary for documenting sacred plant knowledge in Afro-Atlantic traditions. Provides ritual use governance over Darwin Core botanical data. Focus on medicinal and ritual applications, harvest protocols, preparation methods, and access control for operational knowledge."@en ;
    dcterms:creator "Iroko Historical Society" ;
    dcterms:created "2026-02-17"^^xsd:date ;
    dcterms:modified "2026-02-17"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe/1.0.0> ;
    owl:priorVersion <https://iroko-framework.github.io/iroko-ewe-module/vocab/iroko-ewe-module.ttl/0.2.1> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    rdfs:comment """This module extends Darwin Core for botanical description with Afro-Atlantic ritual/spiritual dimensions. Use Darwin Core for scientific classification and Ewé module for sacred knowledge governance.
    
    Integration pattern:
    - dwc:scientificName for binomial nomenclature
    - ewe:ritualUse for ceremonial applications
    - ewe:harvestProtocol for ritual harvest (community-only access)
    - ewe:preparationMethodDetailed for exact instructions (initiated-only access)
    """@en ;
    owl:imports <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# CLASSES
# ===================================================================

ewe:Plant 
    a owl:Class ;
    rdfs:subClassOf iroko:SacredEntity ;
    rdfs:label "Plant"@en ;
    rdfs:comment "Sacred plant entity in Afro-Atlantic traditions. Corresponds to dwc:Occurrence in Darwin Core for botanical description. This class adds ritual, medicinal, and access governance dimensions."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> ;
    skos:example """
    :akoko a ewe:Plant ;
        dwc:scientificName "Newbouldia laevis" ;
        skos:prefLabel "Akoko"@yo ;
        ewe:medicinalUse ewe:medicinal/fever-reduction ;
        ewe:ritualUse ewe:ritual/purification, ewe:ritual/protection ;
        ewe:entityAssociation <https://iroko.org/entities/obatala> ;
        iroko:tradition iroko:tradition/lucumi ;
        iroko:accessLevel iroko:access/public-unrestricted .
    """ .

ewe:PlantPreparation 
    a owl:Class ;
    rdfs:label "Plant Preparation"@en ;
    rdfs:comment "A prepared spiritual material combining specific plants with defined quantities and methods. Example: Omiero for Obatalá (bath with 21 leaves of Akoko, Prodigiosa, Albahaca blanca)."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:HerbariumSheet 
    a owl:Class ;
    rdfs:subClassOf iroko:DocumentaryEvidence ;
    rdfs:label "Herbarium Sheet"@en ;
    rdfs:comment "Physical plant specimen preserved for documentation. Links botanical voucher to plant record and archival photograph."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

# ===================================================================
# PROPERTIES - Ritual & Medicinal Dimension
# ===================================================================

ewe:medicinalUse 
    a owl:ObjectProperty ;
    rdfs:label "medicinal use"@en ;
    rdfs:comment "Medicinal/healing application of this plant. Values from controlled vocabulary: fever-reduction, digestive-support, wound-healing, etc. Access: public-unrestricted."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range skos:Concept ;
    iroko:minimumAccessLevel "public-unrestricted" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:ritualUse 
    a owl:ObjectProperty ;
    rdfs:label "ritual use"@en ;
    rdfs:comment "Ceremonial/spiritual application of this plant. Values: purification, protection, invocation, offering, etc. Access: public-unrestricted."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range skos:Concept ;
    iroko:minimumAccessLevel "public-unrestricted" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:ritualContext 
    a owl:DatatypeProperty ;
    rdfs:label "ritual context"@en ;
    rdfs:comment "Textual description of ceremonial use context. When and how the plant is used ritually. Access: community-only or higher."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    iroko:minimumAccessLevel "community-only" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:plantPart 
    a owl:ObjectProperty ;
    rdfs:label "plant part"@en ;
    rdfs:comment "Which part of the plant is used. Values: leaf, root, bark, seed, flower, etc. Access: public-unrestricted."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range skos:Concept ;
    iroko:minimumAccessLevel "public-unrestricted" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:harvestProtocol 
    a owl:ObjectProperty ;
    rdfs:label "harvest protocol"@en ;
    rdfs:comment "Method of harvesting: ritual vs. commercial, timing, offerings required. Values: ritual-harvest-offering-required, wildcrafted, cultivated, etc. Access: community-only."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range skos:Concept ;
    iroko:minimumAccessLevel "community-only" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:harvestProtocolDetailed 
    a owl:DatatypeProperty ;
    rdfs:label "harvest protocol (detailed)"@en ;
    rdfs:comment "Detailed harvest instructions: exact timing (dawn, dusk), direction (face east), quantities (3, 7, 9, 21), offerings required. Access: community-only."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    iroko:minimumAccessLevel "community-only" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:preparationMethod 
    a owl:ObjectProperty ;
    rdfs:label "preparation method"@en ;
    rdfs:comment "General preparation method. Values: infusion, decoction, bath, fumigation, poultice, etc. Access: community-only."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range skos:Concept ;
    iroko:minimumAccessLevel "community-only" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:preparationMethodDetailed 
    a owl:DatatypeProperty ;
    rdfs:label "preparation method (detailed)"@en ;
    rdfs:comment "Exact preparation instructions: 'Boil 7 minutes, strain twice through white cloth'. Includes timing, quantities by work type, critical steps. Access: initiated-only."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    iroko:minimumAccessLevel "initiated-only" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:contraindication 
    a owl:DatatypeProperty ;
    rdfs:label "contraindication"@en ;
    rdfs:comment "Safety warnings: allergic reactions, pregnancy contraindications, toxic if ingested, etc. Access: public-unrestricted."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    iroko:minimumAccessLevel "public-unrestricted" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

# ===================================================================
# PROPERTIES - Semantic Cross-Links
# ===================================================================

ewe:entityAssociation 
    a owl:ObjectProperty ;
    rdfs:label "entity association"@en ;
    rdfs:comment "Spiritual entity (òrìṣà, lwa, mpungu) associated with this plant. Links to Nkisi module. Access: public-unrestricted."@en ;
    rdfs:domain ewe:Plant ;
    # Range would be iroko-nkisi:SpiritualEntity but avoiding hard dependency
    iroko:minimumAccessLevel "public-unrestricted" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:processReference 
    a owl:ObjectProperty ;
    rdfs:label "process reference"@en ;
    rdfs:comment "Ritual process where this plant is used. Links to Travay module. Example: used in rogación (head cooling ceremony). Access: community-only."@en ;
    rdfs:domain ewe:Plant ;
    # Range would be iroko-travay:RitualProcess
    iroko:minimumAccessLevel "community-only" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:signReference 
    a owl:ObjectProperty ;
    rdfs:label "sign reference"@en ;
    rdfs:comment "Divination sign that prescribes this plant. Links to Marca module. Example: Ogbe Meji prescribes Akoko for purification. Access: initiated-only."@en ;
    rdfs:domain ewe:Plant ;
    # Range would be iroko-marca:DivinationSign
    iroko:minimumAccessLevel "initiated-only" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

# ===================================================================
# PROPERTIES - Naming & Provenance
# ===================================================================

ewe:nameCollision 
    a owl:DatatypeProperty ;
    rdfs:label "name collision"@en ;
    rdfs:comment "Boolean indicating if the same vernacular name refers to multiple distinct species. Example: 'Prodigiosa' can refer to different plants in different regions."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:collisionNotes 
    a owl:DatatypeProperty ;
    rdfs:label "collision notes"@en ;
    rdfs:comment "Explanation of name collision: which plants share the name, how to distinguish, regional variations."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:geographicVariation 
    a owl:DatatypeProperty ;
    rdfs:label "geographic variation"@en ;
    rdfs:comment "Regional differences in use, preparation, or identification. Example: 'In Matanzas, 9 leaves are standard; in Havana, 7 leaves'."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

# ===================================================================
# PROPERTIES - Source Attribution
# ===================================================================

ewe:vergerReference 
    a owl:DatatypeProperty ;
    rdfs:label "Verger reference"@en ;
    rdfs:comment "Citation to Pierre Verger's plant documentation. Example: 'Verger 1995, p. 234'."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:cabreraReference 
    a owl:DatatypeProperty ;
    rdfs:label "Cabrera reference"@en ;
    rdfs:comment "Citation to Lydia Cabrera's plant documentation. Example: 'Cabrera, El Monte, p. 156'."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:derenReference 
    a owl:DatatypeProperty ;
    rdfs:label "Deren reference"@en ;
    rdfs:comment "Citation to Maya Deren's Vodou plant documentation."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

# ===================================================================
# PROPERTIES - Archival Integration
# ===================================================================

ewe:specimenNumber 
    a owl:DatatypeProperty ;
    rdfs:label "specimen number"@en ;
    rdfs:comment "Herbarium catalog number or specimen identifier."@en ;
    rdfs:domain ewe:HerbariumSheet ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:photographicVoucher 
    a owl:ObjectProperty ;
    rdfs:label "photographic voucher"@en ;
    rdfs:comment "Link to photographic documentation of this plant specimen."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range iroko:DocumentaryEvidence ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

# ===================================================================
# PROPERTIES - Operational (Never Exported)
# ===================================================================

ewe:invocationText 
    a owl:DatatypeProperty ;
    rdfs:label "invocation text"@en ;
    rdfs:comment "Exact words/prayers recited when harvesting or using this plant. OPERATIONAL ONLY - never exported to RDF. Access: no-access."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    iroko:minimumAccessLevel "no-access" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

ewe:secretName 
    a owl:DatatypeProperty ;
    rdfs:label "secret name"@en ;
    rdfs:comment "Alternative/secret names used in ceremonies. OPERATIONAL ONLY - never exported to RDF. Access: no-access."@en ;
    rdfs:domain ewe:Plant ;
    rdfs:range xsd:string ;
    iroko:minimumAccessLevel "no-access" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe> .

# ===================================================================
# CONCEPT SCHEME: Medicinal Use
# ===================================================================

ewe:MedicinalUseScheme 
    a skos:ConceptScheme ;
    rdfs:label "Medicinal Use Classification"@en ;
    dcterms:description "Controlled vocabulary of medicinal and healing applications."@en .

ewe:medicinal/digestive-support 
    a skos:Concept ;
    skos:inScheme ewe:MedicinalUseScheme ;
    skos:prefLabel "Digestive Support"@en ;
    skos:definition "Supports digestive system, relieves stomach issues."@en .

ewe:medicinal/respiratory-support 
    a skos:Concept ;
    skos:inScheme ewe:MedicinalUseScheme ;
    skos:prefLabel "Respiratory Support"@en ;
    skos:definition "Supports respiratory system, cough relief, asthma."@en .

ewe:medicinal/skin-topical 
    a skos:Concept ;
    skos:inScheme ewe:MedicinalUseScheme ;
    skos:prefLabel "Skin/Topical"@en ;
    skos:definition "Applied to skin for rashes, irritation, wounds."@en .

ewe:medicinal/general-tonic 
    a skos:Concept ;
    skos:inScheme ewe:MedicinalUseScheme ;
    skos:prefLabel "General Tonic"@en ;
