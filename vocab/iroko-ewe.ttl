ewe:medicinal/reproductive-fertility 
    a skos:Concept ;
    skos:inScheme ewe:MedicinalUseScheme ;
    skos:prefLabel "Reproductive/Fertility"@en ;
    skos:definition "Supports reproductive health, fertility."@en .

ewe:medicinal/spiritual-psychosomatic 
    a skos:Concept ;
    skos:inScheme ewe:MedicinalUseScheme ;
    skos:prefLabel "Spiritual/Psychosomatic"@en ;
    skos:definition "Addresses spiritual/emotional dimensions of illness."@en .

ewe:medicinal/pediatric 
