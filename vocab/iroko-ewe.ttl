# ===================================================================
# CONCEPT SCHEME: Harvest Protocol
# ===================================================================

ewe:HarvestProtocolScheme 
    a skos:ConceptScheme ;
    rdfs:label "Harvest Protocol Classification"@en ;
    dcterms:description "Methods and requirements for harvesting plants."@en .

ewe:harvest/ritual-offering-required 
    a skos:Concept ;
    skos:inScheme ewe:HarvestProtocolScheme ;
    skos:prefLabel "Ritual Harvest (Offering Required)"@en ;
    skos:definition "Requires ritual protocol and offering to plant spirit before harvesting."@en .

ewe:harvest/commercial-market 
    a skos:Concept ;
    skos:inScheme ewe:HarvestProtocolScheme ;
    skos:prefLabel "Commercial/Market"@en ;
    skos:definition "Purchased from commercial sources or markets."@en .

ewe:harvest/wildcrafted 
    a skos:Concept ;
    skos:inScheme ewe:HarvestProtocolScheme ;
    skos:prefLabel "Wildcrafted (No Ritual)"@en ;
    skos:definition "Harvested from wild without specific ritual protocol."@en .

ewe:harvest/cultivated 
    a skos:Concept ;
    skos:inScheme ewe:HarvestProtocolScheme ;
    skos:prefLabel "Cultivated"@en ;
    skos:definition "Grown intentionally in gardens or farms."@en .

ewe:harvest/lunar-phase-required 
    a skos:Concept ;
    skos:inScheme ewe:HarvestProtocolScheme ;
    skos:prefLabel "Requires Lunar Phase"@en ;
    skos:definition "Must be harvested during specific moon phase."@en .

ewe:harvest/specific-practitioner 
    a skos:Concept ;
    skos:inScheme ewe:HarvestProtocolScheme ;
    skos:prefLabel "Requires Specific Practitioner"@en ;
    skos:definition "Must be harvested by practitioner with specific initiation."@en .

ewe:harvest/specific-time-of-day 
    a skos:Concept ;
    skos:inScheme ewe:HarvestProtocolScheme ;
    skos:prefLabel "Requires Specific Time of Day"@en ;
    skos:definition "Must be harvested at dawn, dusk, midnight, etc."@en .

ewe:harvest/plant-spirit-offering 
    a skos:Concept ;
    skos:inScheme ewe:HarvestProtocolScheme ;
    skos:prefLabel "Requires Offering to Plant Spirit"@en ;
    skos:definition "Offering (water, coins, tobacco) must be left at plant base."@en .

# ===================================================================
# CONCEPT SCHEME: Preparation Method
# ===================================================================

ewe:PreparationMethodScheme 
    a skos:ConceptScheme ;
    rdfs:label "Preparation Method Classification"@en ;
    dcterms:description "Methods for preparing plant materials."@en .

ewe:preparation/infusion 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Infusion (Hot Water)"@en ;
    skos:definition "Steeped in hot water like tea."@en .

ewe:preparation/decoction 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Decoction (Boiled)"@en ;
    skos:definition "Boiled to extract properties from harder plant parts."@en .

ewe:preparation/maceration 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Maceration (Cold Soak)"@en ;
    skos:definition "Soaked in cold water or oil for extended period."@en .

ewe:preparation/bath 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Bath (Baño/Bain)"@en ;
    skos:definition "Prepared as spiritual bath for immersion or washing."@en .

ewe:preparation/fumigation 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Fumigation (Sahumerio)"@en ;
    skos:definition "Burned as incense or smoke for cleansing."@en .

ewe:preparation/poultice 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Poultice/Compress"@en ;
    skos:definition "Applied topically as paste or compress."@en .

ewe:preparation/ingestion 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Ingestion (Tea/Food)"@en ;
    skos:definition "Consumed internally as tea, tonic, or food."@en .

ewe:preparation/topical 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Topical Application"@en ;
    skos:definition "Applied directly to skin or affected area."@en .

ewe:preparation/incantation-only 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Incantation-Only"@en ;
    skos:definition "Used ritually with words/prayers but not physically prepared."@en .

ewe:preparation/powder 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Powder (Afoche)"@en ;
    skos:definition "Dried and ground into powder."@en .

ewe:preparation/wash 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Wash (Omiero/Lavage)"@en ;
    skos:definition "Prepared as liquid wash for ritual bathing or anointing."@en .

ewe:preparation/tincture 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Tincture/Alcohol"@en ;
    skos:definition "Extracted in alcohol or spirits."@en .

ewe:preparation/dried-bundle 
    a skos:Concept ;
    skos:inScheme ewe:PreparationMethodScheme ;
    skos:prefLabel "Dried Bundle"@en ;
    skos:definition "Dried and bundled for hanging or storage."@en .

# ===================================================================
# USAGE EXAMPLES
# ===================================================================

# Example 1: Simple public plant record
<https://iroko.org/plants/akoko-001> 
    a ewe:Plant ;
    dwc:scientificName "Newbouldia laevis" ;
    dwc:family "Bignoniaceae" ;
    skos:prefLabel "Akoko"@yo ;
    skos:altLabel "Akoko funfun"@yo ;
    ewe:medicinalUse ewe:medicinal/fever-reduction ;
    ewe:ritualUse ewe:ritual/purification, ewe:ritual/protection ;
    ewe:plantPart ewe:part/leaf ;
    ewe:entityAssociation <https://iroko.org/entities/obatala> ;
    iroko:tradition iroko:tradition/lucumi ;
    iroko:accessLevel iroko:access/public-unrestricted ;
    dcterms:source <https://iroko.org/sources/verger-1995> .

# Example 2: Community-level detail (harvest protocol)
<https://iroko.org/plant-details/akoko-harvest> 
    a rdf:Statement ;
    rdf:subject <https://iroko.org/plants/akoko-001> ;
    rdf:predicate ewe:harvestProtocolDetailed ;
    rdf:object "Harvest at dawn before sunrise. Face east while cutting. Take 3, 7, 9, or 21 leaves depending on work. Pour water at base as offering before cutting." ;
    iroko:accessLevel iroko:access/community-only ;
    dcterms:source <https://iroko.org/sources/fieldwork-havana-2018> .

# Example 3: Initiated-level detail (preparation)
<https://iroko.org/plant-details/akoko-preparation> 
    a rdf:Statement ;
    rdf:subject <https://iroko.org/plants/akoko-001> ;
    rdf:predicate ewe:preparationMethodDetailed ;
    rdf:object """Boil exactly 7 minutes in clean water. Strain twice through white cloth. 
    
Quantities by work:
- Rogación (head cooling): 9 leaves
- Full spiritual bath: 21 leaves  
- Ebó to head: 3 leaves

Can combine with prodigiosa and albahaca blanca. NEVER combine with atiponlá.

If Akoko unavailable, prodigiosa MAY substitute for general cleansing but NOT for Obatalá-specific work.""" ;
    iroko:accessLevel iroko:access/initiated-only ;
    iroko:tradition iroko:tradition/lucumi ;
    dcterms:source <https://iroko.org/sources/elder-teaching-matanzas> .
```

---

## Repository Structure

Place these files in your new repository:
```
iroko-framework/
├── vocab/
│   ├── iroko-core.ttl          ← Place File 1 here
│   ├── iroko-ewe.ttl           ← Place File 2 here
│   └── (future module files)
├── terms/
│   └── (will contain generated HTML pages for each term)
├── docs/
│   ├── ARCHITECTURE.md         ← Your buildout document
│   └── EXTERNAL-VOCABULARIES.md
├── examples/
│   └── plant-example.ttl       ← Usage examples
├── README.md
└── LICENSE
