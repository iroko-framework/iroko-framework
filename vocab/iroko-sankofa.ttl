    iroko:minimumAccessLevel iroko:access-public-unrestricted ;
    rdfs:isDefinedBy <https://www.irokosociety.org/iroko-framework/sankofa> .

# ===================================================================
# CONCEPT SCHEMES
# ===================================================================

# --- Movement Types ---

sankofa:MovementTypeScheme
    a skos:ConceptScheme ;
    rdfs:label "Reclamation Movement Types"@en ;
    skos:prefLabel "Reclamation Movement Types"@en ;
    skos:prefLabel "Tipos de movimiento de reclamación"@es ;
    skos:prefLabel "Types de mouvement de réclamation"@fr ;
    skos:prefLabel "Tipos de movimento de reclamação"@pt ;
    skos:prefLabel "Àwọn ìrú ìgbiyànjú ìpadàbọ̀"@yo ;
    skos:hasTopConcept sankofa:type-re-africanization,
                       sankofa:type-decolonization,
                       sankofa:type-purification,
                       sankofa:type-validation-seeking,
                       sankofa:type-reconstruction,
                       sankofa:type-repatriation,
                       sankofa:type-heritage-tourism,
                       sankofa:type-other .

sankofa:type-re-africanization
    a skos:Concept ; skos:inScheme sankofa:MovementTypeScheme ;
    skos:prefLabel "Re-Africanization"@en ;
    skos:prefLabel "Re-africanización"@es ;
    skos:prefLabel "Ré-africanisation"@fr ;
    skos:definition "Efforts to restore African elements to diaspora traditions that have been transformed by colonialism, syncretism, or assimilation. Exemplified by the Candomblé re-Africanization movement in Bahia and the movement to remove Catholic saint imagery from Lucumí/Ocha practice."@en .

sankofa:type-decolonization
    a skos:Concept ; skos:inScheme sankofa:MovementTypeScheme ;
    skos:prefLabel "Decolonization"@en ;
    skos:prefLabel "Descolonización"@es ;
    skos:prefLabel "Décolonisation"@fr ;
    skos:definition "Specifically framed efforts to identify and remove colonial impositions (Catholic syncretism, colonial-era secrecy requirements, European naming conventions) from a diaspora tradition. Overlaps with re-Africanization but emphasizes the political critique of colonialism."@en .

sankofa:type-purification
    a skos:Concept ; skos:inScheme sankofa:MovementTypeScheme ;
    skos:prefLabel "Purification / orthodoxy movement"@en ;
    skos:definition "Efforts within a tradition community to establish or enforce a more 'authentic' or 'pure' practice, often by marginalizing innovations perceived as non-traditional. May be conservative (defending existing diaspora practice) or reformist (seeking African models)."@en .

sankofa:type-validation-seeking
    a skos:Concept ; skos:inScheme sankofa:MovementTypeScheme ;
    skos:prefLabel "Validation-seeking"@en ;
    skos:definition "Efforts by diaspora practitioners to obtain formal recognition, initiation, or endorsement from African source communities or their representatives. May involve travel, correspondence, or receiving African elders in diaspora contexts."@en .

sankofa:type-reconstruction
    a skos:Concept ; skos:inScheme sankofa:MovementTypeScheme ;
    skos:prefLabel "Tradition reconstruction"@en ;
    skos:definition "Efforts to create or restore a practice from documentary, archaeological, or cross-tradition scholarly sources where direct lineage transmission has been lost."@en .

sankofa:type-repatriation
    a skos:Concept ; skos:inScheme sankofa:MovementTypeScheme ;
    skos:prefLabel "Repatriation"@en ;
    skos:definition "Physical return of diaspora people to African source communities, creating new hybrid communities and exchanges. Examples: Brazilian returnee (aguda/tabom) communities in West Africa who brought diaspora Candomblé elements back to Benin and Nigeria."@en .

sankofa:type-heritage-tourism
    a skos:Concept ; skos:inScheme sankofa:MovementTypeScheme ;
    skos:prefLabel "Heritage tourism / pilgrimage"@en ;
    skos:definition "Organized or individual diaspora visits to African source sites for spiritual, cultural, or commemorative purposes. Distinguished from DiasporaReturn in being primarily observational rather than initiatory."@en .

sankofa:type-other
    a skos:Concept ; skos:inScheme sankofa:MovementTypeScheme ;
    skos:prefLabel "Other"@en ;
    skos:definition "Movement type not covered by existing concepts."@en .

# --- Return Types ---

sankofa:ReturnTypeScheme
    a skos:ConceptScheme ;
    rdfs:label "Diaspora Return Types"@en ;
    skos:prefLabel "Diaspora Return Types"@en ;
    skos:prefLabel "Tipos de retorno diaspórico"@es ;
    skos:prefLabel "Types de retour diasporique"@fr ;
    skos:prefLabel "Tipos de retorno diaspórico"@pt ;
    skos:prefLabel "Àwọn ìrú ìpadàbọ̀ ará ìjìnlẹ̀ ayé"@yo ;
    skos:hasTopConcept sankofa:return-initiation,
                       sankofa:return-consultation,
                       sankofa:return-protocol-exchange,
                       sankofa:return-ceremony-participation,
                       sankofa:return-research,
                       sankofa:return-other .

sankofa:return-initiation
    a skos:Concept ; skos:inScheme sankofa:ReturnTypeScheme ;
    skos:prefLabel "African initiation"@en ;
    skos:definition "Diaspora practitioner receives initiation in Africa within a source tradition."@en .

sankofa:return-consultation
    a skos:Concept ; skos:inScheme sankofa:ReturnTypeScheme ;
    skos:prefLabel "Consultation / divination"@en ;
    skos:definition "Diaspora practitioner receives divination or consultation from African authority figures."@en .

sankofa:return-protocol-exchange
    a skos:Concept ; skos:inScheme sankofa:ReturnTypeScheme ;
    skos:prefLabel "Protocol / knowledge exchange"@en ;
    skos:definition "Formal exchange of liturgical, ceremonial, or governance knowledge between diaspora and African communities."@en .

sankofa:return-ceremony-participation
    a skos:Concept ; skos:inScheme sankofa:ReturnTypeScheme ;
    skos:prefLabel "Ceremony participation"@en ;
    skos:definition "Diaspora practitioner participates in African ceremonies without receiving initiation."@en .

sankofa:return-research
    a skos:Concept ; skos:inScheme sankofa:ReturnTypeScheme ;
    skos:prefLabel "Research / ethnographic"@en ;
    skos:definition "Diaspora practitioner or scholar conducts fieldwork in African source communities."@en .

sankofa:return-other
    a skos:Concept ; skos:inScheme sankofa:ReturnTypeScheme ;
    skos:prefLabel "Other"@en ;
    skos:definition "Return type not covered by existing concepts."@en .

# --- Reconstruction Methods ---

sankofa:ReconstructionMethodScheme
    a skos:ConceptScheme ;
    rdfs:label "Reconstruction Methods"@en ;
    skos:prefLabel "Reconstruction Methods"@en ;
    skos:prefLabel "Métodos de reconstrucción"@es ;
    skos:prefLabel "Méthodes de reconstruction"@fr ;
    skos:prefLabel "Métodos de reconstrução"@pt ;
    skos:prefLabel "Àwọn ọ̀nà ìtúnpadà"@yo ;
    skos:hasTopConcept sankofa:method-ethnographic,
                       sankofa:method-archival,
                       sankofa:method-oral-tradition,
                       sankofa:method-cross-tradition-synthesis,
                       sankofa:method-community-consensus,
                       sankofa:method-other .

sankofa:method-ethnographic
    a skos:Concept ; skos:inScheme sankofa:ReconstructionMethodScheme ;
    skos:prefLabel "Published ethnographic sources"@en ;
    skos:definition "Reconstruction based primarily on published ethnographic literature (Bascom, Farrow, Verger, Cabrera, Herskovits, etc.)."@en .

sankofa:method-archival
    a skos:Concept ; skos:inScheme sankofa:ReconstructionMethodScheme ;
    skos:prefLabel "Archival / documentary sources"@en ;
    skos:definition "Reconstruction based on primary archival sources: colonial records, religious registers, fieldwork notes, photographs."@en .

sankofa:method-oral-tradition
    a skos:Concept ; skos:inScheme sankofa:ReconstructionMethodScheme ;
    skos:prefLabel "Oral tradition and living practitioners"@en ;
    skos:definition "Reconstruction based on oral transmission from living elders or communities with partial survival of the tradition."@en .

sankofa:method-cross-tradition-synthesis
    a skos:Concept ; skos:inScheme sankofa:ReconstructionMethodScheme ;
    skos:prefLabel "Cross-tradition synthesis"@en ;
    skos:definition "Reconstruction by synthesizing elements from multiple related surviving traditions to fill gaps in a fragmented one."@en .

sankofa:method-community-consensus
    a skos:Concept ; skos:inScheme sankofa:ReconstructionMethodScheme ;
    skos:prefLabel "Community deliberation and consensus"@en ;
    skos:definition "Reconstruction through formal community process: elders and practitioners deliberating together to establish or restore practice."@en .

sankofa:method-other
    a skos:Concept ; skos:inScheme sankofa:ReconstructionMethodScheme ;
    skos:prefLabel "Other"@en ;
    skos:definition "Reconstruction method not covered by existing concepts."@en .

# --- Heritage Relationship Types ---

sankofa:HeritageRelationshipTypeScheme
    a skos:ConceptScheme ;
    rdfs:label "Heritage Relationship Types"@en ;
    skos:prefLabel "Heritage Relationship Types"@en ;
    skos:prefLabel "Tipos de relación patrimonial"@es ;
    skos:prefLabel "Types de relation patrimoniale"@fr ;
    skos:prefLabel "Tipos de relação patrimonial"@pt ;
    skos:prefLabel "Àwọn ìrú ìbátan àṣà ìní"@yo ;
    skos:hasTopConcept sankofa:rel-direct-descent,
                       sankofa:rel-parallel-development,
                       sankofa:rel-influence,
                       sankofa:rel-reconstructed,
                       sankofa:rel-claimed-disputed,
                       sankofa:rel-other .

sankofa:rel-direct-descent
    a skos:Concept ; skos:inScheme sankofa:HeritageRelationshipTypeScheme ;
    skos:prefLabel "Direct descent (widely attested)"@en ;
    skos:definition "The diaspora tradition descends directly from the African source tradition through documented enslaved practitioner transmission. Widely recognized by scholars and both communities."@en .

sankofa:rel-parallel-development
    a skos:Concept ; skos:inScheme sankofa:HeritageRelationshipTypeScheme ;
    skos:prefLabel "Parallel development from shared source"@en ;
    skos:definition "The diaspora and African traditions share a common ancestor but developed in parallel rather than one descending from the other."@en .

sankofa:rel-influence
    a skos:Concept ; skos:inScheme sankofa:HeritageRelationshipTypeScheme ;
    skos:prefLabel "Historical influence"@en ;
    skos:definition "The African tradition influenced the diaspora tradition without a direct descent relationship. Elements were adopted or adapted."@en .

sankofa:rel-reconstructed
    a skos:Concept ; skos:inScheme sankofa:HeritageRelationshipTypeScheme ;
    skos:prefLabel "Reconstructed / claimed"@en ;
    skos:definition "The relationship is based on reconstruction from historical evidence rather than surviving living transmission."@en .

sankofa:rel-claimed-disputed
    a skos:Concept ; skos:inScheme sankofa:HeritageRelationshipTypeScheme ;
    skos:prefLabel "Claimed but contested"@en ;
    skos:definition "The diaspora tradition claims a relationship to the African source, but this claim is disputed by scholars, the African community, or other diaspora communities."@en .

sankofa:rel-other
    a skos:Concept ; skos:inScheme sankofa:HeritageRelationshipTypeScheme ;
    skos:prefLabel "Other"@en ;
    skos:definition "Heritage relationship type not covered by existing concepts."@en .

# --- Recognition Status ---

sankofa:RecognitionStatusScheme
    a skos:ConceptScheme ;
    rdfs:label "Recognition Status"@en ;
    skos:prefLabel "Recognition Status"@en ;
    skos:prefLabel "Estado de reconocimiento"@es ;
    skos:prefLabel "Statut de reconnaissance"@fr ;
    skos:prefLabel "Status de reconhecimento"@pt ;
    skos:prefLabel "Ipò ìdásílẹ̀"@yo ;
    skos:hasTopConcept sankofa:recognition-formally-recognized,
                       sankofa:recognition-informally-recognized,
                       sankofa:recognition-disputed,
                       sankofa:recognition-not-sought,
                       sankofa:recognition-rejected,
                       sankofa:recognition-pending .

sankofa:recognition-formally-recognized
    a skos:Concept ; skos:inScheme sankofa:RecognitionStatusScheme ;
    skos:prefLabel "Formally recognized"@en ;
    skos:definition "The reconstructed or diaspora practice has received formal recognition from a source tradition authority."@en .

sankofa:recognition-informally-recognized
    a skos:Concept ; skos:inScheme sankofa:RecognitionStatusScheme ;
    skos:prefLabel "Informally recognized"@en ;
    skos:definition "Recognition exists through interpersonal relationships and mutual respect without formal institutional endorsement."@en .

sankofa:recognition-disputed
    a skos:Concept ; skos:inScheme sankofa:RecognitionStatusScheme ;
    skos:prefLabel "Disputed"@en ;
    skos:definition "Some source tradition representatives recognize the practice; others do not. Contested."@en .

sankofa:recognition-not-sought
    a skos:Concept ; skos:inScheme sankofa:RecognitionStatusScheme ;
    skos:prefLabel "Not sought"@en ;
    skos:definition "The community practices without seeking external recognition, asserting autonomy over its own validity."@en .

sankofa:recognition-rejected
    a skos:Concept ; skos:inScheme sankofa:RecognitionStatusScheme ;
    skos:prefLabel "Rejected"@en ;
    skos:definition "Source tradition authorities have formally rejected or declined to recognize this practice or community."@en .

sankofa:recognition-pending
    a skos:Concept ; skos:inScheme sankofa:RecognitionStatusScheme ;
    skos:prefLabel "Pending"@en ;
    skos:definition "Recognition process is underway; outcome not yet determined."@en .
