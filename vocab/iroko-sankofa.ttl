    rdfs:comment "Whether and how this reconstructed practice has been recognized by source tradition communities. Range: sankofa:RecognitionStatusScheme."@en ;
    rdfs:domain sankofa:ReconstructedPractice ;
    rdfs:range skos:Concept ;
    iroko:minimumAccessLevel iroko:access-public-unrestricted ;
    rdfs:isDefinedBy <https://www.irokosociety.org/iroko-framework/sankofa> .

