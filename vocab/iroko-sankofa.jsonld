  },
  "@graph": [
    {
      "@id": "iroko:MovementTypeScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Reclamation Movement Types"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:type-decolonization"
        },
        {
          "@id": "iroko:type-heritage-tourism"
        },
        {
          "@id": "iroko:type-other"
        },
        {
          "@id": "iroko:type-purification"
        },
        {
          "@id": "iroko:type-re-africanization"
        },
        {
          "@id": "iroko:type-reconstruction"
        },
        {
          "@id": "iroko:type-repatriation"
        },
        {
          "@id": "iroko:type-validation-seeking"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Reclamation Movement Types"
        },
        {
          "@language": "es",
          "@value": "Tipos de movimiento de reclamación"
        },
        {
          "@language": "fr",
          "@value": "Types de mouvement de réclamation"
        },
        {
          "@language": "pt",
          "@value": "Tipos de movimento de reclamação"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ìrú ìgbiyànjú ìpadàbọ̀"
        }
      ]
    },
    {
      "@id": "iroko:recognition-informally-recognized",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Recognition exists through interpersonal relationships and mutual respect without formal institutional endorsement."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Informally recognized"
      }
    },
    {
      "@id": "iroko:TransAfroAtlanticReturn",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A documented instance of a Afro-Atlantic practitioner or community making contact with, seeking validation from, or receiving initiation within an African source community. Examples: Cuban Babalawos traveling to Yorùbáland for Ifá validation; Haitian Vodouisants conducting ceremonies in Benin at Ouidah; Candomblé priests initiating in West Africa. A Trans-Afro-Atlantic return may be documented as an event, a relationship, or a formal protocol exchange. The outcomes of such encounters — including mutual recognition or rejection — should be documented without taking sides."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Trans-Afro-Atlantic Return"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:return-initiation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Afro-Atlantic practitioner receives initiation in Africa within a source tradition."
      },
      "skos:inScheme": {
        "@id": "iroko:ReturnTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "African initiation"
      }
    },
    {
      "@id": "iroko:paper-type-official-correspondence",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Letters, reports, or memoranda between colonial administrators, customs officials, port authorities, or clergy concerning the movement, legal status, or trade of enslaved persons. Includes instructions on trade suppression enforcement in the post-1808 period."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Official Correspondence"
        },
        {
          "@language": "es",
          "@value": "Correspondencia oficial"
        }
      ]
    },
    {
      "@id": "iroko:method-archival",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Reconstruction based on primary archival sources: colonial records, religious registers, fieldwork notes, photographs."
      },
      "skos:inScheme": {
        "@id": "iroko:ReconstructionMethodScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Archival / documentary sources"
      }
    },
    {
      "@id": "iroko:SlavePaperTypeScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Document type classification for colonial legal instruments that constituted or contested ownership claims over enslaved persons in the Atlantic world."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Slave Paper Types"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:paper-type-baptismal-register"
        },
        {
          "@id": "iroko:paper-type-customs-certification"
        },
        {
          "@id": "iroko:paper-type-freedom-petition"
        },
        {
          "@id": "iroko:paper-type-irregular-forged"
        },
        {
          "@id": "iroko:paper-type-judicial-filing"
        },
        {
          "@id": "iroko:paper-type-manumission-instrument"
        },
        {
          "@id": "iroko:paper-type-official-correspondence"
        },
        {
          "@id": "iroko:paper-type-sale-record"
        },
        {
          "@id": "iroko:paper-type-ship-manifest"
        }
      ]
    },
    {
      "@id": "iroko:paper-type-sale-record",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A notarized instrument documenting the sale or transfer of an enslaved person between owners. Core document in the Atlantic ownership chain; required notarial authentication in most colonial legal systems."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Sale Record"
        },
        {
          "@language": "es",
          "@value": "Escritura de venta"
        }
      ]
    },
    {
      "@id": "iroko:paper-function-ownership-challenge",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Document contests or disrupts a claimed ownership right — through judicial petition, contested manumission, coartación claim, or challenge to the legality of original enslavement."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ownership Challenge"
      }
    },
    {
      "@id": "iroko:type-reconstruction",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Efforts to create or restore a practice from documentary, archaeological, or cross-tradition scholarly sources where direct lineage transmission has been lost."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Tradition reconstruction"
      }
    },
    {
      "@id": "iroko:evidentiarySources",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The documentary, scholarly, or oral sources used as the basis for reconstruction. Range: iroko:DocumentaryEvidence."
      },
      "rdfs:domain": {
        "@id": "iroko:ReconstructedPractice"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "evidentiary sources"
      },
      "rdfs:range": {
        "@id": "iroko:DocumentaryEvidence"
      }
    },
    {
      "@id": "iroko:period-post-1820",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Criminalization period: the U.S. Piracy Act of 1820 classified slave trading as a capital offense, forcing the trade into maximum clandestinity. Documentation became systematically destroyed, forged, or simply absent. Surviving slave paper from this period is often the product of legal challenges, freedom petitions, or judicial proceedings."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperPeriodScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Post-1820"
        },
        {
          "@language": "es",
          "@value": "Después de 1820"
        }
      ],
      "skos:topConceptOf": {
        "@id": "iroko:SlavePaperPeriodScheme"
      }
    },
    {
      "@id": "iroko:rel-direct-descent",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Afro-Atlantic tradition descends directly from the African source tradition through documented enslaved practitioner transmission. Widely recognized by scholars and both communities."
      },
      "skos:inScheme": {
        "@id": "iroko:HeritageRelationshipTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Direct descent (widely attested)"
      }
    },
    {
      "@id": "iroko:ReconstructionMethodScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Reconstruction Methods"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:method-archival"
        },
        {
          "@id": "iroko:method-community-consensus"
        },
        {
          "@id": "iroko:method-cross-tradition-synthesis"
        },
        {
          "@id": "iroko:method-ethnographic"
        },
        {
          "@id": "iroko:method-oral-tradition"
        },
        {
          "@id": "iroko:method-other"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Reconstruction Methods"
        },
        {
          "@language": "es",
          "@value": "Métodos de reconstrucción"
        },
        {
          "@language": "fr",
          "@value": "Méthodes de reconstruction"
        },
        {
          "@language": "pt",
          "@value": "Métodos de reconstrução"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ọ̀nà ìtúnpadà"
        }
      ]
    },
    {
      "@id": "iroko:paper-function-identity-document",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Document establishes or records the name, origin, or identity of an enslaved person within the colonial bureaucratic system."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Identity Documentation"
      }
    },
    {
      "@id": "iroko:recognition-disputed",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Some source tradition representatives recognize the practice; others do not. Contested."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Disputed"
      }
    },
    {
      "@id": "iroko:geographicLocus",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The city, country, or region where this movement, return event, or reconstructed practice was primarily based or most active. Language-tagged string. Examples: 'New York City (1920s–1940s)'@en for Garveyite reclamation; 'Bahia, Brazil'@pt for the Candomblé re-Africanization effort; 'Port-au-Prince, Haiti'@fr for a Vodou governance movement. For machine-readable geographic linking, use iroko:hasJurisdiction (from iroko-authority.ttl) instead of or in addition to this property."
      },
      "rdfs:domain": {
        "@id": "_:n4efb9a1d4f3a44f4994274ae5a16dd4fb5"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "geographic locus"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "_:n4efb9a1d4f3a44f4994274ae5a16dd4fb5",
      "@type": "owl:Class",
      "owl:unionOf": {
        "@list": [
          {
            "@id": "iroko:ReclamationMovement"
          },
          {
            "@id": "iroko:TransAfroAtlanticReturn"
          },
          {
            "@id": "iroko:ReconstructedPractice"
          }
        ]
      }
    },
    {
      "@id": "iroko:paper-function-ownership-claim",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Document asserts or transfers a legal ownership claim over an enslaved person."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ownership Claim"
      }
    },
    {
      "@id": "iroko:type-validation-seeking",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Efforts by Afro-Atlantic practitioners to obtain formal recognition, initiation, or endorsement from African source communities or their representatives. May involve travel, correspondence, or receiving African elders in Afro-Atlantic contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Validation-seeking"
      }
    },
    {
      "@id": "iroko:paper-type-irregular-forged",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A document in the slave paper chain that was fraudulently produced, backdated, altered, or otherwise irregular. Analytically essential for the post-1820 period of illegal trade: the prevalence of forged documentation reveals the legal requirements of the official system and the networks that circumvented them."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Irregular or Forged Paper"
        },
        {
          "@language": "es",
          "@value": "Documento irregular o falsificado"
        }
      ]
    },
    {
      "@id": "iroko:originDate",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Approximate date the movement began."
      },
      "rdfs:domain": {
        "@id": "iroko:ReclamationMovement"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "origin date"
      },
      "rdfs:range": {
        "@id": "xsd:gYear"
      }
    },
    {
      "@id": "iroko:recognition-pending",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Recognition process is underway; outcome not yet determined."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Pending"
      }
    },
    {
      "@id": "iroko:returnDate",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:domain": {
        "@id": "iroko:TransAfroAtlanticReturn"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "return date"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "iroko:targetTradition",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The Afro-Atlantic tradition this movement seeks to reclaim or revitalize. Range: iroko:TraditionScheme concept."
      },
      "rdfs:domain": {
        "@id": "iroko:ReclamationMovement"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "target tradition"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:rel-reconstructed",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The relationship is based on reconstruction from historical evidence rather than surviving living transmission."
      },
      "skos:inScheme": {
        "@id": "iroko:HeritageRelationshipTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Reconstructed / claimed"
      }
    },
    {
      "@id": "iroko:period-1808-1820",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Nominal suppression period: the Atlantic trade was illegal under U.S. and British law but continued with reduced official documentation, irregular certifications, forged manifests, and fraudulent domestic sale records obscuring trans-Atlantic origins. Slave paper from this period reflects the legal fiction of domestic transfer masking ongoing trans-Atlantic trafficking."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperPeriodScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "1808–1820"
        },
        {
          "@language": "es",
          "@value": "1808–1820"
        }
      ],
      "skos:topConceptOf": {
        "@id": "iroko:SlavePaperPeriodScheme"
      }
    },
    {
      "@id": "iroko:returnOutcome",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The documented result of this return: mutual recognition, initiation, rejection, or ongoing relationship. Free-text."
      },
      "rdfs:domain": {
        "@id": "iroko:TransAfroAtlanticReturn"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "return outcome"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:type-purification",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Efforts within a tradition community to establish or enforce a more 'authentic' or 'pure' practice, often by marginalizing innovations perceived as non-traditional. May be conservative (defending existing Afro-Atlantic practice) or reformist (seeking African models)."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Purification / orthodoxy movement"
      }
    },
    {
      "@id": "iroko:SlavePaperFunctionScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "The legal or institutional function served by a slave paper document within the Atlantic ownership claim apparatus."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Slave Paper Functions"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:paper-function-chain-of-title"
        },
        {
          "@id": "iroko:paper-function-freedom-basis"
        },
        {
          "@id": "iroko:paper-function-identity-document"
        },
        {
          "@id": "iroko:paper-function-ownership-challenge"
        },
        {
          "@id": "iroko:paper-function-ownership-claim"
        }
      ]
    },
    {
      "@id": "iroko:recognition-rejected",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Source tradition authorities have formally rejected or declined to recognize this practice or community."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Rejected"
      }
    },
    {
      "@id": "iroko:rel-parallel-development",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Afro-Atlantic and African traditions share a common ancestor but developed in parallel rather than one descending from the other."
      },
      "skos:inScheme": {
        "@id": "iroko:HeritageRelationshipTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Parallel development from shared source"
      }
    },
    {
      "@id": "iroko:return-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Return type not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:ReturnTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:method-ethnographic",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Reconstruction based primarily on published ethnographic literature (Bascom, Farrow, Verger, Cabrera, Herskovits, etc.)."
      },
      "skos:inScheme": {
        "@id": "iroko:ReconstructionMethodScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Published ethnographic sources"
      }
    },
    {
      "@id": "iroko:relationshipType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The type of heritage relationship claimed. Range: iroko:HeritageRelationshipTypeScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:HeritageRelationship"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "relationship type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:return-consultation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Afro-Atlantic practitioner receives divination or consultation from African authority figures."
      },
      "skos:inScheme": {
        "@id": "iroko:ReturnTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Consultation / divination"
      }
    },
    {
      "@id": "iroko:paper-function-chain-of-title",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Document serves as a link in the chain of ownership title — establishing the legal sequence of transfers by which the current owner's claim derives from the original sale or entry."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Chain-of-Title Link"
      }
    },
    {
