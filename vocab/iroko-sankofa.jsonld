      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-sankofa",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-22"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Domain module. Vocabulary for the full Afro-Atlantic arc: the forced-departure side, documenting the colonial legal instruments that constituted and contested ownership over enslaved persons (iroko:SlavePaper and the SlavePaper type, function, and period schemes); and the return side, documenting revitalization movements, Trans-Afro-Atlantic returns, reconstructed traditions, and heritage relationships. The module name follows the Akan sankofa principle — to go back and fetch what was taken — a structure that encompasses both what was taken (documented in slave paper) and the subsequent return to claim it. Models semantic relationships between Afro-Atlantic practice and African source traditions without adjudicating authenticity. All heritage relationship claims are modeled as iroko:RelationshipAssertion to reflect their contested and negotiated character. The classes and properties in this module are descriptive instruments — they document what movements call themselves and what they claim to do. The use of terms such as 'return', 'diaspora', and 'reclamation' reflects the self-description of the movements documented here, not a normative position of the Iroko Framework on questions of African identity or belonging. Use with iroko-authority to document who may authorize heritage relationship claims and recognition, and for contributor roles (notary, scribe, commissioner) associated with slave paper production; iroko-narrative for movement histories, oral transmission chains, and contested origin accounts."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-06-16"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-narrative"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Sankofa Module (Documentary Apparatus, Reclamation Movements, and Trans-Afro-Atlantic Returns)"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:priorVersion": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa/1.3.0"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa/1.3.1"
      },
      "owl:versionInfo": "1.3.1",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:ReconstructedPractice",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A religious practice or tradition that has been assembled or restored from documentary sources, scholarly research, or cross-tradition synthesis rather than direct lineage transmission. Examples: reconstructed Yorùbá practice in communities without living initiatory lineage; synthesis traditions drawing on Farrow, Bascom, or Verger ethnographic documentation; Neo-African traditions developed from scholarly sources in North America or Europe. The reconstruction method and its evidentiary basis are the core data here; the framework makes no judgment about the resulting practice's validity."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Reconstructed Practice"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:period-pre-1808",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Legal trade period: the Atlantic slave trade operated within formal legal frameworks with extensive official documentation — bills of sale, ship manifests, customs declarations, baptismal registers, and notarial records. The full apparatus of slave paper as an active legal instrument of colonial property law. Documentation density is highest in this period."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperPeriodScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Pre-1808"
        },
        {
          "@language": "es",
          "@value": "Antes de 1808"
        }
      ],
      "skos:topConceptOf": {
        "@id": "iroko:SlavePaperPeriodScheme"
      }
    },
    {
      "@id": "iroko:method-oral-tradition",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Reconstruction based on oral transmission from living elders or communities with partial survival of the tradition."
      },
      "skos:inScheme": {
        "@id": "iroko:ReconstructionMethodScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Oral tradition and living practitioners"
      }
    },
    {
      "@id": "iroko:paper-type-ship-manifest",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A customs or port document listing enslaved persons as cargo aboard a vessel. Required for transatlantic and coastal trade; used to collect duties and establish initial entry into the colonial documentary record."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Ship Manifest"
        },
        {
          "@language": "es",
          "@value": "Manifiesto de carga"
        }
      ]
    },
    {
      "@id": "iroko:type-decolonization",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Specifically framed efforts to identify and remove colonial impositions (Catholic syncretism, colonial-era secrecy requirements, European naming conventions) from a Afro-Atlantic tradition. Overlaps with re-Africanization but emphasizes the political critique of colonialism."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Decolonization"
        },
        {
          "@language": "es",
          "@value": "Descolonización"
        },
        {
          "@language": "fr",
          "@value": "Décolonisation"
        }
      ]
    },
    {
      "@id": "iroko:HeritageRelationshipTypeScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Heritage Relationship Types"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:rel-claimed-disputed"
        },
        {
          "@id": "iroko:rel-direct-descent"
        },
        {
          "@id": "iroko:rel-influence"
        },
        {
          "@id": "iroko:rel-other"
        },
        {
          "@id": "iroko:rel-parallel-development"
        },
        {
          "@id": "iroko:rel-reconstructed"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Heritage Relationship Types"
        },
        {
          "@language": "es",
          "@value": "Tipos de relación patrimonial"
        },
        {
          "@language": "fr",
          "@value": "Types de relation patrimoniale"
        },
        {
          "@language": "pt",
          "@value": "Tipos de relação patrimonial"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ìrú ìbátan àṣà ìní"
        }
      ]
    },
    {
      "@id": "iroko:paper-type-manumission-instrument",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A legal instrument by which an enslaved person was formally freed by their enslaver. Coartación documents, cartas de libertad, and similar instruments. Manumission could be conditional, partial, or purchased (coartación) — the instrument type records the terms."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Manumission Instrument"
        },
        {
          "@language": "es",
          "@value": "Carta de libertad"
        }
      ]
    },
    {
      "@id": "iroko:HeritageRelationship",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A formal assertion of the relationship between a Afro-Atlantic tradition and its claimed African source tradition. Subclass of iroko:RelationshipAssertion: the claim is documented with its source, asserter, and status (widely attested, lineage-specific, or contested) without requiring resolution. Examples: the documented Yorùbá–Lucumí relationship; the contested specificity of Fon vs. Ewe sources for Haitian Vodou Rada; the debated connection between specific Cuban Abakuá potencias and Cross River Ékpè lodges."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Heritage Relationship"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:RelationshipAssertion"
      }
    },
    {
      "@id": "iroko:paper-type-baptismal-register",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "An ecclesiastical record of an enslaved person's baptism. Critical for identity and status: in colonial Catholic systems, baptism established a Christian name and was often the first record of an enslaved person by name in the local documentary apparatus."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Baptismal Register Entry"
        },
        {
          "@language": "es",
          "@value": "Registro de bautismo"
        }
      ]
    },
    {
      "@id": "iroko:return-research",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Afro-Atlantic practitioner or scholar conducts fieldwork in African source communities."
      },
      "skos:inScheme": {
        "@id": "iroko:ReturnTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Research / ethnographic"
      }
    },
    {
      "@id": "iroko:method-community-consensus",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Reconstruction through formal community process: elders and practitioners deliberating together to establish or restore practice."
      },
      "skos:inScheme": {
        "@id": "iroko:ReconstructionMethodScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community deliberation and consensus"
      }
    },
