      }
    },
    {
      "@id": "iroko:evidencesHeritage",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a SlavePaper instance to the HeritageRelationship it evidences — typically because the document records the name, origin, or cultural identity of an enslaved person whose tradition can be traced. This is the ontological connection between the forced-departure documentation and the reclamation arc: the slave record that proves a transmission chain is the evidentiary link between forced removal and the heritage claim."
      },
      "rdfs:domain": {
        "@id": "iroko:SlavePaper"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "evidences heritage"
      },
      "rdfs:range": {
        "@id": "iroko:HeritageRelationship"
      }
    },
    {
      "@id": "iroko:afroAtlanticTradition",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The Afro-Atlantic side of the claimed heritage relationship. Range: iroko:TraditionScheme concept."
      },
      "rdfs:domain": {
        "@id": "iroko:HeritageRelationship"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Afro-Atlantic tradition"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:sourceTradition",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The African tradition identified as the reclamation's reference point. Range: iroko:TraditionScheme concept."
      },
      "rdfs:domain": {
        "@id": "iroko:ReclamationMovement"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "source tradition"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:return-ceremony-participation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Afro-Atlantic practitioner participates in African ceremonies without receiving initiation."
      },
      "skos:inScheme": {
        "@id": "iroko:ReturnTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ceremony participation"
      }
    },
    {
      "@id": "iroko:type-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Movement type not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:rel-claimed-disputed",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Afro-Atlantic tradition claims a relationship to the African source, but this claim is disputed by scholars, the African community, or other Afro-Atlantic communities."
      },
      "skos:inScheme": {
        "@id": "iroko:HeritageRelationshipTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Claimed but contested"
      }
    },
    {
      "@id": "iroko:slavePaperType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The document type classification for this slave paper instance. Range: iroko:SlavePaperTypeScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:SlavePaper"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "slave paper type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:type-repatriation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Physical return of Afro-Atlantic people to African source communities, creating new hybrid communities and exchanges. Examples: Brazilian returnee (aguda/tabom) communities in West Africa who brought Afro-Atlantic Candomblé elements back to Benin and Nigeria."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Repatriation"
      }
    },
    {
      "@id": "iroko:evidenceBase",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Summary of the scholarly and community evidence supporting or complicating this heritage relationship claim."
      },
      "rdfs:domain": {
        "@id": "iroko:HeritageRelationship"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "evidence base"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:paper-type-judicial-filing",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A court record — complaint, testimony, judgment, or order — pertaining to the status, ownership, or freedom of an enslaved person. Judicial filings constitute the primary site where ownership claims were actively contested."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Judicial Filing"
        },
        {
          "@language": "es",
          "@value": "Expediente judicial"
        }
      ]
    },
    {
      "@id": "iroko:africanTradition",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The African source tradition claimed in this heritage relationship. Range: iroko:TraditionScheme concept."
      },
      "rdfs:domain": {
        "@id": "iroko:HeritageRelationship"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "African source tradition"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:movementName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The name or designation of this reclamation or revitalization movement. Language-tagged."
      },
      "rdfs:domain": {
        "@id": "iroko:ReclamationMovement"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "movement name"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:rel-influence",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The African tradition influenced the Afro-Atlantic tradition without a direct descent relationship. Elements were adopted or adapted."
      },
      "skos:inScheme": {
        "@id": "iroko:HeritageRelationshipTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Historical influence"
      }
    },
    {
      "@id": "iroko:paper-type-customs-certification",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A document issued by colonial customs or port authorities certifying the legal introduction of enslaved persons into a jurisdiction. Particularly significant in the post-1808 period when trade illegality required fraudulent backdating or re-certification."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Customs Certification"
        },
        {
          "@language": "es",
          "@value": "Certificación aduanera"
        }
      ]
    },
    {
      "@id": "iroko:tradePeriod",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The Atlantic slave trade chronological period in which this slave paper was produced or to which it belongs. Range: iroko:SlavePaperPeriodScheme. The three TiSP periods reflect distinct legal regimes: pre-1808 (open Atlantic trade), 1808-1820 (nominal suppression, ongoing trade), post-1820 (intensified illegal trade requiring more elaborate documentary apparatus)."
      },
      "rdfs:domain": {
        "@id": "iroko:SlavePaper"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "trade period"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
