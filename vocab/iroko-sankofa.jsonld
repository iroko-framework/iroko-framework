          "@id": "iroko:rel-parallel-development"
        },
        {
          "@id": "iroko:rel-reconstructed"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Heritage Relationship Types"
        },
        {
          "@language": "es",
          "@value": "Tipos de relación patrimonial"
        },
        {
          "@language": "fr",
          "@value": "Types de relation patrimoniale"
        },
        {
          "@language": "pt",
          "@value": "Tipos de relação patrimonial"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ìrú ìbátan àṣà ìní"
        }
      ]
    },
    {
      "@id": "iroko:rel-claimed-disputed",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Afro-Atlantic tradition claims a relationship to the African source, but this claim is disputed by scholars, the African community, or other Afro-Atlantic communities."
      },
      "skos:inScheme": {
        "@id": "iroko:HeritageRelationshipTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Claimed but contested"
      }
    },
    {
      "@id": "iroko:africanTradition",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The African source tradition claimed in this heritage relationship. Range: iroko:TraditionScheme concept."
      },
      "rdfs:domain": {
        "@id": "iroko:HeritageRelationship"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "African source tradition"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:TransAfroAtlanticReturn",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A documented instance of a Afro-Atlantic practitioner or community making contact with, seeking validation from, or receiving initiation within an African source community. Examples: Cuban Babalawos traveling to Yorùbáland for Ifá validation; Haitian Vodouisants conducting ceremonies in Benin at Ouidah; Candomblé priests initiating in West Africa. A Trans-Afro-Atlantic return may be documented as an event, a relationship, or a formal protocol exchange. The outcomes of such encounters — including mutual recognition or rejection — should be documented without taking sides."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Trans-Afro-Atlantic Return"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:return-consultation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Afro-Atlantic practitioner receives divination or consultation from African authority figures."
      },
      "skos:inScheme": {
        "@id": "iroko:ReturnTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Consultation / divination"
      }
    },
    {
      "@id": "iroko:method-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Reconstruction method not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:ReconstructionMethodScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:recognition-formally-recognized",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The reconstructed or Afro-Atlantic practice has received formal recognition from a source tradition authority."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Formally recognized"
      }
    },
    {
      "@id": "iroko:rel-reconstructed",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The relationship is based on reconstruction from historical evidence rather than surviving living transmission."
      },
      "skos:inScheme": {
        "@id": "iroko:HeritageRelationshipTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Reconstructed / claimed"
      }
    },
    {
      "@id": "iroko:recognition-rejected",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Source tradition authorities have formally rejected or declined to recognize this practice or community."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Rejected"
      }
    },
    {
      "@id": "iroko:RecognitionStatusScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Recognition Status"
      },
      "skos:hasTopConcept": [
