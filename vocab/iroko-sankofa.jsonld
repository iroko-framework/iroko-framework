      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The Atlantic trade corridor node at which this slave paper was issued, recorded, or enforced. Range: iroko:Jurisdiction (from iroko-authority.ttl). Use to link slave paper to specific port cities and colonial administrative territories in the TiSP corridor."
      },
      "rdfs:domain": {
        "@id": "iroko:SlavePaper"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
