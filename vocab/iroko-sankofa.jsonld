    {
      "@id": "iroko:type-purification",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Efforts within a tradition community to establish or enforce a more 'authentic' or 'pure' practice, often by marginalizing innovations perceived as non-traditional. May be conservative (defending existing Afro-Atlantic practice) or reformist (seeking African models)."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Purification / orthodoxy movement"
      }
    },
    {
      "@id": "iroko:method-community-consensus",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Reconstruction through formal community process: elders and practitioners deliberating together to establish or restore practice."
      },
      "skos:inScheme": {
        "@id": "iroko:ReconstructionMethodScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community deliberation and consensus"
      }
    },
    {
      "@id": "iroko:method-ethnographic",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Reconstruction based primarily on published ethnographic literature (Bascom, Farrow, Verger, Cabrera, Herskovits, etc.)."
      },
      "skos:inScheme": {
        "@id": "iroko:ReconstructionMethodScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Published ethnographic sources"
      }
    },
    {
      "@id": "iroko:method-cross-tradition-synthesis",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Reconstruction by synthesizing elements from multiple related surviving traditions to fill gaps in a fragmented one."
      },
      "skos:inScheme": {
        "@id": "iroko:ReconstructionMethodScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Cross-tradition synthesis"
      }
    },
    {
      "@id": "iroko:rel-parallel-development",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Afro-Atlantic and African traditions share a common ancestor but developed in parallel rather than one descending from the other."
      },
      "skos:inScheme": {
        "@id": "iroko:HeritageRelationshipTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Parallel development from shared source"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-sankofa",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-22"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Domain module. Vocabulary for documenting revitalization and reclamation movements, Trans-Afro-Atlantic returns to African source communities, reconstructed traditions, and heritage relationships. Models semantic relationships between Afro-Atlantic practice and African source traditions without adjudicating authenticity. All heritage relationship claims are modeled as iroko:RelationshipAssertion to reflect their contested and negotiated character. Use with iroko-authority to document who may authorize heritage relationship claims and recognition; iroko-narrative for movement histories, oral transmission chains, and contested origin accounts."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-02-25"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-narrative"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Sankofa Module (Reclamation Movements and Trans-Afro-Atlantic Returns)"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
