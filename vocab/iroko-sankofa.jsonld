      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The community practices without seeking external recognition, asserting autonomy over its own validity."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Not sought"
      }
    },
    {
