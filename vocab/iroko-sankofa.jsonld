      "@id": "_:nebb46e9e3f504fb19238354b30b412f1b1",
      "@type": "owl:Class",
      "owl:unionOf": {
        "@list": [
          {
            "@id": "iroko:TransAfroAtlanticReturn"
          },
          {
            "@id": "iroko:ReclamationMovement"
          }
        ]
      }
    },
    {
      "@id": "iroko:evidentiarySources",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The documentary, scholarly, or oral sources used as the basis for reconstruction. Range: iroko:DocumentaryEvidence."
      },
      "rdfs:domain": {
        "@id": "iroko:ReconstructedPractice"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "evidentiary sources"
      },
      "rdfs:range": {
        "@id": "iroko:DocumentaryEvidence"
      }
    },
    {
      "@id": "iroko:originDate",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Approximate date the movement began."
      },
      "rdfs:domain": {
        "@id": "iroko:ReclamationMovement"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "origin date"
      },
      "rdfs:range": {
        "@id": "xsd:gYear"
      }
    },
    {
      "@id": "iroko:recognition-informally-recognized",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Recognition exists through interpersonal relationships and mutual respect without formal institutional endorsement."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Informally recognized"
      }
    },
    {
      "@id": "iroko:type-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Movement type not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:returnContestation",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "How this return has been evaluated or contested within the broader tradition community."
      },
      "rdfs:domain": {
        "@id": "iroko:TransAfroAtlanticReturn"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "contestation notes"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:type-validation-seeking",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Efforts by Afro-Atlantic practitioners to obtain formal recognition, initiation, or endorsement from African source communities or their representatives. May involve travel, correspondence, or receiving African elders in Afro-Atlantic contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Validation-seeking"
      }
    },
    {
      "@id": "iroko:method-oral-tradition",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Reconstruction based on oral transmission from living elders or communities with partial survival of the tradition."
      },
      "skos:inScheme": {
        "@id": "iroko:ReconstructionMethodScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Oral tradition and living practitioners"
      }
    },
    {
      "@id": "iroko:type-repatriation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Physical return of Afro-Atlantic people to African source communities, creating new hybrid communities and exchanges. Examples: Brazilian returnee (aguda/tabom) communities in West Africa who brought Afro-Atlantic Candomblé elements back to Benin and Nigeria."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Repatriation"
      }
    },
    {
      "@id": "iroko:type-reconstruction",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Efforts to create or restore a practice from documentary, archaeological, or cross-tradition scholarly sources where direct lineage transmission has been lost."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Tradition reconstruction"
      }
    },
    {
      "@id": "iroko:return-research",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Afro-Atlantic practitioner or scholar conducts fieldwork in African source communities."
      },
      "skos:inScheme": {
        "@id": "iroko:ReturnTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Research / ethnographic"
      }
    },
    {
      "@id": "iroko:sourceTradition",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The African tradition identified as the reclamation's reference point. Range: iroko:TraditionScheme concept."
      },
      "rdfs:domain": {
        "@id": "iroko:ReclamationMovement"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "source tradition"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:return-protocol-exchange",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Formal exchange of liturgical, ceremonial, or governance knowledge between Afro-Atlantic and African communities."
      },
      "skos:inScheme": {
        "@id": "iroko:ReturnTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Protocol / knowledge exchange"
      }
    },
    {
      "@id": "iroko:type-re-africanization",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Efforts to restore African elements to Afro-Atlantic traditions that have been transformed by colonialism, syncretism, or assimilation. Exemplified by the Candomblé re-Africanization movement in Bahia and the movement to remove Catholic saint imagery from Lucumí/Ocha practice."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Re-Africanization"
        },
        {
          "@language": "es",
          "@value": "Re-africanización"
        },
        {
          "@language": "fr",
          "@value": "Ré-africanisation"
        }
      ]
    },
    {
      "@id": "iroko:recognition-pending",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Recognition process is underway; outcome not yet determined."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Pending"
      }
    },
    {
      "@id": "iroko:HeritageRelationship",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A formal assertion of the relationship between a Afro-Atlantic tradition and its claimed African source tradition. Subclass of iroko:RelationshipAssertion: the claim is documented with its source, asserter, and status (widely attested, lineage-specific, or contested) without requiring resolution. Examples: the documented Yorùbá–Lucumí relationship; the contested specificity of Fon vs. Ewe sources for Haitian Vodou Rada; the debated connection between specific Cuban Abakuá potencias and Cross River Ékpè lodges."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Heritage Relationship"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:RelationshipAssertion"
      }
    },
    {
      "@id": "iroko:rel-direct-descent",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Afro-Atlantic tradition descends directly from the African source tradition through documented enslaved practitioner transmission. Widely recognized by scholars and both communities."
      },
      "skos:inScheme": {
        "@id": "iroko:HeritageRelationshipTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Direct descent (widely attested)"
      }
    },
    {
      "@id": "iroko:type-decolonization",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Specifically framed efforts to identify and remove colonial impositions (Catholic syncretism, colonial-era secrecy requirements, European naming conventions) from a Afro-Atlantic tradition. Overlaps with re-Africanization but emphasizes the political critique of colonialism."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Decolonization"
        },
        {
          "@language": "es",
          "@value": "Descolonización"
        },
        {
          "@language": "fr",
          "@value": "Décolonisation"
        }
      ]
    },
    {
      "@id": "iroko:recognition-disputed",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Some source tradition representatives recognize the practice; others do not. Contested."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Disputed"
      }
    },
    {
      "@id": "iroko:method-archival",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Reconstruction based on primary archival sources: colonial records, religious registers, fieldwork notes, photographs."
      },
      "skos:inScheme": {
        "@id": "iroko:ReconstructionMethodScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Archival / documentary sources"
      }
    },
    {
      "@id": "iroko:HeritageRelationshipTypeScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Heritage Relationship Types"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:rel-claimed-disputed"
        },
        {
          "@id": "iroko:rel-direct-descent"
