      }
    },
    {
      "@id": "iroko:paper-type-freedom-petition",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A legal petition filed by or on behalf of an enslaved person seeking recognition of free status, disputing ownership, or claiming coartación rights. Freedom petitions are the primary site of enslaved legal agency within the colonial documentary apparatus."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Freedom Petition"
        },
        {
          "@language": "es",
          "@value": "Petición de libertad"
        }
      ]
    },
    {
      "@id": "iroko:SlavePaper",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A colonial legal document — sale record, ship manifest, customs certification, baptismal register entry, judicial filing, manumission instrument, or freedom petition — that constituted, maintained, challenged, or forged an ownership claim over an enslaved person in the Atlantic world. The class name follows the TiSP (Trafficking in Slave Paper) project terminology, which foregrounds the documentary nature of the legal mechanism: slave paper was not merely a record of completed transactions but an active legal instrument through which status, ownership, and identity were continuously made and contested. Slave paper required perpetual renewal through notarial, customs, ecclesiastical, or judicial systems; the gap or absence in that chain was itself a legal event. SlavePaper instances may serve as iroko:evidentiarySources for iroko:ReconstructedPractice and populate iroko:evidenceBase on iroko:HeritageRelationship where the enslaved person's cultural or religious identity can be traced. Contributor roles for producers of slave paper (notary, scribe, commissioner) are modeled in iroko-authority.ttl via iroko:ContributorRoleScheme."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Slave Paper"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:DocumentaryEvidence"
      }
    },
    {
      "@id": "iroko:paper-function-freedom-basis",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Document constitutes or supports the legal basis for an enslaved person's free status — manumission instruments, freedom petitions, and successful court rulings."
      },
      "skos:inScheme": {
        "@id": "iroko:SlavePaperFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Freedom Basis"
      }
    },
    {
      "@id": "iroko:movementType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The typological category of this movement. Range: iroko:MovementTypeScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:ReclamationMovement"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "movement type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:sourceRegion",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The continental African geographic region toward which this movement, return event, or heritage relationship is oriented. Range: iroko:TraditionScheme geographic region concepts (iroko:region-west-african, iroko:region-central-african, iroko:region-east-african, iroko:region-southern-african, iroko:region-north-african, iroko:region-nile-valley). Distinct from iroko:sourceTradition, which points to a specific cultural-linguistic tradition; sourceRegion carries the broader geographic orientation when the specific tradition is not identified or when the movement is pan-regionally oriented. A Garveyite movement asserting a general Africa-wide claim would use sourceRegion rather than sourceTradition. Both properties may be asserted simultaneously."
      },
      "rdfs:domain": {
        "@id": "_:n4efb9a1d4f3a44f4994274ae5a16dd4fb1"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "source region"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "_:n4efb9a1d4f3a44f4994274ae5a16dd4fb1",
      "@type": "owl:Class",
      "owl:unionOf": {
        "@list": [
          {
            "@id": "iroko:ReclamationMovement"
          },
          {
            "@id": "iroko:TransAfroAtlanticReturn"
          },
          {
            "@id": "iroko:HeritageRelationship"
          }
        ]
      }
    },
    {
      "@id": "iroko:type-re-africanization",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Efforts to restore African elements to Afro-Atlantic traditions that have been transformed by colonialism, syncretism, or assimilation. Exemplified by the Candomblé re-Africanization movement in Bahia and the movement to remove Catholic saint imagery from Lucumí/Ocha practice."
      },
      "skos:inScheme": {
        "@id": "iroko:MovementTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Re-Africanization"
        },
        {
          "@language": "es",
          "@value": "Re-africanización"
        },
        {
          "@language": "fr",
          "@value": "Ré-africanisation"
        }
      ]
    },
    {
      "@id": "iroko:ReclamationMovement",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An organized or semi-organized community effort to recover, revitalize, or Africanize a Afro-Atlantic religious tradition. Examples: the Candomblé re-Africanization movement beginning in the 1930s–70s (Mãe Aninha, Martiniano do Bonfim, and later the SECNEB research agenda); the Lucumí decolonization efforts removing Catholic syncretism from Ocha practice; the Ifá revival in Trinidad and other Afro-Atlantic communities seeking direct Yorùbá validation; the African American Ifá reclamation beginning in the late 20th century. A movement is documented without adjudicating whether its claims of authenticity are correct."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Reclamation Movement"
      },
      "rdfs:subClassOf": [
        {
          "@id": "https://schema.org/Event"
        },
        {
          "@id": "iroko:SacredEntity"
        }
      ]
    },
    {
      "@id": "iroko:currentCommunity",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The house or community practicing this reconstructed tradition. Range: iroko:House."
      },
      "rdfs:domain": {
        "@id": "iroko:ReconstructedPractice"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-sankofa"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "current practicing community"
      },
      "rdfs:range": {
        "@id": "iroko:House"
      }
    },
    {
      "@id": "iroko:recognition-formally-recognized",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The reconstructed or Afro-Atlantic practice has received formal recognition from a source tradition authority."
      },
      "skos:inScheme": {
        "@id": "iroko:RecognitionStatusScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Formally recognized"
      }
    },
    {
      "@id": "iroko:SlavePaperPeriodScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Chronological periods reflecting distinct legal regimes in the Atlantic slave trade, as defined in the TiSP (Trafficking in Slave Paper) project framework."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Atlantic Trade Periods (TiSP)"
      },
      "skos:hasTopConcept": [
        {
