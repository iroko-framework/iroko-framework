        {
          "@id": "iroko:entityType-mpungo-inquice"
        },
        {
          "@id": "iroko:entityType-nfumbe"
        },
        {
          "@id": "iroko:entityType-ori"
        },
        {
          "@id": "iroko:entityType-orisa"
        },
        {
          "@id": "iroko:entityType-spirit-of-element"
        },
        {
          "@id": "iroko:entityType-spirit-of-place"
        },
        {
          "@id": "iroko:entityType-vodun"
        }
      ]
    },
    {
      "@id": "iroko:number",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Sacred number or numbers associated with this entity. Example: 8 (Oshun), 16 (Obatala), 4 and 6 (Shango). Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sacred number"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:element",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Natural element or sphere associated with this entity. Example: ocean (Yemaya), river (Oshun), cemetery (Oya Igbale, Baron Samedi), forest (Ochosi, Ogun). Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "element"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:pathName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The name of this specific path or camino. Example: Oya Yansa, Oya Igbale, Oshun Ibu Kole, Obatala Ocha Grinan. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:Path"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "path name"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:path",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a SpiritualEntity to its known Path instances (caminos/avatars). A single entity may have many paths. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "path"
      },
      "rdfs:range": {
        "@id": "iroko:Path"
      }
    },
    {
      "@id": "iroko:domain",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The sphere of influence or governance of this entity. Example: iron, war, roads (Ogun); love, rivers, beauty (Oshun); wind, death, transformation (Oya). Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "domain"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:TemperamentScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Temperament or spiritual disposition of an entity or path. Reflects the nature and quality of the entity's energy and how it is approached in ritual."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Temperament Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:temperament-cool-sweet"
        },
        {
          "@id": "iroko:temperament-hot-fierce"
        },
        {
          "@id": "iroko:temperament-liminal"
        },
        {
          "@id": "iroko:temperament-transformative"
        }
      ]
    },
    {
      "@id": "iroko:offering-candle-light",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Candles or other light sources offered or burned for an entity."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Candle/Light"
      }
    },
    {
      "@id": "iroko:entityType-vodun",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Vodu"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Divine forces in Fon/Ewe-derived traditions including Arara in Cuba. Related to but distinct from Haitian lwa; represents the continental Dahomean tradition."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Vodun"
      }
    },
    {
      "@id": "iroko:entityType-lwa-rada",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Loa Rada"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Spirits of the Rada nanchon in Haitian Vodou. Generally cool, sweet, and beneficent in temperament. Primary Fon/Dahomey origins. Received with white and light colors."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lwa (Rada)"
      }
    },
    {
      "@id": "iroko:offering-drink",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Liquids offered to an entity: water, rum, wine, honey, etc."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Drink"
      }
    },
    {
      "@id": "iroko:SpiritKinshipRelationScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Controlled kinship relation types for spirit-to-spirit relationship assertions. Used as the range of iroko:relationType on iroko:RelationshipAssertion nodes. Kinship in this context is cosmological, not biological."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Spirit Kinship Relation Types"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:kinship-brother-of"
        },
        {
          "@id": "iroko:kinship-child-of"
        },
        {
          "@id": "iroko:kinship-father-of"
        },
        {
          "@id": "iroko:kinship-mother-of"
        },
        {
          "@id": "iroko:kinship-parent-of"
        },
        {
          "@id": "iroko:kinship-sibling-of"
        },
        {
          "@id": "iroko:kinship-sister-of"
        },
        {
          "@id": "iroko:kinship-spouse-of"
        },
        {
          "@id": "iroko:kinship-twin-of"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Spirit Kinship Relations"
        },
        {
          "@language": "es",
          "@value": "Relaciones de parentesco espiritual"
        },
        {
          "@language": "fr",
          "@value": "Relations de parenté spirituelle"
        },
        {
          "@language": "pt",
          "@value": "Relações de parentesco espiritual"
        },
        {
          "@language": "yo",
          "@value": "Ìbátan ẹ̀mí sí ẹ̀mí"
        }
      ]
    },
    {
      "@id": "iroko:polarity-androgynous",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Masculine and feminine qualities are simultaneously present and inseparable. Distinct from aspect-dependent, where polarity shifts between manifestations."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Obatala in many lineages simultaneously embodies masculine and feminine principles, expressed in white, stillness, and completion."
      },
      "skos:inScheme": {
        "@id": "iroko:PolarityModalityScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Androgynous"
        },
        {
          "@language": "es",
          "@value": "Andrógino"
        },
        {
          "@language": "fr",
          "@value": "Androgyne"
        },
        {
          "@language": "pt",
          "@value": "Andrógino"
        },
        {
          "@language": "yo",
          "@value": "Akọ àti abo papọ̀"
        }
      ]
    },
    {
      "@id": "iroko:entityType-ori",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The individual divine head and personal destiny in Yoruba and Yoruba-derived traditions. Not an external spirit but the innermost self and personal divine principle. Ori has a shrine (ile ori), receives rogacion and propitiation, and is considered the most important force in an individual's life. Its guidance supersedes that of the orisa."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ori"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Ori is ontologically distinct from the orisa — personal rather than cosmic, internal rather than external. It should not be classified under orisa."
      }
    },
    {
      "@id": "iroko:offering-labor-action",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Dedicated labor, service, or action performed as offering. Example: building a shrine, completing a vow, acts of charity associated with an entity's domain."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Labor/Action"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-nkisi",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-18"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Domain module. Vocabulary for documenting spiritual entities across Afro-Atlantic traditions. Covers orisa, lwa, mpungo/inquice, vodun, egun, ajogun, nature spirits, Espiritismo guides and commissions, and Ori. Supports path/camino modeling, shrine documentation, and syncretic identity tracking. Use with iroko-agency for manifestation events; iroko-authority to govern who may assert claims about entity identity, kinship, or caminos; iroko-narrative for patakí, odù verse attribution, and contested kinship claims."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-07"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-agency"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-narrative"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Nkisi Module (Spiritual Entities)"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:commission-madama",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Commission of maternal African or Afro-Caribbean women spirits, often depicted as market women or healers. Work with protection, home, healing, and practical matters."
      },
      "skos:inScheme": {
        "@id": "iroko:CommissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Madama"
      }
    },
    {
      "@id": "iroko:kinship-child-of",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:SpiritKinshipRelationScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "child of"
        },
        {
          "@language": "es",
          "@value": "hijo o hija de"
        },
        {
          "@language": "fr",
          "@value": "enfant de"
        },
        {
          "@language": "pt",
          "@value": "filho ou filha de"
        },
        {
          "@language": "yo",
          "@value": "ọmọ fún"
        }
      ]
    },
    {
      "@id": "iroko:polarity-temporal",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Seasonal polarity shift"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Polarity shifts according to time of year, liturgical calendar, season, or ritual period. The shift is cyclical and predictable, not camino-specific."
      },
      "skos:inScheme": {
        "@id": "iroko:PolarityModalityScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Temporal"
        },
        {
          "@language": "es",
          "@value": "Temporal"
        },
        {
          "@language": "fr",
          "@value": "Temporel"
        },
        {
          "@language": "pt",
          "@value": "Temporal"
        },
        {
          "@language": "yo",
          "@value": "Gẹ́gẹ́ bí àsìkò"
        }
      ]
    },
    {
      "@id": "iroko:day",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Day of the week or calendar feast day associated with this entity. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sacred day"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:pathOfferingDetailed",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Offering details specific to this path. May differ significantly from parent entity offerings. Access: initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:Path"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "path offering (detailed)"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:temperament-transformative",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Entities whose primary nature is change, transition, and transformation. Neither simply cool nor hot; work with both destruction and creation. Example: Oya, Elegba."
      },
      "skos:inScheme": {
        "@id": "iroko:TemperamentScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Transformative"
      }
    },
    {
      "@id": "iroko:kinship-mother-of",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:SpiritKinshipRelationScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "mother of"
        },
        {
          "@language": "es",
          "@value": "madre de"
        },
        {
          "@language": "fr",
          "@value": "mère de"
        },
        {
          "@language": "pt",
          "@value": "mãe de"
        },
        {
          "@language": "yo",
          "@value": "ìyá fún"
        }
      ]
    },
    {
      "@id": "iroko:entityType-espiritu-commission",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Commission Spirit"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A spirit belonging to a named commission (comision) in Espiritismo. Commissions are groups of spirits sharing a common historical, cultural, or archetypal identity. Commission type is documented via iroko:commissionType property and the CommissionTypeScheme."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Espiritu de Commission"
      }
    },
    {
      "@id": "iroko:pathColor",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Color specific to this path, which may differ from the parent entity's general colors. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:Path"
