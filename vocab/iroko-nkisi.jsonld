{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:Shrine",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A consecrated physical space or vessel housing a spiritual entity. Includes ile (houses), soperas, nganga, peristyle altars, and boveda. Shrine records link physical location and custody to the entity and tradition. Operational shrine details are access-restricted."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Shrine"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredSpecimen"
      }
    },
    {
      "@id": "iroko:color",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Sacred color or color combination associated with this entity. Example: white (Obatala), yellow and gold (Oshun), red and white (Shango). Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "color"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:polarity-feminine",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Consistent feminine polarity in ritual address, manifestation, and alignment across known caminos."
      },
      "skos:inScheme": {
        "@id": "iroko:PolarityModalityScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Feminine"
        },
        {
          "@language": "es",
          "@value": "Femenino"
        },
        {
          "@language": "fr",
          "@value": "Féminin"
        },
        {
          "@language": "pt",
          "@value": "Feminino"
        },
        {
          "@language": "yo",
          "@value": "Abo"
        }
      ]
    },
    {
      "@id": "iroko:commission-marinero",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Sailor"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Commission of sailor or seafaring spirits. Work with travel, navigation, and matters of the sea. Reflect Caribbean maritime culture."
      },
      "skos:inScheme": {
        "@id": "iroko:CommissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Marinero"
      }
    },
    {
      "@id": "iroko:entityType-orisa",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Orisha"
        },
        {
          "@language": "en",
          "@value": "Orixa"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Divine forces in Yoruba and Yoruba-derived traditions (Lucumi, Candomble Ketu, Trinidad Orisha, Oyotunji). Orisa are cosmic powers governing natural and human domains, each with specific attributes, offerings, colors, and numbers."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Orisa"
      }
    },
    {
      "@id": "iroko:kinship-spouse-of",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:SpiritKinshipRelationScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "spouse of"
        },
        {
          "@language": "es",
          "@value": "cónyuge de"
        },
        {
          "@language": "fr",
          "@value": "époux ou épouse de"
        },
        {
          "@language": "pt",
          "@value": "cônjuge de"
        },
        {
          "@language": "yo",
          "@value": "alábàáṣiṣẹ́ ìgbéyàwó fún"
        }
      ]
    },
    {
      "@id": "iroko:pathDomain",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The specific domain of this path, which may differ from the parent entity's general domain. Example: Oshun Ibu Kole governs vultures and transformation, distinct from Oshun's general river domain. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:Path"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "path domain"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:taboo",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Prohibitions associated with this entity: foods, behaviors, or materials to avoid. Access: community-only."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "taboo"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:entityType-spirit-of-place",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Faires"
        },
        {
          "@language": "en",
          "@value": "Spirit of the Land"
        },
        {
          "@language": "en",
          "@value": "Woodland Spirit"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Spirits tied to specific locations, landscapes, or natural features: forests, rivers, crossroads, mountains, specific trees or stones. Not the dead, not divine powers, not malevolent by nature. Engaged through offering and acknowledgment. Found across multiple traditions including Hoodoo and syncretic folk practices."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Spirit of Place"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The term Faires may reflect crossover from European folk traditions into Hoodoo and syncretic contexts. Terminological certainty varies by regional tradition. Document tradition-specific terminology via iroko:alternateNames and iroko:tradition on individual instances."
      }
    },
    {
      "@id": "iroko:offering-animal",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Animal sacrifice or offering. Category is public; specific animals, method, and context are initiated-only."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Animal"
      }
    },
    {
      "@id": "iroko:commission-medical",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Comision Medica"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Commission of spirits who were doctors, healers, or medical practitioners in life. Work with healing and health matters. Sometimes called upon in misa for diagnosis."
      },
      "skos:inScheme": {
        "@id": "iroko:CommissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Medical Commission"
      }
    },
    {
      "@id": "iroko:relatedEntity",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Another spiritual entity with a significant relationship to this one. Example: Elegba and Ogun (road and iron); Oya and Shango (consort). Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "related entity"
      },
      "rdfs:range": {
        "@id": "iroko:SpiritualEntity"
      }
    },
    {
      "@id": "iroko:offering-money-coin",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Coins or currency offered to an entity, particularly common with Elegba, Oshun, and market-oriented spirits."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Money/Coin"
      }
    },
    {
      "@id": "iroko:shrine",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a spiritual entity to a documented shrine or vessel. Access: community-only."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "shrine"
      },
      "rdfs:range": {
        "@id": "iroko:Shrine"
      }
    },
    {
      "@id": "iroko:entityType-espiritu-guia",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Guide"
        },
        {
          "@language": "en",
          "@value": "Spirit Guide"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "A personal spirit guide in the Espiritismo tradition. Part of an individual's cuadro espiritual (spiritual frame). Guides may be ancestral relatives, historical figures, or evolved spirits assigned to assist a specific person. Identified through mediumship and misa espiritual."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Espiritu Guia"
      }
    },
    {
      "@id": "iroko:salutation",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Formal greeting or praise name used when addressing this entity in ceremony. Access: initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "salutation"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:parentEntity",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The SpiritualEntity of which this Path is an aspect or manifestation."
      },
      "rdfs:domain": {
        "@id": "iroko:Path"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "parent entity"
      },
      "rdfs:range": {
        "@id": "iroko:SpiritualEntity"
      }
    },
    {
      "@id": "iroko:entityType-lwa-petwo",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Loa Petro"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Spirits of the Petwo nanchon in Haitian Vodou. Hot, fierce, and transformative in temperament. Kongo, New World maroon, and creole origins. Associated with fire and gunpowder."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lwa (Petwo)"
      }
    },
    {
      "@id": "iroko:temperament-liminal",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Entities who exist at thresholds — between life and death, sacred and profane, this world and the next. Example: Ghede lwa, Eshu/Elegba as gatekeeper, Oya Igbale."
      },
      "skos:inScheme": {
        "@id": "iroko:TemperamentScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Liminal"
      }
    },
    {
      "@id": "iroko:pathSyncreticIdentity",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Catholic saint or other syncretic correspondence specific to this path, if different from parent entity. Example: some paths of Oshun correspond to Our Lady of Charity; others to Our Lady of Candelaria. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:Path"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "path syncretic identity"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:traditionalName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Name of this entity in its tradition of origin. May differ from diaspora names. Example: Sango (Yoruba continental) vs. Shango (Lucumi) vs. Xango (Candomble). Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "traditional name"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:lineageNotes",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Notes on which lineages recognize this path and any contested aspects of its identity or attributes. Access: community-only."
      },
      "rdfs:domain": {
        "@id": "iroko:Path"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "lineage notes"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:kinship-sister-of",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:SpiritKinshipRelationScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "sister of"
        },
        {
          "@language": "es",
          "@value": "hermana de"
        },
        {
          "@language": "fr",
          "@value": "sœur de"
        },
        {
          "@language": "pt",
          "@value": "irmã de"
        },
        {
          "@language": "yo",
          "@value": "ẹ̀gbọ́n tàbí àbúròbìnrin fún"
        }
      ]
    },
    {
      "@id": "iroko:OfferingTypeScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "General categories of offerings given to spiritual entities. Specific quantities and preparation are access-restricted; these general categories are public."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Offering Type Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:offering-animal"
        },
        {
          "@id": "iroko:offering-candle-light"
        },
        {
          "@id": "iroko:offering-cloth-fabric"
        },
        {
          "@id": "iroko:offering-drink"
        },
        {
          "@id": "iroko:offering-food"
        },
        {
          "@id": "iroko:offering-labor-action"
        },
        {
          "@id": "iroko:offering-money-coin"
        },
        {
          "@id": "iroko:offering-music-song"
        },
        {
          "@id": "iroko:offering-object"
        },
        {
          "@id": "iroko:offering-plant"
        },
        {
          "@id": "iroko:offering-water"
        }
      ]
    },
    {
      "@id": "iroko:temperament-cool-sweet",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Frio"
        },
        {
          "@language": "en",
          "@value": "Rada"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Entities of cool, gentle, beneficent energy. Approached with white and light colors, cool water, and gentle offerings. Example: Obatala, Yemaya (certain paths), Rada lwa."
      },
      "skos:inScheme": {
        "@id": "iroko:TemperamentScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Cool/Sweet"
      }
    },
    {
      "@id": "iroko:kinship-twin-of",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:SpiritKinshipRelationScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "twin of"
        },
        {
          "@language": "es",
          "@value": "gemelo o gemela de"
        },
        {
          "@language": "fr",
          "@value": "jumeau ou jumelle de"
        },
        {
          "@language": "pt",
          "@value": "gêmeo ou gêmea de"
        },
        {
          "@language": "yo",
          "@value": "ìbejì fún"
        }
      ],
      "skos:scopeNote": {
        "@language": "en",
        "@value": "In Lucumí cosmology, Ibeji (twins) hold specific sacred status. This relation type should be used with iroko:assertionStatus to indicate whether the twin relationship is consensual or lineage-specific."
      }
    },
    {
      "@id": "iroko:commission-celestial",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Comision Celestial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Commission of highly evolved or elevated spirits associated with light, purity, and spiritual advancement. May include spirits identified as angels or exalted ancestors."
      },
      "skos:inScheme": {
        "@id": "iroko:CommissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Celestial Commission"
      }
    },
    {
      "@id": "iroko:PolarityModalityScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Controlled terms for describing metaphysical polarity or gendered alignment in ritual address, cosmology, and manifestation. This scheme does not describe biological sex. Multiple concepts may apply to a single entity via different paths (iroko:RelationshipAssertion with assertionScope for camino-level distinctions)."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Polarity and Gender Modality"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:polarity-androgynous"
        },
        {
          "@id": "iroko:polarity-apolar"
        },
        {
          "@id": "iroko:polarity-aspect-dependent"
        },
        {
          "@id": "iroko:polarity-feminine"
        },
        {
          "@id": "iroko:polarity-masculine"
        },
        {
          "@id": "iroko:polarity-temporal"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Polarity and Gender Modality"
        },
        {
          "@language": "es",
          "@value": "Polaridad y modalidad de género"
        },
        {
          "@language": "fr",
          "@value": "Polarité et modalité de genre"
        },
        {
          "@language": "pt",
          "@value": "Polaridade e modalidade de gênero"
        },
        {
          "@language": "yo",
          "@value": "Ìṣọ̀kan agbára àti ìwà ìbálò"
        }
      ]
    },
    {
      "@id": "iroko:commission-intranquil",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Espiritu Intranquilo"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Spirits who died in conflict, trauma, or without resolution. Worked cautiously; associated with unrest and unfinished business. Distinct from the other commissions in that they are engaged for specific workings rather than as ongoing guides."
      },
      "skos:inScheme": {
        "@id": "iroko:CommissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Intranquil Spirit"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Intranquil spirits occupy a contested category in Espiritismo — some practitioners consider them dangerous and do not work with them. Document lineage position via iroko:contestedNotes."
      }
    },
    {
      "@id": "iroko:offeringDetailed",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Specific offering details: exact foods, quantities, preparation methods. Access: initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "offering (detailed)"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:pathNumber",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Sacred number specific to this path. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:Path"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
