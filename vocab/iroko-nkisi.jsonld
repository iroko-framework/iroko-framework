        {
          "@id": "iroko:entityType-espiritu-commission"
        },
        {
          "@id": "iroko:entityType-espiritu-guia"
        },
        {
          "@id": "iroko:entityType-lwa-ghede"
        },
        {
          "@id": "iroko:entityType-lwa-petwo"
        },
        {
          "@id": "iroko:entityType-lwa-rada"
