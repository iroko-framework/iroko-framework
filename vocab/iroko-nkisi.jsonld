        "@value": "path number"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:commission-indio",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Native American"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Commission of Indigenous American spirits. Work with nature, healing, and the land. Common in Cuban, Puerto Rican, and Dominican Espiritismo reflecting indigenous Taino presence."
      },
      "skos:inScheme": {
        "@id": "iroko:CommissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Indio"
      }
    },
    {
      "@id": "iroko:entityType-spirit-of-element",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Elemental Spirit"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Spirits governing elemental forces — water, wind, fire, earth, lightning — not otherwise classified as orisa, lwa, or other named divine powers. Includes elemental presences recognized in folk traditions and syncretic contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Spirit of Element"
      }
    },
    {
      "@id": "iroko:offering-water",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Fresh water, ocean water, river water, or blessed water offered to an entity."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Water"
      }
    },
    {
      "@id": "iroko:commission-congo",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Commission of Kongo-derived spirits in Espiritismo. Work with earthy, transformative, and protective matters. Bridge between Espiritismo and Palo traditions in syncretic practice."
      },
      "skos:inScheme": {
        "@id": "iroko:CommissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Congo"
      }
    },
    {
      "@id": "iroko:SpiritualEntity",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A divine power, ancestral spirit, nature spirit, adversarial force, or personal essence recognized and engaged within an Afro-Atlantic tradition. Includes orisa, lwa, mpungo/inquice, vodun, egun, ajogun, Ori, Espiritismo guides and commissions, and spirits of place and element."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Spiritual Entity"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:Spirit"
      }
    },
    {
      "@id": "iroko:entityType-egun",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Ancestors"
        },
        {
          "@language": "en",
          "@value": "Eggun"
        },
        {
          "@language": "en",
          "@value": "The Dead"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The ancestral dead across Afro-Atlantic traditions. Not tradition-specific: encompasses egungún (Yoruba), the dead honored at boveda (Espiritismo), ancestral courts in Vodou, and the honored dead in all traditions where ancestors are engaged. The dead precede and supersede the orisa and lwa in most traditions."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Egun"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Egun as a category is deliberately cross-traditional. Tradition-specific practices of ancestral engagement are documented via the iroko:tradition property on individual instances."
      }
    },
    {
      "@id": "iroko:entityType-ajogun",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Adversarial Force"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Adversarial cosmic forces in Yoruba cosmology. The principal Ajogun are Iku (Death), Arun (Disease), Ofo (Loss), Egba (Paralysis), Oran (Legal Trouble), Epe (Curse), Ewon (Imprisonment), and Ese (all other afflictions). Powerful forces that are propitiated or deflected rather than worshipped. Not deities; not ancestors; ontologically distinct from orisa."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ajogun"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Ajogun are not evil spirits in a moral sense but cosmic forces of adversity that must be balanced. Their propitiation is a legitimate archival and ritual category distinct from orisa worship."
      }
    },
    {
      "@id": "iroko:entityType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Classification of this spiritual entity within the EntityType scheme. Values: iroko:entityType-orisa, iroko:entityType-lwa-rada, iroko:entityType-lwa-petwo, iroko:entityType-lwa-ghede, iroko:entityType-mpungo-inquice, iroko:entityType-vodun, iroko:entityType-ori, iroko:entityType-egun, iroko:entityType-nfumbe, iroko:entityType-espiritu-guia, iroko:entityType-espiritu-commission, iroko:entityType-spirit-of-place, iroko:entityType-spirit-of-element, iroko:entityType-ajogun. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "entity type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:entityType-mpungo-inquice",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Inquice"
        },
        {
          "@language": "en",
          "@value": "Mpungu"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Divine forces in Bantu-derived traditions: Mpungo in Palo Monte and Mayombe, Inquice in Candomble Angola. These are the same cosmic powers known by different names in the Kongo religious continuum. Example: Zarabanda (Palo) corresponds to Ogum (Candomble Angola)."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Mpungo/Inquice"
      }
    },
    {
      "@id": "iroko:Path",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A distinct manifestation, aspect, or camino of a spiritual entity. Paths share the parent entity's fundamental nature but have distinct domains, temperaments, colors, numbers, offerings, and sometimes distinct syncretic identities. Example: Oya Yansa (fierce warrior aspect) vs. Oya Igbale (governess of the cemetery). Paths are not separate entities but distinct faces of the same power."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Path"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:offeringGeneral",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "General category of offering accepted by this entity. Values from OfferingTypeScheme. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "offering (general)"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:Offering",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A material or symbolic offering given to a spiritual entity. Includes food, drink, objects, colors, animals, and actions. General offering categories are public; specific quantities, combinations, and preparation details are access-restricted."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Offering"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:kinship-father-of",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:SpiritKinshipRelationScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "father of"
        },
        {
          "@language": "es",
          "@value": "padre de"
        },
        {
          "@language": "fr",
          "@value": "père de"
        },
        {
          "@language": "pt",
          "@value": "pai de"
        },
        {
          "@language": "yo",
          "@value": "bàbá fún"
        }
      ]
    },
    {
      "@id": "iroko:syncreticIdentity",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Catholic saint or other syncretic correspondence for this entity. Prevents santos from slipping through classification gaps. Example: Shango syncretizes with Santa Barbara in Lucumi; Ogou with Saint Jacques in Vodou. Free text to accommodate regional and lineage variation. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "syncretic identity"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:pathTaboo",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Prohibitions specific to this path. Access: community-only."
      },
      "rdfs:domain": {
        "@id": "iroko:Path"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "path taboo"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:entityType-nfumbe",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The human dead bound to a nganga in Palo Monte and Mayombe. Ontologically distinct from free ancestors (egun): the nfumbe enters a specific contractual and coercive relationship with the Palero and the nganga vessel. The nfumbe works within the nganga and is not free."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Nfumbe"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Nfumbe should not be classified as egun. The bound nature of the nfumbe is a defining characteristic with significant ethical and archival implications."
      }
    },
    {
      "@id": "iroko:entityType-lwa-ghede",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Gede"
        },
        {
          "@language": "en",
          "@value": "Loa Gede"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Spirits of the Ghede nanchon in Haitian Vodou. Govern death, sexuality, resurrection, and the boundary between living and dead. Liminal in temperament. Composite New World origins distinct from both Rada and Petwo."
      },
      "skos:inScheme": {
        "@id": "iroko:EntityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lwa (Ghede)"
      }
    },
    {
      "@id": "iroko:polarity-aspect-dependent",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Camino-dependent"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Polarity varies by named camino, avatar, path, or manifestation. Individual paths should carry their own polarity assertion via iroko:RelationshipAssertion with assertionScope."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Oya presents as feminine in most lineages but some roads (caminos) of Oya are understood as masculine or androgynous."
      },
      "skos:inScheme": {
        "@id": "iroko:PolarityModalityScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Aspect-Dependent"
        },
        {
          "@language": "es",
          "@value": "Dependiente del aspecto"
        },
        {
          "@language": "fr",
          "@value": "Dépendant de l'aspect"
        },
        {
          "@language": "pt",
          "@value": "Dependente do aspecto"
        },
        {
          "@language": "yo",
          "@value": "Gẹ́gẹ́ bí àwòrán tí a fihàn"
        }
      ]
    },
    {
      "@id": "iroko:kinship-parent-of",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:SpiritKinshipRelationScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "parent of"
        },
        {
          "@language": "es",
          "@value": "progenitor de"
        },
        {
          "@language": "fr",
          "@value": "parent de"
        },
        {
          "@language": "pt",
          "@value": "genitor de"
        },
        {
          "@language": "yo",
          "@value": "òbí fún"
        }
      ],
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Use when the gendered parent role is unspecified or ambiguous in source material."
      }
    },
    {
      "@id": "iroko:offering-food",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Prepared or natural foods offered to an entity. Specific foods are tradition and entity specific."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Food"
      }
    },
    {
      "@id": "iroko:offering-music-song",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Songs, drumming, or music performed in honor of an entity. General category is public; specific songs and rhythms are initiated-only."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Music/Song"
      }
    },
    {
      "@id": "iroko:commissionType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "For espiritu-commission entities: the specific commission they belong to. Values from CommissionTypeScheme. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "commission type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:plantAssociation",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Plants associated with this entity. Links to ewe:Plant instances. Inverse of ewe:entityAssociation. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SpiritualEntity"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "plant association"
      },
      "rdfs:range": {
        "@id": "iroko:Plant"
      }
    },
    {
      "@id": "iroko:temperament-hot-fierce",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Caliente"
        },
        {
          "@language": "en",
          "@value": "Petwo"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Entities of hot, intense, warrior energy. Approached with fire, iron, rum, and strong offerings. Example: Ogun, Shango, Petwo lwa."
      },
      "skos:inScheme": {
        "@id": "iroko:TemperamentScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Hot/Fierce"
      }
    },
    {
      "@id": "iroko:kinship-sibling-of",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:SpiritKinshipRelationScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "sibling of"
        },
        {
          "@language": "es",
          "@value": "hermano o hermana de"
        },
        {
          "@language": "fr",
          "@value": "frère ou sœur de"
        },
        {
          "@language": "pt",
          "@value": "irmão ou irmã de"
        },
        {
          "@language": "yo",
          "@value": "ará fún"
        }
      ],
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Use when gendered sibling distinction is absent or contested in source material."
      }
    },
    {
      "@id": "iroko:commission-gitano",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Gypsy"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Commission of Romani spirits. Work with divination, luck, commerce, and love. Often approached for card reading and matters of fortune."
      },
      "skos:inScheme": {
        "@id": "iroko:CommissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Gitano"
      }
    },
    {
      "@id": "iroko:offering-plant",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Plants, flowers, or herbal preparations offered to an entity. Links to ewe:Plant instances."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Plant/Herb"
      }
    },
    {
      "@id": "iroko:polarity-masculine",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Consistent masculine polarity in ritual address, manifestation, and alignment across known caminos."
      },
      "skos:inScheme": {
        "@id": "iroko:PolarityModalityScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Masculine"
        },
        {
          "@language": "es",
          "@value": "Masculino"
        },
        {
          "@language": "fr",
          "@value": "Masculin"
        },
        {
          "@language": "pt",
          "@value": "Masculino"
        },
        {
          "@language": "yo",
          "@value": "Akọ"
        }
      ]
    },
    {
      "@id": "iroko:offering-cloth-fabric",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Fabric, beads, or clothing offered or draped for an entity in the entity's sacred colors."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Cloth/Fabric"
      }
    },
    {
      "@id": "iroko:offering-object",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Ritual objects, implements, or symbolic items offered or dedicated to an entity."
      },
      "skos:inScheme": {
        "@id": "iroko:OfferingTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Sacred Object"
      }
    },
    {
      "@id": "iroko:commission-arabe",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Arab"
        },
        {
          "@language": "en",
          "@value": "Moro"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Commission of Arab or Moorish spirits. Work with commerce, prosperity, and esoteric knowledge. Reflect historical Moorish presence in Iberian culture transmitted to the Caribbean."
      },
      "skos:inScheme": {
        "@id": "iroko:CommissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Arabe"
      }
    },
    {
      "@id": "iroko:pathTemperament",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Temperament of this specific path. Values from TemperamentScheme. A path may have a different temperament than its parent entity. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:Path"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-nkisi"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "path temperament"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:commission-africano",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Commission of African spirits, often depicted as enslaved Africans or African elders. Work with strength, protection, and grounding. Among the most powerful commissions."
      },
      "skos:inScheme": {
        "@id": "iroko:CommissionTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Africano"
      }
    },
    {
      "@id": "iroko:polarity-apolar",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Beyond polarity"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Not described in gendered or polarity terms, or explicitly transcending the masculine/feminine binary. Not the same as unknown."
      },
      "skos:inScheme": {
        "@id": "iroko:PolarityModalityScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Apolar"
        },
        {
          "@language": "es",
          "@value": "Apolar"
        },
        {
          "@language": "fr",
          "@value": "Apolaire"
        },
        {
          "@language": "pt",
          "@value": "Apolar"
        },
        {
          "@language": "yo",
          "@value": "Àìní ìṣọ̀kan"
        }
      ]
    },
    {
      "@id": "iroko:EntityTypeScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Classification of spiritual entity types across Afro-Atlantic traditions. Organized by ontological category: divine powers, personal essence, ancestral spirits, nature spirits, and adversarial forces."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Entity Type Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:entityType-ajogun"
        },
        {
          "@id": "iroko:entityType-egun"
