@prefix iroko:    <https://ontology.irokosociety.org/core/> .
@prefix iroko-ag: <https://ontology.irokosociety.org/agency/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.irokosociety.org/agency/>
    a owl:Ontology ;
    rdfs:label "Iroko agency module"@en ;
    dcterms:description "Defines a sovereignty-aligned agency model for sacred systems. Designed to degrade gracefully: minimal use requires only SacredAgent, Spirit, and RitualEvent. Additional classes and properties are optional and additive."@en ;
    dcterms:creator "Iroko Historical Society"@en ;
    dcterms:issued "2026-02-22"^^xsd:date ;
    dcterms:license <https://ontology.irokosociety.org/policy/terms-of-use> ;
    dcterms:isPartOf <https://ontology.irokosociety.org/> ;
    dcterms:references <http://www.w3.org/ns/prov#> ;
    dcterms:requires <https://ontology.irokosociety.org/core/> .

# ===================================================================
# CORE CLASSES (minimal profile uses these)
# ===================================================================

iroko-ag:SacredAgent
    a owl:Class ;
    rdfs:label "Sacred Agent"@en ;
    rdfs:comment "An entity recognized within a ritual system as capable of intentional action, authorization, refusal, protection, sanctioning, or manifestation. This class is defined without metaphysical claims. It enables structured modeling of agency in sovereignty-aware archives."@en .

iroko-ag:Spirit
    a owl:Class ;
    rdfs:subClassOf iroko-ag:SacredAgent ;
    rdfs:label "Spirit"@en ;
    rdfs:comment "A sacred agent recognized as a spirit within a cultural and ritual framework. Specific typologies can be modeled via subclasses or concept schemes."@en .

iroko-ag:RitualEvent
    a owl:Class ;
    rdfs:label "Ritual Event"@en ;
    rdfs:comment "A time-bounded ritual activity in which agents participate. A ritual event can generate claims, permissions, constraints, or records. Temporal calendar time should use PROV time properties in instance data when needed."@en .

# ===================================================================
# OPTIONAL EVENT SUBCLASSES (elaborate profile)
# ===================================================================

iroko-ag:ManifestationEvent
    a owl:Class ;
    rdfs:subClassOf iroko-ag:RitualEvent ;
    rdfs:label "Manifestation Event"@en ;
    rdfs:comment "A ritual event in which a sacred agent is asserted to manifest through a medium, place, dream, divination, or other mode."@en .

iroko-ag:AuthorizationEvent
    a owl:Class ;
    rdfs:subClassOf iroko-ag:RitualEvent ;
    rdfs:label "Authorization Event"@en ;
    rdfs:comment "A ritual event in which authorization is asserted, delegated, conditioned, or revoked. This supports sovereignty modeling for access, disclosure, and stewardship mandates."@en .

iroko-ag:RefusalEvent
    a owl:Class ;
    rdfs:subClassOf iroko-ag:RitualEvent ;
    rdfs:label "Refusal Event"@en ;
    rdfs:comment "A ritual event in which a sacred agent is asserted to refuse participation, disclosure, access, or a requested action."@en .

# ===================================================================
# OPTIONAL SUPPORT CLASSES (elaborate profile)
# ===================================================================

iroko-ag:RitualAction
    a owl:Class ;
    rdfs:label "Ritual Action"@en ;
    rdfs:comment "A typed action asserted to be performed or effected within ritual practice. Used when finer granularity than RitualEvent is needed."@en .

iroko-ag:AuthorizationChain
    a owl:Class ;
    rdfs:label "Authorization Chain"@en ;
    rdfs:comment "A structured representation of delegated or layered authority across agents, mandates, and conditions. Used for ritual governance and stewardship contexts."@en .

iroko-ag:StewardshipMandate
    a owl:Class ;
    rdfs:label "Stewardship Mandate"@en ;
    rdfs:comment "A mandate asserted to govern stewardship, custody, disclosure, or use of materials. Can be associated with agents and can condition access policies."@en .

iroko-ag:RitualConsequence
    a owl:Class ;
    rdfs:label "Ritual Consequence"@en ;
    rdfs:comment "An outcome category used to describe asserted consequences of ritual actions or events. This is descriptive and does not claim causal certainty."@en .

# ===================================================================
# CORE PROPERTIES (minimal profile can use these)
# ===================================================================

iroko-ag:involvesAgent
    a owl:ObjectProperty ;
    rdfs:label "involves agent"@en ;
    rdfs:comment "Links an event, action, or assertion node to an agent involved. This complements PROV association properties in instance data."@en ;
    rdfs:range iroko-ag:SacredAgent .

iroko-ag:hasOutcome
    a owl:ObjectProperty ;
    rdfs:label "has outcome"@en ;
    rdfs:comment "Links an event or action to an outcome entity such as a RelationshipAssertion, AccessPolicy, EpistemicConstraint, or record."@en .

# ===================================================================
# OPTIONAL PROPERTIES (elaborate profile)
# ===================================================================

iroko-ag:hasAuthorizationChain
    a owl:ObjectProperty ;
    rdfs:label "has authorization chain"@en ;
    rdfs:comment "Associates a RitualEvent or policy with an AuthorizationChain."@en ;
    rdfs:range iroko-ag:AuthorizationChain .

iroko-ag:hasMandate
    a owl:ObjectProperty ;
    rdfs:label "has mandate"@en ;
    rdfs:comment "Associates an agent, event, or policy with a StewardshipMandate."@en ;
    rdfs:range iroko-ag:StewardshipMandate .

iroko-ag:hasRitualConsequence
    a owl:ObjectProperty ;
    rdfs:label "has ritual consequence"@en ;
    rdfs:comment "Associates an event or action with a RitualConsequence category."@en ;
    rdfs:range iroko-ag:RitualConsequence .

# Cross-cutting qualifier hook
iroko-ag:hasTemporalVariation
    a owl:ObjectProperty ;
    rdfs:label "has temporal variation"@en ;
    rdfs:comment "Cross-cutting qualifier that reuses the core TemporalVariation scheme to express time-based or context-based variation on agency-related resources."@en ;
    rdfs:range iroko:TemporalVariation .
