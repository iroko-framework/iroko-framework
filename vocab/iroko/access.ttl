# iroko-access.ttl
@prefix iroko:   <https://iroko-framework.org/ontology/iroko#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

iroko:IrokoAccessModule
  a owl:Ontology ;
  dcterms:title "Iroko Access Module"@en ;
  dcterms:description "Tiered access control modeled at the assertion level, with optional rules for defaulting and enforcement."@en .

########
# Core access classes
########

iroko:AccessTier a owl:Class ;
  rdfs:label "Access Tier"@en ;
  rdfs:subClassOf skos:Concept .

iroko:AccessTierScheme a owl:Class ;
  rdfs:label "Access Tier Scheme"@en ;
  rdfs:subClassOf skos:ConceptScheme .

iroko:AccessPolicy a owl:Class ;
  rdfs:label "Access Policy"@en ;
  rdfs:comment "A policy node that can declare defaults and constraints. It does not enforce by itself, it documents intended governance rules."@en .

########
# Properties
########

iroko:accessTier a owl:ObjectProperty ;
  rdfs:label "access tier"@en ;
  rdfs:comment "Applies to an iroko:Assertion. Defines who may see or use the statement."@en ;
  rdfs:range iroko:AccessTier .

iroko:accessTierScheme a owl:ObjectProperty ;
  rdfs:label "access tier scheme"@en ;
  rdfs:domain iroko:AccessPolicy ;
  rdfs:range iroko:AccessTierScheme .

iroko:defaultAccessTier a owl:ObjectProperty ;
  rdfs:label "default access tier"@en ;
  rdfs:comment "Default tier used when an assertion has no explicit accessTier. Recommended for ingestion pipelines, not as a substitute for explicit tiering."@en ;
  rdfs:domain iroko:AccessPolicy ;
  rdfs:range iroko:AccessTier .

iroko:requiresExplicitTier a owl:DatatypeProperty ;
  rdfs:label "requires explicit tier"@en ;
  rdfs:comment "If true, assertions must carry iroko:accessTier explicitly. This is your preferred posture for ritual authority at the property level."@en ;
  rdfs:domain iroko:AccessPolicy ;
  rdfs:range xsd:boolean .

iroko:policyAppliesTo a owl:ObjectProperty ;
  rdfs:label "policy applies to"@en ;
  rdfs:comment "Targets a dataset, collection, or module. Leave open range so you can point to a named graph, repo module, or collection concept."@en ;
  rdfs:domain iroko:AccessPolicy .

iroko:tierDescription a owl:DatatypeProperty ;
  rdfs:label "tier description"@en ;
  rdfs:domain iroko:AccessTier ;
  rdfs:range xsd:string .

iroko:tierOrder a owl:DatatypeProperty ;
  rdfs:label "tier order"@en ;
  rdfs:comment "Lower is more public. Higher is more restricted."@en ;
  rdfs:domain iroko:AccessTier ;
  rdfs:range xsd:integer .

########
# Scheme and tiers (starter)
########

iroko:AccessTierScheme_Iroko v a iroko:AccessTierScheme ;
  skos:prefLabel "Iroko tiered access scheme"@en ;
  skos:hasTopConcept iroko:Tier0_Public, iroko:Tier1_Community, iroko:Tier2_Initiate, iroko:Tier3_Lineage, iroko:Tier4_Elder .

iroko:Tier0_Public a iroko:AccessTier ;
  skos:inScheme iroko:AccessTierScheme_Iroko ;
  skos:prefLabel "Tier 0 Public descriptive"@en ;
  iroko:tierOrder 0 ;
  iroko:tierDescription "Public descriptive metadata and non-sensitive statements."@en .

iroko:Tier1_Community a iroko:AccessTier ;
  skos:inScheme iroko:AccessTierScheme_Iroko ;
  skos:prefLabel "Tier 1 Community-shared"@en ;
  iroko:tierOrder 1 ;
  iroko:tierDescription "Community-shared knowledge that is not initiation-bound and is approved for internal circulation."@en .

iroko:Tier2_Initiate a iroko:AccessTier ;
  skos:inScheme iroko:AccessTierScheme_Iroko ;
  skos:prefLabel "Tier 2 Initiate-level"@en ;
  iroko:tierOrder 2 ;
  iroko:tierDescription "Initiate-level knowledge, limited to vetted members with appropriate standing."@en .

iroko:Tier3_Lineage a iroko:AccessTier ;
  skos:inScheme iroko:AccessTierScheme_Iroko ;
  skos:prefLabel "Tier 3 Lineage-bound"@en ;
  iroko:tierOrder 3 ;
  iroko:tierDescription "Lineage or house-bound knowledge, restricted by ritual governance and jurisdiction."@en .

iroko:Tier4_Elder a iroko:AccessTier ;
  skos:inScheme iroko:AccessTierScheme_Iroko ;
  skos:prefLabel "Tier 4 Elder-only"@en ;
  iroko:tierOrder 4 ;
  iroko:tierDescription "Elder-only knowledge. Highest restriction, typically never exported."@en .

########
# Recommended policy (assertion-level tier required)
########

iroko:AccessPolicy_StrictAssertionTiering a iroko:AccessPolicy ;
  skos:prefLabel "Strict assertion-level tiering policy"@en ;
  iroko:accessTierScheme iroko:AccessTierScheme_Iroko ;
  iroko:requiresExplicitTier true ;
  iroko:defaultAccessTier iroko:Tier4_Elder ;
  rdfs:comment "Recommended posture: every iroko:Assertion must have iroko:accessTier. Default is Tier4 only for incomplete drafts during ingestion, never for publication."@en .
