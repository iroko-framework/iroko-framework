# iroko-authority.ttl
@prefix iroko:   <https://iroko-framework.org/ontology/iroko#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

iroko:IrokoAuthorityModule
  a owl:Ontology ;
  dcterms:title "Iroko Authority Module"@en ;
  dcterms:description "Ritual authority, jurisdiction, and validity for authorizing assertion-level claims."@en .

########
# Core classes
########

iroko:Authority a owl:Class ;
  rdfs:label "Ritual Authority"@en ;
  rdfs:comment "A jurisdictional authority that can authorize assertions. Can represent lineage, cabildo, house, elder council, or other governance structure."@en ;
  rdfs:subClassOf prov:Agent .

iroko:AuthorityType a owl:Class ;
  rdfs:label "Authority Type"@en ;
  rdfs:subClassOf skos:Concept .

iroko:Jurisdiction a owl:Class ;
  rdfs:label "Jurisdiction"@en ;
  rdfs:comment "A place, house, cabildo, lineage territory, or other bounded domain where an authority is recognized."@en .

iroko:RitualRole a owl:Class ;
  rdfs:label "Ritual Role"@en ;
  rdfs:subClassOf skos:Concept .

iroko:AuthorityBasis a owl:Class ;
  rdfs:label "Authority Basis"@en ;
  rdfs:comment "What the authority rests on, for example lineage succession, consecration, appointment, community recognition."@en ;
  rdfs:subClassOf skos:Concept .

########
# Properties
########

iroko:authorizedBy a owl:ObjectProperty ;
  rdfs:label "authorized by"@en ;
  rdfs:comment "Links an iroko:Assertion to the iroko:Authority that authorizes it."@en ;
  rdfs:range iroko:Authority .

iroko:authorityType a owl:ObjectProperty ;
  rdfs:label "authority type"@en ;
  rdfs:domain iroko:Authority ;
  rdfs:range iroko:AuthorityType .

iroko:hasJurisdiction a owl:ObjectProperty ;
  rdfs:label "has jurisdiction"@en ;
  rdfs:domain iroko:Authority ;
  rdfs:range iroko:Jurisdiction .

iroko:jurisdictionLabel a owl:DatatypeProperty ;
  rdfs:label "jurisdiction label"@en ;
  rdfs:domain iroko:Jurisdiction ;
  rdfs:range xsd:string .

iroko:validFrom a owl:DatatypeProperty ;
  rdfs:label "valid from"@en ;
  rdfs:domain iroko:Authority ;
  rdfs:range xsd:date .

iroko:validUntil a owl:DatatypeProperty ;
  rdfs:label "valid until"@en ;
  rdfs:domain iroko:Authority ;
  rdfs:range xsd:date .

iroko:recognizedBy a owl:ObjectProperty ;
  rdfs:label "recognized by"@en ;
  rdfs:comment "Links an authority to a recognizing body, council, or adjacent authority. Use for documenting recognition networks."@en ;
  rdfs:domain iroko:Authority ;
  rdfs:range iroko:Authority .

iroko:authorityBasis a owl:ObjectProperty ;
  rdfs:label "authority basis"@en ;
  rdfs:domain iroko:Authority ;
  rdfs:range iroko:AuthorityBasis .

iroko:ritualRole a owl:ObjectProperty ;
  rdfs:label "ritual role"@en ;
  rdfs:domain iroko:Authority ;
  rdfs:range iroko:RitualRole .

iroko:culturalFrame a owl:DatatypeProperty ;
  rdfs:label "cultural frame"@en ;
  rdfs:comment "Short label for tradition frame, for example Lucumi, Palo, Espiritismo, Vodou. Use at Authority level when stable."@en ;
  rdfs:domain iroko:Authority ;
  rdfs:range xsd:string .

########
# Authority types (starter)
########

iroko:AuthorityType_Lineage a iroko:AuthorityType ; skos:prefLabel "Lineage authority"@en .
iroko:AuthorityType_House a iroko:AuthorityType ; skos:prefLabel "House authority"@en .
iroko:AuthorityType_Cabildo a iroko:AuthorityType ; skos:prefLabel "Cabildo authority"@en .
iroko:AuthorityType_Council a iroko:AuthorityType ; skos:prefLabel "Council authority"@en .
iroko:AuthorityType_IndividualElder a iroko:AuthorityType ; skos:prefLabel "Individual elder authority"@en .

########
# Authority basis (starter)
########

iroko:AuthorityBasis_Succession a iroko:AuthorityBasis ; skos:prefLabel "Lineage succession"@en .
iroko:AuthorityBasis_Consecration a iroko:AuthorityBasis ; skos:prefLabel "Consecration"@en .
iroko:AuthorityBasis_Appointment a iroko:AuthorityBasis ; skos:prefLabel "Appointment"@en .
iroko:AuthorityBasis_CommunityRecognition a iroko:AuthorityBasis ; skos:prefLabel "Community recognition"@en .

########
# Ritual roles (starter)
########

iroko:RitualRole_Elder a iroko:RitualRole ; skos:prefLabel "Elder"@en .
iroko:RitualRole_Priest a iroko:RitualRole ; skos:prefLabel "Priest"@en .
iroko:RitualRole_ArchivistSteward a iroko:RitualRole ; skos:prefLabel "Archivist-steward"@en .
iroko:RitualRole_Witness a iroko:RitualRole ; skos:prefLabel "Witness"@en .

########
# Example jurisdiction nodes (optional pattern)
########

iroko:Jurisdiction_Havana a iroko:Jurisdiction ;
  iroko:jurisdictionLabel "Havana"@en .

iroko:Jurisdiction_CapHaitien a iroko:Jurisdiction ;
  iroko:jurisdictionLabel "Cap-Haïtien"@en .
