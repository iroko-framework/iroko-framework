<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:iroko="https://ontology.irokosociety.org/iroko#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">authority requirement</rdfs:label>
    <rdfs:comment xml:lang="en">The initiation or authority title required to perform in this lineage. Range: iroko:AuthorityTitleScheme concept.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#MusicianLineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#setLineage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">drum set lineage</rdfs:label>
    <rdfs:comment xml:lang="en">The musician lineage to which this drum set belongs. Particularly important for Añá bàtá: the Olubatá lineage determines performance rights and toque knowledge. Initiated-only.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredDrumSet"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#MusicianLineage"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#inst-petwo-drum">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Drums used in Haitian Vodou Petwo nation ceremonies. Prepared differently from Rada drums; tighter skin tuning and faster tempo.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InstrumentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Petwo drum</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Tambou Petwo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#inst-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Sacred instrument type not covered by existing concepts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InstrumentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#inst-agogo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Double or single iron bell providing the timeline in many Afro-Atlantic rhythm traditions. Associated with Ogun/Ogou in Lucumí and Vodou contexts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InstrumentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Agogô (bell)</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Agogô</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SacredRhythm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sacred Rhythm</rdfs:label>
    <rdfs:comment xml:lang="en">A tradition-specific ritual drumming pattern with defined entity associations, ceremonial function, and authority requirements for performance. In Lucumí: a toque or canto. In Haitian Vodou: a tanbou rhythm for a specific lwa. In Candomblé: a xirê toque. Each rhythm is identified by its name, entity association, tradition, and lineage variant. Rhythm names are community-restricted; possession-trigger status and toque sequences are initiated-only.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0b7d02ee5e754beeaaaaa2276f095592b3">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#SacredInstrument"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rhythmName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">rhythm name</rdfs:label>
    <rdfs:comment xml:lang="en">The conventional name of the rhythm in the tradition's liturgical language. Language-tagged. Community-restricted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredRhythm"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#possessionTrigger">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">possession trigger</rdfs:label>
    <rdfs:comment xml:lang="en">Whether this rhythm or instrument is understood to trigger or invite spirit possession when performed correctly. Domain broadened in v1.3.0 to include iroko:SacredInstrument as well as iroko:SacredRhythm: a consecrated drum set (SacredDrumSet) or individual sacred instrument may trigger possession independently of which specific rhythm is being played, as the instrument itself carries the invocation capacity. Initiated-only: this knowledge is operationally significant and not appropriate for public documentation.</rdfs:comment>
    <rdfs:domain rdf:nodeID="n0b7d02ee5e754beeaaaaa2276f095592b1"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-21</dcterms:modified>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SacredInstrument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sacred Instrument</rdfs:label>
    <rdfs:comment xml:lang="en">A musical instrument used in Afro-Atlantic sacred contexts, which may be consecrated, named, or otherwise distinguished from secular instruments of the same type. Examples: a set of consecrated bàtá drums; Vodou rada drums (manman, seconde, bula); Candomblé rum/rumpi/lé. An instrument may have its own name, lineage, and history. The instrument type is public; consecration status and internal names are community-restricted.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#inst-shekere">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Gourd rattle with bead netting used across Yorùbá-derived and related traditions. Consecrated shekeré are used in Orisha ceremonies; güiro refers to the Cuban variant.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InstrumentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Shekeré / Güiro</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Shekeré</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SacredDrumSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sacred Drum Set</rdfs:label>
    <rdfs:comment xml:lang="en">A formally recognized set of consecrated drums understood as a unified sacred entity within a tradition. In Lucumí: the Añá bàtá set, which holds the spirit of Añá and requires specific initiation (Aña or Olubatá) to play. In Haitian Vodou: the Rada drum battery (manman, seconde, bula). In Candomblé: the atabaque trio (rum, rumpi, lé). A drum set may have its own name, lineage, house affiliation, and reception date. The Añá bàtá in particular carries highly restricted esoteric status; set identity and lineage are initiated-only.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#InstrumentTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Instrument Types</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#inst-agogo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#inst-atabaque"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#inst-bata"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#inst-nkomo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#inst-other"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#inst-petwo-drum"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#inst-rada-drum"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#inst-shekere"/>
    <skos:prefLabel xml:lang="en">Instrument Types</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Tipos de instrumento sagrado</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Types d'instrument sacré</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Tipos de instrumento sagrado</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àwọn ìrú ohun-èlò ìlù mímọ́</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#MusicianLineage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Musician Lineage</rdfs:label>
    <rdfs:comment xml:lang="en">A documented chain of transmission from master musician to apprentice, governing the right to play specific sacred instruments, lead specific rhythms, or perform specific songs. In Lucumí: Olubatá lineages with specific Añá initiations. In Candomblé: ogan lineages. Musician lineages are community knowledge in general form; specific transmission records are initiated-only.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#song-initiation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Songs performed specifically within initiatory rites, restricted to those contexts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SongFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Initiation ceremony</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#lineageFounder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">lineage founder</rdfs:label>
    <rdfs:comment xml:lang="en">The founding master musician of this lineage. Range: foaf:Person.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#MusicianLineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#inst-nkomo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Drums used in Palo Monte ceremonies. The nkómo tradition derives from Bantu/Kongo drumming practice. Different preparation and restriction protocols than bàtá.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InstrumentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Nkómo (Palo)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Nkómo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#RhythmFamilyScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Rhythm Families</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#family-candomble-angola"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#family-candomble-ketu"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#family-lucumi-bata"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#family-lucumi-guiro"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#family-other"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#family-palo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#family-vodou-petwo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#family-vodou-rada"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#family-yoruba-continental"/>
    <skos:prefLabel xml:lang="en">Rhythm Families</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Familias de ritmos sagrados</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Familles de rythmes sacrés</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Famílias de ritmos sagrados</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àwọn ìdílé ìlù mímọ́</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#inst-atabaque">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Single-headed conical drum used in Candomblé in sets of three (rum/grande, rumpi/médio, lé/pequeno). May be consecrated; the rum (largest) typically leads.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InstrumentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Atabaque</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Atabaque</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko-ngoma">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-22</dcterms:created>
    <dcterms:creator>Iroko Historical Society</dcterms:creator>
    <dcterms:description xml:lang="en">Domain module. Vocabulary for documenting sacred music across Afro-Atlantic traditions. Covers ritual rhythms and their entity associations, sacred songs and verse corpora, consecrated drum sets and their lineages, and musician authority transmission. Integrates with the Music Ontology (mo:) where applicable. Access control distinguishes public knowledge (rhythm names, entity associations) from restricted operational detail (toque sequences, song texts, drum preparation). Use with iroko-agency for consecrated instrument agency (Añá); iroko-authority for musician lineage authorization; iroko-narrative for song transmission chains and verse corpus provenance.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-21</dcterms:modified>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-agency"/>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-narrative"/>
    <dcterms:title xml:lang="en">Iroko Framework: Ngoma Module (Sacred Music, Rhythms, Songs, and Instruments)</dcterms:title>
    <rdfs:seeAlso rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <owl:imports rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <owl:versionIRI rdf:resource="https://ontology.irokosociety.org/iroko-ngoma/1.3.0"/>
    <owl:versionInfo>1.3.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#entityCalled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">entity called</rdfs:label>
    <rdfs:comment xml:lang="en">The spiritual entity primarily associated with this rhythm — the entity this rhythm is sung/played for or that it invites. Range: iroko:SpiritualEntity. Community-restricted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredRhythm"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SpiritualEntity"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#instrumentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">instrument type</rdfs:label>
    <rdfs:comment xml:lang="en">The type of sacred instrument. Range: iroko:InstrumentTypeScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredInstrument"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rhythmFamily">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">rhythm family</rdfs:label>
    <rdfs:comment xml:lang="en">The broad rhythmic family or tradition category. Range: iroko:RhythmFamilyScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredRhythm"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#setComponents">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">set components</rdfs:label>
    <rdfs:comment xml:lang="en">Description of the drums in a consecrated set (e.g., iyá, itótele, okónkolo for bàtá). Community-restricted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredDrumSet"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#song-funerary">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Songs performed in Ituto, Egungun, or other funerary and ancestral contexts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SongFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Funerary / ancestral</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rhythmAlternateName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">alternate rhythm name</rdfs:label>
    <rdfs:comment xml:lang="en">Alternative or regional names for this rhythm. Language-tagged.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredRhythm"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#song-healing">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Songs performed as part of healing or cleansing interventions.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SongFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Healing</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#family-lucumi-guiro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Rhythms performed on non-consecrated shakers, cajón, or güiro in Lucumí contexts. Used in güiro ceremonies and some Espiritismo-adjacent practice. Less restricted than bàtá but still tradition-specific.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFamilyScheme"/>
    <skos:prefLabel xml:lang="en">Lucumí — Güiro / Cajón</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#toqueSequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">toque sequence</rdfs:label>
    <rdfs:comment xml:lang="en">The full performance sequence: how this rhythm is introduced, developed, and resolved within a ceremony. Initiated-elder only: toque sequences are core esoteric knowledge of the musician lineage.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredRhythm"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-elder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#consecrationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">consecration date</rdfs:label>
    <rdfs:comment xml:lang="en">Date the instrument was consecrated or born. For Añá bàtá: the date of Aña reception.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredInstrument"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#songTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">song title</rdfs:label>
    <rdfs:comment xml:lang="en">The title or opening phrase identifying this song. Language-tagged. Community-restricted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredSong"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#songEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">song entity</rdfs:label>
    <rdfs:comment xml:lang="en">The spiritual entity addressed or invoked by this song. Range: iroko:SpiritualEntity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredSong"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SpiritualEntity"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#func-funerary">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The rhythm is performed in funerary, Egungun, or ancestral veneration contexts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Funerary / ancestral</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#houseAffiliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">house affiliation</rdfs:label>
    <rdfs:comment xml:lang="en">The religious house with which this instrument or drum set is affiliated. Range: iroko:House.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredInstrument"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#family-vodou-rada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Rhythms of the Rada nation in Haitian Vodou, associated with the cool, beneficent lwa (primarily Fon-derived: Lasirèn, Loko, Ayizan, Danbala). Performed on the Rada drum battery.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFamilyScheme"/>
    <skos:prefLabel xml:lang="en">Haitian Vodou — Rada</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Vodou Rada</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#songFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">song function</rdfs:label>
    <rdfs:comment xml:lang="en">The ceremonial function of this song. Range: iroko:SongFunctionScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredSong"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SongFunctionScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Song Functions</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#song-funerary"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#song-healing"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#song-initiation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#song-invocation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#song-narrative"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#song-other"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#song-praise"/>
    <skos:prefLabel xml:lang="en">Song Functions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Funciones del canto sagrado</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Fonctions du chant sacré</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Funções do canto sagrado</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àwọn iṣẹ́ orin mímọ́</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rhythmNotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">rhythm notation</rdfs:label>
    <rdfs:comment xml:lang="en">Onomatopoeic or phonetic notation of the rhythm pattern (e.g., 'kon-ko-lo' for a specific bàtá pattern). Community-restricted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredRhythm"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#song-invocation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Song that calls or invites a spiritual entity. Primary function of canto de entrada and analogous opening songs.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SongFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Invocation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#songLanguage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">liturgical language</rdfs:label>
    <rdfs:comment xml:lang="en">The liturgical language in which this song is performed (e.g., Lucumí/Yorùbá, Fon, Kikongo, Haitian Kreyòl). Language tag.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredSong"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#language"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0b7d02ee5e754beeaaaaa2276f095592b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n0b7d02ee5e754beeaaaaa2276f095592b2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#RhythmFunctionScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Rhythm Functions</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#func-entertainment"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#func-farewell"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#func-funerary"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#func-initiation"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#func-possession-induction"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#func-processional"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#func-salutation"/>
    <skos:prefLabel xml:lang="en">Rhythm Functions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Funciones del ritmo sagrado</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Fonctions du rythme sacré</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Funções do ritmo sagrado</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Àwọn iṣẹ́ ìlù mímọ́</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#associatedRhythm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">associated rhythm</rdfs:label>
    <rdfs:comment xml:lang="en">The rhythm pattern that accompanies this song.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredSong"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#SacredRhythm"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#func-entertainment">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The rhythm has an accepted public or entertainment role alongside its sacred function (e.g., folkloric bàtá performances).</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Entertainment / public</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#transmissionLineage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">transmission lineage</rdfs:label>
    <rdfs:comment xml:lang="en">The musician lineage through which this rhythm is transmitted. Range: iroko:MusicianLineage.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredRhythm"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#MusicianLineage"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#songTranslation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">song translation</rdfs:label>
    <rdfs:comment xml:lang="en">Translation of song text into a non-liturgical language. Initiated-only: translations reveal meaning even without the liturgical text.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredSong"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#songText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">song text</rdfs:label>
    <rdfs:comment xml:lang="en">The full text of the song as transmitted in the lineage. Initiated-elder only: sacred song texts are among the most sensitive items in this corpus, equivalent to verse corpora in the Marca module.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredSong"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-elder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#SacredSong">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sacred Song</rdfs:label>
    <rdfs:comment xml:lang="en">A song, chant, or liturgical vocal composition used in Afro-Atlantic ceremonial contexts. Includes oriki (Yorùbá praise poetry), canto de entrada (Lucumí invocation songs), chanson Vodou, and analogous forms. Songs may be classified by entity addressed, ceremony type, and liturgical language. Song text is among the most sensitive data in this module: song existence and entity association are community-restricted; text and melodic structure are initiated-only to elder-only.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#SacredEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#family-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Rhythm family not covered by existing concepts. Use skos:scopeNote to describe.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFamilyScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#func-possession-induction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The rhythm is specifically associated with inducing or deepening spirit possession in a prepared recipient. Initiated-only detail.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Possession induction</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#instrumentName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">instrument name</rdfs:label>
    <rdfs:comment xml:lang="en">The name of this specific consecrated instrument or set. For Añá bàtá: the name of the drum set. Community-restricted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredInstrument"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#func-farewell">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The rhythm signals or facilitates the departure of a spiritual entity from the ceremonial space.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Farewell / departure</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#family-lucumi-bata">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Rhythms performed on the consecrated Añá bàtá drum set in Lucumí/Ocha tradition. Requires Olubatá authority and Aña initiation to lead. Considered the highest-authority drumming tradition in Lucumí; specific toques are associated with specific Orisha and are operationally significant.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFamilyScheme"/>
    <skos:prefLabel xml:lang="en">Lucumí — Bàtá (Añá)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Bàtá de Aña</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#inst-rada-drum">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The three-drum Haitian Vodou Rada battery: manman (largest), seconde (middle), bula (smallest). Associated with cool, Fon-derived lwa.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InstrumentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Rada drum battery</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Tambou Rada</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#lineageName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">lineage name</rdfs:label>
    <rdfs:comment xml:lang="en">The name of this musician lineage or school. Community-restricted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#MusicianLineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#song-narrative">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Song that tells a story about an entity, an ancestor, or a sacred event.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SongFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Narrative / Pataki</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#func-initiation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The rhythm is performed specifically during initiatory ceremonies and is restricted to those contexts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Initiation ceremony</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#rhythmFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">rhythm function</rdfs:label>
    <rdfs:comment xml:lang="en">The ceremonial function of this rhythm. Range: iroko:RhythmFunctionScheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredRhythm"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#lineageHouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">lineage house</rdfs:label>
    <rdfs:comment xml:lang="en">The religious house through which this musician lineage operates. Range: iroko:House.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#MusicianLineage"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#House"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#family-vodou-petwo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Rhythms of the Petwo nation in Haitian Vodou, associated with fiercer and more demanding lwa (often Kongo-derived). Distinguished by faster tempos and specific drum preparation practices.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFamilyScheme"/>
    <skos:prefLabel xml:lang="en">Haitian Vodou — Petwo</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Vodou Petwo</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#song-other">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Song function not covered by existing concepts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SongFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#func-processional">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The rhythm accompanies movement through ceremonial space or between spaces.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Processional</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#addaEspiritualStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">esoteric status notes</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text description of the esoteric or sacred status of this instrument, including any restrictions on who may touch, play, or be present. Initiated-elder only.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#SacredDrumSet"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-ngoma"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-initiated-elder"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#family-yoruba-continental">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Sacred rhythms in continental Yorùbá practice, including dundun (talking drum), bàtá, and sakara traditions as practiced in Nigeria and Benin.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFamilyScheme"/>
    <skos:prefLabel xml:lang="en">Yorùbá (continental)</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Yorùbá</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#family-palo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Rhythms of Palo Monte and related Cuban Bantu-Atlantic traditions, performed on nkómo drums and associated percussion. Tata Nganga authority determines performance rights for restricted rhythms.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFamilyScheme"/>
    <skos:prefLabel xml:lang="en">Palo Monte / Kongo-derived</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Palo Monte</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n0b7d02ee5e754beeaaaaa2276f095592b2">
    <rdf:first rdf:resource="https://ontology.irokosociety.org/iroko#SacredRhythm"/>
    <rdf:rest rdf:nodeID="n0b7d02ee5e754beeaaaaa2276f095592b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#inst-bata">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Two-headed conical hourglass drum of Yorùbá origin. In Lucumí tradition, the consecrated Añá bàtá set (iyá, itótele, okónkolo) is the highest-authority drum. Requires Olubatá/Aña initiation to play in sacred contexts.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#InstrumentTypeScheme"/>
    <skos:prefLabel xml:lang="en">Bàtá</skos:prefLabel>
    <skos:prefLabel xml:lang="yo">Bàtá</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#family-candomble-ketu">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Rhythms of the Ketu (Yorùbá-derived) nation in Candomblé, performed on the atabaque trio (rum, rumpi, lé). The xirê sequence calls each Orixá in a defined order.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFamilyScheme"/>
    <skos:prefLabel xml:lang="en">Candomblé — Ketu (Yorùbá)</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Candomblé Ketu</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#family-candomble-angola">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Rhythms of the Angola (Bantu/Kongo-derived) nation in Candomblé. Maculelê, capoeira, and samba de roda exist in relationship with Angola ritual music.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFamilyScheme"/>
    <skos:prefLabel xml:lang="en">Candomblé — Angola (Bantu)</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Candomblé Angola</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#func-salutation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The rhythm formally greets and honors an entity without necessarily seeking possession. Often the opening toque in a sequence.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RhythmFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Salutation / greeting</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#song-praise">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Song that honors and praises an entity or ancestor without necessarily seeking presence. Oriki are the primary Yorùbá form.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#SongFunctionScheme"/>
    <skos:prefLabel xml:lang="en">Praise / Oriki</skos:prefLabel>
  </rdf:Description>
</rdf:RDF>
