{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:jurisdictionLabel",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Human-readable name for this jurisdiction."
      },
      "rdfs:domain": {
        "@id": "iroko:Jurisdiction"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "jurisdiction label"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:authorityType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Classifies an Authority instance by its structural form."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "authority type"
      },
      "rdfs:range": {
        "@id": "iroko:AuthorityType"
      }
    },
    {
      "@id": "iroko:role-contrib-bookseller",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A person involved in the commercial sale or distribution of the manuscript or printed work. Documents the commercial networks through which manuscripts traveled."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Bookseller"
      }
    },
    {
      "@id": "iroko:role-contrib-patron",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A person who provided financial, political, or institutional support enabling the production or survival of the manuscript or the transmission of the tradition. The patron may or may not have directly commissioned the work — patronage may be ongoing rather than project-specific."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Patron"
      }
    },
    {
      "@id": "iroko:AuthorityBasis",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "What the authority rests on: lineage succession, consecration, appointment, community recognition, divinatory selection, or other basis."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Authority Basis"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:Jurisdiction",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A place, house, cabildo, lineage territory, nation, or other bounded domain in which an authority is recognized. May be geographic, genealogical, or institutional."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Jurisdiction"
      }
    },
    {
      "@id": "iroko:jurisdiction-matanzas",
      "@type": "iroko:Jurisdiction",
      "iroko:jurisdictionLabel": {
        "@language": "en",
        "@value": "Matanzas"
      },
      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "iroko:authorityType-cabildo",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a cabildo or mutual aid association with ritual governance functions."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Cabildo Authority"
      }
    },
    {
      "@id": "iroko:role-contrib-attributed",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A person to whom a role is attributed by tradition, later inscription, or scholarly inference, without direct documentation in the manuscript itself. Attribution is a scholarly or community claim — record the basis and asserter of the attribution separately. Distinct from all other roles, which are documented rather than inferred."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Attributed"
      }
    },
    {
      "@id": "iroko:role-priest",
      "@type": "iroko:RitualRole",
      "skos:inScheme": {
        "@id": "iroko:RitualRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Priest"
      }
    },
    {
      "@id": "iroko:role-contrib-unspecified",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A person whose contribution to the manuscript is documented but whose specific function is not known or not recorded in the source. Use when a name appears in a colophon, marginal note, or catalog entry without a role designation."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Contributor (role unspecified)"
      }
    },
    {
      "@id": "iroko:role-contrib-editor",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A person who prepared the text for transmission or publication, including revisions, additions, corrections, or redactions. Distinguished from compiler (who assembles source material) and from translator (who changes language)."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Editor"
      }
    },
    {
      "@id": "iroko:basis-contested",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "The basis of the authority is itself disputed across lineages or houses."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Contested Basis"
      }
    },
    {
      "@id": "iroko:role-contrib-notary",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A person with official legal standing who authenticated, witnessed, or recorded the document in a formal legal capacity. Critical for colonial notarial records, manumission documents, legal instruments, and formal attestations in Afro-Atlantic archival contexts. The notarial function is administrative and legal; the notary may not be the scribe or author."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Notary"
      }
    },
    {
      "@id": "iroko:jurisdiction-havana",
      "@type": "iroko:Jurisdiction",
      "iroko:jurisdictionLabel": [
        {
          "@language": "en",
          "@value": "Havana"
        },
        {
          "@language": "es",
          "@value": "La Habana"
        }
      ],
      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "iroko:jurisdiction-galveston",
      "@type": "iroko:Jurisdiction",
      "iroko:jurisdictionLabel": {
        "@language": "en",
        "@value": "Galveston"
      },
      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "iroko:jurisdictionType",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Short classifer for the jurisdiction type: 'geographic', 'genealogical', 'institutional', 'diasporic', etc."
      },
      "rdfs:domain": {
        "@id": "iroko:Jurisdiction"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "jurisdiction type"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:authorityType-house",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a religious house (ile, sosyete, cabildo house, etc.)."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "House Authority"
      }
    },
    {
      "@id": "iroko:basis-hereditary",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from family lineage independent of formal consecration or appointment."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Hereditary"
      }
    },
    {
      "@id": "iroko:hasJurisdiction",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an authority to the domain(s) where it is recognized."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has jurisdiction"
      },
      "rdfs:range": {
        "@id": "iroko:Jurisdiction"
      }
    },
    {
      "@id": "iroko:authorityType-divinatory-office",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a specific divinatory office — Babalawo, Oluwo, Houngan Asogwe, etc. — rather than the individual holder."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Divinatory Office"
      }
    },
    {
      "@id": "iroko:authorityBasis",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "What the authority rests on — the epistemic or social foundation for its recognition."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "authority basis"
      },
      "rdfs:range": {
        "@id": "iroko:AuthorityBasis"
      }
    },
    {
      "@id": "iroko:basis-divinatory-selection",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from selection through divination (Ifa, oracle, sortition, etc.)."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Divinatory Selection"
      }
    },
    {
      "@id": "iroko:AuthorityType",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Classifies the structural form of an authority — lineage, house, cabildo, council, individual elder, etc."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Authority Type"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:ContributorRole",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A SKOS concept describing the function of a person in the production, transmission, or dissemination of a manuscript, archival object, or text. Covers roles from physical production (scribe, artist) through institutional and financial relationships (patron, commissioner) to textual transformation (translator, compiler, editor). Derived from the vHMML contributor role taxonomy (CC BY 4.0, Hill Museum and Manuscript Library) and extended for Iroko Framework use. Role concepts reside in iroko:ContributorRoleScheme."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Contributor Role"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:role-contrib-compiler",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A person who assembled a text from multiple sources without being the originating author of those sources. Relevant for anthologies, florilegia, and composite manuscripts bringing together materials from different traditions."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Compiler"
      }
    },
    {
      "@id": "iroko:role-contrib-translator",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The person who rendered the text from one language into another. The source and target languages should be recorded on the associated iroko:TextContent instance using iroko:textLanguage."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Translator"
      }
    },
    {
      "@id": "iroko:authorityNote",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Free-text note on the nature, history, or contested aspects of this authority's standing."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "authority note"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:role-contrib-publisher",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A person or institution responsible for the formal publication or release of the work. Applies primarily to printed materials; for manuscripts, use commissioner or patron."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Publisher"
      }
    },
    {
      "@id": "iroko:RitualRoleScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Functional roles within ritual governance systems."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Ritual Roles"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:role-archivist-steward"
        },
        {
          "@id": "iroko:role-community-delegate"
        },
        {
          "@id": "iroko:role-diviner"
        },
        {
          "@id": "iroko:role-priest"
        }
      ]
    },
    {
      "@id": "iroko:AuthorityBasisScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "What a ritual authority rests on — the social and epistemic foundation for recognition."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Authority Bases"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:basis-appointment"
        },
        {
          "@id": "iroko:basis-community-recognition"
        },
        {
          "@id": "iroko:basis-consecration"
        },
        {
          "@id": "iroko:basis-contested"
        },
        {
          "@id": "iroko:basis-divinatory-selection"
        },
        {
          "@id": "iroko:basis-hereditary"
        },
        {
          "@id": "iroko:basis-succession"
        }
      ]
    },
    {
      "@id": "iroko:jurisdiction-new-orleans",
      "@type": "iroko:Jurisdiction",
      "iroko:jurisdictionLabel": [
        {
          "@language": "en",
          "@value": "New Orleans"
        },
        {
          "@language": "fr",
          "@value": "La Nouvelle-Orléans"
        },
        {
          "@language": "es",
          "@value": "Nueva Orleans"
        }
      ],
      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-authority",
      "@type": "owl:Ontology",
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Governance Layer module. Full governance model for ritual authority, jurisdiction, and authorization basis. Extends the iroko:RitualAuthority stub in Core with jurisdiction modeling, authority type and basis classification, ritual roles, recognition networks, and temporal validity. Used to authorize assertion-level claims across all modules."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-01-15"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-06-16"
      },
      "dcterms:requires": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Authority Module"
      },
      "owl:priorVersion": {
        "@id": "https://ontology.irokosociety.org/iroko-authority/1.3.0"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-authority/1.3.1"
      },
      "owl:versionInfo": "1.3.1",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:Authority",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A jurisdictional authority capable of authorizing assertion-level claims and governance decisions. May represent a lineage, cabildo, religious house, elder council, or recognized individual in a governance role. Extends the iroko:RitualAuthority stub in Core. For the individual's held credential (title, office), see ile:ReligiousOffice."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Authority"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:RitualAuthority"
      }
    },
    {
      "@id": "iroko:jurisdiction-port-au-prince",
      "@type": "iroko:Jurisdiction",
      "iroko:jurisdictionLabel": {
        "@language": "fr",
        "@value": "Port-au-Prince"
      },
      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "iroko:culturalFrame",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Short label for the tradition frame within which this authority operates. Example: Lucumi, Palo, Espiritismo, Vodou, Candomble. Use iroko:tradition for linked-data-typed values."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "cultural frame"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:role-archivist-steward",
      "@type": "iroko:RitualRole",
      "skos:definition": {
        "@language": "en",
        "@value": "Recognized steward of archival materials within a tradition or house."
      },
      "skos:inScheme": {
        "@id": "iroko:RitualRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Archivist-Steward"
      }
    },
    {
      "@id": "iroko:authorityType-individual-elder",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a recognized individual elder acting in their own governance capacity."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Individual Elder Authority"
      }
    },
    {
      "@id": "iroko:role-contrib-dedicatee",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The person to whom the work is formally dedicated. The dedication relationship often carries political, patronage, or devotional significance that may illuminate the context of production."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Dedicatee"
      }
    },
    {
      "@id": "iroko:authorityType-lineage",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a descent line or transmission chain."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lineage Authority"
      }
    },
    {
      "@id": "iroko:role-contrib-artist",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The person responsible for illustrations, illuminations, diagrams, decorative elements, or graphic components of the manuscript. In Ethiopian and Nubian manuscript traditions, the artist may be documented separately from the scribe."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Artist / Illuminator"
      }
    },
    {
      "@id": "iroko:jurisdiction-new-spain",
      "@type": "iroko:Jurisdiction",
      "iroko:jurisdictionLabel": [
        {
          "@language": "en",
          "@value": "New Spain"
        },
        {
          "@language": "es",
          "@value": "Nueva España"
        }
      ],
      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "iroko:role-contrib-commissioner",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A person who formally ordered or commissioned the production of this specific manuscript or the performance of this specific ceremony or text. Distinguished from patron by the directness and specificity of the commissioning relationship."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Commissioner"
      }
    },
    {
      "@id": "iroko:role-diviner",
      "@type": "iroko:RitualRole",
      "skos:inScheme": {
        "@id": "iroko:RitualRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Diviner"
      }
    },
    {
      "@id": "iroko:AuthorityTypeScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Structural classification of ritual authority entities."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Authority Types"
      },
