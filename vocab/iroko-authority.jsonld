      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "valid from"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
