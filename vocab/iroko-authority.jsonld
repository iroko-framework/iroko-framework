      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "iroko:recognizedBy",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links one authority to a recognizing body, council, or adjacent authority. Used for documenting recognition networks and cross-lineage acknowledgments."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "recognized by"
      },
      "rdfs:range": {
        "@id": "iroko:Authority"
      }
    },
    {
      "@id": "iroko:AuthorityType",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Classifies the structural form of an authority — lineage, house, cabildo, council, individual elder, etc."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Authority Type"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:basis-hereditary",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from family lineage independent of formal consecration or appointment."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Hereditary"
      }
    },
    {
      "@id": "iroko:role-diviner",
      "@type": "iroko:RitualRole",
      "skos:inScheme": {
        "@id": "iroko:RitualRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Diviner"
      }
    },
    {
      "@id": "iroko:culturalFrame",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Short label for the tradition frame within which this authority operates. Example: Lucumi, Palo, Espiritismo, Vodou, Candomble. Use iroko:tradition for linked-data-typed values."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "cultural frame"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:authorityType-house",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a religious house (ile, sosyete, cabildo house, etc.)."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "House Authority"
      }
    },
    {
      "@id": "iroko:authorityType-lineage",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a descent line or transmission chain."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lineage Authority"
      }
    },
    {
      "@id": "iroko:basis-contested",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "The basis of the authority is itself disputed across lineages or houses."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Contested Basis"
      }
    },
    {
      "@id": "iroko:authorityType-cabildo",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a cabildo or mutual aid association with ritual governance functions."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Cabildo Authority"
      }
    },
    {
      "@id": "iroko:role-priest",
      "@type": "iroko:RitualRole",
      "skos:inScheme": {
        "@id": "iroko:RitualRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Priest"
      }
    },
    {
      "@id": "iroko:RitualRole",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The functional role an authority occupies within a ritual governance system — elder, priest, archivist-steward, witness, etc. Distinct from ile:ReligiousOffice (specific held title) — RitualRole is a classification concept."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Ritual Role"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-authority",
      "@type": "owl:Ontology",
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Governance Layer module. Full governance model for ritual authority, jurisdiction, and authorization basis. Extends the iroko:RitualAuthority stub in Core with jurisdiction modeling, authority type and basis classification, ritual roles, recognition networks, and temporal validity. Used to authorize assertion-level claims across all modules. Commonly paired with iroko-epistemic for constraint-aware archives."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-02-23"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-02-25"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-agency"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-epistemic"
        }
      ],
      "dcterms:requires": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Authority Module"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-authority/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:authorityBasis",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "What the authority rests on — the epistemic or social foundation for its recognition."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "authority basis"
      },
      "rdfs:range": {
        "@id": "iroko:AuthorityBasis"
      }
    },
    {
      "@id": "iroko:Authority",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A jurisdictional authority capable of authorizing assertion-level claims and governance decisions. May represent a lineage, cabildo, religious house, elder council, or recognized individual in a governance role. Extends the iroko:RitualAuthority stub in Core. For the individual's held credential (title, office), see ile:ReligiousOffice."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Authority"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:RitualAuthority"
      }
