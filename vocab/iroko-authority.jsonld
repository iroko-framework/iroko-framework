{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:Jurisdiction",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A place, house, cabildo, lineage territory, nation, or other bounded domain in which an authority is recognized. May be geographic, genealogical, or institutional."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Jurisdiction"
      }
    },
    {
      "@id": "iroko:hasJurisdiction",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an authority to the domain(s) where it is recognized."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has jurisdiction"
      },
      "rdfs:range": {
        "@id": "iroko:Jurisdiction"
      }
    },
    {
      "@id": "iroko:authorityType-individual-elder",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a recognized individual elder acting in their own governance capacity."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Individual Elder Authority"
      }
    },
    {
      "@id": "iroko:authorityType-council",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a collective governing council of elders or priests."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Council Authority"
      }
    },
    {
      "@id": "iroko:authorityNote",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Free-text note on the nature, history, or contested aspects of this authority's standing."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "authority note"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:basis-consecration",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from a ritual consecration event."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Consecration"
      }
    },
    {
      "@id": "iroko:validFrom",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Date from which the authority's governance standing is recognized or effective."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "valid from"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "iroko:jurisdictionLabel",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Human-readable name for this jurisdiction."
      },
      "rdfs:domain": {
        "@id": "iroko:Jurisdiction"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "jurisdiction label"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:basis-appointment",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from formal appointment by a recognized governing body."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Appointment"
      }
    },
    {
      "@id": "iroko:jurisdiction-havana",
      "@type": "iroko:Jurisdiction",
      "iroko:jurisdictionLabel": [
        {
          "@language": "en",
          "@value": "Havana"
        },
        {
          "@language": "es",
          "@value": "La Habana"
        }
      ],
      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "iroko:jurisdictionType",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Short classifer for the jurisdiction type: 'geographic', 'genealogical', 'institutional', 'diasporic', etc."
      },
      "rdfs:domain": {
        "@id": "iroko:Jurisdiction"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "jurisdiction type"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:AuthorityTypeScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Structural classification of ritual authority entities."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Authority Types"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:authorityType-cabildo"
        },
        {
          "@id": "iroko:authorityType-council"
        },
        {
          "@id": "iroko:authorityType-divinatory-office"
        },
        {
          "@id": "iroko:authorityType-house"
        },
        {
          "@id": "iroko:authorityType-individual-elder"
        },
        {
          "@id": "iroko:authorityType-lineage"
        }
      ]
    },
    {
      "@id": "iroko:validUntil",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Date until which the authority's governance standing is recognized. Absence of this property does not imply perpetual validity — use iroko:contestedStatus where appropriate."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "valid until"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "iroko:RitualRoleScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Functional roles within ritual governance systems."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Ritual Roles"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:role-archivist-steward"
        },
        {
          "@id": "iroko:role-community-delegate"
        },
        {
          "@id": "iroko:role-diviner"
        },
        {
          "@id": "iroko:role-priest"
        }
      ]
    },
    {
      "@id": "iroko:authorityType-divinatory-office",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a specific divinatory office — Babalawo, Oluwo, Houngan Asogwe, etc. — rather than the individual holder."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Divinatory Office"
      }
    },
    {
      "@id": "iroko:authorityType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Classifies an Authority instance by its structural form."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "authority type"
      },
      "rdfs:range": {
        "@id": "iroko:AuthorityType"
      }
    },
    {
      "@id": "iroko:basis-succession",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from recognized succession in a transmission line."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lineage Succession"
      }
    },
    {
      "@id": "iroko:basis-divinatory-selection",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from selection through divination (Ifa, oracle, sortition, etc.)."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Divinatory Selection"
      }
    },
    {
      "@id": "iroko:AuthorityBasis",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "What the authority rests on: lineage succession, consecration, appointment, community recognition, divinatory selection, or other basis."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Authority Basis"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:basis-community-recognition",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from informal but sustained community acknowledgment."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community Recognition"
      }
    },
    {
      "@id": "iroko:role-community-delegate",
      "@type": "iroko:RitualRole",
      "skos:definition": {
        "@language": "en",
        "@value": "Person acting in an authorized representative capacity on behalf of a house or community."
      },
      "skos:inScheme": {
        "@id": "iroko:RitualRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community Delegate"
      }
    },
    {
      "@id": "iroko:ritualRole",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The functional governance role this authority occupies."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "ritual role"
      },
      "rdfs:range": {
        "@id": "iroko:RitualRole"
      }
    },
