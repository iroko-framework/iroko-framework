        },
        {
          "@id": "iroko:authorityType-individual-elder"
        },
        {
          "@id": "iroko:authorityType-lineage"
        }
      ]
    },
    {
      "@id": "iroko:validUntil",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Date until which the authority's governance standing is recognized. Absence of this property does not imply perpetual validity — use iroko:contestedStatus where appropriate."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "valid until"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "iroko:authorityType-council",
      "@type": "iroko:AuthorityType",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority vested in a collective governing council of elders or priests."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Council Authority"
      }
    },
    {
      "@id": "iroko:role-contrib-recipient",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The person for whom the manuscript was produced, as distinct from the dedicatee or commissioner. Common in gift manuscripts, royal commissions, and personal correspondence. The recipient is the intended reader or owner of this specific copy."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Recipient"
      }
    },
    {
      "@id": "iroko:basis-succession",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from recognized succession in a transmission line."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lineage Succession"
      }
    },
    {
      "@id": "iroko:basis-appointment",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from formal appointment by a recognized governing body."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Appointment"
      }
    },
    {
      "@id": "iroko:jurisdiction-veracruz",
      "@type": "iroko:Jurisdiction",
      "iroko:jurisdictionLabel": [
        {
          "@language": "en",
          "@value": "Veracruz"
        },
        {
          "@language": "es",
          "@value": "Veracruz"
        }
      ],
      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "iroko:role-contrib-scribe",
      "@type": "iroko:ContributorRole",
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The person who physically copied or wrote the text. Distinguished from the intellectual author (originator of the content) and from the translator. In manuscript traditions, the scribe is often the most directly documented contributor."
      },
      "skos:inScheme": {
        "@id": "iroko:ContributorRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Scribe"
      }
    },
    {
      "@id": "iroko:recognizedBy",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links one authority to a recognizing body, council, or adjacent authority. Used for documenting recognition networks and cross-lineage acknowledgments."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "recognized by"
      },
      "rdfs:range": {
        "@id": "iroko:Authority"
      }
    },
    {
      "@id": "iroko:ritualRole",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The functional governance role this authority occupies."
      },
      "rdfs:domain": {
        "@id": "iroko:Authority"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "ritual role"
      },
      "rdfs:range": {
        "@id": "iroko:RitualRole"
      }
    },
    {
      "@id": "iroko:jurisdiction-cap-haitien",
      "@type": "iroko:Jurisdiction",
      "iroko:jurisdictionLabel": [
        {
          "@language": "en",
          "@value": "Cap-Haitien"
        },
        {
          "@language": "fr",
          "@value": "Cap-Haïtien"
        }
      ],
      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "iroko:role-community-delegate",
      "@type": "iroko:RitualRole",
      "skos:definition": {
        "@language": "en",
        "@value": "Person acting in an authorized representative capacity on behalf of a house or community."
      },
      "skos:inScheme": {
        "@id": "iroko:RitualRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community Delegate"
      }
    },
    {
      "@id": "iroko:hasContributorRole",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a person in a specific manuscript or textual production context to their functional role. Range: iroko:ContributorRoleScheme concept. Because the role is context-dependent (the same person may be a patron for one manuscript and a recipient for another), this property is best used within a reification node or named graph associating the person, the role, and the specific object. When used directly on an iroko:ArchivalPerson instance, it asserts a general characterization rather than a context-specific one."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has contributor role"
      },
      "rdfs:range": {
        "@id": "iroko:ContributorRole"
      }
    },
    {
      "@id": "iroko:basis-consecration",
      "@type": "iroko:AuthorityBasis",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority derives from a ritual consecration event."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityBasisScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Consecration"
      }
    },
    {
      "@id": "iroko:ContributorRoleScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Controlled terms for the roles of persons contributing to the production, transmission, or dissemination of a manuscript or archival object. Adopted from the vHMML contributor role taxonomy (CC BY 4.0, Hill Museum and Manuscript Library) with additions for Iroko Framework use cases including colonial notarial records and Afro-Atlantic archival genres."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Contributor Roles"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:role-contrib-scribe"
        },
        {
          "@id": "iroko:role-contrib-patron"
        },
        {
          "@id": "iroko:role-contrib-commissioner"
        },
        {
          "@id": "iroko:role-contrib-translator"
        },
        {
          "@id": "iroko:role-contrib-compiler"
        },
        {
          "@id": "iroko:role-contrib-artist"
        },
        {
          "@id": "iroko:role-contrib-notary"
        },
        {
          "@id": "iroko:role-contrib-editor"
        },
        {
          "@id": "iroko:role-contrib-dedicatee"
        },
        {
          "@id": "iroko:role-contrib-recipient"
        },
        {
          "@id": "iroko:role-contrib-bookseller"
        },
        {
          "@id": "iroko:role-contrib-publisher"
        },
        {
          "@id": "iroko:role-contrib-unspecified"
        },
        {
          "@id": "iroko:role-contrib-attributed"
        }
      ]
    },
    {
      "@id": "iroko:jurisdiction-charleston",
      "@type": "iroko:Jurisdiction",
      "iroko:jurisdictionLabel": {
        "@language": "en",
        "@value": "Charleston"
      },
      "iroko:jurisdictionType": "geographic"
    },
    {
      "@id": "iroko:RitualRole",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The functional role an authority occupies within a ritual governance system — elder, priest, archivist-steward, witness, etc. Distinct from ile:ReligiousOffice (specific held title) — RitualRole is a classification concept."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-authority"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Ritual Role"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
