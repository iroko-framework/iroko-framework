# -*- coding: utf-8 -*-
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix iroko: <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core#> .

<https://iroko-framework.github.io/iroko-framework/vocab/iroko-core>
    a owl:Ontology ;
    dcterms:title "Iroko Framework Core Vocabulary"@en ;
    dcterms:description "Cross-module infrastructure for governance and semantic integration of Afro-Atlantic sacred knowledge systems. Provides access control, provenance tracking, contested knowledge modeling, and semantic linking capabilities."@en ;
    dcterms:creator "Iroko Historical Society" ;
    dcterms:created "2026-02-17"^^xsd:date ;
    dcterms:modified "2026-02-18"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core/1.0.0> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    rdfs:seeAlso <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core.html> ;
    rdfs:comment "This vocabulary provides the shared infrastructure for all Iroko Framework modules. It does not duplicate existing standards (Dublin Core, Schema.org, PROV-O) but adds governance mechanisms specific to sacred knowledge systems. For usage examples, see the /examples/ directory."@en .

# ===================================================================
# CLASSES
# ===================================================================

iroko:SacredEntity
    a owl:Class ;
    rdfs:label "Sacred Entity"@en ;
    rdfs:comment "Top-level class for any tradition-specific concept within the Iroko Framework. All module-specific classes (Plant, SpiritualEntity, RitualProcess, etc.) are subclasses of this."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:SacredSpecimen
    a owl:Class ;
    rdfs:label "Sacred Specimen"@en ;
    rdfs:comment "Distinguishes objects that maintain active sacred status (consecrated, in ritual use) from decommissioned objects or museum specimens. Used to track the ritual life cycle of material culture."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:LineageKnowledgeGraph
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Lineage Knowledge Graph"@en ;
    rdfs:comment "A named graph representing one lineage's perspective on contested knowledge. Enables multiple community-endorsed positions to coexist without requiring resolution. Core mechanism for postcustodial knowledge governance."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:ContestedAuthority
    a owl:Class ;
    rdfs:label "Contested Authority"@en ;
    rdfs:comment "An authority (religious title, position, or role) whose legitimacy or historical continuity is disputed across lineages. Example: Iyanifa (women Ifa priests) - some lineages affirm historical continuity, others claim modern innovation."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:DocumentaryEvidence
    a owl:Class ;
    rdfs:label "Documentary Evidence"@en ;
    rdfs:comment "Umbrella class for archival materials (photographs, manuscripts, audio recordings, herbarium specimens) that document sacred knowledge practices. Maps to schema:CreativeWork in RDF serialization."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# PROPERTIES - Tradition and Governances
# ===================================================================

iroko:tradition
    a owl:ObjectProperty ;
    rdfs:label "tradition"@en ;
    rdfs:comment "The Afro-Atlantic tradition to which this entity belongs. Values from controlled vocabulary: iroko:tradition-lucumi, iroko:tradition-candomble-ketu, iroko:tradition-vodou-rada, etc. First-class governance dimension, not just subject tagging."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:accessLevel
    a owl:ObjectProperty ;
    rdfs:label "access level"@en ;
    rdfs:comment "Governs who may view this knowledge. Values: iroko:access-public-unrestricted, iroko:access-public-no-amplification, iroko:access-community-only, iroko:access-initiated-only, iroko:access-initiated-elder, iroko:access-no-access. Applied at record level and/or field level."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range skos:Concept ;
    iroko:minimumAccessLevel "public-unrestricted" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:communityEndorsement
    a owl:ObjectProperty ;
    rdfs:label "community endorsement"@en ;
    rdfs:comment "Status of community review and approval. Values: iroko:endorsement-unreviewed, iroko:endorsement-community-reviewed, iroko:endorsement-elder-approved, iroko:endorsement-contested, iroko:endorsement-withdrawn, iroko:endorsement-pending-review. Flips institutional authority model by centering community validation."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:contestedStatus
    a owl:DatatypeProperty ;
    rdfs:label "contested status"@en ;
    rdfs:comment "Boolean indicating whether this entity's attributes, existence, or interpretation are disputed across lineages. If true, see iroko:competingClaim for alternative positions."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:contestedNotes
    a owl:DatatypeProperty ;
    rdfs:label "contested notes"@en ;
    rdfs:comment "Free-text description of the nature of contestation. What specifically is disputed and by whom."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# PROPERTIES - Provenance and Epistemology
# ===================================================================

iroko:oralTransmissionChain
    a owl:DatatypeProperty ;
    rdfs:label "oral transmission chain"@en ;
    rdfs:comment "Documented chain of oral transmission for this knowledge. Example: Elder A (Havana) to Elder B (Matanzas) to Informant C (2018). No Dublin Core equivalent for this culturally specific provenance pattern."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:epistemicType
    a owl:ObjectProperty ;
    rdfs:label "epistemic type"@en ;
    rdfs:comment "Epistemological source classification. Values: iroko:epistemicType-continuous-oral-transmission, iroko:epistemicType-published-ethnography, iroko:epistemicType-fieldwork-recording, iroko:epistemicType-archival-document, iroko:epistemicType-material-culture, iroko:epistemicType-ritual-performance, iroko:epistemicType-reconstructed-from-text, iroko:epistemicType-claimed-revelation, iroko:epistemicType-political-reinterpretation. Enables transparency about knowledge sources."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:fieldworkProvenance
    a owl:DatatypeProperty ;
    rdfs:label "fieldwork provenance"@en ;
    rdfs:comment "Details of fieldwork context if this knowledge derives from direct ethnographic observation. Location, date, circumstances, informant relationship."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# PROPERTIES - Contested Knowledge
# ===================================================================

iroko:competingClaim
    a owl:ObjectProperty ;
    rdfs:label "competing claim"@en ;
    rdfs:comment "Links to a prov:Entity representing an alternative position on this contested knowledge. Typically references a named graph containing a lineage's assertion. Multiple claims may coexist."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range prov:Entity ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:supportingLineages
    a owl:DatatypeProperty ;
    rdfs:label "supporting lineages"@en ;
    rdfs:comment "Text list of lineages or houses that endorse this position on contested knowledge. Example: Oyotunji Village, Oshun Temple (Oshogbo), select Candomble houses."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:rejectingLineages
    a owl:DatatypeProperty ;
    rdfs:label "rejecting lineages"@en ;
    rdfs:comment "Text list of lineages or houses that reject this position on contested knowledge. Example: Most Cuban Lucumi houses, Ile-Ife traditional authorities."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# PROPERTIES - Sacred Object Status
# ===================================================================

iroko:sacredStatus
    a owl:ObjectProperty ;
    rdfs:label "sacred status"@en ;
    rdfs:comment "Current ritual status of an object. Values: iroko:sacredStatus-consecrated-active, iroko:sacredStatus-decommissioned, iroko:sacredStatus-museum-specimen, iroko:sacredStatus-replica-teaching, iroko:sacredStatus-awaiting-consecration, iroko:sacredStatus-contested-consecration, iroko:sacredStatus-unknown. Distinguishes living practice from documentation."@en ;
    rdfs:domain iroko:SacredSpecimen ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:custodialRelationship
    a owl:ObjectProperty ;
    rdfs:label "custodial relationship"@en ;
    rdfs:comment "Nature of custody for sacred objects. Values: iroko:custodial-community-held, iroko:custodial-institutional-with-access, iroko:custodial-institutional-disputed, iroko:custodial-repatriation-active, iroko:custodial-private-collection, iroko:custodial-unknown-location, iroko:custodial-shared-custody, iroko:custodial-under-negotiation. Supports postcustodial tracking."@en ;
    rdfs:domain iroko:SacredSpecimen ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# PROPERTIES - Semantic Integration
# ===================================================================

iroko:depicts
    a owl:ObjectProperty ;
    rdfs:label "depicts"@en ;
    rdfs:comment "Links archival materials to the entities they depict. Example: photograph depicts Obatala altar, herbarium sheet depicts plant specimen. Cross-module linking property."@en ;
    rdfs:domain iroko:DocumentaryEvidence ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:documents
    a owl:ObjectProperty ;
    rdfs:label "documents"@en ;
    rdfs:comment "Links archival materials to practices or events they document. Example: audio recording documents ceremony, photograph documents initiation. Cross-module linking property."@en ;
    rdfs:domain iroko:DocumentaryEvidence ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:relatedTradition
    a owl:ObjectProperty ;
    rdfs:label "related tradition"@en ;
    rdfs:comment "Links to related traditions when knowledge spans multiple systems. Example: a practice present in both Lucumi and Candomble with local variations."@en ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:sourceRelationship
    a owl:ObjectProperty ;
    rdfs:label "source relationship"@en ;
    rdfs:comment "Nature of relationship to source tradition for reconstructed or reclaimed practices. Primarily used in Sankofa module."@en ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# ANNOTATION PROPERTY
# ===================================================================

iroko:minimumAccessLevel
    a owl:AnnotationProperty ;
    rdfs:label "minimum access level"@en ;
    rdfs:comment "Annotation property used on other properties to indicate the minimum access level required to view their values. Used in vocabulary documentation and RDF export filtering."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# CONCEPT SCHEME: Traditions
# ===================================================================

iroko:TraditionScheme
    a skos:ConceptScheme ;
    rdfs:label "Tradition Classification"@en ;
    dcterms:description "Controlled vocabulary of Afro-Atlantic tradition classifications."@en ;
    skos:hasTopConcept iroko:tradition-yoruba-derived,
                       iroko:tradition-bantu-derived,
                       iroko:tradition-fon-ewe-derived,
                       iroko:tradition-haitian-vodou,
                       iroko:tradition-calabari,
                       iroko:tradition-akan-derived,
                       iroko:tradition-afro-indigenous,
                       iroko:tradition-syncretic,
                       iroko:tradition-kemetic,
                       iroko:tradition-pan-african .

# --- Grouping concepts (top-level, no broader) ---

iroko:tradition-yoruba-derived
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Yoruba-Derived"@en ;
    skos:definition "Traditions with primary roots in Yoruba religious culture."@en .

iroko:tradition-bantu-derived
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Bantu-Derived"@en ;
    skos:definition "Traditions with primary roots in Bantu and Kongo religious culture."@en .

iroko:tradition-fon-ewe-derived
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Fon/Ewe-Derived"@en ;
    skos:definition "Traditions with primary roots in Fon and Ewe religious culture from Dahomey."@en .

iroko:tradition-calabari
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Calabari/Cross River"@en ;
    skos:definition "Traditions rooted in Efik, Ejagham, and Cross River peoples."@en .

iroko:tradition-akan-derived
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Akan-Derived"@en ;
    skos:definition "Traditions with primary roots in Akan religious culture."@en .

iroko:tradition-afro-indigenous
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Afro-Indigenous"@en ;
    skos:definition "Traditions that blend African and Indigenous American religious elements."@en .

iroko:tradition-syncretic
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Syncretic/Creole"@en ;
    skos:definition "Traditions that deliberately blend multiple African, European, or Indigenous religious streams."@en .

iroko:tradition-kemetic
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Kemetic/Revivalist"@en ;
    skos:definition "Traditions reconstructing or reviving Ancient Egyptian (Kemetic) religious practice."@en .

iroko:tradition-pan-african
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Pan-African Political-Spiritual"@en ;
    skos:definition "Traditions that integrate African religious identity with political liberation frameworks."@en .

# --- Yoruba-derived traditions ---

iroko:tradition-yoruba-continental
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Yoruba (continental)"@en ;
    skos:altLabel "Nigerian Yoruba"@en ;
    skos:definition "Continental Yoruba religious practices in southwestern Nigeria."@en ;
    skos:broader iroko:tradition-yoruba-derived .

iroko:tradition-lucumi
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Lucumi"@en ;
    skos:altLabel "Regla de Ocha"@en, "Santeria"@en ;
    skos:definition "Yoruba-derived tradition in Cuba."@en ;
    skos:broader iroko:tradition-yoruba-derived .

iroko:tradition-candomble-ketu
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Candomble Ketu"@en ;
    skos:definition "Yoruba-derived Candomble tradition in Brazil (Nago/Ketu nation)."@en ;
    skos:broader iroko:tradition-yoruba-derived .

iroko:tradition-trinidad-orisha
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Trinidad Orisha"@en ;
    skos:altLabel "Shango Baptist"@en ;
    skos:definition "Yoruba-derived tradition in Trinidad and Tobago."@en ;
    skos:broader iroko:tradition-yoruba-derived .

iroko:tradition-oyotunji
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Oyotunji"@en ;
    skos:definition "African-centered Yoruba revivalist tradition founded in South Carolina."@en ;
    skos:broader iroko:tradition-yoruba-derived .

# --- Bantu-derived traditions ---

iroko:tradition-palo-monte
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Palo Monte"@en ;
    skos:altLabel "Regla de Congo"@en ;
    skos:definition "Bantu-derived Kongo religious tradition in Cuba."@en ;
    skos:broader iroko:tradition-bantu-derived .

iroko:tradition-palo-mayombe
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Palo Mayombe"@en ;
    skos:definition "Branch of Palo emphasizing darker or transformative spiritual work."@en ;
    skos:broader iroko:tradition-bantu-derived .

iroko:tradition-candomble-angola
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Candomble Angola"@en ;
    skos:definition "Bantu-derived Candomble tradition in Brazil (Angola nation)."@en ;
    skos:broader iroko:tradition-bantu-derived .

iroko:tradition-umbanda
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Umbanda"@en ;
    skos:definition "Brazilian syncretic tradition blending African, Indigenous, and Spiritist influences."@en ;
    skos:broader iroko:tradition-bantu-derived .

iroko:tradition-quimbanda
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Quimbanda"@en ;
    skos:definition "Brazilian tradition focused on exu spirits and transformative work."@en ;
    skos:broader iroko:tradition-bantu-derived .

# --- Fon/Ewe-derived traditions ---

iroko:tradition-arara
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Arara"@en ;
    skos:definition "Fon/Ewe-derived tradition in Cuba."@en ;
    skos:broader iroko:tradition-fon-ewe-derived .

iroko:tradition-candomble-jeje
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Candomble Jeje"@en ;
    skos:definition "Fon/Ewe-derived Candomble tradition in Brazil (Jeje nation)."@en ;
    skos:broader iroko:tradition-fon-ewe-derived .

# --- Hatian Vodou traditions ---

iroko:tradition-haitian-vodou
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Haitian Vodou"@en ;
    skos:definition "The creolized sacred tradition of Haiti, encompassing multiple nanchon (nations) with distinct African, Kongo, and New World origins. Internal distinctions (Rada, Petwo, Ghede) reflect different spiritual lineages and temperaments rather than a single ethnic root."@en .

iroko:tradition-vodou-rada
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Vodou Rada"@en ;
    skos:definition "Rada (cool/sweet) rites in Haitian Vodou, primarily Fon/Dahomey origins."@en ;
    skos:broader iroko:tradition-fon-ewe-derived .

iroko:tradition-vodou-petwo
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Vodou Petwo"@en ;
    skos:altLabel "Petro"@en ;
    skos:definition "Petwo (hot/bitter) rites in Haitian Vodou, with Kongo and New World influences."@en ;
    skos:broader iroko:tradition-fon-ewe-derived .

iroko:tradition-ghede
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Vodou Ghede"@en ;
    skos:definition "Ghede nanchon in Haitian Vodou. Governs death, sexuality, resurrection, and the boundary between living and dead. Composite origins drawing on New World cemetery and ancestor cult practices, with Fon, Kongo, and creole influences. Neither Rada nor Petwo; considered a separate nation with its own liturgical character."@en ;
    skos:broader iroko:tradition-haitian-vodou .
    
# --- Calabari/Cross River traditions ---

iroko:tradition-abakua
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Abakua"@en ;
    skos:definition "Calabari/Efik-derived all-male secret society in Cuba."@en ;
    skos:broader iroko:tradition-calabari .

iroko:tradition-ekpe
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Ekpe"@en ;
    skos:altLabel "Egbo"@en ;
    skos:definition "Continental Efik/Ejagham leopard society in Cross River region."@en ;
    skos:broader iroko:tradition-calabari .

# --- Akan-derived traditions ---

iroko:tradition-winti
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Winti"@en ;
    skos:definition "Afro-Surinamese tradition with Akan and other West African influences."@en ;
    skos:broader iroko:tradition-akan-derived .

iroko:tradition-kromanti
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Kromanti"@en ;
    skos:definition "Akan-derived practices in Jamaica and Suriname."@en ;
    skos:broader iroko:tradition-akan-derived .

# --- Afro-Indigenous traditions ---

iroko:tradition-garifuna
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Garifuna"@en ;
    skos:altLabel "Dugu"@en ;
    skos:definition "Afro-Indigenous tradition of Garifuna people (Central America, Caribbean)."@en ;
    skos:broader iroko:tradition-afro-indigenous .

iroko:tradition-kumina
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Kumina"@en ;
    skos:definition "Afro-Jamaican tradition with Bantu origins."@en ;
    skos:broader iroko:tradition-afro-indigenous .

# --- Syncretic/Creole traditions ---

iroko:tradition-espiritismo
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Espiritismo"@en ;
    skos:definition "Spiritist tradition with African, Catholic, and Kardecist influences in the Caribbean."@en ;
    skos:broader iroko:tradition-syncretic .

iroko:tradition-hoodoo
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Hoodoo"@en ;
    skos:altLabel "Conjure"@en, "Rootwork"@en ;
    skos:definition "African-American magical and healing tradition in the US South."@en ;
    skos:broader iroko:tradition-syncretic .

iroko:tradition-21-divisiones
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "21 Divisiones"@en ;
    skos:altLabel "Dominican Vodu"@en ;
    skos:definition "Dominican syncretic tradition with Vodou and Espiritismo influences."@en ;
    skos:broader iroko:tradition-syncretic .

# --- Kemetic/Revivalist traditions ---

iroko:tradition-kemetic-orthodoxy
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Kemetic Orthodoxy"@en ;
    skos:definition "Reconstructed Ancient Egyptian religion (Tamara Siuda lineage)."@en ;
    skos:broader iroko:tradition-kemetic .

iroko:tradition-ausar-auset
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Ausar Auset Society"@en ;
    skos:definition "Kemetic-centered spiritual organization founded by Ra Un Nefer Amen."@en ;
    skos:broader iroko:tradition-kemetic .

# --- Pan-African political-spiritual traditions ---

iroko:tradition-rastafari
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Rastafari"@en ;
    skos:definition "Afrocentric religious and political movement from Jamaica."@en ;
    skos:broader iroko:tradition-pan-african .

# ===================================================================
# CONCEPT SCHEME: Access Levels
# ===================================================================

iroko:AccessLevelScheme
    a skos:ConceptScheme ;
    rdfs:label "Access Level Classification"@en ;
    dcterms:description "Hierarchical classification of access restrictions for sacred knowledge."@en ;
    skos:hasTopConcept iroko:access-public-unrestricted,
                       iroko:access-public-no-amplification,
                       iroko:access-community-only,
                       iroko:access-initiated-only,
                       iroko:access-initiated-elder,
                       iroko:access-no-access .

iroko:access-public-unrestricted
    a skos:Concept ;
    skos:inScheme iroko:AccessLevelScheme ;
    skos:prefLabel "Public - Unrestricted"@en ;
    skos:definition "Freely accessible to anyone. No authentication required."@en ;
    skos:notation "1"^^xsd:integer .

iroko:access-public-no-amplification
    a skos:Concept ;
    skos:inScheme iroko:AccessLevelScheme ;
    skos:prefLabel "Public - No Amplification"@en ;
    skos:definition "Publicly viewable but should not be amplified, shared widely, or used for commercial purposes."@en ;
    skos:notation "2"^^xsd:integer .

iroko:access-community-only
    a skos:Concept ;
    skos:inScheme iroko:AccessLevelScheme ;
    skos:prefLabel "Community Only"@en ;
    skos:definition "Accessible to verified community members (practitioners, scholars with community relationships). Requires authentication."@en ;
    skos:notation "3"^^xsd:integer .

iroko:access-initiated-only
    a skos:Concept ;
    skos:inScheme iroko:AccessLevelScheme ;
    skos:prefLabel "Initiated Only"@en ;
    skos:definition "Accessible only to initiated practitioners whose initiation has been verified. Detailed preparation methods, quantities, combinations."@en ;
    skos:notation "4"^^xsd:integer .

iroko:access-initiated-elder
    a skos:Concept ;
    skos:inScheme iroko:AccessLevelScheme ;
    skos:prefLabel "Initiated Elder"@en ;
    skos:definition "Requires elder designation within tradition — those recognized by their community as having authority to access lineage-specific teachings, complex ceremonial knowledge, and restricted spiritual technologies. Not merely initiated, but recognized as elder or authority holder."@en ;
    skos:notation "5"^^xsd:integer .

iroko:access-no-access
    a skos:Concept ;
    skos:inScheme iroko:AccessLevelScheme ;
    skos:prefLabel "No Access"@en ;
    skos:definition "Operational or internal use only. Never exported to RDF. Invocation texts, secret names, internal notes."@en ;
    skos:notation "99"^^xsd:integer .

# ===================================================================
# CONCEPT SCHEME: Epistemic Types
# ===================================================================

iroko:EpistemicTypeScheme
    a skos:ConceptScheme ;
    rdfs:label "Epistemic Source Type"@en ;
    dcterms:description "Classification of knowledge sources for epistemological transparency."@en ;
    skos:hasTopConcept iroko:epistemicType-continuous-oral-transmission,
                       iroko:epistemicType-published-ethnography,
                       iroko:epistemicType-fieldwork-recording,
                       iroko:epistemicType-archival-document,
                       iroko:epistemicType-material-culture,
                       iroko:epistemicType-ritual-performance,
                       iroko:epistemicType-reconstructed-from-text,
                       iroko:epistemicType-speculative-reconstruction,
                       iroko:epistemicType-claimed-revelation,
                       iroko:epistemicType-political-reinterpretation .

iroko:epistemicType-continuous-oral-transmission
    a skos:Concept ;
    skos:inScheme iroko:EpistemicTypeScheme ;
    skos:prefLabel "Continuous Oral Transmission"@en ;
    skos:definition "Knowledge transmitted orally across generations without interruption."@en .

iroko:epistemicType-published-ethnography
    a skos:Concept ;
    skos:inScheme iroko:EpistemicTypeScheme ;
    skos:prefLabel "Published Ethnography"@en ;
    skos:definition "Knowledge documented in academic or popular ethnographic publications."@en .

iroko:epistemicType-fieldwork-recording
    a skos:Concept ;
    skos:inScheme iroko:EpistemicTypeScheme ;
    skos:prefLabel "Fieldwork Recording"@en ;
    skos:definition "Direct ethnographic observation and documentation by researchers."@en .

iroko:epistemicType-archival-document
    a skos:Concept ;
    skos:inScheme iroko:EpistemicTypeScheme ;
    skos:prefLabel "Archival Document"@en ;
    skos:definition "Historical documents (manuscripts, letters, official records)."@en .

iroko:epistemicType-material-culture
    a skos:Concept ;
    skos:inScheme iroko:EpistemicTypeScheme ;
    skos:prefLabel "Material Culture"@en ;
    skos:definition "Knowledge inferred from physical objects, ritual implements, or architecture."@en .

iroko:epistemicType-ritual-performance
    a skos:Concept ;
    skos:inScheme iroko:EpistemicTypeScheme ;
    skos:prefLabel "Ritual Performance (Embodied)"@en ;
    skos:definition "Knowledge transmitted through embodied practice, dance, gesture, and music."@en .

iroko:epistemicType-reconstructed-from-text
    a skos:Concept ;
    skos:inScheme iroko:EpistemicTypeScheme ;
    skos:prefLabel "Reconstructed from Text"@en ;
    skos:definition "Knowledge reconstructed from ancient texts or historical documents without living transmission."@en .

iroko:epistemicType-speculative-reconstruction
    a skos:Concept ;
    skos:inScheme iroko:EpistemicTypeScheme ;
    skos:prefLabel "Speculative Reconstruction"@en ;
    skos:definition "Theoretical reconstruction based on fragmentary evidence or comparative analysis."@en .

iroko:epistemicType-claimed-revelation
    a skos:Concept ;
    skos:inScheme iroko:EpistemicTypeScheme ;
    skos:prefLabel "Claimed Direct Revelation"@en ;
    skos:definition "Knowledge claimed to be received through direct spiritual revelation or channeling."@en .

iroko:epistemicType-political-reinterpretation
    a skos:Concept ;
    skos:inScheme iroko:EpistemicTypeScheme ;
    skos:prefLabel "Political Reinterpretation"@en ;
    skos:definition "Deliberate reinterpretation of existing tradition for political, social, or liberation purposes."@en .

# ===================================================================
# CONCEPT SCHEME: Sacred Status
# ===================================================================

iroko:SacredStatusScheme
    a skos:ConceptScheme ;
    rdfs:label "Sacred Object Status"@en ;
    dcterms:description "Classification of ritual life cycle status for sacred objects."@en ;
    skos:hasTopConcept iroko:sacredStatus-consecrated-active,
                       iroko:sacredStatus-decommissioned,
                       iroko:sacredStatus-museum-specimen,
                       iroko:sacredStatus-replica-teaching,
                       iroko:sacredStatus-awaiting-consecration,
                       iroko:sacredStatus-contested-consecration,
                       iroko:sacredStatus-contested-consecration,
                       iroko:sacredStatus-hereditary-custody,
                       iroko:sacredStatus-unknown .

iroko:sacredStatus-consecrated-active
    a skos:Concept ;
    skos:inScheme iroko:SacredStatusScheme ;
    skos:prefLabel "Consecrated/Active Use"@en ;
    skos:definition "Object is consecrated and actively used in ritual practice."@en .

iroko:sacredStatus-decommissioned
    a skos:Concept ;
    skos:inScheme iroko:SacredStatusScheme ;
    skos:prefLabel "Decommissioned"@en ;
    skos:definition "Object has been ritually deactivated or decommissioned but retains historical significance."@en .

iroko:sacredStatus-museum-specimen
    a skos:Concept ;
    skos:inScheme iroko:SacredStatusScheme ;
    skos:prefLabel "Museum Specimen"@en ;
    skos:definition "Object held in museum or archive for documentation, not ritual use."@en .

iroko:sacredStatus-replica-teaching
    a skos:Concept ;
    skos:inScheme iroko:SacredStatusScheme ;
    skos:prefLabel "Replica/Teaching Object"@en ;
    skos:definition "Replica created for educational purposes, never consecrated."@en .

iroko:sacredStatus-awaiting-consecration
    a skos:Concept ;
    skos:inScheme iroko:SacredStatusScheme ;
    skos:prefLabel "Awaiting Consecration"@en ;
    skos:definition "Object prepared but not yet consecrated."@en .

iroko:sacredStatus-contested-consecration
    a skos:Concept ;
    skos:inScheme iroko:SacredStatusScheme ;
    skos:prefLabel "Contested Consecration"@en ;
    skos:definition "Consecration status disputed across lineages."@en .

iroko:sacredStatus-hereditary-custody
    a skos:Concept ;
    skos:inScheme iroko:SacredStatusScheme ;
    skos:prefLabel "Hereditary Custody"@en ;
    skos:definition "Object has passed to a new keeper through lineage or house succession and is actively maintained. Custodial responsibility has transferred but sacred status and care protocols remain continuous."@en .

iroko:sacredStatus-honored-rest
    a skos:Concept ;
    skos:inScheme iroko:SacredStatusScheme ;
    skos:prefLabel "Honored Rest"@en ;
    skos:definition "Object has been retired from active ritual use but continues to be tended with respect and veneration. Distinguished from decommissioned in that no formal ritual deactivation has occurred — the object rests rather than being withdrawn."@en .
    
iroko:sacredStatus-unknown
    a skos:Concept ;
    skos:inScheme iroko:SacredStatusScheme ;
    skos:prefLabel "Unknown Status"@en ;
    skos:definition "Sacred status unknown or unclear from available documentation."@en .

# ===================================================================
# CONCEPT SCHEME: Custodial Relationship
# ===================================================================

iroko:CustodialRelationshipScheme
    a skos:ConceptScheme ;
    rdfs:label "Custodial Relationship"@en ;
    dcterms:description "Classification of custodial arrangements for sacred objects."@en ;
    skos:hasTopConcept iroko:custodial-community-held,
                       iroko:custodial-institutional-with-access,
                       iroko:custodial-institutional-disputed,
                       iroko:custodial-repatriation-active,
                       iroko:custodial-private-collection,
                       iroko:custodial-unknown-location,
                       iroko:custodial-shared-custody,
                       iroko:custodial-under-negotiation .

iroko:custodial-community-held
    a skos:Concept ;
    skos:inScheme iroko:CustodialRelationshipScheme ;
    skos:prefLabel "Community-Held"@en ;
    skos:definition "Object held and controlled by originating community."@en .

iroko:custodial-institutional-with-access
    a skos:Concept ;
    skos:inScheme iroko:CustodialRelationshipScheme ;
    skos:prefLabel "Institutional Holding with Community Access"@en ;
    skos:definition "Institution holds object but community maintains access and consultation rights."@en .

iroko:custodial-institutional-disputed
    a skos:Concept ;
    skos:inScheme iroko:CustodialRelationshipScheme ;
    skos:prefLabel "Institutional Holding Disputed"@en ;
    skos:definition "Institution holds object; community disputes legitimacy of custody."@en .

iroko:custodial-repatriation-active
    a skos:Concept ;
    skos:inScheme iroko:CustodialRelationshipScheme ;
    skos:prefLabel "Repatriation Claim Active"@en ;
    skos:definition "Active claim for repatriation to community of origin."@en .

iroko:custodial-private-collection
    a skos:Concept ;
    skos:inScheme iroko:CustodialRelationshipScheme ;
    skos:prefLabel "Private Collection"@en ;
    skos:definition "Held in private collection, access restricted."@en .

iroko:custodial-unknown-location
    a skos:Concept ;
    skos:inScheme iroko:CustodialRelationshipScheme ;
    skos:prefLabel "Unknown Location"@en ;
    skos:definition "Current location unknown; object documented but whereabouts unclear."@en .

iroko:custodial-shared-custody
    a skos:Concept ;
    skos:inScheme iroko:CustodialRelationshipScheme ;
    skos:prefLabel "Shared Custody"@en ;
    skos:definition "Custody shared between institution and community through formal agreement."@en .

iroko:custodial-under-negotiation
    a skos:Concept ;
    skos:inScheme iroko:CustodialRelationshipScheme ;
    skos:prefLabel "Under Negotiation"@en ;
    skos:definition "Custody arrangement currently under negotiation."@en .

# ===================================================================
# CONCEPT SCHEME: Community Endorsement
# ===================================================================

iroko:CommunityEndorsementScheme
    a skos:ConceptScheme ;
    rdfs:label "Community Endorsement Status"@en ;
    dcterms:description "Classification of community review and approval status."@en ;
    skos:hasTopConcept iroko:endorsement-unreviewed,
                       iroko:endorsement-community-reviewed,
                       iroko:endorsement-elder-approved,
                       iroko:endorsement-contested,
                       iroko:endorsement-withdrawn,
                       iroko:endorsement-pending-review .

iroko:endorsement-unreviewed
    a skos:Concept ;
    skos:inScheme iroko:CommunityEndorsementScheme ;
    skos:prefLabel "Unreviewed"@en ;
    skos:definition "Has not yet been reviewed by community authorities."@en .

iroko:endorsement-community-reviewed
    a skos:Concept ;
    skos:inScheme iroko:CommunityEndorsementScheme ;
    skos:prefLabel "Community-Reviewed"@en ;
    skos:definition "Reviewed by community members but not yet formally approved by elders."@en .

iroko:endorsement-elder-approved
    a skos:Concept ;
    skos:inScheme iroko:CommunityEndorsementScheme ;
    skos:prefLabel "Elder-Approved"@en ;
    skos:definition "Formally approved by recognized community elders or authorities."@en .

iroko:endorsement-contested
    a skos:Concept ;
    skos:inScheme iroko:CommunityEndorsementScheme ;
    skos:prefLabel "Contested"@en ;
    skos:definition "Disputed across community; multiple contradictory positions exist."@en .

iroko:endorsement-withdrawn
    a skos:Concept ;
    skos:inScheme iroko:CommunityEndorsementScheme ;
    skos:prefLabel "Withdrawn"@en ;
    skos:definition "Previously endorsed but subsequently withdrawn by community."@en .

iroko:endorsement-pending-review
    a skos:Concept ;
    skos:inScheme iroko:CommunityEndorsementScheme ;
    skos:prefLabel "Pending Review"@en ;
    skos:definition "Under active review by community authorities."@en .
