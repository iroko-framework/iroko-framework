@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix iroko: <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core#> .

<https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> 
    a owl:Ontology ;
    dcterms:title "Iroko Framework Core Vocabulary"@en ;
    dcterms:description "Cross-module infrastructure for governance and semantic integration of Afro-Atlantic sacred knowledge systems. Provides access control, provenance tracking, contested knowledge modeling, and semantic linking capabilities."@en ;
    dcterms:creator "Iroko Historical Society" ;
    dcterms:created "2026-02-17"^^xsd:date ;
    dcterms:modified "2026-02-17"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    rdfs:seeAlso <https://iroko-framework.github.io/iroko-framework/terms/> ;
    rdfs:comment "This vocabulary provides the shared infrastructure for all Iroko Framework modules. It does not duplicate existing standards (Dublin Core, Schema.org, PROV-O) but adds governance mechanisms specific to sacred knowledge systems."@en .

# ===================================================================
# CLASSES
# ===================================================================

iroko:SacredEntity 
    a owl:Class ;
    rdfs:label "Sacred Entity"@en ;
    rdfs:comment "Top-level class for any tradition-specific concept within the Iroko Framework. All module-specific classes (Plant, SpiritualEntity, RitualProcess, etc.) are subclasses of this."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:SacredSpecimen 
    a owl:Class ;
    rdfs:label "Sacred Specimen"@en ;
    rdfs:comment "Distinguishes objects that maintain active sacred status (consecrated, in ritual use) from decommissioned objects or museum specimens. Used to track the ritual life cycle of material culture."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:LineageKnowledgeGraph 
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Lineage Knowledge Graph"@en ;
    rdfs:comment "A named graph representing one lineage's perspective on contested knowledge. Enables multiple community-endorsed positions to coexist without requiring resolution. Core mechanism for postcustodial knowledge governance."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:ContestedAuthority 
    a owl:Class ;
    rdfs:label "Contested Authority"@en ;
    rdfs:comment "An authority (religious title, position, or role) whose legitimacy or historical continuity is disputed across lineages. Example: Iyanifa (women Ifá priests) - some lineages affirm historical continuity, others claim modern innovation."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:DocumentaryEvidence 
    a owl:Class ;
    rdfs:label "Documentary Evidence"@en ;
    rdfs:comment "Umbrella class for archival materials (photographs, manuscripts, audio recordings, herbarium specimens) that document sacred knowledge practices. Maps to schema:CreativeWork in RDF serialization."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# PROPERTIES - Tradition & Governance
# ===================================================================

iroko:tradition 
    a owl:ObjectProperty ;
    rdfs:label "tradition"@en ;
    rdfs:comment "The Afro-Atlantic tradition to which this entity belongs. Values from controlled vocabulary: Lucumí, Candomblé, Vodou, Palo, etc. First-class governance dimension, not just subject tagging."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:accessLevel 
    a owl:ObjectProperty ;
    rdfs:label "access level"@en ;
    rdfs:comment "Governs who may view this knowledge. Values: public-unrestricted, public-no-amplification, community-only, initiated-only, practitioner-access, no-access. Applied at record level and/or field level."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range skos:Concept ;
    iroko:minimumAccessLevel "public-unrestricted" ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:communityEndorsement 
    a owl:ObjectProperty ;
    rdfs:label "community endorsement"@en ;
    rdfs:comment "Status of community review and approval. Values: unreviewed, community-reviewed, elder-approved, contested, withdrawn, pending-review. Flips institutional authority model by centering community validation."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:contestedStatus 
    a owl:DatatypeProperty ;
    rdfs:label "contested status"@en ;
    rdfs:comment "Boolean indicating whether this entity's attributes, existence, or interpretation are disputed across lineages. If true, see iroko:competingClaim for alternative positions."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:contestedNotes 
    a owl:DatatypeProperty ;
    rdfs:label "contested notes"@en ;
    rdfs:comment "Free-text description of the nature of contestation. What specifically is disputed and by whom."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# PROPERTIES - Provenance & Epistemology
# ===================================================================

iroko:oralTransmissionChain 
    a owl:DatatypeProperty ;
    rdfs:label "oral transmission chain"@en ;
    rdfs:comment "Documented chain of oral transmission for this knowledge. Example: 'Elder A (Havana) → Elder B (Matanzas) → Informant C (2018)'. No Dublin Core equivalent for this culturally specific provenance pattern."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:epistemicType 
    a owl:ObjectProperty ;
    rdfs:label "epistemic type"@en ;
    rdfs:comment "Epistemological source classification. Values: continuous-oral-transmission, published-ethnography, fieldwork-recording, archival-document, material-culture, ritual-performance, reconstructed-from-text, claimed-revelation, political-reinterpretation. Enables transparency about knowledge sources."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:fieldworkProvenance 
    a owl:DatatypeProperty ;
    rdfs:label "fieldwork provenance"@en ;
    rdfs:comment "Details of fieldwork context if this knowledge derives from direct ethnographic observation. Location, date, circumstances, informant relationship."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# PROPERTIES - Contested Knowledge
# ===================================================================

iroko:competingClaim 
    a owl:ObjectProperty ;
    rdfs:label "competing claim"@en ;
    rdfs:comment "Links to a prov:Entity representing an alternative position on this contested knowledge. Typically references a named graph containing a lineage's assertion. Multiple claims may coexist."@en ;
    rdfs:domain iroko:SacredEntity ;
    rdfs:range prov:Entity ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:supportingLineages 
    a owl:DatatypeProperty ;
    rdfs:label "supporting lineages"@en ;
    rdfs:comment "Text list of lineages/houses that endorse this position on contested knowledge. Example: 'Oyotunji Village, Oshun Temple (Oshogbo), select Candomblé houses'."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:rejectingLineages 
    a owl:DatatypeProperty ;
    rdfs:label "rejecting lineages"@en ;
    rdfs:comment "Text list of lineages/houses that reject this position on contested knowledge. Example: 'Most Cuban Lucumí houses, Ile-Ife traditional authorities'."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# PROPERTIES - Sacred Object Status
# ===================================================================

iroko:sacredStatus 
    a owl:ObjectProperty ;
    rdfs:label "sacred status"@en ;
    rdfs:comment "Current ritual status of an object. Values: consecrated-active, decommissioned, museum-specimen, replica-teaching, awaiting-consecration, contested-consecration, unknown-status. Distinguishes living practice from documentation."@en ;
    rdfs:domain iroko:SacredSpecimen ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:custodialRelationship 
    a owl:ObjectProperty ;
    rdfs:label "custodial relationship"@en ;
    rdfs:comment "Nature of custody for sacred objects. Values: community-held, institutional-with-access, institutional-disputed, repatriation-active, private-collection, unknown-location, shared-custody, under-negotiation. Supports postcustodial tracking."@en ;
    rdfs:domain iroko:SacredSpecimen ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# PROPERTIES - Semantic Integration
# ===================================================================

iroko:depicts 
    a owl:ObjectProperty ;
    rdfs:label "depicts"@en ;
    rdfs:comment "Links archival materials to the entities they depict. Example: photograph depicts Obatalá altar, herbarium sheet depicts plant specimen. Cross-module linking property."@en ;
    rdfs:domain iroko:DocumentaryEvidence ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:documents 
    a owl:ObjectProperty ;
    rdfs:label "documents"@en ;
    rdfs:comment "Links archival materials to practices/events they document. Example: audio recording documents ceremony, photograph documents initiation. Cross-module linking property."@en ;
    rdfs:domain iroko:DocumentaryEvidence ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:relatedTradition 
    a owl:ObjectProperty ;
    rdfs:label "related tradition"@en ;
    rdfs:comment "Links to related traditions when knowledge spans multiple systems. Example: a practice present in both Lucumí and Candomblé with local variations."@en ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

iroko:sourceRelationship 
    a owl:ObjectProperty ;
    rdfs:label "source relationship"@en ;
    rdfs:comment "Nature of relationship to source tradition for reconstructed/reclaimed practices. Primarily used in Sankofa module. Values: continuous-oral, reconstructed-from-text, speculative-reconstruction, claimed-revelation, etc."@en ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# ANNOTATION PROPERTY
# ===================================================================

iroko:minimumAccessLevel 
    a owl:AnnotationProperty ;
    rdfs:label "minimum access level"@en ;
    rdfs:comment "Annotation property used on other properties to indicate minimum access level required to view their values. Used in vocabulary documentation and RDF export filtering."@en ;
    rdfs:isDefinedBy <https://iroko-framework.github.io/iroko-framework/vocab/iroko-core> .

# ===================================================================
# CONCEPT SCHEME: Traditions
# ===================================================================

iroko:TraditionScheme 
    a skos:ConceptScheme ;
    rdfs:label "Tradition Classification"@en ;
    dcterms:description "Controlled vocabulary of Afro-Atlantic tradition classifications."@en ;
    skos:hasTopConcept iroko:tradition/yoruba-derived,
                       iroko:tradition/bantu-derived,
                       iroko:tradition/fon-ewe-derived,
                       iroko:tradition/calabari,
                       iroko:tradition/akan-derived,
                       iroko:tradition/afro-indigenous,
                       iroko:tradition/syncretic,
                       iroko:tradition/kemetic,
                       iroko:tradition/pan-african .

# Yoruba-derived traditions
iroko:tradition/yoruba-continental 
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Yorùbá (continental)"@en ;
    skos:altLabel "Nigerian Yoruba"@en ;
    skos:definition "Continental Yoruba religious practices in southwestern Nigeria."@en ;
    skos:broader iroko:tradition/yoruba-derived .

iroko:tradition/lucumi 
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Lucumí"@en ;
    skos:altLabel "Regla de Ocha"@en, "Santería"@en ;
    skos:definition "Yoruba-derived tradition in Cuba."@en ;
    skos:broader iroko:tradition/yoruba-derived .

iroko:tradition/candomble-ketu 
    a skos:Concept ;
    skos:inScheme iroko:TraditionScheme ;
    skos:prefLabel "Candomblé Ketu"@en ;
    skos:definition "Yoruba-der
