# --- AssertionStatusScheme -------------------------------------------------

iroko:AssertionStatusScheme
    a skos:ConceptScheme ;
    rdfs:label "Assertion Status"@en ;
    skos:prefLabel "Assertion Status"@en ;
    skos:prefLabel "Estado de afirmación"@es ;
    skos:prefLabel "Statut d'affirmation"@fr ;
    skos:prefLabel "Status de afirmação"@pt ;
    skos:prefLabel "Ipo ìtẹnumọ́"@yo ;
    dcterms:description "Controlled terms for whether a claim is widely attested, lineage-specific, or actively contested."@en ;
    skos:hasTopConcept iroko:assertion-consensual,
                       iroko:assertion-lineage-specific,
                       iroko:assertion-contested .

iroko:assertion-consensual
    a skos:Concept ; skos:inScheme iroko:AssertionStatusScheme ;
    skos:prefLabel "Widely Attested"@en ;
    skos:prefLabel "Ampliamente atestiguado"@es ;
    skos:prefLabel "Largement attesté"@fr ;
    skos:prefLabel "Amplamente atestado"@pt ;
    skos:prefLabel "Tí ọ̀pọ̀lọpọ̀ ìdílé jẹ́rìí sí"@yo ;
    skos:altLabel "Cross-lineage consensus"@en ;
    skos:definition "Affirmed by multiple independent lineages or sources."@en .

iroko:assertion-lineage-specific
    a skos:Concept ; skos:inScheme iroko:AssertionStatusScheme ;
    skos:prefLabel "Lineage-Specific"@en ;
    skos:prefLabel "Específico de linaje"@es ;
    skos:prefLabel "Spécifique à une lignée"@fr ;
    skos:prefLabel "Específico de linhagem"@pt ;
    skos:prefLabel "Tó dá lórí ìdílé kan"@yo ;
    skos:definition "Recognized within a specific lineage or house but not universally."@en .

iroko:assertion-contested
    a skos:Concept ; skos:inScheme iroko:AssertionStatusScheme ;
    skos:prefLabel "Contested"@en ;
    skos:prefLabel "Disputado"@es ;
    skos:prefLabel "Contesté"@fr ;
    skos:prefLabel "Contestado"@pt ;
    skos:prefLabel "Tí a ń jiyàn lórí"@yo ;
    skos:definition "Actively disputed; multiple contradictory positions exist across lineages."@en .

# --- MediaTypeScheme -------------------------------------------------------

iroko:MediaTypeScheme
    a skos:ConceptScheme ;
