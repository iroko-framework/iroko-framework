    skos:prefLabel "Grabación de audio"@es ;
    skos:prefLabel "Enregistrement audio"@fr ;
    skos:prefLabel "Gravação de áudio"@pt ;
    skos:prefLabel "Àgbékalẹ̀ ohùn"@yo .

iroko:mediaType-photograph
    a skos:Concept ; skos:inScheme iroko:MediaTypeScheme ;
    skos:prefLabel "Photograph"@en ;
    skos:prefLabel "Fotografía"@es ;
    skos:prefLabel "Photographie"@fr ;
    skos:prefLabel "Fotografia"@pt ;
    skos:prefLabel "Àwòrán"@yo .

iroko:mediaType-video
    a skos:Concept ; skos:inScheme iroko:MediaTypeScheme ;
    skos:prefLabel "Video Recording"@en ;
    skos:prefLabel "Grabación de video"@es ;
    skos:prefLabel "Enregistrement vidéo"@fr ;
    skos:prefLabel "Gravação de vídeo"@pt ;
    skos:prefLabel "Àgbékalẹ̀ fídíò"@yo .

iroko:mediaType-manuscript
    a skos:Concept ; skos:inScheme iroko:MediaTypeScheme ;
    skos:prefLabel "Manuscript"@en ;
    skos:prefLabel "Manuscrito"@es ;
    skos:prefLabel "Manuscrit"@fr ;
    skos:prefLabel "Ìwé àfọwọ́kọ"@yo .

iroko:mediaType-ephemera
    a skos:Concept ; skos:inScheme iroko:MediaTypeScheme ;
    skos:prefLabel "Ephemera"@en ;
    skos:prefLabel "Efímero"@es ;
    skos:prefLabel "Éphémère"@fr ;
    skos:definition "Printed or handwritten items of transient purpose: programs, invitations, ritual schedules, advertisements for religious events."@en .

