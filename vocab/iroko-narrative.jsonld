      "skos:definition": {
        "@language": "en",
        "@value": "A heading, liturgical direction, or structural marker in the narrative."
      },
      "skos:inScheme": {
        "@id": "iroko:SegmentTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Rubric"
      }
    },
    {
      "@id": "iroko:aboutEntity",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a narrative or variant to entities it concerns — a spirit, plant, place, ritual, person, or any other resource. Range: iroko:SacredEntity — the top-level class for all tradition-specific concepts in the framework."
      },
      "rdfs:domain": {
        "@id": "iroko:NarrativeVariant"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-narrative"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "about entity"
      },
      "rdfs:range": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:variantAuthority",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The Authority context recognized for this variant. Which lineage or house endorses this telling as authoritative."
      },
      "rdfs:domain": {
        "@id": "iroko:NarrativeVariant"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-narrative"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "variant authority"
      },
      "rdfs:range": {
        "@id": "iroko:RitualAuthority"
      }
    },
