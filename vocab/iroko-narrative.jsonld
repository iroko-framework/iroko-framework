      "@id": "iroko:InterpretiveStance",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A hermeneutic or epistemological approach to reading a narrative or variant. Tags the reading frame rather than the content."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-narrative"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Interpretive Stance"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
