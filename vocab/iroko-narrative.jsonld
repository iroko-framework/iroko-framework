    {
      "@id": "iroko:StoryLineage",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A transmission chain for a narrative — who transmitted the story to whom, in what context. Separate from biological kinship. Models oral transmission provenance."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-narrative"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Story Lineage"
      }
    },
    {
      "@id": "iroko:assertsKinship",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a NarrativeVariant to a KinshipClaim it asserts. Used for spirit kinship — spirit-father, spirit-sibling, ancestral claims — where the bond is narrated or testified rather than generated by a documented event. The claim may be contested across lineages or traditions; iroko:KinshipClaim is a subclass of iroko:Assertion and inherits its contested-knowledge modeling. Access: community-only."
      },
      "rdfs:domain": {
        "@id": "iroko:NarrativeVariant"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-narrative"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "asserts kinship"
      },
      "rdfs:range": {
        "@id": "iroko:KinshipClaim"
      }
    },
    {
      "@id": "iroko:stance-analytic",
      "@type": "iroko:InterpretiveStance",
      "skos:definition": {
        "@language": "en",
        "@value": "Researcher or scholarly reading, necessarily outside community interpretive authority."
      },
      "skos:inScheme": {
        "@id": "iroko:InterpretiveStanceScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Analytic"
      }
    },
    {
      "@id": "iroko:narrativeLanguage",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "BCP 47 language tag of the language in which the variant is expressed."
      },
      "rdfs:domain": {
        "@id": "iroko:NarrativeVariant"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-narrative"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "narrative language"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:interpretiveStance",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
