        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a narrative or variant to a sacred agent (spirit, ancestor) who appears as an actor within the narrative content."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-narrative"
      },
      "rdfs:label": {
