        "@id": "iroko:SegmentTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Prayer"
      }
    },
    {
      "@id": "iroko:kinship-road",
      "@type": "skos:Concept",
      "skos:altLabel": {
