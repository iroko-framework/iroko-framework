        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The FieldworkEvent or ritual event that captured or generated this narrative variant."
      },
      "rdfs:domain": {
        "@id": "iroko:NarrativeVariant"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-narrative"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "variant event"
      },
      "rdfs:range": {
        "@id": "iroko:FieldworkEvent"
      }
    },
    {
      "@id": "iroko:role-narrator",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Primary teller or transmitter of the narrative."
      },
      "skos:inScheme": {
        "@id": "iroko:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Narrator"
      }
    },
    {
      "@id": "iroko:varRel-translation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A variant that is a translation into another language, which may introduce interpretive differences."
      },
      "skos:inScheme": {
        "@id": "iroko:VariantRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Translation"
      }
    },
    {
      "@id": "iroko:role-officiant",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Ritual officiant whose role shapes the telling."
      },
      "skos:inScheme": {
        "@id": "iroko:NarrativeRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Officiant"
      }
    },
    {
      "@id": "iroko:varRel-derived",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "One variant clearly derives from or expands upon the other."
      },
      "skos:inScheme": {
        "@id": "iroko:VariantRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Derived"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-narrative",
      "@type": "owl:Ontology",
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Governance Layer module. Full narrative modeling for Afro-Atlantic sacred knowledge systems. Covers story transmission chains, contested kinship claims, testimonies, fieldnotes, interpretive stances, and narrative variant relationships. Builds on the thin narrative spine in iroko-core v1.3.0. Researcher voice (Fieldnote) is kept structurally distinct from community voice (Testimony). Use with iroko-authority to govern who may assert transmission claims, iroko-agency to link sacred agents to narrative appearances, and iroko-epistemic to constrain access to sensitive narrative content."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-02-23"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-02-25"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-agency"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-epistemic"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-manifestation"
        }
      ],
      "dcterms:requires": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Narrative Module"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-narrative/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:relatedAs",
