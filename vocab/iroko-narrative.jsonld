    {
      "@id": "iroko:kinship-child",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "iroko:KinshipTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "child"
        },
        {
          "@language": "es",
          "@value": "hijo/hija"
        }
      ]
    },
    {
      "@id": "iroko:generatesKinship",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an InitiationEvent to the KinshipClaim it creates. Covers initiation-based human kinship bonds: godfather/godson (padrino/ahijado), initiator/initiate, elder/junior lineage member. Unlike assertsKinship, this bond is generated by a documented event of record rather than narrated — the initiation created the bond. Access: initiated-only — initiation genealogy and godparent lineage are internal community records not appropriate for public or community-tier disclosure."
      },
      "rdfs:domain": {
        "@id": "iroko:InitiationEvent"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-narrative"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "generates kinship"
      },
      "rdfs:range": {
        "@id": "iroko:KinshipClaim"
      }
    },
    {
      "@id": "iroko:varRel-close",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Two variants sharing the same core content with minor differences."
      },
      "skos:inScheme": {
        "@id": "iroko:VariantRelationTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Close Variant"
      }
    },
    {
      "@id": "iroko:variantEvent",
      "@type": "owl:ObjectProperty",
