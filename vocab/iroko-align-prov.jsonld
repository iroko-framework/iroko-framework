      }
    },
    {
      "@id": "iroko:DocumentaryEvidence",
      "rdfs:subClassOf": {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-align-prov",
      "@type": "owl:Ontology",
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Reference-only subclass alignment to PROV-O. Declares that Iroko agents, events, entities, and policies are specializations of PROV classes to support interoperability. Does not use owl:imports or owl:equivalentClass — Iroko classes remain semantically sovereign."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-02-23"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-07"
      },
      "dcterms:requires": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-core"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-agency"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework — PROV-O Alignment"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "http://www.w3.org/ns/prov#"
      }
    },
    {
