  },
  "@graph": [
    {
      "@id": "iroko:SacredAgent",
      "rdfs:subClassOf": {
        "@id": "http://www.w3.org/ns/prov#Agent"
      }
    },
    {
      "@id": "iroko:Assertion",
      "rdfs:subClassOf": {
