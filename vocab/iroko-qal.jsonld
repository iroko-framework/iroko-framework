    {
      "@id": "iroko:act-praise",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Formal praise speech honoring an entity, ancestor, or lineage. Oriki in Yorùbá-derived traditions; analogous forms in other traditions."
      },
      "skos:inScheme": {
        "@id": "iroko:SpeechActTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Praise / oriki"
      }
    },
    {
      "@id": "iroko:naming-ecobio-abakua",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The initiatory name given to an Abakuá member at their juramento. No-access."
      },
      "skos:inScheme": {
        "@id": "iroko:SecretNameConventionScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Ecobio name (Abakuá)"
        },
        {
          "@language": "es",
          "@value": "Nombre de ecobio"
        }
      ]
    },
    {
      "@id": "iroko:LiturgicalPhrase",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A multi-word expression, formula, invocation, or greeting used in Afro-Atlantic sacred contexts. Examples: Yorùbá greeting formulas specific to Orisha (mojuba formulas); Palo Kikongo invocations; Vodou salutation phrases for specific lwa. Phrases are documented with their tradition, ceremony context, and speaker authority requirements. General greetings are community-restricted; ceremonial invocations are initiated-only."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Liturgical Phrase"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:LexicalSense",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A specific meaning of a lexical entry, which may carry different access levels than the entry itself. An Orisha's name (entry) may be public, while a path-specific epithet (restricted sense) is community-restricted, and a secret name (esoteric sense) is no-access. Multiple senses of the same term are documented as separate LexicalSense instances with appropriate access levels."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Lexical Sense"
      },
      "rdfs:subClassOf": [
        {
          "@id": "http://www.w3.org/ns/lemon/ontolex#LexicalSense"
        },
        {
          "@id": "iroko:SacredEntity"
        }
      ]
    },
    {
      "@id": "iroko:authorityRequired",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
