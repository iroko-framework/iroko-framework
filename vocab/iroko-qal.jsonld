      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The secret name of a specific Nganga/nkisi in Palo Monte, given at preparation. Known to the Tata and their lineage."
      },
      "skos:inScheme": {
        "@id": "iroko:SecretNameConventionScheme"
      },
