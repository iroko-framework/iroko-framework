    {
      "@id": "iroko:script-arabic",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Arabic script used to write African languages in religious contexts, particularly in Ajami traditions (Fulfulde, Hausa, Wolof in Arabic script). Relevant in West African Islamic contexts that intersect with Afro-Atlantic traditions."
      },
      "skos:inScheme": {
        "@id": "iroko:ScriptSystemScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Arabic script (Ajami)"
      }
    },
    {
      "@id": "iroko:cognateTerms",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Terms in related languages that are etymologically cognate or semantically parallel. Used to document cross-tradition vocabulary relationships (e.g., Yorùbá 'Egúngún' → Lucumí 'Eggun'; Fon 'Legba' → Haitian 'Legba')."
      },
      "rdfs:domain": {
        "@id": "iroko:LexicalEntry"
      },
      "rdfs:isDefinedBy": {
