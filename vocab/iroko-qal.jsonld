{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:SpeechActTypeScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Speech Act Types"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:act-blessing"
        },
        {
          "@id": "iroko:act-consecration"
        },
        {
          "@id": "iroko:act-farewell"
        },
        {
          "@id": "iroko:act-invocation"
        },
        {
          "@id": "iroko:act-naming"
        },
        {
          "@id": "iroko:act-oath"
        },
        {
          "@id": "iroko:act-other"
        },
        {
          "@id": "iroko:act-praise"
        },
        {
          "@id": "iroko:act-prohibition"
        },
        {
          "@id": "iroko:act-salutation"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Speech Act Types"
        },
        {
          "@language": "es",
          "@value": "Tipos de acto de habla sagrado"
        },
        {
          "@language": "fr",
          "@value": "Types d'acte de parole sacré"
        },
        {
          "@language": "pt",
          "@value": "Tipos de ato de fala sagrado"
        },
        {
          "@language": "yo",
          "@value": "Àwọn ìrú ọ̀rọ̀ mímọ́"
        }
      ]
    },
    {
      "@id": "iroko:scriptSystem",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The writing system used for this language, where applicable. Range: iroko:ScriptSystemScheme."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredLanguage"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "script system"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:lang-full-liturgical",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A language used in its complete grammatical form as the primary medium of sacred communication. Examples: Yorùbá in continental Yorùbá religion; Fon in Beninese Vodun; Ge'ez in Ethiopian Orthodox liturgy."
      },
      "skos:inScheme": {
        "@id": "iroko:SacredLanguageTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Full liturgical language"
      }
    },
    {
      "@id": "iroko:lang-graphic-lexical",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A system in which graphic signs function as lexical or semiotic units, functioning analogously to writing. Examples: Nsibidi (Ejagham) as a graphic communication system; Anaforuana signs with lexical referents. Linked to iroko-veve for the graphic dimension."
      },
      "skos:inScheme": {
        "@id": "iroko:SacredLanguageTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Graphic-lexical system"
      }
    },
    {
      "@id": "iroko:SacredSpeechAct",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A formally defined speech act type within a tradition's ceremonial protocol: oath-taking, naming, cursing, blessing, consecration, authorization. Distinct from a specific utterance: a SacredSpeechAct is the category (e.g., 'Ifá greeting formula') while a LiturgicalPhrase is a specific instance. The existence of a speech act type is community-restricted; its specific form and context are initiated-only to elder-only."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sacred Speech Act"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:hasSense",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a LexicalEntry to one of its LexicalSenses. A single entry may carry multiple senses at different access levels — a public sense (general meaning), a community sense (practitioner usage), and an esoteric sense (initiated meaning). Each sense is a separate LexicalSense instance governed by its own access level. Declared as rdfs:subPropertyOf ontolex:sense to maintain OntoLex-Lemon alignment. Access: community-only at minimum; individual senses carry their own access governance."
      },
      "rdfs:domain": {
        "@id": "iroko:LexicalEntry"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has sense"
      },
      "rdfs:range": {
        "@id": "iroko:LexicalSense"
      },
      "rdfs:subPropertyOf": {
        "@id": "http://www.w3.org/ns/lemon/ontolex#sense"
      }
    },
    {
      "@id": "iroko:script-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Script system not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:ScriptSystemScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:act-prohibition",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Speech acts that declare or reinforce a taboo, restriction, or prohibition."
      },
      "skos:inScheme": {
        "@id": "iroko:SpeechActTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Prohibition / taboo declaration"
      }
    },
    {
      "@id": "iroko:SecretName",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An esoteric or restricted name for a spiritual entity, practitioner, or sacred object known only to initiated members at a specific grade or above. Examples: the secret name of an Orisha camino revealed in itá; a Palo Tata's nkisi name; an Abakuá ecobio name. The existence of secret name conventions within a tradition is public; the names themselves are no-access."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Secret Name"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:LexicalEntry",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A word, term, or morpheme in a sacred language with its liturgical or ritual meaning documented. Subclass of ontolex:LexicalEntry for integration with multilingual lexicographic infrastructure. A single lexical entry may have multiple senses (iroko:LexicalSense), including restricted senses whose esoteric meaning is not disclosed publicly. The existence of a term is community-restricted; its esoteric sense is initiated-only."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Lexical Entry"
      },
      "rdfs:subClassOf": [
        {
          "@id": "http://www.w3.org/ns/lemon/ontolex#LexicalEntry"
        },
        {
          "@id": "iroko:SacredEntity"
        }
      ]
    },
    {
      "@id": "iroko:script-geez",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Ethiopic abugida used to write Ge'ez, Amharic, Tigrinya, and other Ethiopian and Eritrean languages. The sacred script of Ethiopian and Eritrean Orthodox liturgy."
      },
      "skos:inScheme": {
        "@id": "iroko:ScriptSystemScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "am",
          "@value": "ፊደል (Fidel)"
        },
        {
          "@language": "en",
          "@value": "Ge'ez / Ethiopic script"
        }
      ]
    },
    {
      "@id": "iroko:act-oath",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A sworn commitment made in the presence of spiritual witnesses, binding on the speaker. Examples: Abakuá juramento; Palo Monte pact formulas. Initiated-only."
      },
      "skos:inScheme": {
        "@id": "iroko:SpeechActTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Oath / juramento"
      }
    },
    {
      "@id": "iroko:phraseText",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The text of the liturgical phrase in its original language. Language-tagged. Initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:LiturgicalPhrase"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "phrase text"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:act-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Speech act type not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:SpeechActTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:lang-african-christian",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Languages of African origin used in pre-colonial or early-colonial African Christian traditions. Ge'ez (Ethiopian Orthodox, Eritrean Orthodox), Coptic (Egyptian Coptic Church). Included here because of their continuity with African sacred language traditions and their presence in Afro-Atlantic communities."
      },
      "skos:inScheme": {
        "@id": "iroko:SacredLanguageTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "African Christian liturgical language"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-qal",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-22"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Domain module. Vocabulary for documenting sacred lexicons, liturgical languages, and esoteric terminology across Afro-Atlantic and related African sacred traditions. Qal (ቃል) — Ge'ez for 'word.' Covers liturgical Yorùbá (Lucumí), Kikongo (Palo), Haitian Kreyòl sacred register, Fon/Ewe, and Ge'ez. Integrates with the OntoLex-Lemon Ontology for Lexicography for multilingual lexical data. Access control distinguishes public knowledge (language names, general vocabulary) from restricted esoteric terminology and secret names. Use with iroko-epistemic to model secret name and esoteric term disclosure constraints; iroko-narrative for liturgical phrase transmission chains and praise poetry provenance."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-02-25"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-epistemic"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-narrative"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Qal Module (Sacred Lexicons and Liturgical Language)"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-qal/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:esotericDefinition",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The initiated or esoteric meaning of this sense, disclosed only to qualified practitioners. Initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:LexicalSense"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "esoteric definition"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:lang-afro-atlantic",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A source language preserved in Afro-Atlantic in a fossilized or adapted form, used for liturgical purposes but no longer a community vernacular. Examples: Lucumí (Afro-Atlantic Yorùbá in Cuba); Kikongo as used in Cuban Palo Monte; liturgical Fon in Haitian Vodou."
      },
      "skos:inScheme": {
        "@id": "iroko:SacredLanguageTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Afro-Atlantic liturgical language"
      }
    },
    {
      "@id": "iroko:act-consecration",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Speech that transforms an object, person, or space from secular to sacred status. Among the most restricted speech acts."
      },
      "skos:inScheme": {
        "@id": "iroko:SpeechActTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Consecration"
      }
    },
    {
      "@id": "iroko:act-farewell",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Formal speech acts that close a ceremony or take leave of a spiritual entity."
      },
      "skos:inScheme": {
        "@id": "iroko:SpeechActTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Farewell / closing"
      }
    },
    {
      "@id": "iroko:act-blessing",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A formally authorized speech act conferring spiritual benefit, protection, or grace. Requires recognized authority to perform."
      },
      "skos:inScheme": {
        "@id": "iroko:SpeechActTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Blessing"
      }
    },
    {
      "@id": "iroko:script-anaforuana",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Abakuá graphic script with lexical and communicative functions. Cross-listed with iroko-veve; included here for documentation of the semiotic/communicative dimension."
      },
      "skos:inScheme": {
        "@id": "iroko:ScriptSystemScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Anaforuana (Abakuá)"
      }
    },
    {
      "@id": "iroko:communityDefinition",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A definition appropriate for community members and practitioners, including cultural context not meant for general publication. Language-tagged."
      },
      "rdfs:domain": {
        "@id": "iroko:LexicalSense"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "community definition"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:secretNameHolder",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-no-access"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The entity (spiritual or human) who holds this secret name. Range: iroko:SpiritualEntity or foaf:Person. No-access."
      },
      "rdfs:domain": {
        "@id": "iroko:SecretName"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "name holder"
      },
      "rdfs:range": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:hasEntry",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "owl:inverseOf": {
        "@id": "iroko:inLanguage"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a SacredLanguage to a LexicalEntry in that language. Inverse of iroko:inLanguage. Enables a researcher to start from a language and traverse its full lexical inventory. A SacredLanguage may have many entries; each entry belongs to exactly one SacredLanguage via inLanguage. Access: community-only — the lexical inventory of a sacred language is appropriate for practitioners and scholars with community standing."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredLanguage"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has entry"
      },
      "rdfs:range": {
        "@id": "iroko:LexicalEntry"
      }
    },
    {
      "@id": "iroko:pos-adverb",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "An adverbial modifier."
      },
      "skos:inScheme": {
        "@id": "iroko:PartOfSpeechScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Adverb"
      }
    },
    {
      "@id": "iroko:speechActType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a LiturgicalPhrase to the SacredSpeechAct type it instantiates — oath, invocation, greeting, prohibition, praise, or similar. SacredSpeechAct is a classification of the ceremonial function a phrase performs within ritual protocol; this property tags the phrase with that type. A phrase may instantiate more than one speech act type. Access: community-only."
      },
      "rdfs:domain": {
        "@id": "iroko:LiturgicalPhrase"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "speech act type"
      },
      "rdfs:range": {
        "@id": "iroko:SacredSpeechAct"
      }
    },
    {
      "@id": "iroko:act-salutation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Formal greetings addressed to an entity, elder, or ceremonial space. Examples: Orisha salutation formulas (Mojuba); Vodou bonjou to specific lwa."
      },
      "skos:inScheme": {
        "@id": "iroko:SpeechActTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Salutation / greeting"
      }
    },
    {
      "@id": "iroko:geographicBase",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The geographic region(s) where this language is primarily used. Free-text."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredLanguage"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "geographic base"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:script-latin",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Latin alphabet as used to transcribe liturgical Yorùbá, Lucumí, Kikongo, Haitian Kreyòl, and most documented Afro-Atlantic liturgical languages."
      },
      "skos:inScheme": {
        "@id": "iroko:ScriptSystemScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Latin script"
      }
    },
    {
      "@id": "iroko:ScriptSystemScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@language": "en",
        "@value": "Script Systems"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:script-adinkra"
        },
        {
          "@id": "iroko:script-anaforuana"
        },
        {
          "@id": "iroko:script-arabic"
        },
        {
          "@id": "iroko:script-geez"
        },
        {
          "@id": "iroko:script-latin"
        },
        {
          "@id": "iroko:script-nsibidi"
        },
        {
          "@id": "iroko:script-oral-only"
        },
        {
          "@id": "iroko:script-other"
        }
      ],
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Script Systems"
        },
        {
          "@language": "es",
          "@value": "Sistemas de escritura sagrada"
        },
        {
