      }
    },
    {
      "@id": "iroko:pos-verb",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A verb or verb phrase (ceremonial actions, states)."
      },
      "skos:inScheme": {
        "@id": "iroko:PartOfSpeechScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Verb"
      }
    },
    {
      "@id": "iroko:SacredLanguage",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A language, language register, or language variety used as a liturgical or ritual medium in Afro-Atlantic or related African sacred practice. Includes fully distinct languages (Yorùbá in Lucumí/Candomblé; Kikongo in Palo Monte; Fon in Haitian Vodou), sacred registers of creole languages (Haitian Kreyòl ceremonial register), specialized vocabularies (Lucumí as Afro-Atlantic-adapted liturgical Yorùbá), and graphic-lexical systems (Nsibidi as both script and vocabulary system). Also includes African Christian liturgical languages: Ge'ez (Ethiopian/Eritrean Orthodox), Coptic (Egyptian Coptic Church)."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sacred Language"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:lang-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Sacred language type not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:SacredLanguageTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:script-nsibidi",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The Ejagham ideographic writing system, functioning as both script and graphic sign system. Cross-listed with iroko-veve for its graphic dimension; listed here for its lexical and communicative dimension."
      },
      "skos:inScheme": {
        "@id": "iroko:ScriptSystemScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Nsibidi (Ejagham)"
      }
    },
    {
      "@id": "iroko:naming-initiate-ita",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A name or identifier given to an initiate in their itá (life reading). Typically held as private to the initiate and their elders."
      },
      "skos:inScheme": {
        "@id": "iroko:SecretNameConventionScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Initiate name (from itá)"
        },
        {
          "@language": "es",
          "@value": "Nombre de itá"
        }
      ]
    },
