        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Translation of the phrase into a non-liturgical language. Initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:LiturgicalPhrase"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
