      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The secret name of a specific camino (path) of an Orisha, revealed in divination. Community-restricted in general; the specific name is initiated-elder only."
      },
      "skos:inScheme": {
        "@id": "iroko:SecretNameConventionScheme"
