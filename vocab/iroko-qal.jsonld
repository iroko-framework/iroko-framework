        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:act-naming",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The formal conferral of a sacred or initiatory name on a person, object, or entity."
      },
      "skos:inScheme": {
        "@id": "iroko:SpeechActTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Naming"
      }
    },
    {
      "@id": "iroko:script-oral-only",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Language transmitted exclusively orally without a writing system. The majority of Afro-Atlantic liturgical languages fall here historically; Latin transcription is secondary."
      },
      "skos:inScheme": {
        "@id": "iroko:ScriptSystemScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Oral tradition (no script)"
      }
    },
    {
      "@id": "iroko:phraseTranslation",
