    {
      "@id": "iroko:hasPhrase",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "owl:inverseOf": {
        "@id": "iroko:phraseLanguage"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a SacredLanguage to a LiturgicalPhrase expressed in that language. Inverse of iroko:phraseLanguage. Enables a researcher to start from a language and traverse its attested liturgical formulas, invocations, greetings, and oaths. Access: community-only — attested liturgical phrases are appropriate for practitioners and qualified scholars; phrase translations and full texts are governed at initiated level on the LiturgicalPhrase instances themselves."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredLanguage"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-qal"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has phrase"
      },
      "rdfs:range": {
        "@id": "iroko:LiturgicalPhrase"
      }
    },
    {
      "@id": "iroko:pos-formula",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A multi-word fixed expression that functions as a unit in ceremonial contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:PartOfSpeechScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Fixed formula"
      }
    },
    {
      "@id": "iroko:lang-sacred-register",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A specialized ceremonial register of a vernacular language, with vocabulary and formulas specific to sacred contexts. Examples: the Vodou ceremonial register of Haitian Kreyòl; the ceremonial Jamaican Patois of Kumina."
      },
      "skos:inScheme": {
        "@id": "iroko:SacredLanguageTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Sacred register of a vernacular"
      }
    },
