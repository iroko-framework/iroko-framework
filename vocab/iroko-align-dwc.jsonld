{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "http://rs.tdwg.org/dwc/terms/associatedMedia",
      "rdfs:comment": {
        "@language": "en",
        "@value": "In Iroko Framework context: closeMatch to iroko:photographicVoucher. Range difference: iroko:DocumentaryEvidence vs. free-text URI list."
      }
    },
    {
      "@id": "http://rs.tdwg.org/dwc/terms/Occurrence",
      "rdfs:comment": {
        "@language": "en",
        "@value": "In Iroko Framework context: equivalent to iroko:Plant. See iroko-align-dwc."
      }
    },
    {
      "@id": "iroko:Plant",
      "owl:equivalentClass": {
        "@id": "http://rs.tdwg.org/dwc/terms/Occurrence"
      }
    },
    {
      "@id": "http://rs.tdwg.org/dwc/terms/catalogNumber",
      "rdfs:comment": {
        "@language": "en",
        "@value": "In Iroko Framework context: exactMatch to iroko:specimenNumber on iroko:HerbariumSheet instances."
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-align-dwc",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-03-08"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Formal OWL and SKOS alignment declarations between Iroko Ewe Module terms and Darwin Core (dwc:) terms published by TDWG. This file is reference-only infrastructure: it contains no user-facing vocabulary terms. Import or cite alongside iroko-ewe when interoperating with herbarium, occurrence, and biodiversity informatics systems."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-08"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Darwin Core Alignment"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-ewe"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-align-dwc/1.0.0"
      },
      "owl:versionInfo": "1.0.0",
      "rdfs:seeAlso": {
        "@id": "https://dwc.tdwg.org/terms/"
      }
    },
    {
      "@id": "iroko:photographicVoucher",
      "skos:closeMatch": {
        "@id": "http://rs.tdwg.org/dwc/terms/associatedMedia"
      }
    },
    {
      "@id": "iroko:specimenNumber",
      "skos:exactMatch": {
        "@id": "http://rs.tdwg.org/dwc/terms/catalogNumber"
      }
    }
  ]
}