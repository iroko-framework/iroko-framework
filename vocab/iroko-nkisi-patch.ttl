# -*- coding: utf-8 -*-
# ===================================================================
# IROKO NKISI MODULE — PATCH
# Additions: SpiritKinshipRelationScheme, PolarityModalityScheme
# Append to iroko-nkisi.ttl
# ===================================================================

# ===================================================================
# CONCEPT SCHEME: Spirit Kinship Relations
# Belongs in nkisi (spirit-to-spirit relationships).
# Used with iroko:RelationshipAssertion from iroko-core.
# ===================================================================

nkisi:SpiritKinshipRelationScheme
    a skos:ConceptScheme ;
    rdfs:label "Spirit Kinship Relation Types"@en ;
    dcterms:description "Controlled kinship relation types for spirit-to-spirit relationship assertions. Used as the range of iroko:relationType on iroko:RelationshipAssertion nodes. Kinship in this context is cosmological, not biological."@en ;
    skos:prefLabel "Spirit Kinship Relations"@en ;
    skos:prefLabel "Relaciones de parentesco espiritual"@es ;
    skos:prefLabel "Relations de parenté spirituelle"@fr ;
    skos:prefLabel "Relações de parentesco espiritual"@pt ;
    skos:prefLabel "Ìbátan ẹ̀mí sí ẹ̀mí"@yo ;
    skos:hasTopConcept nkisi:kinship-father-of,
                       nkisi:kinship-mother-of,
                       nkisi:kinship-parent-of,
                       nkisi:kinship-child-of,
                       nkisi:kinship-sibling-of,
                       nkisi:kinship-brother-of,
                       nkisi:kinship-sister-of,
                       nkisi:kinship-spouse-of,
                       nkisi:kinship-twin-of .

nkisi:kinship-father-of
    a skos:Concept ;
    skos:inScheme nkisi:SpiritKinshipRelationScheme ;
    skos:prefLabel "father of"@en ;
    skos:prefLabel "padre de"@es ;
    skos:prefLabel "père de"@fr ;
    skos:prefLabel "pai de"@pt ;
    skos:prefLabel "bàbá fún"@yo .

nkisi:kinship-mother-of
    a skos:Concept ;
    skos:inScheme nkisi:SpiritKinshipRelationScheme ;
    skos:prefLabel "mother of"@en ;
    skos:prefLabel "madre de"@es ;
    skos:prefLabel "mère de"@fr ;
    skos:prefLabel "mãe de"@pt ;
    skos:prefLabel "ìyá fún"@yo .

nkisi:kinship-parent-of
    a skos:Concept ;
    skos:inScheme nkisi:SpiritKinshipRelationScheme ;
    skos:prefLabel "parent of"@en ;
    skos:prefLabel "progenitor de"@es ;
    skos:prefLabel "parent de"@fr ;
    skos:prefLabel "genitor de"@pt ;
    skos:prefLabel "òbí fún"@yo ;
    skos:scopeNote "Use when the gendered parent role is unspecified or ambiguous in source material."@en .

nkisi:kinship-child-of
    a skos:Concept ;
    skos:inScheme nkisi:SpiritKinshipRelationScheme ;
    skos:prefLabel "child of"@en ;
    skos:prefLabel "hijo o hija de"@es ;
    skos:prefLabel "enfant de"@fr ;
    skos:prefLabel "filho ou filha de"@pt ;
    skos:prefLabel "ọmọ fún"@yo .

nkisi:kinship-sibling-of
    a skos:Concept ;
    skos:inScheme nkisi:SpiritKinshipRelationScheme ;
    skos:prefLabel "sibling of"@en ;
    skos:prefLabel "hermano o hermana de"@es ;
    skos:prefLabel "frère ou sœur de"@fr ;
    skos:prefLabel "irmão ou irmã de"@pt ;
    skos:prefLabel "ará fún"@yo ;
    skos:scopeNote "Use when gendered sibling distinction is absent or contested in source material."@en .

nkisi:kinship-brother-of
    a skos:Concept ;
    skos:inScheme nkisi:SpiritKinshipRelationScheme ;
    skos:prefLabel "brother of"@en ;
    skos:prefLabel "hermano de"@es ;
    skos:prefLabel "frère de"@fr ;
    skos:prefLabel "irmão de"@pt ;
    skos:prefLabel "ẹ̀gbọ́n tàbí àbúròkùnrin fún"@yo .

nkisi:kinship-sister-of
    a skos:Concept ;
    skos:inScheme nkisi:SpiritKinshipRelationScheme ;
    skos:prefLabel "sister of"@en ;
    skos:prefLabel "hermana de"@es ;
    skos:prefLabel "sœur de"@fr ;
    skos:prefLabel "irmã de"@pt ;
    skos:prefLabel "ẹ̀gbọ́n tàbí àbúròbìnrin fún"@yo .

nkisi:kinship-spouse-of
    a skos:Concept ;
    skos:inScheme nkisi:SpiritKinshipRelationScheme ;
    skos:prefLabel "spouse of"@en ;
    skos:prefLabel "cónyuge de"@es ;
    skos:prefLabel "époux ou épouse de"@fr ;
    skos:prefLabel "cônjuge de"@pt ;
    skos:prefLabel "alábàáṣiṣẹ́ ìgbéyàwó fún"@yo .

nkisi:kinship-twin-of
    a skos:Concept ;
    skos:inScheme nkisi:SpiritKinshipRelationScheme ;
    skos:prefLabel "twin of"@en ;
    skos:prefLabel "gemelo o gemela de"@es ;
    skos:prefLabel "jumeau ou jumelle de"@fr ;
    skos:prefLabel "gêmeo ou gêmea de"@pt ;
    skos:prefLabel "ìbejì fún"@yo ;
    skos:scopeNote "In Lucumí cosmology, Ibeji (twins) hold specific sacred status. This relation type should be used with iroko:assertionStatus to indicate whether the twin relationship is consensual or lineage-specific."@en .

# ===================================================================
# CONCEPT SCHEME: Polarity and Gender Modality
# Belongs in nkisi (attributes of spiritual entities).
# This is metaphysical polarity, not biological sex.
# ===================================================================

nkisi:PolarityModalityScheme
    a skos:ConceptScheme ;
    rdfs:label "Polarity and Gender Modality"@en ;
    dcterms:description "Controlled terms for describing metaphysical polarity or gendered alignment in ritual address, cosmology, and manifestation. This scheme does not describe biological sex. Multiple concepts may apply to a single entity via different paths (iroko:RelationshipAssertion with assertionScope for camino-level distinctions)."@en ;
    skos:prefLabel "Polarity and Gender Modality"@en ;
    skos:prefLabel "Polaridad y modalidad de género"@es ;
    skos:prefLabel "Polarité et modalité de genre"@fr ;
    skos:prefLabel "Polaridade e modalidade de gênero"@pt ;
    skos:prefLabel "Ìṣọ̀kan agbára àti ìwà ìbálò"@yo ;
    skos:hasTopConcept nkisi:polarity-masculine,
                       nkisi:polarity-feminine,
                       nkisi:polarity-androgynous,
                       nkisi:polarity-apolar,
                       nkisi:polarity-aspect-dependent,
                       nkisi:polarity-temporal .

nkisi:polarity-masculine
    a skos:Concept ;
    skos:inScheme nkisi:PolarityModalityScheme ;
    skos:prefLabel "Masculine"@en ;
    skos:prefLabel "Masculino"@es ;
    skos:prefLabel "Masculin"@fr ;
    skos:prefLabel "Masculino"@pt ;
    skos:prefLabel "Akọ"@yo ;
    skos:definition "Consistent masculine polarity in ritual address, manifestation, and alignment across known caminos."@en .

nkisi:polarity-feminine
    a skos:Concept ;
    skos:inScheme nkisi:PolarityModalityScheme ;
    skos:prefLabel "Feminine"@en ;
    skos:prefLabel "Femenino"@es ;
    skos:prefLabel "Féminin"@fr ;
    skos:prefLabel "Feminino"@pt ;
    skos:prefLabel "Abo"@yo ;
    skos:definition "Consistent feminine polarity in ritual address, manifestation, and alignment across known caminos."@en .

nkisi:polarity-androgynous
    a skos:Concept ;
    skos:inScheme nkisi:PolarityModalityScheme ;
    skos:prefLabel "Androgynous"@en ;
    skos:prefLabel "Andrógino"@es ;
    skos:prefLabel "Androgyne"@fr ;
    skos:prefLabel "Andrógino"@pt ;
    skos:prefLabel "Akọ àti abo papọ̀"@yo ;
    skos:definition "Masculine and feminine qualities are simultaneously present and inseparable. Distinct from aspect-dependent, where polarity shifts between manifestations."@en ;
    skos:example "Obatala in many lineages simultaneously embodies masculine and feminine principles, expressed in white, stillness, and completion."@en .

nkisi:polarity-apolar
    a skos:Concept ;
    skos:inScheme nkisi:PolarityModalityScheme ;
    skos:prefLabel "Apolar"@en ;
    skos:prefLabel "Apolar"@es ;
    skos:prefLabel "Apolaire"@fr ;
    skos:prefLabel "Apolar"@pt ;
    skos:prefLabel "Àìní ìṣọ̀kan"@yo ;
    skos:altLabel "Beyond polarity"@en ;
    skos:definition "Not described in gendered or polarity terms, or explicitly transcending the masculine/feminine binary. Not the same as unknown."@en .

nkisi:polarity-aspect-dependent
    a skos:Concept ;
    skos:inScheme nkisi:PolarityModalityScheme ;
    skos:prefLabel "Aspect-Dependent"@en ;
    skos:prefLabel "Dependiente del aspecto"@es ;
    skos:prefLabel "Dépendant de l'aspect"@fr ;
    skos:prefLabel "Dependente do aspecto"@pt ;
    skos:prefLabel "Gẹ́gẹ́ bí àwòrán tí a fihàn"@yo ;
    skos:altLabel "Camino-dependent"@en ;
    skos:definition "Polarity varies by named camino, avatar, path, or manifestation. Individual paths should carry their own polarity assertion via iroko:RelationshipAssertion with assertionScope."@en ;
    skos:example "Oya presents as feminine in most lineages but some roads (caminos) of Oya are understood as masculine or androgynous."@en .

nkisi:polarity-temporal
    a skos:Concept ;
    skos:inScheme nkisi:PolarityModalityScheme ;
    skos:prefLabel "Temporal"@en ;
    skos:prefLabel "Temporal"@es ;
    skos:prefLabel "Temporel"@fr ;
    skos:prefLabel "Temporal"@pt ;
    skos:prefLabel "Gẹ́gẹ́ bí àsìkò"@yo ;
    skos:altLabel "Seasonal polarity shift"@en ;
    skos:definition "Polarity shifts according to time of year, liturgical calendar, season, or ritual period. The shift is cyclical and predictable, not camino-specific."@en .
