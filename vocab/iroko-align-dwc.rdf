<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko-align-dwc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Iroko Framework: Darwin Core Alignment</dcterms:title>
    <dcterms:description xml:lang="en">Formal OWL and SKOS alignment declarations between Iroko Ewe Module terms and Darwin Core (dwc:) terms published by TDWG. This file is reference-only infrastructure: it contains no user-facing vocabulary terms. Import or cite alongside iroko-ewe when interoperating with herbarium, occurrence, and biodiversity informatics systems.</dcterms:description>
    <dcterms:creator>Iroko Historical Society</dcterms:creator>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-08</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-08</dcterms:modified>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:isPartOf rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <rdfs:seeAlso rdf:resource="https://dwc.tdwg.org/terms/"/>
    <owl:imports rdf:resource="https://ontology.irokosociety.org/iroko-ewe"/>
    <owl:versionIRI rdf:resource="https://ontology.irokosociety.org/iroko-align-dwc/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#specimenNumber">
    <skos:exactMatch rdf:resource="http://rs.tdwg.org/dwc/terms/catalogNumber"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Plant">
    <owl:equivalentClass rdf:resource="http://rs.tdwg.org/dwc/terms/Occurrence"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rs.tdwg.org/dwc/terms/catalogNumber">
    <rdfs:comment xml:lang="en">In Iroko Framework context: exactMatch to iroko:specimenNumber on iroko:HerbariumSheet instances.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://rs.tdwg.org/dwc/terms/associatedMedia">
    <rdfs:comment xml:lang="en">In Iroko Framework context: closeMatch to iroko:photographicVoucher. Range difference: iroko:DocumentaryEvidence vs. free-text URI list.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#photographicVoucher">
    <skos:closeMatch rdf:resource="http://rs.tdwg.org/dwc/terms/associatedMedia"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rs.tdwg.org/dwc/terms/Occurrence">
    <rdfs:comment xml:lang="en">In Iroko Framework context: equivalent to iroko:Plant. See iroko-align-dwc.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
