[
  {
    "localName": "region-central-african",
    "prefLabel": "Central African traditions",
    "altLabels": [],
    "uri": "https://ontology.irokosociety.org/iroko#region-central-african",
    "anchorUrl": "https://ontology.irokosociety.org/vocab/iroko-core.html#region-central-african",
    "broader": null,
    "definition": "Traditions with primary roots in the Bantu and Equatorial communities of Central Africa, including the Kongo kingdom and its successor traditions, Luba, Mbundu, Chokwe, and related cultures of the Congo River basin and its watersheds.",
    "scopeNote": ""
  },
  {
    "localName": "region-east-african",
    "prefLabel": "East African traditions",
    "altLabels": [],
    "uri": "https://ontology.irokosociety.org/iroko#region-east-african",
    "anchorUrl": "https://ontology.irokosociety.org/vocab/iroko-core.html#region-east-african",
    "broader": null,
    "definition": "Traditions with primary roots in the Swahili coast, Great Lakes region, and Horn of Africa, including Swahili-speaking coastal communities, Cushitic-speaking peoples (Somali, Oromo, Afar), Great Lakes Bantu communities (Ganda, Nyoro, Haya), and the diverse cultures of the East African interior.",
    "scopeNote": ""
  },
  {
    "localName": "region-nile-valley",
    "prefLabel": "Nile Valley and Northeast African traditions",
    "altLabels": [],
    "uri": "https://ontology.irokosociety.org/iroko#region-nile-valley",
    "anchorUrl": "https://ontology.irokosociety.org/vocab/iroko-core.html#region-nile-valley",
    "broader": null,
    "definition": "Traditions with primary roots in the Middle Nile Valley, Upper Nile, Ethiopian highlands, and Eritrean plateau. Covers Christian Nubian civilization (Nobadia, Makuria, Alodia), Sudanic traditions, Ethiopian Orthodox and indigenous Ethiopian communities, and Ge'ez-language manuscript cultures. The geographic scope of materials in the Database of Medieval Nubian Texts (DBMNT, University of Warsaw) and the Hill Museum and Manuscript Library Northeast African collections.",
    "scopeNote": ""
  },
  {
    "localName": "region-north-african",
    "prefLabel": "North African traditions",
    "altLabels": [],
    "uri": "https://ontology.irokosociety.org/iroko#region-north-african",
    "anchorUrl": "https://ontology.irokosociety.org/vocab/iroko-core.html#region-north-african",
    "broader": null,
    "definition": "Traditions with primary roots in the Maghreb and Mediterranean African zones, including Amazigh/Berber communities, North African Arab traditions, and Coptic Christian communities of Egypt. Also covers ancient Egyptian religious traditions (Kemetic) and their modern revivals.",
    "scopeNote": ""
  },
  {
    "localName": "region-southern-african",
    "prefLabel": "Southern African traditions",
    "altLabels": [],
    "uri": "https://ontology.irokosociety.org/iroko#region-southern-african",
    "anchorUrl": "https://ontology.irokosociety.org/vocab/iroko-core.html#region-southern-african",
    "broader": null,
    "definition": "Traditions with primary roots in the southern African plateau and coastal zones, including Nguni-speaking peoples (Zulu, Xhosa, Swati, Ndebele), Sotho-Tswana communities, Venda, Shona, San/Khoisan hunter-gatherer traditions, and the diverse cultures of southern Africa.",
    "scopeNote": ""
  },
  {
    "localName": "region-west-african",
    "prefLabel": "West African traditions",
    "altLabels": [],
    "uri": "https://ontology.irokosociety.org/iroko#region-west-african",
    "anchorUrl": "https://ontology.irokosociety.org/vocab/iroko-core.html#region-west-african",
    "broader": null,
    "definition": "Traditions with primary roots in the peoples and cultures of the West African coastal and Sahel zones, spanning the area from Senegambia through the Gulf of Guinea. Includes but is not limited to Yoruba, Akan, Ewe-Fon/Gbe, Igbo, Hausa-Fulani, Mande, and Cross River/Efik communities. The geographic region from which the largest share of Afro-Atlantic religious traditions originate.",
    "scopeNote": ""
  },
