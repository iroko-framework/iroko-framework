    {
      "@id": "iroko:inst-shekere",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Gourd rattle with bead netting used across Yorùbá-derived and related traditions. Consecrated shekeré are used in Orisha ceremonies; güiro refers to the Cuban variant."
      },
      "skos:inScheme": {
        "@id": "iroko:InstrumentTypeScheme"
