    {
      "@id": "iroko:inst-bata",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Two-headed conical hourglass drum of Yorùbá origin. In Lucumí tradition, the consecrated Añá bàtá set (iyá, itótele, okónkolo) is the highest-authority drum. Requires Olubatá/Aña initiation to play in sacred contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:InstrumentTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
