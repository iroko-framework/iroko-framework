        }
      ]
    },
    {
      "@id": "iroko:song-healing",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Songs performed as part of healing or cleansing interventions."
      },
      "skos:inScheme": {
        "@id": "iroko:SongFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Healing"
      }
    },
    {
      "@id": "iroko:associatedRhythm",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The rhythm pattern that accompanies this song."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredSong"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "associated rhythm"
      },
      "rdfs:range": {
        "@id": "iroko:SacredRhythm"
      }
    },
    {
      "@id": "iroko:instrumentType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
