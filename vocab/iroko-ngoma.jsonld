      "rdfs:label": {
        "@language": "en",
        "@value": "song text"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:inst-petwo-drum",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Drums used in Haitian Vodou Petwo nation ceremonies. Prepared differently from Rada drums; tighter skin tuning and faster tempo."
      },
      "skos:inScheme": {
        "@id": "iroko:InstrumentTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Petwo drum"
        },
        {
          "@language": "fr",
          "@value": "Tambou Petwo"
        }
      ]
    },
    {
      "@id": "iroko:addaEspiritualStatus",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-elder"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Free-text description of the esoteric or sacred status of this instrument, including any restrictions on who may touch, play, or be present. Initiated-elder only."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredDrumSet"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "esoteric status notes"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:song-invocation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Song that calls or invites a spiritual entity. Primary function of canto de entrada and analogous opening songs."
      },
      "skos:inScheme": {
        "@id": "iroko:SongFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Invocation"
      }
    },
    {
      "@id": "iroko:setLineage",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The musician lineage to which this drum set belongs. Particularly important for Añá bàtá: the Olubatá lineage determines performance rights and toque knowledge. Initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredDrumSet"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "drum set lineage"
      },
      "rdfs:range": {
        "@id": "iroko:MusicianLineage"
      }
    },
    {
      "@id": "iroko:inst-atabaque",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Single-headed conical drum used in Candomblé in sets of three (rum/grande, rumpi/médio, lé/pequeno). May be consecrated; the rum (largest) typically leads."
      },
      "skos:inScheme": {
        "@id": "iroko:InstrumentTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Atabaque"
        },
        {
          "@language": "pt",
          "@value": "Atabaque"
        }
      ]
    },
    {
      "@id": "iroko:song-initiation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Songs performed specifically within initiatory rites, restricted to those contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:SongFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Initiation ceremony"
      }
    },
    {
      "@id": "iroko:family-vodou-petwo",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Rhythms of the Petwo nation in Haitian Vodou, associated with fiercer and more demanding lwa (often Kongo-derived). Distinguished by faster tempos and specific drum preparation practices."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFamilyScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Haitian Vodou — Petwo"
        },
        {
          "@language": "fr",
          "@value": "Vodou Petwo"
        }
      ]
    },
    {
      "@id": "iroko:MusicianLineage",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A documented chain of transmission from master musician to apprentice, governing the right to play specific sacred instruments, lead specific rhythms, or perform specific songs. In Lucumí: Olubatá lineages with specific Añá initiations. In Candomblé: ogan lineages. Musician lineages are community knowledge in general form; specific transmission records are initiated-only."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Musician Lineage"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:toqueSequence",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-elder"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The full performance sequence: how this rhythm is introduced, developed, and resolved within a ceremony. Initiated-elder only: toque sequences are core esoteric knowledge of the musician lineage."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredRhythm"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "toque sequence"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
