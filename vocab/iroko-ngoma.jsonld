{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "iroko": "https://ontology.irokosociety.org/iroko#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "iroko:SacredRhythm",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A tradition-specific ritual drumming pattern with defined entity associations, ceremonial function, and authority requirements for performance. In Lucumí: a toque or canto. In Haitian Vodou: a tanbou rhythm for a specific lwa. In Candomblé: a xirê toque. Each rhythm is identified by its name, entity association, tradition, and lineage variant. Rhythm names are community-restricted; possession-trigger status and toque sequences are initiated-only."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sacred Rhythm"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:SacredInstrument",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A musical instrument used in Afro-Atlantic sacred contexts, which may be consecrated, named, or otherwise distinguished from secular instruments of the same type. Examples: a set of consecrated bàtá drums; Vodou rada drums (manman, seconde, bula); Candomblé rum/rumpi/lé. An instrument may have its own name, lineage, and history. The instrument type is public; consecration status and internal names are community-restricted."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sacred Instrument"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:func-processional",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The rhythm accompanies movement through ceremonial space or between spaces."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Processional"
      }
    },
    {
      "@id": "iroko:family-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Rhythm family not covered by existing concepts. Use skos:scopeNote to describe."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFamilyScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:songEntity",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The spiritual entity addressed or invoked by this song. Range: iroko:SpiritualEntity."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredSong"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "song entity"
      },
      "rdfs:range": {
        "@id": "iroko:SpiritualEntity"
      }
    },
    {
      "@id": "iroko:consecrationDate",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Date the instrument was consecrated or born. For Añá bàtá: the date of Aña reception."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredInstrument"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "consecration date"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "iroko:family-candomble-ketu",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Rhythms of the Ketu (Yorùbá-derived) nation in Candomblé, performed on the atabaque trio (rum, rumpi, lé). The xirê sequence calls each Orixá in a defined order."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFamilyScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Candomblé — Ketu (Yorùbá)"
        },
        {
          "@language": "pt",
          "@value": "Candomblé Ketu"
        }
      ]
    },
    {
      "@id": "iroko:song-praise",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Song that honors and praises an entity or ancestor without necessarily seeking presence. Oriki are the primary Yorùbá form."
      },
      "skos:inScheme": {
        "@id": "iroko:SongFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Praise / Oriki"
      }
    },
    {
      "@id": "iroko:func-salutation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The rhythm formally greets and honors an entity without necessarily seeking possession. Often the opening toque in a sequence."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Salutation / greeting"
      }
    },
    {
      "@id": "iroko:song-funerary",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Songs performed in Ituto, Egungun, or other funerary and ancestral contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:SongFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Funerary / ancestral"
      }
    },
    {
      "@id": "iroko:inst-rada-drum",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The three-drum Haitian Vodou Rada battery: manman (largest), seconde (middle), bula (smallest). Associated with cool, Fon-derived lwa."
      },
      "skos:inScheme": {
        "@id": "iroko:InstrumentTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Rada drum battery"
        },
        {
          "@language": "fr",
          "@value": "Tambou Rada"
        }
      ]
    },
    {
      "@id": "iroko:song-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Song function not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:SongFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-ngoma",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-22"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Domain module. Vocabulary for documenting sacred music across Afro-Atlantic traditions. Covers ritual rhythms and their entity associations, sacred songs and verse corpora, consecrated drum sets and their lineages, and musician authority transmission. Integrates with the Music Ontology (mo:) where applicable. Access control distinguishes public knowledge (rhythm names, entity associations) from restricted operational detail (toque sequences, song texts, drum preparation). Use with iroko-agency for consecrated instrument agency (Añá); iroko-authority for musician lineage authorization; iroko-narrative for song transmission chains and verse corpus provenance."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-agency"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-narrative"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Ngoma Module (Sacred Music, Rhythms, Songs, and Instruments)"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:authorityRequirement",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The initiation or authority title required to perform in this lineage. Range: iroko:AuthorityTitleScheme concept."
      },
      "rdfs:domain": {
        "@id": "iroko:MusicianLineage"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "authority requirement"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:songTranslation",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Translation of song text into a non-liturgical language. Initiated-only: translations reveal meaning even without the liturgical text."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredSong"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "song translation"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:rhythmName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The conventional name of the rhythm in the tradition's liturgical language. Language-tagged. Community-restricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredRhythm"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "rhythm name"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:houseAffiliation",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The religious house with which this instrument or drum set is affiliated. Range: iroko:House."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredInstrument"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "house affiliation"
      },
      "rdfs:range": {
        "@id": "iroko:House"
      }
    },
    {
      "@id": "iroko:family-candomble-angola",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Rhythms of the Angola (Bantu/Kongo-derived) nation in Candomblé. Maculelê, capoeira, and samba de roda exist in relationship with Angola ritual music."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFamilyScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Candomblé — Angola (Bantu)"
        },
        {
          "@language": "pt",
          "@value": "Candomblé Angola"
        }
      ]
    },
    {
      "@id": "iroko:SacredSong",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A song, chant, or liturgical vocal composition used in Afro-Atlantic ceremonial contexts. Includes oriki (Yorùbá praise poetry), canto de entrada (Lucumí invocation songs), chanson Vodou, and analogous forms. Songs may be classified by entity addressed, ceremony type, and liturgical language. Song text is among the most sensitive data in this module: song existence and entity association are community-restricted; text and melodic structure are initiated-only to elder-only."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Sacred Song"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:songTitle",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The title or opening phrase identifying this song. Language-tagged. Community-restricted."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredSong"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "song title"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:func-farewell",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The rhythm signals or facilitates the departure of a spiritual entity from the ceremonial space."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Farewell / departure"
      }
    },
    {
      "@id": "iroko:inst-other",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Sacred instrument type not covered by existing concepts."
      },
      "skos:inScheme": {
        "@id": "iroko:InstrumentTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other"
      }
    },
    {
      "@id": "iroko:family-lucumi-guiro",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Rhythms performed on non-consecrated shakers, cajón, or güiro in Lucumí contexts. Used in güiro ceremonies and some Espiritismo-adjacent practice. Less restricted than bàtá but still tradition-specific."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFamilyScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lucumí — Güiro / Cajón"
      }
    },
    {
      "@id": "iroko:inst-nkomo",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Drums used in Palo Monte ceremonies. The nkómo tradition derives from Bantu/Kongo drumming practice. Different preparation and restriction protocols than bàtá."
      },
      "skos:inScheme": {
        "@id": "iroko:InstrumentTypeScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Nkómo (Palo)"
        },
        {
          "@language": "es",
          "@value": "Nkómo"
        }
      ]
    },
    {
      "@id": "iroko:func-initiation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The rhythm is performed specifically during initiatory ceremonies and is restricted to those contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Initiation ceremony"
      }
    },
    {
      "@id": "iroko:family-yoruba-continental",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Sacred rhythms in continental Yorùbá practice, including dundun (talking drum), bàtá, and sakara traditions as practiced in Nigeria and Benin."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFamilyScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Yorùbá (continental)"
        },
        {
          "@language": "yo",
          "@value": "Yorùbá"
        }
      ]
    },
    {
      "@id": "iroko:lineageName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The name of this musician lineage or school. Community-restricted."
      },
      "rdfs:domain": {
        "@id": "iroko:MusicianLineage"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "lineage name"
      },
      "rdfs:range": {
        "@id": "rdf:langString"
      }
    },
    {
      "@id": "iroko:song-narrative",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Song that tells a story about an entity, an ancestor, or a sacred event."
      },
      "skos:inScheme": {
        "@id": "iroko:SongFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Narrative / Pataki"
      }
    },
    {
      "@id": "iroko:possessionTrigger",
      "@type": "owl:DatatypeProperty",
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-03-21"
      },
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Whether this rhythm or instrument is understood to trigger or invite spirit possession when performed correctly. Domain broadened in v1.3.0 to include iroko:SacredInstrument as well as iroko:SacredRhythm: a consecrated drum set (SacredDrumSet) or individual sacred instrument may trigger possession independently of which specific rhythm is being played, as the instrument itself carries the invocation capacity. Initiated-only: this knowledge is operationally significant and not appropriate for public documentation."
      },
      "rdfs:domain": {
        "@id": "_:nec86c6c8cd234268b22d735c9460222eb1"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "possession trigger"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "_:nec86c6c8cd234268b22d735c9460222eb1",
      "@type": "owl:Class",
      "owl:unionOf": {
        "@list": [
          {
            "@id": "iroko:SacredRhythm"
          },
          {
            "@id": "iroko:SacredInstrument"
          }
        ]
      }
    },
