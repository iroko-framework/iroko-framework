    {
      "@id": "iroko:family-lucumi-bata",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Rhythms performed on the consecrated Añá bàtá drum set in Lucumí/Ocha tradition. Requires Olubatá authority and Aña initiation to lead. Considered the highest-authority drumming tradition in Lucumí; specific toques are associated with specific Orisha and are operationally significant."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFamilyScheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Lucumí — Bàtá (Añá)"
        },
        {
          "@language": "es",
          "@value": "Bàtá de Aña"
        }
      ]
    },
    {
      "@id": "iroko:func-possession-induction",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "The rhythm is specifically associated with inducing or deepening spirit possession in a prepared recipient. Initiated-only detail."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Possession induction"
      }
    },
    {
