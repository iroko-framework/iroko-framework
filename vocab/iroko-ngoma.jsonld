      "skos:definition": {
        "@language": "en",
        "@value": "The rhythm is performed in funerary, Egungun, or ancestral veneration contexts."
      },
      "skos:inScheme": {
        "@id": "iroko:RhythmFunctionScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
