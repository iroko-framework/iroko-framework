    {
      "@id": "iroko:songText",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-elder"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The full text of the song as transmitted in the lineage. Initiated-elder only: sacred song texts are among the most sensitive items in this corpus, equivalent to verse corpora in the Marca module."
      },
      "rdfs:domain": {
        "@id": "iroko:SacredSong"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-ngoma"
