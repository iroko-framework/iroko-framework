  },
  "@graph": [
    {
      "@id": "iroko:ProcessTypeScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Classification of ritual process types across Afro-Atlantic traditions."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Process Type Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:processType-ancestor-veneration"
        },
        {
          "@id": "iroko:processType-cleansing"
        },
        {
          "@id": "iroko:processType-community-working"
        },
        {
          "@id": "iroko:processType-divination"
        },
        {
          "@id": "iroko:processType-elevation"
        },
        {
          "@id": "iroko:processType-feast-celebration"
        },
        {
          "@id": "iroko:processType-funerary"
        },
        {
          "@id": "iroko:processType-head-feeding"
        },
        {
          "@id": "iroko:processType-healing"
        },
        {
          "@id": "iroko:processType-initiation-full"
        },
        {
          "@id": "iroko:processType-initiation-reception"
        },
        {
          "@id": "iroko:processType-possession-ceremony"
        },
        {
          "@id": "iroko:processType-protection"
        },
        {
          "@id": "iroko:processType-sacrifice-offering"
        }
      ]
    },
    {
      "@id": "iroko:lineageVariations",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Documented variations in how different lineages or houses conduct this process. Access: initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "lineage variations"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:prerequisiteProcess",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A RitualProcess that must be completed before this one. Example: receiving Warriors before kariocha. Links to iroko:RitualProcess instances. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "prerequisite process"
      },
      "rdfs:range": {
        "@id": "iroko:RitualProcess"
      }
    },
    {
      "@id": "iroko:role-lead-officiant",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Houngan"
        },
        {
          "@language": "en",
          "@value": "Mambo"
        },
        {
          "@language": "en",
          "@value": "Oriaté"
        },
        {
          "@language": "en",
          "@value": "Tata"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The principal authority leading the ceremony. Title varies by tradition."
      },
      "skos:inScheme": {
        "@id": "iroko:ParticipantRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lead Officiant"
      }
    },
    {
      "@id": "iroko:role-godparent",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Madrina"
        },
        {
          "@language": "en",
          "@value": "Marraine"
        },
        {
          "@language": "en",
          "@value": "Padrino"
        },
        {
          "@language": "en",
          "@value": "Parrain"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The initiated sponsor responsible for the initiant's spiritual formation and ceremonial participation."
      },
      "skos:inScheme": {
        "@id": "iroko:ParticipantRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Godparent/Sponsor"
      }
    },
    {
      "@id": "iroko:requiredAuthority",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The level of initiation or authority required to lead this process. Values from AuthorityLevelScheme. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "required authority"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:role-co-officiant",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "A supporting officiant with authority to perform portions of the ceremony."
      },
      "skos:inScheme": {
        "@id": "iroko:ParticipantRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Co-Officiant"
      }
    },
    {
      "@id": "iroko:processType-funerary",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Axexe"
        },
        {
          "@language": "en",
          "@value": "Ituto"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Death and funeral ceremonies specific to initiated practitioners. Includes ituto (Lucumi), axexe (Candomble), and rites handling spiritual obligations of deceased initiates."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Funerary"
      }
    },
    {
      "@id": "iroko:TimingRequirementScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Whether a ritual process has specific timing requirements."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Timing Requirement Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:timing-annual-cycle"
        },
        {
          "@id": "iroko:timing-any-time"
        },
        {
          "@id": "iroko:timing-calendar-feast"
        },
        {
          "@id": "iroko:timing-divination-prescribed"
        },
        {
          "@id": "iroko:timing-emergency"
        },
        {
          "@id": "iroko:timing-life-event"
        },
        {
          "@id": "iroko:timing-lunar-phase"
        }
      ]
    },
    {
      "@id": "iroko:sequenceStep",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A numbered step label within the ceremonial sequence. The label is visible; operational content is governed separately. Access: initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:CeremonialSequence"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sequence step"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:materialRequirements",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Detailed list of materials, implements, and quantities required. Access: initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "material requirements"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:authority-olorisha",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Head-initiated"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Requires full head initiation: kariocha in Lucumi, kanzo in Vodou, feitura in Candomble, or equivalent in other traditions."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Olorisha / Equivalent"
      }
    },
    {
      "@id": "iroko:initiationLevel-reception",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "General category for receiving sacred objects or marks without full head initiation. The entry level of formal initiation in most traditions."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiationLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Reception Level"
      }
    },
    {
      "@id": "iroko:processName",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The name of this ritual process in its tradition. Example: Rogacion de Cabeza, Kariocha, Kanzo, Tambor de Fundamento. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "process name"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:processType-initiation-full",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Head Initiation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Full head initiation permanently transforming the initiant's spiritual status. Examples: kariocha (Lucumi), kanzo (Vodou), rayamiento (Palo), feitura (Candomble). The most restricted process type."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Initiation - Full"
      }
    },
    {
      "@id": "iroko:participantRole",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Roles that participants may hold in this process. Values from ParticipantRoleScheme. Multiple values allowed. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "participant role"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:initiationLevel-necklaces",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Collares"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Reception of consecrated beaded necklaces in Lucumi tradition. First formal step. Confers relationship with specific orisa represented."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiationLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Necklaces/Elekes"
      }
    },
    {
      "@id": "iroko:processType",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Classification of this ritual process. Values from ProcessTypeScheme. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "process type"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:processType-ancestor-veneration",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Egun ceremony"
        },
        {
          "@language": "en",
          "@value": "Misa Espiritual"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Ceremonies specifically directed to the ancestral dead. Includes misa espiritual (Espiritismo), egungún masquerade, boveda work, and ituto (funeral rites for initiates)."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ancestor Veneration"
      }
    },
    {
      "@id": "iroko:operationalNotes",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-community-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Contextual notes about how this process is conducted in practice. Not a step-by-step sequence; general practitioner guidance. Access: community-only."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "operational notes"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:timing-any-time",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "No specific timing requirement; may be performed as needed."
      },
      "skos:inScheme": {
        "@id": "iroko:TimingRequirementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Any Time"
      }
    },
    {
      "@id": "iroko:sponsorRequirement",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Whether a godparent or existing initiate must sponsor this initiation. General requirement is public. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:InitiatoryRite"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sponsor requirement"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:processType-divination",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Ritual consultation for guidance. Includes Ifa consultation, dilogun reading, chamalongos in Palo, and card reading in Espiritismo context. Public category; specific methods and interpretations are access-restricted."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Divination"
      }
    },
    {
      "@id": "iroko:timing-emergency",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Performed in response to urgent spiritual or physical crisis without time constraint."
      },
      "skos:inScheme": {
        "@id": "iroko:TimingRequirementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Emergency/As Needed"
      }
    },
    {
      "@id": "iroko:initiationLevel-warriors",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Los Guerreros"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Reception of Eleggua, Ogun, Ochosi, and Osun in Lucumi tradition. Protects the initiant and opens roads. Prerequisite for kariocha."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiationLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Warriors"
      }
    },
    {
      "@id": "iroko:initiationLevel-ifa",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Babalawo initiation"
        },
        {
          "@language": "en",
          "@value": "Mano de Orula"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Initiation into the Ifa priesthood. Mano de Orula (hand of Orula) is a preliminary in Lucumi; full Babalawo initiation is the complete level."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiationLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ifa Initiation"
      }
    },
    {
      "@id": "iroko:role-initiant",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Initiate"
        },
        {
          "@language": "en",
          "@value": "Iyawo"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "The person receiving initiation or the primary recipient of the ceremony."
      },
      "skos:inScheme": {
        "@id": "iroko:ParticipantRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Initiant"
      }
    },
    {
      "@id": "iroko:timing-life-event",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Triggered by a specific life event: birth, death, marriage, illness, major transition."
      },
      "skos:inScheme": {
        "@id": "iroko:TimingRequirementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Life Event"
      }
    },
    {
      "@id": "iroko:processType-sacrifice-offering",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Ebbo"
        },
        {
          "@language": "en",
          "@value": "Matanza"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Ceremonies involving animal sacrifice or major offerings to spiritual entities. General category is public; specific animals, quantities, and procedures are initiated-only or initiated-elder."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Sacrifice/Major Offering"
      }
    },
    {
      "@id": "iroko:processType-possession-ceremony",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Bembe"
        },
        {
          "@language": "en",
          "@value": "Fet"
        },
        {
          "@language": "en",
          "@value": "Tambor"
        },
        {
          "@language": "en",
          "@value": "Wemilere"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Ceremony in which spirits may manifest through initiated practitioners. Includes tambor, bembe, wemilere (Lucumi), Vodou fet, Candomble xire. Drumming, singing, and dance are central."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Possession Ceremony"
      }
    },
    {
      "@id": "iroko:plantUse",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Plants used in this ritual process. Links to ewe:Plant instances. General association is public; specific quantities and combinations are initiated-only. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "plant use"
      },
      "rdfs:range": {
        "@id": "iroko:Plant"
      }
    },
    {
      "@id": "iroko:RitualProcess",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Base class for any structured ceremonial activity in an Afro-Atlantic tradition. Subclassed into Ceremony (recurring practice) and InitiatoryRite (threshold event). General process type, presiding entity, and tradition are public; operational sequences and instructions are restricted."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Ritual Process"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:SacredEntity"
      }
    },
    {
      "@id": "iroko:AuthorityLevelScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Level of initiation or authority required to lead or perform a ritual process."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Authority Level Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:authority-any-practitioner"
        },
        {
          "@id": "iroko:authority-babalawo"
        },
        {
          "@id": "iroko:authority-elder-designation"
        },
        {
          "@id": "iroko:authority-initiated"
        },
        {
          "@id": "iroko:authority-olorisha"
        },
        {
          "@id": "iroko:authority-tradition-specific"
        }
      ]
    },
    {
      "@id": "iroko:processType-protection",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Ceremonial processes establishing or strengthening spiritual protection for a person, household, or space."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Protection"
      }
    },
    {
      "@id": "https://ontology.irokosociety.org/iroko-travay",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-02-18"
      },
      "dcterms:creator": "Iroko Historical Society",
      "dcterms:description": {
        "@language": "en",
        "@value": "Domain module. Vocabulary for documenting ritual processes in Afro-Atlantic traditions. Covers ceremonies, initiatory rites, and ceremonial sequences. Distinguishes ongoing ceremonial practice from threshold initiation events. Access control is at the property level — existence and general nature of ceremonies is public; operational sequences and details are restricted. Use with iroko-authority to document who may perform or authorize a ceremony; iroko-epistemic to model disclosure constraints on operational sequences; iroko-nkisi for the spiritual entities invoked."
      },
      "dcterms:isPartOf": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/publicdomain/zero/1.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-02-25"
      },
      "dcterms:references": [
        {
          "@id": "https://ontology.irokosociety.org/iroko-authority"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-epistemic"
        },
        {
          "@id": "https://ontology.irokosociety.org/iroko-nkisi"
        }
      ],
      "dcterms:title": {
        "@language": "en",
        "@value": "Iroko Framework: Travay Module (Ritual Processes)"
      },
      "owl:imports": {
        "@id": "https://ontology.irokosociety.org/iroko-core"
      },
      "owl:versionIRI": {
        "@id": "https://ontology.irokosociety.org/iroko-travay/1.3.0"
      },
      "owl:versionInfo": "1.3.0",
      "rdfs:seeAlso": {
        "@id": "https://ontology.irokosociety.org/iroko-framework/"
      }
    },
    {
      "@id": "iroko:presidingEntity",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The spiritual entity (orisa, lwa, etc.) for whom or by whose authority this ceremony is performed. Links to iroko:SpiritualEntity. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "presiding entity"
      },
      "rdfs:range": {
        "@id": "iroko:SpiritualEntity"
      }
    },
    {
      "@id": "iroko:InitiationLevelScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Levels of initiation conferred by initiatory rites. General structure is cross-traditional; specific levels are tradition-dependent."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Initiation Level Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:initiationLevel-head-initiation"
        },
        {
          "@id": "iroko:initiationLevel-ifa"
        },
        {
          "@id": "iroko:initiationLevel-necklaces"
        },
        {
          "@id": "iroko:initiationLevel-reception"
        },
        {
          "@id": "iroko:initiationLevel-tradition-specific"
        },
        {
          "@id": "iroko:initiationLevel-warriors"
        }
      ]
    },
    {
      "@id": "iroko:timingRequirement",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Whether this process has specific timing requirements. Values from TimingRequirementScheme. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "timing requirement"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:InitiatoryRite",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A threshold ceremony that permanently changes the initiant's spiritual status. Examples: kariocha (making Ocha), mano de Orula, abo faca, pinaldo, rayamiento (Palo), kanzo (Vodou), feitura (Candomble). Initiatory rites are non-repeatable transformations. Operational details are initiated-elder access."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Initiatory Rite"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:RitualProcess"
      }
    },
    {
      "@id": "iroko:initiationLevel-tradition-specific",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Initiation levels that do not map to general categories. Document with tradition context via iroko:tradition and iroko:operationalNotes."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiationLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Tradition-Specific Level"
      }
    },
    {
      "@id": "iroko:authority-elder-designation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Requires recognition as an elder or authority holder within the tradition, beyond basic initiation. Community recognition is required in addition to initiation level."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Elder Designation"
      }
    },
    {
      "@id": "iroko:processType-initiation-reception",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Receiving"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Reception of sacred objects conferring a level of initiation without full head initiation. Examples: receiving Warriors, receiving Olokun, receiving necklaces. Creates formal relationship with specific entities."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Initiation - Reception"
      }
    },
    {
      "@id": "iroko:ParticipantRoleScheme",
      "@type": "skos:ConceptScheme",
      "dcterms:description": {
        "@language": "en",
        "@value": "Roles that participants may hold within a ritual process."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Participant Role Classification"
      },
      "skos:hasTopConcept": [
        {
          "@id": "iroko:role-co-officiant"
        },
        {
          "@id": "iroko:role-community-member"
        },
        {
          "@id": "iroko:role-godparent"
        },
        {
          "@id": "iroko:role-helper"
        },
        {
          "@id": "iroko:role-initiant"
        },
        {
          "@id": "iroko:role-lead-officiant"
        },
        {
          "@id": "iroko:role-medium"
        },
        {
          "@id": "iroko:role-musician"
        }
      ]
    },
    {
      "@id": "iroko:purposeDescription",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "General description of the purpose and outcome of this ritual process. Non-operational. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "purpose description"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:sequenceStepOperational",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-no-access"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Exact operational instructions for this step. OPERATIONAL ONLY - never exported to RDF. Access: no-access."
      },
      "rdfs:domain": {
        "@id": "iroko:CeremonialSequence"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sequence step (operational)"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:timing-calendar-feast",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Associated with a specific calendar date or feast day of the presiding entity."
      },
      "skos:inScheme": {
        "@id": "iroko:TimingRequirementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Calendar/Feast Day"
      }
    },
    {
      "@id": "iroko:authority-babalawo",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Requires Ifa initiation specifically. Certain ceremonies and all Ifa-based divination require Babalawo authority."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Babalawo / Ifa Priest"
      }
    },
    {
      "@id": "iroko:processType-community-working",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Collective ceremonial work on behalf of a house, lineage, or community rather than an individual. Includes cabildo ceremonies, community ebbos, and house-level divination."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community Working"
      }
    },
    {
      "@id": "iroko:processType-cleansing",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Despojo"
        },
        {
          "@language": "en",
          "@value": "Limpieza"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Ritual cleansing of a person, object, or space. Removes negative energies, spiritual impurities, or adversarial influences. Includes despojos, limpiezas, spiritual baths, and space cleansings."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Cleansing/Purification"
      }
    },
    {
      "@id": "iroko:sequenceOrder",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Integer indicating the position of this step within the full sequence. Access: initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:CeremonialSequence"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sequence order"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "iroko:role-community-member",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "General attendee, potentially uninitiated, present for community portions of the ceremony."
      },
      "skos:inScheme": {
        "@id": "iroko:ParticipantRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community Member"
      }
    },
    {
      "@id": "iroko:conferredTitle",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Title or designation conferred upon completion of this initiatory rite. Example: Olorisha, Babalawo, Mambo, Houngan, Tata Nkisi. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:InitiatoryRite"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "conferred title"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:role-medium",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Chwal"
        },
        {
          "@language": "en",
          "@value": "Horse"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Practitioner who may receive spiritual possession during the ceremony. In Espiritismo context, medium for spirit communication."
      },
      "skos:inScheme": {
        "@id": "iroko:ParticipantRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Medium"
      }
    },
    {
      "@id": "iroko:timing-annual-cycle",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Performed on an annual cycle, such as anniversary of initiation."
      },
      "skos:inScheme": {
        "@id": "iroko:TimingRequirementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Annual Cycle"
      }
    },
    {
      "@id": "iroko:initiationLevel",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "The level of initiation conferred by this InitiatoryRite. Values from InitiationLevelScheme. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:InitiatoryRite"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "initiation level"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "iroko:sequenceStepDescription",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "General description of what occurs at this step, without operational specifics. Access: initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:CeremonialSequence"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sequence step description"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:authority-initiated",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Requires initiation but not a specific level or title. General initiation into the tradition is sufficient."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Initiated Practitioner"
      }
    },
    {
      "@id": "iroko:processType-elevation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Ceremony to elevate the spirit of a deceased person or clear unresolved spiritual burdens. Common in Espiritismo and Lucumi death rites."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Elevation/Levantamiento"
      }
    },
    {
      "@id": "iroko:typicalDuration",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-public-unrestricted"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "General duration of this process. Example: one day, three days, seven days, one year and seven days. Access: public-unrestricted."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "typical duration"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:authority-any-practitioner",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Can be performed by any person regardless of initiation status. Example: basic ancestor veneration at boveda, spiritual baths using common herbs."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Any Practitioner"
      }
    },
    {
      "@id": "iroko:timing-divination-prescribed",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Timing determined through divination consultation. The appropriate time is revealed rather than predetermined."
      },
      "skos:inScheme": {
        "@id": "iroko:TimingRequirementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Divination-Prescribed"
      }
    },
    {
      "@id": "iroko:sequence",
      "@type": "owl:ObjectProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-initiated-only"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a RitualProcess to its CeremonialSequence. Access: initiated-only."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sequence"
      },
      "rdfs:range": {
        "@id": "iroko:CeremonialSequence"
      }
    },
    {
      "@id": "iroko:initiationLevel-head-initiation",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Feitura"
        },
        {
          "@language": "en",
          "@value": "Kanzo"
        },
        {
          "@language": "en",
          "@value": "Kariocha"
        },
        {
          "@language": "en",
          "@value": "Rayamiento"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Full head initiation permanently establishing the initiant as a priest or priestess. Specific name varies by tradition."
      },
      "skos:inScheme": {
        "@id": "iroko:InitiationLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Head Initiation"
      }
    },
    {
      "@id": "iroko:processType-head-feeding",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Rogacion de Cabeza"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Ritual feeding and cooling of the head (Ori) with white foods and prayers. Strengthens personal destiny and calms spiritual disturbances. One of the most fundamental ceremonies across Yoruba-derived traditions."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Head Feeding/Rogation"
      }
    },
    {
      "@id": "iroko:authority-tradition-specific",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Authority requirements are tradition-specific and cannot be generalized. Document via iroko:operationalNotes with tradition context."
      },
      "skos:inScheme": {
        "@id": "iroko:AuthorityLevelScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Tradition-Specific Authority"
      }
    },
    {
      "@id": "iroko:secretComponents",
      "@type": "owl:DatatypeProperty",
      "iroko:minimumAccessLevel": {
        "@id": "iroko:access-no-access"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Components of this process restricted to initiated elders. OPERATIONAL ONLY - never exported to RDF. Access: no-access."
      },
      "rdfs:domain": {
        "@id": "iroko:RitualProcess"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "secret components"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "iroko:role-musician",
      "@type": "skos:Concept",
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Akpwon"
        },
        {
          "@language": "en",
          "@value": "Tambolero"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Drummer, singer, or musician providing ceremonial music. May have specific initiation requirements depending on tradition and ceremony type."
      },
      "skos:inScheme": {
        "@id": "iroko:ParticipantRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Musician/Drummer"
      }
    },
    {
      "@id": "iroko:role-helper",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Initiated helper assisting with logistical or supporting ceremonial tasks."
      },
      "skos:inScheme": {
        "@id": "iroko:ParticipantRoleScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Helper/Aide"
      }
    },
    {
      "@id": "iroko:processType-healing",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Ceremonial processes directed toward physical, spiritual, or psychological healing. May combine plant use, prayer, divination, and direct spiritual intervention."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Healing"
      }
    },
    {
      "@id": "iroko:CeremonialSequence",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An ordered set of steps within a RitualProcess. The existence of a sequence and its general structure are documented. Access control is at the property level: sequence step labels are initiated-only; operational content within each step is no-access."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Ceremonial Sequence"
      }
    },
    {
      "@id": "iroko:timing-lunar-phase",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Must be performed during a specific phase of the moon."
      },
      "skos:inScheme": {
        "@id": "iroko:TimingRequirementScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Lunar Phase"
      }
    },
    {
      "@id": "iroko:Ceremony",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A recurring ritual event that can be performed multiple times for one or many participants. Examples: bembe, tambor, wemilere, misa espiritual, rogacion de cabeza, ebbo, despojos, velacion. Ceremonies are ongoing practice rather than threshold events."
      },
      "rdfs:isDefinedBy": {
        "@id": "https://ontology.irokosociety.org/iroko-travay"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Ceremony"
      },
      "rdfs:subClassOf": {
        "@id": "iroko:RitualProcess"
      }
    },
    {
      "@id": "iroko:processType-feast-celebration",
      "@type": "skos:Concept",
      "skos:altLabel": {
        "@language": "en",
        "@value": "Cumpleanos de Santo"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Celebration ceremonies: anniversary of initiation, feast days of entities, communal celebrations."
      },
      "skos:inScheme": {
        "@id": "iroko:ProcessTypeScheme"
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Feast/Celebration"
      }
    }
  ]
}