<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:iroko="https://ontology.irokosociety.org/iroko#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityType-cabildo">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityType"/>
    <skos:definition xml:lang="en">Authority vested in a cabildo or mutual aid association with ritual governance functions.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTypeScheme"/>
    <skos:prefLabel xml:lang="en">Cabildo Authority</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#hasJurisdiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has jurisdiction</rdfs:label>
    <rdfs:comment xml:lang="en">Links an authority to the domain(s) where it is recognized.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Authority"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#Jurisdiction"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Authority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Authority</rdfs:label>
    <rdfs:comment xml:lang="en">A jurisdictional authority capable of authorizing assertion-level claims and governance decisions. May represent a lineage, cabildo, religious house, elder council, or recognized individual in a governance role. Extends the iroko:RitualAuthority stub in Core. For the individual's held credential (title, office), see ile:ReligiousOffice.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:subClassOf rdf:resource="https://ontology.irokosociety.org/iroko#RitualAuthority"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#RitualRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ritual Role</rdfs:label>
    <rdfs:comment xml:lang="en">The functional role an authority occupies within a ritual governance system — elder, priest, archivist-steward, witness, etc. Distinct from ile:ReligiousOffice (specific held title) — RitualRole is a classification concept.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#AuthorityBasisScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Authority Bases</rdfs:label>
    <dcterms:description xml:lang="en">What a ritual authority rests on — the social and epistemic foundation for recognition.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#basis-appointment"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#basis-community-recognition"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#basis-consecration"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#basis-contested"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#basis-divinatory-selection"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#basis-hereditary"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#basis-succession"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#culturalFrame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">cultural frame</rdfs:label>
    <rdfs:comment xml:lang="en">Short label for the tradition frame within which this authority operates. Example: Lucumi, Palo, Espiritismo, Vodou, Candomble. Use iroko:tradition for linked-data-typed values.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Authority"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityType-lineage">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityType"/>
    <skos:definition xml:lang="en">Authority vested in a descent line or transmission chain.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTypeScheme"/>
    <skos:prefLabel xml:lang="en">Lineage Authority</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityBasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">authority basis</rdfs:label>
    <rdfs:comment xml:lang="en">What the authority rests on — the epistemic or social foundation for its recognition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Authority"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasis"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#basis-contested">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasis"/>
    <skos:definition xml:lang="en">The basis of the authority is itself disputed across lineages or houses.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasisScheme"/>
    <skos:prefLabel xml:lang="en">Contested Basis</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#basis-succession">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasis"/>
    <skos:definition xml:lang="en">Authority derives from recognized succession in a transmission line.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasisScheme"/>
    <skos:prefLabel xml:lang="en">Lineage Succession</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-diviner">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#RitualRole"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RitualRoleScheme"/>
    <skos:prefLabel xml:lang="en">Diviner</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-priest">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#RitualRole"/>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RitualRoleScheme"/>
    <skos:prefLabel xml:lang="en">Priest</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#RitualRoleScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Ritual Roles</rdfs:label>
    <dcterms:description xml:lang="en">Functional roles within ritual governance systems.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#role-archivist-steward"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#role-community-delegate"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#role-diviner"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#role-priest"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityType-house">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityType"/>
    <skos:definition xml:lang="en">Authority vested in a religious house (ile, sosyete, cabildo house, etc.).</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTypeScheme"/>
    <skos:prefLabel xml:lang="en">House Authority</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#jurisdictionLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">jurisdiction label</rdfs:label>
    <rdfs:comment xml:lang="en">Human-readable name for this jurisdiction.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Jurisdiction"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-archivist-steward">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#RitualRole"/>
    <skos:definition xml:lang="en">Recognized steward of archival materials within a tradition or house.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RitualRoleScheme"/>
    <skos:prefLabel xml:lang="en">Archivist-Steward</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#basis-hereditary">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasis"/>
    <skos:definition xml:lang="en">Authority derives from family lineage independent of formal consecration or appointment.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasisScheme"/>
    <skos:prefLabel xml:lang="en">Hereditary</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko-authority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:creator>Iroko Historical Society</dcterms:creator>
    <dcterms:description xml:lang="en">Governance Layer module. Full governance model for ritual authority, jurisdiction, and authorization basis. Extends the iroko:RitualAuthority stub in Core with jurisdiction modeling, authority type and basis classification, ritual roles, recognition networks, and temporal validity. Used to authorize assertion-level claims across all modules. Commonly paired with iroko-epistemic for constraint-aware archives.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-23</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-25</dcterms:modified>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-agency"/>
    <dcterms:references rdf:resource="https://ontology.irokosociety.org/iroko-epistemic"/>
    <dcterms:requires rdf:resource="https://ontology.irokosociety.org/iroko-core"/>
    <dcterms:title xml:lang="en">Iroko Framework: Authority Module</dcterms:title>
    <rdfs:seeAlso rdf:resource="https://ontology.irokosociety.org/iroko-framework/"/>
    <owl:versionIRI rdf:resource="https://ontology.irokosociety.org/iroko-authority/1.3.0"/>
    <owl:versionInfo>1.3.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#basis-community-recognition">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasis"/>
    <skos:definition xml:lang="en">Authority derives from informal but sustained community acknowledgment.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasisScheme"/>
    <skos:prefLabel xml:lang="en">Community Recognition</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#Jurisdiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jurisdiction</rdfs:label>
    <rdfs:comment xml:lang="en">A place, house, cabildo, lineage territory, nation, or other bounded domain in which an authority is recognized. May be geographic, genealogical, or institutional.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityType-individual-elder">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityType"/>
    <skos:definition xml:lang="en">Authority vested in a recognized individual elder acting in their own governance capacity.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTypeScheme"/>
    <skos:prefLabel xml:lang="en">Individual Elder Authority</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#ritualRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">ritual role</rdfs:label>
    <rdfs:comment xml:lang="en">The functional governance role this authority occupies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Authority"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#RitualRole"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#jurisdiction-matanzas">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#Jurisdiction"/>
    <iroko:jurisdictionLabel xml:lang="en">Matanzas</iroko:jurisdictionLabel>
    <iroko:jurisdictionType>geographic</iroko:jurisdictionType>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#validUntil">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">valid until</rdfs:label>
    <rdfs:comment xml:lang="en">Date until which the authority's governance standing is recognized. Absence of this property does not imply perpetual validity — use iroko:contestedStatus where appropriate.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Authority"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#jurisdiction-salvador-bahia">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#Jurisdiction"/>
    <iroko:jurisdictionLabel xml:lang="en">Salvador, Bahia</iroko:jurisdictionLabel>
    <iroko:jurisdictionLabel xml:lang="pt">Salvador, Bahia</iroko:jurisdictionLabel>
    <iroko:jurisdictionType>geographic</iroko:jurisdictionType>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#jurisdiction-cap-haitien">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#Jurisdiction"/>
    <iroko:jurisdictionLabel xml:lang="en">Cap-Haitien</iroko:jurisdictionLabel>
    <iroko:jurisdictionLabel xml:lang="fr">Cap-Haïtien</iroko:jurisdictionLabel>
    <iroko:jurisdictionType>geographic</iroko:jurisdictionType>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#recognizedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">recognized by</rdfs:label>
    <rdfs:comment xml:lang="en">Links one authority to a recognizing body, council, or adjacent authority. Used for documenting recognition networks and cross-lineage acknowledgments.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Authority"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#Authority"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#jurisdiction-havana">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#Jurisdiction"/>
    <iroko:jurisdictionLabel xml:lang="en">Havana</iroko:jurisdictionLabel>
    <iroko:jurisdictionLabel xml:lang="es">La Habana</iroko:jurisdictionLabel>
    <iroko:jurisdictionType>geographic</iroko:jurisdictionType>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#basis-appointment">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasis"/>
    <skos:definition xml:lang="en">Authority derives from formal appointment by a recognized governing body.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasisScheme"/>
    <skos:prefLabel xml:lang="en">Appointment</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#AuthorityBasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Authority Basis</rdfs:label>
    <rdfs:comment xml:lang="en">What the authority rests on: lineage succession, consecration, appointment, community recognition, divinatory selection, or other basis.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#jurisdictionType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">jurisdiction type</rdfs:label>
    <rdfs:comment xml:lang="en">Short classifer for the jurisdiction type: 'geographic', 'genealogical', 'institutional', 'diasporic', etc.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Jurisdiction"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#AuthorityTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Authority Types</rdfs:label>
    <dcterms:description xml:lang="en">Structural classification of ritual authority entities.</dcterms:description>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#authorityType-cabildo"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#authorityType-council"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#authorityType-divinatory-office"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#authorityType-house"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#authorityType-individual-elder"/>
    <skos:hasTopConcept rdf:resource="https://ontology.irokosociety.org/iroko#authorityType-lineage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#AuthorityType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Authority Type</rdfs:label>
    <rdfs:comment xml:lang="en">Classifies the structural form of an authority — lineage, house, cabildo, council, individual elder, etc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#validFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">valid from</rdfs:label>
    <rdfs:comment xml:lang="en">Date from which the authority's governance standing is recognized or effective.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Authority"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">authority type</rdfs:label>
    <rdfs:comment xml:lang="en">Classifies an Authority instance by its structural form.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Authority"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityType"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-public-unrestricted"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#basis-consecration">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasis"/>
    <skos:definition xml:lang="en">Authority derives from a ritual consecration event.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasisScheme"/>
    <skos:prefLabel xml:lang="en">Consecration</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">authority note</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text note on the nature, history, or contested aspects of this authority's standing.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.irokosociety.org/iroko#Authority"/>
    <rdfs:isDefinedBy rdf:resource="https://ontology.irokosociety.org/iroko-authority"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <iroko:minimumAccessLevel rdf:resource="https://ontology.irokosociety.org/iroko#access-community-only"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#basis-divinatory-selection">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasis"/>
    <skos:definition xml:lang="en">Authority derives from selection through divination (Ifa, oracle, sortition, etc.).</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityBasisScheme"/>
    <skos:prefLabel xml:lang="en">Divinatory Selection</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#role-community-delegate">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#RitualRole"/>
    <skos:definition xml:lang="en">Person acting in an authorized representative capacity on behalf of a house or community.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#RitualRoleScheme"/>
    <skos:prefLabel xml:lang="en">Community Delegate</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#jurisdiction-port-au-prince">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#Jurisdiction"/>
    <iroko:jurisdictionLabel xml:lang="fr">Port-au-Prince</iroko:jurisdictionLabel>
    <iroko:jurisdictionType>geographic</iroko:jurisdictionType>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityType-council">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityType"/>
    <skos:definition xml:lang="en">Authority vested in a collective governing council of elders or priests.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTypeScheme"/>
    <skos:prefLabel xml:lang="en">Council Authority</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.irokosociety.org/iroko#authorityType-divinatory-office">
    <rdf:type rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityType"/>
    <skos:definition xml:lang="en">Authority vested in a specific divinatory office — Babalawo, Oluwo, Houngan Asogwe, etc. — rather than the individual holder.</skos:definition>
    <skos:inScheme rdf:resource="https://ontology.irokosociety.org/iroko#AuthorityTypeScheme"/>
    <skos:prefLabel xml:lang="en">Divinatory Office</skos:prefLabel>
  </rdf:Description>
</rdf:RDF>
