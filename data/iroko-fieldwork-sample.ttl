@prefix iroko:   <https://iroko-framework.org/ontology/iroko#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

########
# Places
########

iroko:Havana a iroko:Place ;
  skos:prefLabel "Havana"@en ;
  skos:altLabel "La Habana"@es .

iroko:CapHaitien a iroko:Place ;
  skos:prefLabel "Cap-Haïtien"@en ;
  skos:altLabel "Kap Ayisyen"@ht ;
  skos:altLabel "Cap-Haïtien"@fr .

########
# People
########

iroko:DeleFagbemiO a iroko:Researcher ;
  skos:prefLabel "Délé Fágbèmí O."@en .

iroko:ParticipantA a iroko:Participant ;
  skos:prefLabel "Participant A"@en .

iroko:ParticipantB a iroko:Participant ;
  skos:prefLabel "Participant B"@en .

########
# Authorities
########

iroko:Authority_Havana_LineageX a iroko:Authority ;
  skos:prefLabel "Havana Lineage Authority X"@en .

iroko:Authority_CapHaitien_HouseY a iroko:Authority ;
  skos:prefLabel "Cap-Haïtien House Authority Y"@en .

########
# Fieldwork events (PROV activity subclass)
########

iroko:FW_HAV_2026_02_10 a iroko:FieldworkEvent ;
  dcterms:title "Fieldwork session in Havana"@en ;
  prov:startedAtTime "2026-02-10T10:00:00"^^xsd:dateTime ;
  prov:endedAtTime   "2026-02-10T12:00:00"^^xsd:dateTime ;
  prov:wasAssociatedWith iroko:DeleFagbemiO ;
  prov:atLocation iroko:Havana .

iroko:FW_CAP_2026_02_12 a iroko:FieldworkEvent ;
  dcterms:title "Fieldwork session in Cap-Haïtien"@en ;
  prov:startedAtTime "2026-02-12T15:00:00"^^xsd:dateTime ;
  prov:endedAtTime   "2026-02-12T17:00:00"^^xsd:dateTime ;
  prov:wasAssociatedWith iroko:DeleFagbemiO ;
  prov:atLocation iroko:CapHaitien .

########
# Example domain entity (Plant)
########

iroko:Plant0001 a iroko:Plant ;
  dcterms:identifier "Plant0001" ;
  skos:prefLabel "Example Plant"@en .

########
# Narrative with variants
########

iroko:Narrative_CeibaListening a iroko:Narrative ;
  dcterms:title "Listening to the bark"@en ;
  iroko:hasNarrativeVariant iroko:Narrative_CeibaListening_V1 ;
  iroko:hasNarrativeVariant iroko:Narrative_CeibaListening_V2 .

iroko:Narrative_CeibaListening_V1 a iroko:NarrativeVariant ;
  iroko:narratedBy iroko:ParticipantA ;
  iroko:narrativeLanguage "es" ;
  iroko:narrativeText "Variant A phrasing of the story as told in Havana."@en .

iroko:Narrative_CeibaListening_V2 a iroko:NarrativeVariant ;
  iroko:narratedBy iroko:ParticipantB ;
  iroko:narrativeLanguage "fr" ;
  iroko:narrativeText "Variant B phrasing of the story as told in Cap-Haïtien."@en .

########
# Assertion-level knowledge with tiered access and ritual authority
#
# Example: Two contested relationship claims or use-claims can co-exist.
########

# Claim 1: Plant0001 has some use (kept lineage-bound)
iroko:Assertion_0001 a iroko:Assertion ;
  iroko:assertionSubject iroko:Plant0001 ;
  iroko:assertionPredicate iroko:hasUse ;
  iroko:assertionObject iroko:Use_HealingWork ;
  iroko:authorizedBy iroko:Authority_Havana_LineageX ;
  iroko:accessTier iroko:Tier3_Lineage ;
  iroko:inCulturalFrame "Lucumi" ;
  iroko:inJurisdiction iroko:Havana ;
  iroko:recordedInEvent iroko:FW_HAV_2026_02_10 ;
  iroko:recordedBy iroko:DeleFagbemiO ;
  iroko:recordedAt iroko:Havana ;
  iroko:recordedOn "2026-02-10"^^xsd:date ;
  iroko:contestedFlag false .

# Claim 2: A different use is asserted in a different jurisdiction (initiate-level)
iroko:Assertion_0002 a iroko:Assertion ;
  iroko:assertionSubject iroko:Plant0001 ;
  iroko:assertionPredicate iroko:hasUse ;
  iroko:assertionObject iroko:Use_ProtectionWork ;
  iroko:authorizedBy iroko:Authority_CapHaitien_HouseY ;
  iroko:accessTier iroko:Tier2_Initiate ;
  iroko:inCulturalFrame "Vodou" ;
  iroko:inJurisdiction iroko:CapHaitien ;
  iroko:recordedInEvent iroko:FW_CAP_2026_02_12 ;
  iroko:recordedBy iroko:DeleFagbemiO ;
  iroko:recordedAt iroko:CapHaitien ;
  iroko:recordedOn "2026-02-12"^^xsd:date ;
  iroko:contestedFlag true ;
  iroko:contestedNote "Different houses describe different authorized uses. Do not merge." .

########
# Minimal vocab for the example objects used above
########

iroko:Use_HealingWork a skos:Concept ;
  skos:prefLabel "Healing work"@en .

iroko:Use_ProtectionWork a skos:Concept ;
  skos:prefLabel "Protection work"@en .

# Predicates can be minted in your namespace too
iroko:hasUse a skos:Concept ;
  skos:prefLabel "has use"@en .
