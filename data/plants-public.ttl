@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix ewe: <https://iroko-framework.github.io/iroko-framework/vocab/iroko-ewe#> .

<https://iroko-framework.github.io/iroko-framework/data/plants-public>
    a void:Dataset ;
    dcterms:title "Iroko Historical Society - Public Plant Names"@en ;
    dcterms:description "Scientific and vernacular names of sacred plants in Afro-Atlantic traditions. This dataset will contain identification information only. For detailed knowledge including ritual uses and preparation methods, visit https://irokosociety.org with appropriate access credentials."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:created "2026-02-18"^^xsd:date ;
    rdfs:comment "Dataset is currently empty. Plant data will be added as the operational archive is populated."@en ;
    rdfs:seeAlso <https://irokosociety.org> .

# Plant instances will be added here when operational database is ready
